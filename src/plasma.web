@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Read in information about plasma.

@<Functions...@>=
      subroutine read_plasma
      implicit_none
      decl_plasma
      integer nx,ny
      open(unit=20,file='../data/b2specss',status='old',form='formatted')
      read(20,*) nx,ny
      read(20,*)
      read(20,*)
      nplasma=nx*ny
      nsolid=3
      nvacuum=3
      nzones=nplasma+nsolid+nvacuum
      nbackground=2
      call read_b2_plasma(nx,ny)
      close(unit=20)
      return
      end

@ The main routine.

@<Functions...@>=
      subroutine read_b2_plasma(nx,ny)
      implicit_none
      decl_plasma
      integer nx,ny,j
      sy_common
      
      var_alloc(zone_type)
      var_alloc(plasma_t)
      var_alloc(plasma_n)
      var_alloc(plasma_type)
      plasma_type[1]=1
      plasma_type[2]=2
      
      do j=1,nx*ny
         zone_type[z_type,j]=PLASMA
         zone_type[z_index,j]=j
      end do
      zone_type[z_type,nx*ny+1]=VACUUM
      zone_type[z_index,nx*ny+1]=1
      zone_type[z_type,nx*ny+2]=SOLID
      zone_type[z_index,nx*ny+2]=1
      zone_type[z_type,nx*ny+3]=SOLID
      zone_type[z_index,nx*ny+3]=2
      zone_type[z_type,nx*ny+4]=SOLID
      zone_type[z_index,nx*ny+4]=3
      zone_type[z_type,nx*ny+5]=VACUUM
      zone_type[z_index,nx*ny+5]=2
      zone_type[z_type,nx*ny+6]=VACUUM
      zone_type[z_index,nx*ny+6]=3
      
      do j=1,nx*ny
         read(20,*)             // IX IY
         read(20,*)             // Coords
         read(20,*)             // cr/cz
         read(20,*)
         read(20,*)
         read(20,*)
         read(20,*)
         read(20,*)             // Te ...
         read(20,*) plasma_t[1,j],plasma_n[1,j],plasma_t[2,j]
         read(20,*)             // Species
         read(20,*)
         plasma_n[2,j]=plasma_n[1,j]
      end do

      return
      end

@ Read in neutral density and volume info.

@<Functions...@>=
      subroutine read_neutral
      implicit_none
      integer nzonesp
      parameter(nzonesp=1158)
      integer dum,j
      real vol,den
      real min_n,max_n,density[nzonesp]
      common /temp/ min_n,max_n,density
      open(unit=20,file='geomtest.out',form='formatted',status='old')
      open(unit=21,file='geomtest.tmp',form='formatted',status='old')

      min_n=const(1.0,50)
      max_n=zero
      
      read(20,*)
      read(21,*)
      read(21,*)
      read(21,*)

      do j=1,nzonesp
         read(20,*) dum,vol
         read(20,*)
         read(21,*) dum,den
         read(21,*)
         density[j]=den/vol
         if (density[j] > zero) then
            min_n=min(min_n,density[j])
            max_n=max(max_n,density[j])
         end if
      end do
      
      return
      end
         

      
