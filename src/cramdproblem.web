% $Id$
\Title{cramdproblem}

% $Log$
% Revision 1.1  1997/08/07 19:33:10  dstotler
% Separate stand-alone code (to go with boxgen) to take the generic
% CRAMD-problem.nc file and replace the data values with the real ones.
% The idea was to avoid reading problem data into boxgen (to keep it
% simple). Without this program, add_cramd_data is only called in
% readbackground.
%

@* Replace placeholder problemfile data with real CRAMD data. Reads in the
plasma description, calls CRAMD routines, and fills in problem data in the
problemfile.

\ID{$Id$}

@m FILE 'cramdproblem.web'

@I macros.hweb


@ The main program.


@a 
      program cramdproblem
      implicit_none_f77
      implicit_none_f90

      call readfilenames

      call read_geometry

      call nc_read_species
      call nc_read_materials
      call nc_read_reactions
      call nc_read_pmi
      call nc_read_problem
      call nc_read_background
      call add_cramd_data

      stop
      end
