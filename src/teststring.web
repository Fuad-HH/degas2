@m FILE 'teststring.web'

@I macros.hweb


@ The unnamed module.

@a
      program foo
      implicit_none_f77
      implicit_none_f90
      character*LINELEN string
      integer l,p,b,e
      logical test,test1
      external read_string,parse_string,next_token
      logical read_string,next_token
      integer parse_string

      open(unit=20,name='teststring.inp',status='old')
      
loop: continue
      test=read_string(20,string,l)
      l=min(l,len(string))
      l=parse_string(string(1:l))
      write(stdout,*) l
      p=0
loop1:continue
      test1=next_token(string(1:l),b,e,p)
      if (test1) then
         write(stdout,*) e-b+1, ' ', string(b:e)
         goto loop1
      end if
      
      if (test) goto loop

      stop
      end

