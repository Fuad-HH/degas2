@* Test source sampling routines.

\ID{$Id$}

@m FILE 'sourcetest.web'

@I macros.hweb
@I zone.hweb
@I sysdep.hweb
@I particle.hweb
@I flight.hweb
@I random.hweb
@I background.hweb
@I species.hweb
@I string.hweb
@I problem.hweb
@I location.hweb
@I sector.hweb
@I sources.hweb
@I vector.hweb
@I reaction.hweb
@I materials.hweb

@ The main program.

@a
      program sourcetest
      implicit_none_f77
      implicit_none_f90

      call readfilenames
      call degas_init
      call do_src_tests

      stop
      end

      @<Functions and subroutines@>

@ Routine to actually do tests.

@m max_num_chis 10

@<Functions...@>=
      subroutine do_src_tests
      define_varp(stat,FLOAT,zone_ind)
      define_varp(zone_segment,INT,zone_ind)
      define_varp(segment_zone,INT,source_seg_ind)
      define_varp(prob_seg,FLOAT,source_seg_ind)

      implicit_none_f77
      zn_common
      sp_common
      sc_common
      so_common
      implicit_none_f90
      real rel_wt,weight_tot,energy,fr,vsrc_mag,vnorm_mag,cos_theta,
     $     deltax_mag,vpar1,vpar2,vplane2_mag,
     $     min_prob,max_prob
      real chi_sqd(max_num_chis)
      integer num,i,xseg,nsample,zone,nseg,j,num_chis
      integer num_points(max_num_chis)
      rn_seed_decl(seed)
      integer length,p,b,e
      character*LINELEN line

      lc_decl(xsrc)
      so_decl(isource)
      sp_decl(spsrc)
      fl_decl(x)
      vc_decl(vzero)
      vc_decl(vone)
      vc_decl(deltax)
      vc_decl(xp)
      vc_decl(xp2)
      vc_decl(vsrc)
      vc_decl(vnorm)
      vc_decl(vplane2)

      @<Memory allocation interface@>
      rn_decls
      st_decls
      pt_decls
      lc_decls
      vc_decls

      declare_varp(zone_segment)
      declare_varp(stat)
      declare_varp(segment_zone)
      declare_varp(prob_seg)

      var_alloc(zone_segment)
      var_alloc(stat)
      var_alloc(segment_zone)   // Upper bound on size
      var_alloc(prob_seg)

      rn_init(seed,fl_rand(x))  // Initialize random numbers for flight

      open(unit=diskout,file='sourcetest.out',status='unknown')

loop1: continue

      write(stdout,*) 'Enter index for a source group, 1 to ',so_grps,
     $     ' And number of samples'
      if (! read_string(stdin,line,length)) goto break
      assert(length<=len(line))
      length=parse_string(line(:length))
      p=0
      assert(next_token(line,b,e,p))
      isource=read_integer(line(b:e)) 
      assert(isource > 0 && isource <= so_grps)
      assert(next_token(line,b,e,p))
      nsample=read_integer(line(b:e))

      do i=1,zn_num
         zone_segment[i]=0
      end do

      min_prob=one
      max_prob=zero
      do i=1,so_nseg(isource)
         if (so_geom(isource) == so_surface) then
            zone=sector_zone[source_segment_ptr[so_base(isource)+i-1]]
         else if (so_geom(isource) == so_volume) then
            zone=source_segment_ptr[so_base(isource)+i-1]
         else
            assert("Unsupported source geometry" == " ")
         end if
         assert(zone_segment[zone] == 0)
         zone_segment[zone]=i
         segment_zone[i]=zone
         prob_seg[i]=source_current[so_base(isource)+i-1]/so_tot_curr(isource)
         min_prob=min(min_prob,prob_seg[i])
         max_prob=max(max_prob,prob_seg[i])
      end do
      assert(min_prob > zero)
      assert(max_prob < one)

      do i=1,zn_num
         stat[i]=zero
      end do

      weight_tot=zero

      do num=1,nsample
         fl_label(x,num,isource)
         call sample_sources(fl_args(x),rel_wt) 
         stat[lc_zone(pt_loc(fl_origin(x)))]+=rel_wt
         weight_tot+=rel_wt
      end do

      min_prob=const(1.,1)**max(int(log10(min_prob))-1,-10)
      num_chis=int(log10(max_prob/min_prob))+1
      assert(num_chis <= max_num_chis)
      do j=1,num_chis
         chi_sqd[j]=zero
         num_points[j]=0
      end do

      write(diskout,*)
      write(diskout,*) '   For source group = ',isource
      write(diskout,*) 
     $  '  Seg  Ptr    Weight      Rel.Wt.   Rel.Curr.' 
      do i=1,so_nseg(isource)
        write(diskout,'(i5,1x,i5,1x,1pe11.4,1x,e11.4,1x,e11.4)') 
     $        i,source_segment_ptr[so_base(isource)+i-1],
     $        stat[segment_zone[i]],stat[segment_zone[i]]/weight_tot,
     $        prob_seg[i]
        do j=1,num_chis
           if (prob_seg[i] > min_prob*const(1.,1)**(j-1)) then
              num_points[j]++
              chi_sqd[j]+=(stat[segment_zone[i]]-weight_tot*prob_seg[i])**2
     $             /(weight_tot*prob_seg[i])
           end if
        end do
      end do

      write(diskout,*) ' Min. Prob.  Num. Points    Chi Sqd./Num.Pts.'
      do j=1,num_chis
         assert(num_points[j] > 0)
         write(diskout,'(2x,1pe8.1,7x,i5,11x,0pf9.6)') min_prob*const(1.,1)**(j-1),num_points[j],
     $        chi_sqd[j]/num_points[j]
      end do

break:  continue

      var_free(stat)
      var_free(zone_segment)
      var_free(segment_zone)
      var_free(prob_seg)

loop2: continue

      write(stdout,*) 'Segment test: enter source group, 1 to ',so_grps
      if (! read_string(stdin,line,length)) goto eof
      assert(length<=len(line))
      length=parse_string(line(:length))
      p=0
      assert(next_token(line,b,e,p))
      isource=read_integer(line(b:e)) 
      assert(isource > 0 && isource <= so_grps)
      write(stdout,*) 'Enter segment number, 1 to ',so_nseg(isource),
     $     ', and number of samples'

      if (! read_string(stdin,line,length)) goto eof
      assert(length<=len(line))
      length=parse_string(line(:length))
      p=0
      assert(next_token(line,b,e,p))
      nseg=read_integer(line(b:e)) 
      assert(nseg > 0 && nseg <= so_nseg(isource))
      assert(next_token(line,b,e,p))
      nsample=read_integer(line(b:e))

      xseg=source_segment_ptr[so_base(isource)+nseg-1]

      vc_set(vzero,zero,zero,zero)
      vc_set(vone,zero,zero,one)

      write(diskout,*)
      write(diskout,*) 'For source group ',isource,', segment ',
     $     nseg,', which points to geometry element ',xseg
      write(diskout,*) '   i      x            y            z            vx           vy           vz         energy         fr         cos_th       vpar1       vpar2'
      do i=1,nsample
         call set_source_x(so_args(isource),xseg,rn_args(fl_rand(x)),
     $        lc_args(xsrc))
         call set_source_v(so_args(isource),xseg,lc_args(xsrc),
     $        rn_args(fl_rand(x)),vc_args(vsrc),sp_args(spsrc))
         energy=half*sp_m(spsrc)*vc_abs2(vsrc)/electron_charge
/* For surface sources, break |xsrc| and |vsrc| down into components
   relative to surface.
 */
         if (so_geom(isource) == so_surface) then
// Distance along segment (as in |set_puff_source_v|)
            vc_difference(sector_points[xseg][1],sector_points[xseg][0],deltax)
            vc_difference(lc_x(xsrc),sector_points[xseg][0],xp)
            fr=vc_product(xp,deltax)/vc_abs2(deltax)
            assert(fr >= 0 && fr <= one)
            vc_xvt(sector_points[xseg][0],deltax,fr,xp2)

// Normal velocity 
            vsrc_mag=vc_abs(vsrc)
            call surface_reflect(sector_surface[xseg],vc_args(xp2),
     $           vc_args(vzero),vc_args(vone),vc_args(vnorm))
            vnorm_mag=vc_abs(vnorm)
            if (vnorm_mag != zero && vsrc_mag != zero) then
               cos_theta=vc_product(vnorm,vsrc)/(vnorm_mag*vsrc_mag)
            else
               cos_theta=zero
            end if

// Components in plane of surface
            deltax_mag=vc_abs(deltax)  // deltax is one direction in plane
            if (deltax_mag != zero && vsrc_mag != zero) then
               assert(abs(vc_product(deltax,vnorm)/(deltax_mag*vnorm_mag)) 
     $              < geom_epsilon)   // Check that normal is normal
               vpar1=vc_product(deltax,vsrc)/(deltax_mag*vsrc_mag)
            else
               vpar1=zero
            end if

            vc_cross(vnorm,deltax,vplane2)  // A second direction in plane
            vplane2_mag=vc_abs(vplane2)
            if (vplane2_mag != zero && vsrc_mag != zero) then
               vpar2=vc_product(vplane2,vsrc)/(vplane2_mag*vsrc_mag)
            else
               vpar2=zero
            end if
 
         else               // Not a surface source
            fr=zero
            cos_theta=zero
            vpar1=zero
            vpar2=zero
         end if

         write(diskout,'(i5,1x,1p,11(e11.4,2x))') i,lc_x(xsrc)[1],
     $        lc_x(xsrc)[2],lc_x(xsrc)[3],
     $        vsrc[1],vsrc[2],vsrc[3],energy,fr,cos_theta,vpar1,vpar2

      end do
      go to loop2

eof: continue
      close(unit=diskout)

      return
      end

@* INDEX.
