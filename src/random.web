@* External interface to random.

The state of the random number generator is stored in |rn_args(tag)|,
where |tag| is an arbitrary tag.  This should not be altered by any
external routine.  |rn_decl(tag)| declares |rn_args(tag)| and, in
a top-level routine, allocates space for them.

The externally callable routines are:

|call random_init(seed,rn_args(tag))| which initializes the random number
using a two-element integer array |seed[0:1]|.  |seed| must satisfy
|0<=seed[0]<2^24| and |0<=seed[1]<2^23|.

|call random_seed(seed)| initializes a two-element integer array
|seed[0:1]| ``randomly'', based on the current time and the processor id.
The array |seed| is suitable for passing to |random_init|.

|call next_seed(n,seed,newseed)| advances the seed $n$ step forward.  This
allows independent threads of random numbers to be initialized.

|x = random(rn_args(tag))| which returns the next random number in |x|.
|x| is a |real| random number uniformly distributed in $(0,1)$.

|call random_check(n,rn_args(tag))| which checks that $n$ random numbers
are available for return with |fast_random|. |n| must satisfy |0<= n <=
RAN_K|.

|x = fast_random(rn_args(tag))| which returns the next random number in
|x|.  |fast_random| differs from |random| in that no checking is done
that the random numbers are available.  Thus a call to |random_check|
must precede any calls to |fast_random|.

The random numbers returned by |random| and |fast_random| are of the form
$(i+\frac12)/2^{47}$ for $0\le i < 2^{47}$.

@ Typical calling sequence.  Suppose we are running in a multitasking mode,
then in order that the results be independent of the number of threads
executing the simulation, it is natural to start each flight off with an
independent random number sequence.  The top-level routine would then look
like:

@#if 0
@a
      integer ntasks,nflights,n,num
      integer seed0[0:1],seed[0:1,0:ntasks-1]
      
      call random_seed(seed0)   // Write out the seed!

      num=(nflights+ntasks-1)/ntasks // number of flights/task

      do n=0,nflights-1,num
         call next_seed(n,seed0,seed[0,n/num])
         call tskstart(xxx,doflights,min(nflights-n,num),seed[0,n/num],xxx)
      end do
@#endif

@ |doflights| would then be defined by

@#if 0
@a
      subroutine doflights(num,seed,xxx)
      rn_decl(x)          // Allocate space for |rn_args|
      integer i,num
      integer seed[0:1]

      do i=0,num-1
         call random_init(seed,rn_args(x)) // Initialize |rn_args|

  /* follow a flight with many calls to |random| or |fast_random| */

        call next_seed(1,seed,seed) // Get next seed
      end do

      return
      end
@#endif

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Define constants used in the basic random number generator.
The basic algorithm is
\begin{equation}\label{recursion}X_n=(X_{n-k}-X_{n-j})\bmod 1,\end{equation}
with $k$ and $j$ given by Knuth's Table 3.2.2--1 \cite{knuth2}.  In this
relation, replacing $j$ by $k-j$ is equivalent to running the recursion
backwards.  We make the choice $j\ge k/2$, since this results in longer
vectorizing loops.  We also choose $k=63$, since this is the largest $k$
such that |random_batch| vectorizes with short vector loops.

@m ran_k 63                     // Set $k$.
@m ran_j 31                     // Set $j$

@#if 2*ran_j < ran_k      // and ensure that $j\ge k/2$.
   @m ran_j _EVAL(ran_k-#!ran_j)
@#endif

@m ran_d 25               // $d = \lceil(2-\phi) k\rceil$ ($\phi=\frac12(\sqrt5+1)$) and $\gcd(k,d)=1$

_ASSERT(ran_k == RAN_K)   // Check that the header file set |RAN_K| correctly

@m ran_delta const(2.0)^(-47)   // The discreteness of the random numbers

@m ran_m0 2^24                  // The limits on the seeds
@m ran_m1 2^23

@* Functions to return random numbers.  We calculate the random numbers in
batches, placing the results into the array |ran_array|.  The routine to
return a single random number, |random|, can then merely return the next
array element.  It calls the routine to calculate the next batch if
necessary.  |ran_count| points to the next element of |ran_array| to be
used.  |ran_max| points to the first invalid element of |ran_array|.  Thus
the number of usable random numbers is |ran_max - ran_count|.  |ran_count|,
|ran_max|, and |ran_array| together describe the state of the random number
generator.  The header file packages these together into a single argument
|rn_args(x)|.

@<Functions...@>=
      function random(rn_dummy(x))
      implicit_none
      real random               // Function
      rn_decl(x)             // Input/output
      external random_batch     // External

      if (rn_index(x) >= rn_max(x)) then
         call random_batch(rn_args(x))
      end if
      random=rn_array(x)[rn_index(x)]+ran_epsilon
      rn_index(x)=rn_index(x)+1
      return
      end

@ Check that there are at least |n| random numbers available.  After this
routine the next $n$ random numbers can be retrieved with |fast_random|.
Because of the size of the batches in which the random numbers are
generated, we require $n\le k$.

@<Functions...@>=
      subroutine random_check(n,rn_dummy(x))
      implicit_none
      integer n                 // Input
      rn_decl(x)             // Input/output
      external random_batch     // External

      assert(0 <= n && n <= ran_k)
      if (n > rn_max(x)-rn_index(x)) call random_batch(rn_args(x))
      check(n <= rn_max(x)-rn_index(x))
      return
      end

@ If you've called |random_check(n,rn_args(x))|, then you can use this
routine to return the next $n$ random numbers.  Do loops calling
|fast_random| can be vectorized if |fast_random| is expanded inline.

@<Functions...@>=
      function fast_random(rn_dummy(x))
      implicit_none
      real fast_random          // Function
      rn_decl(x)             // Input/output

      fast_random=rn_array(x)[rn_index(x)]+ran_epsilon
      rn_index(x)=rn_index(x)+1
      return
      end

@* Calculate the next batch.  The fills the next $k$ elements of
|rn_array(x)|.  |rn_array(x)| is dimensioned to hold $2k$ elements.  This
simplifies the coding of equation (\ref{recursion}).  It also allows
|random_batch| to be called before the previous batch is exhausted, which
in turn means that we can ensure that at least $n$ elements are available
at any time by calling |random_check(n,rn_args(x))| for $n\le k$.


@<Functions...@>=
      subroutine random_batch(rn_dummy(x))
      implicit_none
      rn_decl(x)             // Input/output
      integer i                 // Local
      real tmp

      check(rn_max(x) == ran_k || rn_max(x) == 2*ran_k) // We assume |rn_max(x)| takes on one of these values

/* First check we didn't take too many random numbers, e.g., by calling
|fast_random| too many times. */
      assert(rn_index(x) >= 0 && rn_index(x) <= rn_max(x))

      if (rn_index(x) < ran_k && rn_max(x) == 2*ran_k) return // Array already full

      if (rn_index(x) >= ran_k && rn_max(x) == 2*ran_k) then // Shift array down
         @<Shift |rn_array(x)| down |ran_k| elements@>
      end if

/* Fill second half.  The compiler codes this as two safe short vectors of
length |ran_j|, in order to avoid the recursion */
      do i=ran_k,2*ran_k-1
         tmp=rn_array(x)[i-ran_k]-rn_array(x)[i-ran_j]
         if (tmp < zero) tmp=one+tmp
         rn_array(x)[i]=tmp
      end do

      rn_max(x)=rn_max(x)+ran_k
      rn_count(x)=rn_count(x)+ran_k

      if (rn_index(x) >= ran_k) then // Shift array down
         @<Shift |rn_array(x)| down...@>
      end if

      check(rn_index(x) >= 0 && rn_index(x) < rn_max(x)) // Sanity check on |rn_index(x)|

      return
      end

@ |random_batch| needs to shift the data in the top half of |rn_array(x)| to
the bottom half.

@<Shift |rn_array(x)| down...@>=
         do i=0,ran_k-1         // a short vector move
            rn_array(x)[i]=rn_array(x)[i+ran_k]
         end do
         rn_index(x)=rn_index(x)-ran_k
         rn_max(x)=rn_max(x)-ran_k

@* Initialize random number generator.  This again follows from Knuth
\cite{knuth2}, although the details are taken from the code for Metafont
\cite{knuth86}.  The initialization uses a Fibonacci-like recursion,
\begin{equation} Y_i = Y_{i-2} - Y_{i-1}. \end{equation}
However, this doesn't grow fast enough to fill out all the bits in fraction
of a floating-point number in $k$ iterations since $\phi^k < 2^{47}$
($\phi=\frac12(\sqrt 5 + 1)$).  So we prime it with an extra $k$ iterations.

|seed[i]| (for $i=0,1$) are integer seeds satisfying $0 \le s_0 < 2^{24}$,
$0 \le s_1 < 2^{23}$.  These seeds are used by combining them into a single
47-bit integer $s_0 + s_1 2^{24}$.

@<Functions...@>=
      subroutine random_init(seed,rn_dummy(x))
      implicit_none
      integer seed[0:1]         // Input
      rn_decl(x)             // Output
      integer i                 // Local
      real k,jj,j
      external random_batch     // External

      assert(0<=seed[0] && seed[0]<ran_m0)
      assert(0<=seed[1] && seed[1]<ran_m1)
      j=(areal(seed[1])*areal(ran_m0)+areal(seed[0]))*ran_delta // starting values
      k=ran_delta
      check(j>=zero && j<one)

      do i=0,ran_k-1            // prime the sequence
         jj=k
         k=j-jj
         if (k < zero) k=k+one
         j=jj
      end do

      do i=0,ran_k-1            // repeat depositing results in |rn_array(x)|
         jj=k
         k=j-jj
         if (k < zero) k=k+one
         j=jj
         rn_array(x)[mod(i*ran_d,ran_k)]=j // Shuffle the sequence
      end do

      rn_max(x)=ran_k
      rn_index(x)=ran_k

      do i=1,3                  // Warm up the generator
         call random_batch(rn_args(x))
         rn_index(x)=rn_index(x)+ran_k
      end do

      rn_count(x) = 0           // Initialize count of random numbers produced
      rn_gauss_index(x) = 0     // Initialize the other generators
      rn_iso_index(x) = 0
      rn_cos_index(x) = 0

      end

@* Choose random seed depending on current time and processor id.  This
returns the seed as two integers $s_i$ for $i=0,1$.  These seeds are to
be combined into a single 47-bit integer $s = s_0+m s_1$.
We begin by setting the seed to the 14-digit (decimal) number formed by
concatenating the year (mod 100), month, day, hour, minute, second, and
process id (mod 100).  (Note that $2^{47} > 10^{14}$.)

The function |next_seed| is then called to randomize the result, so that
successive runs have very different starting seeds.  Within a run,
|next_seed| may be called repeatedly to generate a random sequence of
starting seeds.

@<Functions...@>=
      subroutine random_seed(seed)
      implicit_none
      integer seed[0:1]         // Output
      integer temp[7],i,s[0:1] // Local
      external date_time,get_pid // External
      integer get_pid

      call date_time(temp)
      temp[7]=get_pid()
      goto skip

      entry random_seed_test(seed)
      do i=1,7
         temp[i]=99
      end do

skip: continue

      s[0]=0
      s[1]=0

/* These multiplications by $100$ won't give overflow on a 32-bit computer
because $2^{31}/|ran_m0|=128$. */

      do i=1,7
         s[0]=100*s[0]+mod(temp[i],100) // Use last two digits of year and PID
         s[1]=100*s[1]+s[0]/ran_m0
         s[0]=mod(s[0],ran_m0)
         s[1]=mod(s[1],ran_m1)
      end do

      call next_seed(1,s,s)

      seed[0]=s[0]
      seed[1]=s[1]

      return
      end

@* Generating a sequence of random seeds.  We use the simple linear
congruential formula
\begin{equation}\label{linear}
X_{n+1}=(aX_n + c) \bmod 2^{47},
\end{equation}
See Knuth \cite{knuth2}, Sec.~3.2.1.  We also use the
inverse of equation (\ref{linear})
$$
X_{n-1}=(bX_n + d) \bmod 2^{47},
$$
where $ab = 1 \bmod 2^{47}$ and $d=-bc \bmod 2^{47}$.  We choose $a =
\mathrm{5DEECE66D}_{16} = 273673163155_8 = 25214903917$ and $c = \mathrm
B_{16} = 13_8 = 11$ which are the default choices in the |drand48| library
routine \cite{drand48}.  (|drand48| operates modulo $2^{48}$.  What we are
doing is equivalent to dropping the leading bit.)  We then have $b =
\mathrm{5FE05BCB1365}_{16} = 2776013362611545_8 = 105417217348453$ and $d =
\mathrm{615C0E462AA9}_{16} = 3025601621425251_8 = 107048004364969$.  Since
we want this to work on computers with 32-bit integers, we split up the
47-bit integers into pieces such that $x_0$ holds the low 24 bits and $x_1$
holds to the high 23 bits.

@m ran_a0 0xECE66D
@m ran_a1 0x5DE
@m ran_c0 0xB
@m ran_c1 0x0
@m ran_b0 0xCB1365
@m ran_b1 0x5FE05B
@m ran_d0 0x462AA9
@m ran_d1 0x615C0E

@ |next_seed| steps the seed forward $n$ steps.  Thus, if $X_0 = x$, then
we have $X_n = y$.  $n$ is decomposed in binary and $x$ is stepped forward
by powers of 2.  We do this by composing equation (\ref{linear}) with
itself to give, e.g.,
$$
X_{n+2}=(a'X_n + c') \bmod 2^{47}.
$$
where $a'=a^2 \bmod 2^{47}$ and $c'= (a+1)c \bmod 2^{47}$.  The cpu time is
proportional to $\log n$.  Input and output can overlap.

@<Functions...@>=
      subroutine next_seed(n,x,y)
      implicit_none
      integer n,x[0:1]          // Input
      integer y[0:1]            // Output
      integer a[0:1],c[0:1],t[0:1],m   // Local

      check( 0 <= x[0] && x[0] < ran_m0 )
      check( 0 <= x[1] && x[1] < ran_m1 )

      y[0]=x[0]
      y[1]=x[1]

      if (n == 0) return

      if (n > 0) then
         m = n
         a[0] = ran_a0
         a[1] = ran_a1
         c[0] = ran_c0
         c[1] = ran_c1
      else
         m = -n
         a[0] = ran_b0
         a[1] = ran_b1
         c[0] = ran_d0
         c[1] = ran_d1
      end if

loop: continue
      if (mod(m,2) > 0) then
         call rand_mult(a,y,y)
         call rand_add(y,c,y)
      end if
      m = m/2
      if (m == 0) return
      t[0] = 1                  // Generate coefficients for the square of the mapping.
      t[1] = 0
      call rand_add(a,t,t)
      call rand_mult(t,c,c)     // $c'=(a+1)c$
      call rand_mult(a,a,a)     // $a'=a^2$
      goto loop

      end

@ Add two 47-bit numbers, $z=x+y$.  Output can overlap with input.

@<Functions...@>=
      subroutine rand_add(x,y,z)
      implicit_none
      integer x[0:1],y[0:1]     // Input
      integer z[0:1]            // Ouput

      z[0]=x[0]+y[0]
      z[1]=mod(x[1]+y[1]+z[0]/ran_m0,ran_m1)
      z[0]=mod(z[0],ran_m0)

      return
      end

@ Multiply two 47-bit numbers, $z=xy$.  Output can overlap with input.

@m ran_base 2^12                // The base used in |rand_mult|

@<Functions...@>=
      subroutine rand_mult(x,y,z)
      implicit_none
      integer x[0:1],y[0:1]     // Input
      integer z[0:1]            // Ouput
      integer tx[0:3],ty[0:3],tz[0:3],i,j // Local

      do i=0,1
         tx[2*i]=mod(x[i],ran_base)
         ty[2*i]=mod(y[i],ran_base)
         tx[2*i+1]=x[i]/ran_base
         ty[2*i+1]=y[i]/ran_base
      end do

      do i=0,3
         tz[i]=0
         do j=0,i
            tz[i]=tz[i]+tx[j]*ty[i-j]
         end do
      end do

      z[0] = tz[0] + ran_base*mod(tz[1],ran_base)
      z[1] = tz[1]/ran_base + tz[2] + ran_base*mod(tz[3],ran_base)

      z[1] = mod(z[1] + z[0]/ran_m0, ran_m1)
      z[0] = mod(z[0], ran_m0)

      return
      end

