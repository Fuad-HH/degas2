@* Routines required for quadratures. These are taken from 
{\em Numerical Recipes} by W. H. Press et al. (Cambridge Press,
New York, 1986).
|qromo| does Romberg integration on an open interval.
Returns as |ss| the integral of the function |func| from |a| to |b|,
using any specified integrating subroutine |choose| and Romberg's 
method. Normally |choose| will be an open formula, not evaluating the
function at the endpoints. It is assumed that |choose| triples the 
number of steps on each call, and that its error series contains only
even powers of the number of steps.

@<Functions...@>=
      subroutine qromo(func,a,b,ss,choose)
      implicit_none
      real a, b, func          // Input; |func| is function name
      real ss                  // Output

/* Parameters: |eps| is the fractional accuracy desired, |jmax| limits 
the total number of steps, and |k| is the number of extrapolation points */
      real eps               
      integer jmax,jmaxp,k,km
      parameter (eps=const(1.0,-6)) 
      parameter (jmax=14, jmaxp=jmax+1)
      parameter (k=5, km=k-1)

      real s[jmaxp], h[jmaxp]

      h[1]=one
      do j=1,jmax
         
         call choose(func,a,b,s[j],j)
         if (j >= k) then
            call polint(h[j-km],s[j-km],k,zero,ss,dss)
            if (abs(dss) < eps*abs(ss)) return
         end if
         s[j+1]=s[j]
         h[j+1]=h[j]/const(9.0) // Step tripling assumption used here
      end do
      assert(.false.)           // Indicate error if get here
      end

@ Polynomial interpolation routine. Given arrays |xa| and |ya|, each of
length |n|, and given a value |x|, this routine returns a value |y|, and
an error estimate |dy|. If $P(x)$ is the polynomial of degree |n - 1| such
that $P( |xa[j]| ) = |ya[j]|$, $|j| = 1$, \ldots, |n|, then the returned
value $|y| = P(|x|)$.

@<Functions...@>=
      subroutine polint(xa,ya,n,x,y,dy)
      implicit_none

      integer n                  // Input
      real xa[n],ya[n]
      real x
      real dy,y                  // Output

      integer nmax               // Parameter
      parameter (nmax=10)

      integer i,m,ns             // Local variables
      real c[nmax],d[nmax]
      real den,dif,dift,ho,hp,w

      ns=1
      dif=abs(x-xa[1])
      do i=1,n                   // Here we find index ns of closest entry
         dift=abs(x-xa[i])
         if (dift < dif) then
            ns=i
            dif=dift
         end if
         c[i]=ya[i]             // and initialize the tableau of |c| and |d|
         d[i]=ya[i]
      end do
    
      y=ya[ns]                  // This is the initial approximation to |y|.
      ns=ns-1
/* For each column of the tableau, we loop over the current |c| and |d| and
update them. */
      do m=1,n-1  
         do i=1,n-m
            ho=xa[i]-x
            hp=xa[i+m]-x
            w=c[i+1]-d[i]
            den=ho-hp

/* This error can occur only if two input |xa|'s are identical. */
            assert(den!= zero) 

            den=w/den
            d[i]=hp*den          // Here the |c| and |d| are updated.
            c[i]=ho*den
         end do

/* After each column in the tableau is completed, we decide which
correction, |c| or |d|, we want to add to our accumulating value of |y|,
i.e., which path to take through the tableau -- forking up or down. We
do this in such a way as to take the most ``straight line'' route through
the tableau to its apex, updating |ns| accordingly to keep track of
where we are. This route keeps the partial approximations centered
(insofar as possible) on the target |x|. The last |dy| added is thus the
error indication. */ 

         if (2*ns < n-m) then
            dy=c[ns+1]
         else
            dy=d[ns]
            ns=ns-1 
         end if
         y=y+dy
      end do

      return 
      end
     
@ Basic integration routine. This routine computes the |n|th stage of
refinement of an extended midpoint rule. When called with $|n| = 1$,
the routine returns as |s| the crudest estimate of $\int_{|aa|}^{|bb|}
f(x) dx$. Subsequent calls with |n| = 2, 3, \ldots (in that sequential
order) will improve the accuracy of |s| by adding $(2/3) \times 3^{|n|-1}$
additional interior points. |s| should not be modified between 
sequential calls. For this specific routine, |bb| is assumed to be
infinite (value passed not used). It is assumed that the function
|funk| decreases exponentially at infinity.

@<Functions...@>=
      subroutine midexp(funk,aa,bb,s,n)
      implicit_none

      integer n               // Input
      real aa,bb,funk
      real s                  // Output

      integer it, j           // Local variables
      real a,b,ddel,del,func,sum,tnm,x

/*  Performs substitution $x^{\prime} = e^{-x}$ */
      func(x)=funk(-log(x))/x 
      b=exp(-aa)
      assert(one/bb < epsilon)  // Verify that |bb| is large.
      a=zero 

      if (n = 1) then
         s=(b-a)*func(half*(a+b))
         it=1                  // 2$\times$|it| points will be added next time
      else
         tnm=areal(it)
         del=(b-a)/(const(3.0)*tnm)

/*  The added points alternate in spacing between |del| and |ddel|. */
         ddel=del+del        
         x=a+half*del
         sum=zero
         do j=1,it
            sum=sum+func(x)
            x=x+ddel
            sum=sum+func(x)
            x=x+del
         end do

/* The new sum is combined with the old integral to give a refined integral. */
         s=(s+(b-a)*sum/tnm)/const(3.0)
      end if

      return
      end

@ ALADDIN routine to read fit coefficients. This routine takes as input
|filename|, the name of an ALADDIN data file; |lhsl|, an array of |khsl|
hierarchical search labels; |lbasl|, an array of |kbasl| ``.and.'' boolean
search labels; and |lbnsl|, an array of |kbnsl| ``.not.'' boolean search
labels (see ALADDIN documentation for further details). Following the
search through |filename|, the fit |kcf| fit coefficients are output
in the array |cf|. The boolean label identifying the evaluation routine
is returned in |leval|.  

@<Functions...@>=
      subroutine aladdin_read_coefs(filename,lhsl,khsl,lbasl,kbasl,
     $                              lbnsl,kbnsl,pcf,kcf,leval)
      implicit_none

/* Parameters: same as in ALCOM.FOR 
!!! Should these go in a macro so they can be used elsewhere ??!!*/
      integer nslmx,ncfmx
      parameter (nslmx=100)
      parameter (ncfmx=200)

      character*80 filename               // Input
      character*40 lhsl(nslmx),lbasl(nslmx),lbnsl(nslmx)
      integer khsl,kbasl,kbnsl

      character*40 leval                  // Output
      integer kcf
      double precision pcf(ncfmx)

/* Type declarations for variables in ALPCOM.FOR */
      integer nelnmx,nhlmx,nblmx           // Parameters
      integer leseqn,neln,nhl,nbl,         // Common block alent
     $        lcmptr,ncmln,lcfptr,ncfln
      include 'ALPCOM.FOR'

      logical eof,match
      character*80 errmsg
      integer ientry
      integer nhsl,i,n,k

      open(diskin,file=filename,status='old')

/* Loop through entries in |filename| */
      ientry=0
loop: continue
      call alread(diskin,ientry,eof,errmsg)
      assert(!eof)
      assert(errmsg = ' ')

/* Compare this entry with labels provided on input */
      call alcomp(lhsl,khsl,lbasl,kbasl,lbnsl,kbnsl,match)
      if (!match) goto loop
      close(unit=diskin)

/* Decode coefficients; check first that access label is the standard one */
      assert(bl[1][1:2] = '$ ')
      call alrecf(pcf,kcf,ncfmx,errmsg)
      assert(errmsg = ' ')

      leval = bl[nbl]               // Assign evaluation label variable
/* Note: this step is not really necessary; could just return bl \&
   select the last value when calling the evaluation routine. */
      return
 
      end

@ This routine does the dirty job of associating the input boolean 
label for the evaluation routine, |leval|, with an actual FORTRAN subroutine.
Because all of the ALADDIN routines of interest currently have essentially
the same arguments (although they differ in details which are of no
consequence to the compiler), this clearing-house routine can be
generated automatically from a shell script which reads through the file
containing all of the ALADDIN subroutines.

In addition to |leval|, the 
input arguments are: |pet|, the energy or temperature at which the
ALADDIN fit is to be evaluated and |pcf|, the array of |kncf| fit coefficients
passed in from the ALADDIN data files. The resulting value is returned as
|pfit|. Errors are returned via |kermsg|. 

@<Functions...@>=
      subroutine aladdin_eval(leval, pet, pcf, kncf, pfit, kermsg)
      implicit_none

/* Parameters: same as in ALCOM.FOR */
      integer ncfmax
      parameter (ncfmax=200)

      character*40 leval                  // Input
      integer kcf
      double precision pet
      double precision pcf(ncfmx)

      double precision pfit               // Output
      character*80 kermsg

