@n/

@* Introduction.

\ID{$Id$}

These routines access atomic physics cross sections from the ALADDIN
database and compute reaction rates from them. 

@m FILE 'ratecalc.web'

@I macros.hweb
@I ratecalc.hweb

@ The unnamed module

@a
      program ratecalc
      implicit_none
      integer fileid,j,k             // Local
      real delta,emin,energy,sigma
      character*msg_length error
      ra_common                      // Common
      ra_ncdecl
      xs_common
      xs_ncdecl
      nc_common
      sy_common
      ra_common_l                    // Local common

/* Open file containing the information describing the ALADDIN data */

      fileid = ncopen('../data/aladinput.nc',NC_NOWRITE,nc_stat)

      ra_ncread(fileid)

      call ncclose(fileid,nc_stat)

/* Get fit information from ALADDIN. The first
   dependent variable is assumed to be
   the cross section. The reaction rate and higher moments will be
   placed in subsequent dependent variable slots. */

        call aladdin_read_coefs(ra_data_filename,ra_hier_label,
     $     ra_num_hier,ra_bool_and_label,ra_num_bool_and,
     $     ra_bool_not_label,ra_num_bool_not,fit_coef,
     $     num_fit_coef,leval)

/* In one version, all of the above were functions of dependent variable
   index. The approach was simplified for the purposes of this code. 
   More complicated arrangements would be executed with separate codes
   (or perhaps by reading more than one input file per output file. */

      fileid = ncopen('../data/aladoutput.nc',NC_WRITE,nc_stat)
      
      xs_ncread(fileid)

/* Check some of the data parameters for consistency */
      assert(xs_num_dep_var <= xs_dep_var_max)

      do j=1,xs_num_dep_var
         assert(xs_rank[j] <= xs_table_rank_max)
      end do

/* Fill in table for cross section. First check that rank 
   and independent variable are as expected. */

      assert( (xs_rank[1] == 1) && (xs_var[1,1] == 'energy') )
      if (xs_spacing[1,1] == 'linear') then 
         emin = xs_min[1,1]*xs_mult[1,1]
         delta = (xs_max[1,1]-xs_min[1,1])*xs_mult[1,1]/
     $      areal(xs_tab_index(1,1)-1)
      else if (xs_spacing[1,1] == 'log') then
         emin = log(xs_min[1,1]*xs_mult[1,1])
         delta = log(xs_max[1,1]/xs_min[1,1])/areal(xs_tab_index(1,1)-1)
      else
         assert('Unknown spacing type' == ' ')
      end if

      do k=0,xs_tab_index(1,1)-1
         energy = emin + areal(k)*delta
         if (xs_spacing[1,1] == 'log') energy=exp(energy)
         energy=energy/electron_charge     // Aladdin input variables are in eV
         call aladdin_eval_fit(leval,energy,fit_coef,
     $      num_fit_coef,sigma,error)
         xs_table1[k,1,1]=sigma
      end do

      xs_ncwrite(fileid)
      var_free(xs_table1)
      var_free(xs_table2)
      var_free(xs_table3)
      var_free(xs_table4)
      var_free(xs_table5)
      call ncclose(fileid,nc_stat)
      
      stop             
      end

      @<Functions and subroutines@>

@* Romberg integration and subsidiary routines. These are taken from 
{\em Numerical Recipes} by W. H. Press et al. (Cambridge Press,
New York, 1986). This routine is listed there as {\em qromo}.
|romberg_open_integ| does Romberg integration on an open interval.
Returns as |result| the integral of the function |integrand| 
from |lower_bound| to |upper_bound|,
using any specified integrating subroutine |basic_integ| and Romberg's 
method. Normally |basic_integ| will be an open formula, not evaluating the
function at the endpoints. It is assumed that |basic_integ| triples the 
number of steps on each call, and that its error series contains only
even powers of the number of steps.

@<Functions...@>=
      subroutine romberg_open_integ(integrand,lower_bound,upper_bound,
     $   result,basic_integ)
      implicit_none
      real lower_bound, upper_bound, integrand          // Input
      real result                                       // Output
      integer j                                         // Local
      real extrap_err
      real estimate[max_integ_steps+1], step_size[max_integ_steps+1]
      logical done
      external basic_integ

      done=.false.
      step_size[1]=one
      do j=1,max_integ_steps
         
         call basic_integ(integrand,lower_bound,upper_bound,estimate[j],j)

         if (j >= num_extrap_pts) then
            call poly_interpolation(step_size[j-num_extrap_pts-1],
     $         estimate[j-num_extrap_pts-1],num_extrap_pts,zero,result,
     $         extrap_err)
            if (abs(extrap_err) < integration_acc*abs(result)) then
               done=.true.
               return
            end if
         end if

         estimate[j+1]=estimate[j]
         step_size[j+1]=step_size[j]/const(9.0) // Step tripling assumption 

      end do
      assert(done)                              // Indicate error if get here
      end

@ Polynomial interpolation routine. Given arrays |x_points| and |f_at_x_pts|, 
each of length |num_x_pts|, and given a value |x_req|, this routine 
returns a value |f_at_x_req|, and an error estimate |error_est|. 
If $f(x)$ is the polynomial of degree |num_x_pts - 1| such
that $f( |x_points[j]| ) = |f_at_x_pts[j]|$, $|j| = 1$, \ldots, 
|num_x_pts|, then the returned
value $|f_at_x_req| = f(|x_req|)$.

@<Functions...@>=
      subroutine poly_interpolation(x_points,f_at_x_pts,num_x_pts,x_req,
     $   f_at_x_req,error_est)
      implicit_none

      integer num_x_pts                              // Input
      real x_points[num_x_pts],f_at_x_pts[num_x_pts]
      real x_req
      real error_est,f_at_x_req                      // Output

      integer i,m,ns                                 // Local variables
      real c[max_interp_pts],d[max_interp_pts]
      real den,dif,dift,ho,hp,w

      ns=1
      dif=abs(x_req-x_points[1])
      do i=1,num_x_pts                // Here we find index ns of closest entry
         dift=abs(x_req-x_points[i])
         if (dift < dif) then
            ns=i
            dif=dift
         end if
         c[i]=f_at_x_pts[i]        // and initialize the tableau of |c| and |d|
         d[i]=f_at_x_pts[i]
      end do
    
      f_at_x_req=f_at_x_pts[ns]         // First approximation to |f_at_x_req|.
      ns=ns-1

/* For each column of the tableau, we loop over the current |c| and |d| and
update them. */

      do m=1,num_x_pts-1  
         do i=1,num_x_pts-m
            ho=x_points[i]-x_req
            hp=x_points[i+m]-x_req
            w=c[i+1]-d[i]
            den=ho-hp

/* This error can occur only if two input |x_points|'s are identical. */
            assert(den!= zero) 

            den=w/den
            d[i]=hp*den          // Here the |c| and |d| are updated.
            c[i]=ho*den
         end do

/* After each column in the tableau is completed, we decide which
correction, |c| or |d|, we want to add to our accumulating 
value of |f_at_x_req|,
i.e., which path to take through the tableau -- forking up or down. We
do this in such a way as to take the most ``straight line'' route through
the tableau to its apex, updating |ns| accordingly to keep track of
where we are. This route keeps the partial approximations centered
(insofar as possible) on the target |x_req|. 
The last |error_est| added is thus the
error indication. */ 

         if (2*ns < num_x_pts-m) then
            error_est=c[ns+1]
         else
            error_est=d[ns]
            ns=ns-1 
         end if

         f_at_x_req=f_at_x_req+error_est
      end do

      return 
      end
     
@ Basic integration routine. This routine computes the |n_stage|th stage of
refinement of an extended midpoint rule. When called with $|n_stage| = 1$,
the routine returns as |result| the crudest estimate 
of $\int_{|lower_bound|}^{|upper_bound|}
f(x) dx$. Subsequent calls with |n_stage| = 2, 3, \ldots (in that sequential
order) will improve the accuracy of |result| by 
adding $(2/3) \times 3^{|n_stage|-1}$
additional interior points. |result| should not be modified between 
sequential calls. For this specific routine, |upper_bound| is assumed to be
infinite (value passed not used). It is assumed that the function
|integrand| decreases exponentially at infinity.

@<Functions...@>=
      subroutine basic_exp_integration(integrand,lower_bound,
     $   upper_bound,result,n_stage)
      implicit_none

      integer n_stage                          // Input
      real lower_bound,upper_bound,integrand
      real result                              // Output

      integer ipoints, j                       // Local variables
      real lower_bound_sub,upper_bound_sub,two_delta_x,delta_x,
     $   integrand_sub,sum,real_ipts,x
      save ipoints

/*  Perform substitution $x^{\prime} = e^{-x}$ */

      integrand_sub(x)=integrand(-log(x))/x 
      upper_bound_sub=exp(-lower_bound)
      assert(one/upper_bound < epsilon)  // Verify that |upper_bound| is large.
      lower_bound_sub=zero 

      if (n_stage == 1) then
         result=(upper_bound_sub-lower_bound_sub)*
     $      integrand_sub(half*(lower_bound_sub+upper_bound_sub))
         ipoints=1         // 2$\times$|ipoints| points will be added next time
      else
         real_ipts=areal(ipoints)
         delta_x=(upper_bound_sub-lower_bound_sub)/(const(3.0)*real_ipts)

/*  The added points alternate in spacing 
between |delta_x| and |two_delta_x|. */

         two_delta_x=delta_x+delta_x        
         x=lower_bound_sub+half*delta_x
         sum=zero
         do j=1,ipoints
            sum=sum+integrand_sub(x)
            x=x+two_delta_x
            sum=sum+integrand_sub(x)
            x=x+delta_x
         end do

/* The new sum is combined with the old integral to give a refined integral. */

         result=(result+(upper_bound_sub-lower_bound_sub)*sum/real_ipts)/
     $      const(3.0)
         ipoints=3*ipoints
      end if

      return
      end

@* ALADDIN routine to read fit coefficients. This routine takes as input
|filename|, the name of an ALADDIN data file; |hier_label|, 
an array of |num_hier| hierarchical search labels; |bool_and_label|, 
an array of |num_bool_and| ``.and.'' boolean search labels; 
and |bool_not_label|, an array of |num_bool_not| ``.not.'' boolean search
labels (see ALADDIN documentation for further details). Following the
search through |filename|, the fit |num_fit_coef| fit coefficients are output
in the array |cf|. The boolean label identifying the evaluation routine
is returned in |leval|.  

@<Functions...@>=
      subroutine aladdin_read_coefs(filename,hier_label,num_hier,
     $   bool_and_label,num_bool_and,bool_not_label,num_bool_not,
     $   fit_coef,num_fit_coef,leval)

      implicit_none

      character*ra_data_filename_length filename               // Input
      character*ra_search_label_length hier_label(ra_label_max),
     $   bool_and_label(ra_label_max),bool_not_label(ra_label_max)
      integer num_hier,num_bool_and,num_bool_not

      character*ra_eval_name_length leval                      // Output
      integer num_fit_coef
      double precision fit_coef(ra_fit_coef_max)

      decl_alpcom                                  // Need bl and nbl from here

      logical end_of_file,match                              // Local variables
      character*msg_length errmsg
      integer ientry

      open(diskin,file=filename,status='old')

/* Loop through entries in |filename| */

      ientry=0

loop: continue
      call alread(diskin,ientry,end_of_file,errmsg)

      assert(!end_of_file)
      assert(errmsg == ' ')

/* Compare this entry with labels provided on input */ 

      call alcomp(hier_label,num_hier,bool_and_label,num_bool_and,bool_not_label,num_bool_not,match)
      if (!match) goto loop

      close(unit=diskin)                                        // Have a match

/* Decode coefficients; check first that access label is the standard one */

      assert(bl[1]SP[1:2] == '$ ')

      call alrecf(fit_coef,num_fit_coef,ra_fit_coef_max,errmsg)
      assert(errmsg == ' ')

      leval = bl[nbl]                       // Assign evaluation label variable

/* Note: this step is not really necessary; could just return bl and
   select the last value when calling the evaluation routine. */

      return
 
      end

@* Evaluate ALADDIN fits. 
This routine does the dirty job of associating the input boolean 
label for the evaluation routine, |leval|, with an actual FORTRAN subroutine.
Because all of the ALADDIN routines of interest currently have essentially
the same arguments (although they differ in details which are of no
consequence to the compiler), this clearing-house routine can be
generated automatically from a shell script which reads through the file
containing all of the ALADDIN subroutines.

In addition to |leval|, the 
input arguments are: |pet|, the energy or temperature at which the
ALADDIN fit is to be evaluated and |fit_coef|, 
the array of |num_fit_coef| fit coefficients
passed in from the ALADDIN data files. The resulting value is returned as
|pfit|. Errors are returned via |kermsg|. 

@<Functions...@>=
      subroutine aladdin_eval_fit(leval,pet,fit_coef,num_fit_coef,pfit,kermsg)
      implicit_none

      character*ra_eval_name_length leval                  // Input
      integer num_fit_coef
      double precision pet
      double precision fit_coef(ra_fit_coef_max)

      double precision pfit                                // Output
      character*msg_length kermsg

/* !!! Do we need to declare each routine name as "external"?
       If so, should be done by shell script when generating this 
       routine!!! */

      if (leval == '#ALMEWE') then
         call ALMEWE(pet, fit_coef, num_fit_coef, pfit, kermsg)
      else if (leval == '#ALBELI') then
         call ALBELI(pet, fit_coef, num_fit_coef, pfit, kermsg)
      else if (leval == '#ALCHEB') then
         call ALCHEB(pet, fit_coef, num_fit_coef, pfit, kermsg)
      else if (leval == '#ALKING') then
