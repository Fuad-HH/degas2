# file names for degas2
#the name of this file is passed as argument to readfilenames
# syntax is : symbolic filename  [actual filename]
#the filenames can be in any order, comments and spaces will be ignored 
# (like this line).
#
# This is a working example indicating typical usage of the DEGAS 2 files.
# This file (and it must be called degas2.in) should reside in your
# "Run" directory (e.g., degas2/SUN, degas2/ALPHA, etc.). The other
# run-specific files will be there as well: "backgroundfile", "geometryfile",
# "problemfile", and "problem_infile". As is done here, the user should
# give these files names which will make it easier to track run variations.
# The remainder of these files represent "reference"
# data for the code, and are the same for most runs. Hence, they reside
# in the data directory. Note that "testfile" is presently not used.

elementsfile  ../data/elements.nc 
backgroundfile bk_MyRun.nc 
testfile  test.nc 
geometryfile ge_MyRun.nc 
problemfile pr_MyRun.nc 
reactionfile ../data/reactions.nc 
speciesfile ../data/species.nc 
aladinfile ../data/aladinput.nc
aladoutfile ../data/aladoutput.nc 
elements_infile ../data/elements.input 
problem_infile  pr_MyRun.input
reaction_infile ../data/reactions.input
species_infile ../data/species.input
materials_infile ../data/materials.input
materialsfile ../data/materials.nc
pmi_infile ../data/pmi.input
pmifile ../data/pmi.nc
cramdproblemfile cramdprob.nc
tallyfile tally_MyRun.nc
outputfile degas2_MyRun_out.nc


