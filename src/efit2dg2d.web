real (kind=8) function psi_interpol(r_in,z_in,r_der,z_der)
  use itp_module
  use sml_module, only :  sml_norm_r
  implicit none
  real (kind=8), intent(in) :: r_in, z_in
  integer , intent(in) :: r_der, z_der
  real (kind=8) :: r,z
  real (kind=8) ,external:: interpol_raw
  real (kind=8) :: t0,t1

! check r,z values
  r=r_in
  z=z_in
  if( r < itp_min_r .OR. r > itp_max_r) then
     print *, 'improper r in psi_interpol :' , r*sml_norm_r, itp_min_r*sml_norm_r, itp_max_r*sml_norm_r
     r=max(itp_min_r,min(itp_max_r,r))
  endif
  if( z < itp_min_z .OR. z > itp_max_z) then
     print *, 'improper z in psi_interpol :' , z*sml_norm_r, itp_min_z*sml_norm_r, itp_max_z*sml_norm_r
     z=max(itp_min_z,min(itp_max_z,z))
  endif


  psi_interpol=dbs2dr(r_der, z_der,r,z,ITP_korder_rz,ITP_korder_rz,ITP_r_KNOT, &
         ITP_z_KNOT, itp_mr, itp_mz, ITP_psi_BSCOEF)


end function psi_interpol
@#endif
