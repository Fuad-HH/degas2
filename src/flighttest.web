@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'flighttest.web'

@I macros.hweb
@I sysdep.hweb
@I string.hweb
@I zone.hweb
@I sources.hweb

@ The main program.

@a
      program flight_test
      implicit_none
      integer nflights,nfrag,i
      character*LINELEN arg
      sy_common
      st_common

      nflights=100000
      nfrag=-1
      
      do i=1,min(2,arg_count())
         call command_arg(i,arg)
         if (i == 1) nflights=read_integer(arg)
         if (i == 2) nfrag=read_integer(arg)
      end do
      
      if (nfrag <= 0) nfrag=nflights

      call readfilenames
      call degas_init
      call do_flights_master(nflights,nfrag)

      stop
      end

      @<Functions and Subroutines@>

@ Initialize common blocks.

@<Functions...@>=
      subroutine degas_init
      implicit_none
      
      call read_geometry
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      call nc_read_materials
      call nc_read_pmi
      call nc_read_problem
      call nc_read_background
      
      return
      end
      
@ The master controller.  This breaks the calculation of |nflights|
flights into chunks of size |nfrag|.  This is to make the conversion to
PVM more straightforward.

@<Functions...@>=
      subroutine do_flights_master(nflights,nfrag)
      implicit_none
      integer nflights,nfrag     // Input
      integer seed[0:1],i,j     // Local
      zn_common
      sy_common
      so_common
      real weight,weight1
      ptr_decl(stat)
      ptr_decl(stat1)
      ptr_decl(stat2)
      real stat(2,zn_num)
      real stat1(2,zn_num)
      real stat2(2,zn_num)
      
      real_alloc(stat,2*zn_num)
      real_alloc(stat1,2*zn_num)
      real_alloc(stat2,2*zn_num)

      seed[0]=1                 // Initialize random number seed
      seed[1]=2
      
      weight=zero
      do i=1,zn_num
         do j=1,2
            stat[j,i]=zero
         end do
      end do

      do j=0,nflights-1,nfrag
         call do_flights(j,min(nfrag,nflights-j),seed,stat1,weight1,stat2) // Calculate the flights
         call stat_add(zn_num,weight1,stat1,weight,stat,weight,stat) // Accumulate the results
         call next_seed(nfrag,seed,seed) // Advance the seed
      end do

      do i=1,zn_num
         if (zone_type[i] == zn_plasma) then
            stat[i][2]=sqrt(stat[i][2]/weight)/max(stat[i][1],const(1.0,-100))
            stat[i][1]=stat[i][1]*source_total/zn_volume(i)
         end if
      end do
      open(unit=diskout,file='stat.dat',status='unknown')
      write(diskout,*) stat
      close(unit=diskout)
      open(unit=diskout,file='density.out',status='unknown')
      do i=1,zn_num
         if (zone_type[i] == zn_plasma) then
            write(diskout,'(2i6,1p2e20.4)') zone_index[i][1],zone_index[i][2],
     $           stat[i][1],stat[i][2]
         end if
      end do
      close(unit=diskout)

      real_free(stat,2*zn_num)
      real_free(stat1,2*zn_num)
      real_free(stat2,2*zn_num)

      return
      end


