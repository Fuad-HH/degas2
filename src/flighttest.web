% $Id$
\def\Wtitle{flighttest}

% $Log$

@n/

@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'flighttest.web'
@m SP _UNQUOTE(' ')
@I macros.hweb
@I geomint.hweb

@ The main program.

@a
      program flight_test
      implicit_none

      call degas_init
      call do_flights(100000)

      stop
      end

      @<Functions and Subroutines@>

@ Initialize common blocks.

@<Functions...@>=
      subroutine degas_init
      implicit_none
      
      call read_geometry
      call nc_read_elements
      call nc_read_species
      call nc_read_background
      call nc_read_test
      call nc_read_reactions
      
      return
      end
      
@ Run some flights.

@<Functions...@>=
      subroutine do_flights(nflights)
      implicit_none
      integer nflights          // Input
      integer seed[0:1],i,j     // local
      zn_common
      sy_common
      ptr_decl(stat)
      ptr_decl(stat1)
      real stat(2,zn_num),weight
      real stat1(2,zn_num)
      
      real_alloc(stat,4*zn_num)
      real_alloc(stat1,4*zn_num)
      
      seed[0]=1123
      seed[1]=2341
      
      weight=zero
      do i=1,zn_num
         do j=1,2
            stat[j,i]=zero
         end do
      end do
      
      do j=0,nflights-1
         call follow(j,stat1,seed)
         call stat_add(zn_num,one,stat1,weight,stat,weight,stat)
         call next_seed(1,seed,seed)
      end do
      open(unit=diskout,file='stat.dat')
      write(diskout,*) stat
      close(unit=diskout)
      
      return
      end
      
@ Follow a single particle.

@<Functions...@>=
      subroutine follow(num,stat,seed)
      implicit_none
      integer seed[0:1],num,cell,face,i,j,count
      real stat[2,zn_num],v[3],w[3],r,phi,tot_len,wa,t,tmax,ionize_rate
      logical done
      lc_decl(x)
      rn_decl(x)
      fl_decl(x)
      rn_common
      ts_common
      bk_common
      sp_common
      zn_common
      st_common
      external lc_track,cell_enter,new_cell,reaction_rate,check_location
      logical lc_track,check_location
      real cell_enter,reaction_rate
      integer new_cell
      
      rn_init(seed,x)
      r=2.2+0.2*random(rn_args(x))
      phi=2*PI*random(rn_args(x))
      vc_set(lc_x(x),r*cos(phi),r*sin(phi),-const(2.5))
      vc_set(v,zero,zero,one)
         
      cell=0
      t=cell_enter(cell,lc_x(x),v,face)
      assert(t<geom_infinity)
      vc_xvt(lc_x(x),v,t,lc_x(x))

      lc_cell(x)=new_cell(-face,lc_x(x))
      lc_face(x)=0
      tot_len=zero

loop2: continue                 // Track to plasma
      lc_thru_face(x)
      done=lc_track(TRACK_BASIC,geom_infinity,lc_args(x),v,lc_args(x),t)
      if (zn_type(lc_zone(x)) != zn_plasma) goto loop2
      call rand_cosdist(w,rn_args(x))
      wa=abs(rand_gauss(rn_args(x)))*sqrt(electron_charge*const(10.0)/atomic_mass_unit)
      do i=1,3
         w[i]=wa*w[i]
      end do
      call surface_reflect(-lc_face(x),lc_x(x),v,w,v)
      lc_thru_face(x)

      do j=1,zn_num
         stat[1,j]=zero
         stat[2,j]=zero
      end do
c      write(stdout,*) 'Start: ',lc_x(x)

      fl_number(x)=num
      pt_sp(fl_origin(x)) = sp_lookup('H')
      pt_test(fl_origin(x)) = 1
      pt_t(fl_origin(x)) = zero
      pt_w(fl_origin(x)) = one
      lc_copy(x,pt_loc(fl_origin(x)))
      vc_copy(v,pt_v(fl_origin(x)))
      fl_pointer(x)=1
      
      pt_copy(fl_origin(x),fl_current(x))
      count=0
      
loop1: continue                 // Start a new zone

c      write(stdout,*) SP 1,(lc_x(pt_loc(fl_current(x)))(i),i=1,3)
      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         ionize_rate=reaction_rate(pt_args(fl_current(x)),
     $        ts_rc(pt_test(fl_current(x)),1),
     $        ts_bk(pt_test(fl_current(x)),1))
      else
         ionize_rate=0
      end if         

loop: continue                  // Still in same zone
      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         tmax=-log(random(rn_args(x)))
     $        /reaction_rate(pt_args(fl_current(x)),
     $        ts_rc(pt_test(fl_current(x)),2),
     $        ts_bk(pt_test(fl_current(x)),2))
      else
         tmax=geom_infinity
      end if         

      if (pt_w(fl_current(x)) < const(0.1)) then
         if (random(rn_args(x)) > half) then
            fl_pointer(x)=fl_pointer(x)-1
            if (fl_pointer(x) <= 0) goto break
         else
            pt_w(fl_current(x)) = two*pt_w(fl_current(x))
         end if
      end if

c      write(stdout,*) SP 2,(lc_x(pt_loc(fl_current(x)))(i),i=1,3),tmax
      
      count=count+1
      done=lc_track(TRACK_BASIC,tmax,lc_args(pt_loc(fl_current(x))),v,
     $     lc_args(pt_loc(fl_current(x))),t)
c      write(stdout,*) SP 3,(lc_x(pt_loc(fl_current(x)))(i),i=1,3),t
      if (t==zero || count > 1000) goto break
      stat[1,lc_zone(pt_loc(fl_current(x)))]=
     $     stat[1,lc_zone(pt_loc(fl_current(x)))]+
     $     ionize_rate*t*pt_w(fl_current(x))
      pt_w(fl_current(x))=exp(-ionize_rate*t)*pt_w(fl_current(x))
      
      if (done) then            // Process a charge exchange
         assert(zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma)
         wa=sqrt(two*bk_temp(2,lc_zone(pt_loc(fl_current(x))))*electron_charge/atomic_mass_unit)
         do i=1,3
            pt_v(fl_current(x))[i]=wa*rand_gauss(rn_args(x))
         end do
         goto loop
      else                      // Go to next zone or reflect
         if (lc_cell_next(pt_loc(fl_current(x))) == 0) then
            goto break
         else if (zn_type(lc_zone_next(pt_loc(fl_current(x)))) == zn_solid) then
            assert(lc_check(pt_loc(fl_current(x))))
            call surface_specular(lc_face(pt_loc(fl_current(x))),lc_x(pt_loc(fl_current(x)))(1),pt_v(fl_current(x))(1),pt_v(fl_current(x))(1))
            lc_face(pt_loc(fl_current(x)))=0
         else
            lc_thru_face(pt_loc(fl_current(x)))
         end if
         goto loop1
      end if
break: continue

      return
      end

@* Index.
