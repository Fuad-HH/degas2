@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'flighttest.web'

@I macros.hweb
@I sysdep.hweb
@I string.hweb
@I sources.hweb
@I tally.hweb
@I output.hweb
@I detector.hweb
@I stat.hweb
@I netcdf.hweb
@I readfilenames.hweb
@I problem.hweb
@I random.hweb
@I mpi.hweb

@ The main program.

@a
      program flight_test
      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls
      sy_decls
      st_decls

      mpi_init

      if (mpi_master) call readfilenames
      call degas_init
      if (mpi_master) then
         call do_flights_master
      else
         call do_flights_slave
      end if
      mpi_end
      
      stop
      end

      @<Functions and Subroutines@>

@ The master controller.  Contains the outermost loop over source groups.
For each group, this routine breaks up the requested number of flights into
smaller chunks (of size |nfrag|) to be handled by the slave processors
(if any).

@<Functions...@>=
      subroutine do_flights_master

      define_varp(estimator_factors,FLOAT,tally_ind)
      define_varp(weight_grp,FLOAT,output_grps_ind)

      implicit_none_f77
      zn_common                                             // Common
      so_common
      pr_common
      de_common
      tl_common
      ou_common
      sa_common
      mp_common
      implicit_none_f90

      integer i,j,is,zone,test,new_dim,pr_reac,jscore,      // Local
     $        iview,det,ibin,iauth
      integer index_parameters[tl_index_max]
      real mult,tot_scale_curr,prob,density,dummy,
     $     dens_rsd,pressure,pres_rsd,signal,wavelength
      real sig_det[20]
      logical init,need_scores,have_pressure
      integer nflights,nfrag,nparcel,num,nstart,nslaves,slave
      rn_seed_decl(seed)

      @<Memory allocation interface@>
      tl_decls
      st_decls

      real find_rate,extract_output_datum                   // External
      external find_rate,extract_output_datum

      declare_varp(estimator_factors)
      declare_varp(weight_grp)

      var_alloc(estimator_factors)
      var_alloc(weight_grp)

      call string_to_seed('12',seed) // Initialize random number seed

      assert(ou_back_max >= pr_background_num) // Dimension for a local array

      var_alloc(output_all)
      var_alloc(output_grp)
      
      do i=0,tally_size-1
         output_all[i][o_mean]=zero
         output_all[i][o_var]=zero
      end do

      do is=1,so_grps
         do i=0,tally_size-1
            output_grp[is][i][o_mean]=zero
            output_grp[is][i][o_var]=zero
         end do
      end do

      stat_comp_flt=TRUE
      stat_comp_frag=TRUE // Set using |nfrag| and |nflights|?
      stat_comp_fin=FALSE  // Additional code changes required if set = TRUE

      call stat_init

      tot_scale_curr=zero
     
      do is=1,so_grps
         nflights=so_nflights(is)
         nfrag=max(nflights/100,1)        // The size of each chunk

         weight_grp[is]=zero

         nparcel=(nflights+nfrag-1)/nfrag // The number of chunks
@#if MPI
         nslaves=mpi_size-1
@#else
         nslaves=0
@#endif

@#if MPI
         do j=0,min(nparcel,nslaves)-1 // Send out the initial chunks
            nstart=j*nfrag
            num=min(nfrag,nflights-nstart)
            slave=j+1
            write(stderr,*) 'Send initial batch to slave ',slave
            call slave_send(slave,nstart,num,so_args(is),seed)
            call next_seed(num,seed) // Advance random number seed
         end do
@#endif

         do j=min(nparcel,nslaves),nparcel-1 // Loop reading results and making additional requests
            nstart=j*nfrag
            num=min(nfrag,nflights-nstart)
            
                                             // Calculate the flights
@#if MPI
            if (nslaves>0) then
               call slave_receive(slave)
               write(stderr,*) 'Received batch back from slave ',slave
               write(stderr,*) 'Send initial batch to slave ',slave
               call slave_send(slave,nstart,num,so_args(is),seed)
            else
               call do_flights(nstart,num,so_args(is),seed,estimator_factors)
            end if
            
@#else
            call do_flights(nstart,num,so_args(is),seed,estimator_factors) 
@#endif
            
            @<Merge results@>

            call next_seed(num,seed) // Advance the seed
         end do
         
@#if MPI
         do j=0,min(nparcel,nslaves)-1 // Do the final reads
            call slave_receive(slave)
            write(stderr,*) 'Received batch back from slave ',slave
            @<Merge results@>
         end do
@#endif
         
         if (stat_comp_frag == TRUE)   // |output_grp| here, too!
     $    call stat_wt_balance(stat_wt_tot_fin,stat_size_fin,stat_dim_fin,
     $           output_grp[is][0][o_mean],stat_wt_dim_fin,stat_wt_fin)
         if (stat_comp_fin == TRUE)
     $     call stat_decomp(stat_size_fin,stat_dim_fin,stat_fin,
     $                       stat_ps_dim_fin,stat_ptr2short_fin,
     $                       tally_size,output_grp[is][0][o_mean])

         weight_grp[is]=stat_wt_tot_fin    // Use instead of |stat_wt_tot_fin|?
         stat_wt_tot_fin=zero              // Re-initialize for next group
         tot_scale_curr+=so_scale(is)*so_tot_curr(is)
           
      end do           // Over |is|

/*
   In preparation for combining results from various source groups, scale
   up according to total source rate for this group (presumably determined
   by physics) and the arbitrary scaling factor. Note that the latter does
   provide for real additional flexibility since the individual source
   currents are specified, making the total current derived. Hence, the 
   relative contribution to the sum over source groups can be more 
   efficiently altered via the scale factor. The expressions for 
   the total sample mean (|stat_tot[1]|) and variance of the sample
   mean (|stat_tot[2]|) are taken from Brandt.
*/
      do is=1,so_grps
         do i=0,tally_size-1
            prob=so_scale(is)*so_tot_curr(is)/tot_scale_curr
            output_grp[is][i][o_mean]*=prob
            output_all[i][o_mean]+=output_grp[is][i][o_mean]
            assert(weight_grp[is] > zero)
@#if 0
// Moved ``-1'' factor from |stat_acc| to here
            output_grp[is][i][o_var]*=prob**2/weight_grp[is]
@#endif
            output_grp[is][i][o_var]*=prob**2/(weight_grp[is]-one)
            output_all[i][o_var]+=output_grp[is][i][o_var]
         end do
      end do
/*
   NOTE: the loop below previously divided the volume out of all of the
   means. Temporarily skip this: the appropriate normalizing factor will
   depend on the particular geometry. Furthermore, would need to extract
   from the tally arrays the particular geometry index for each tally.
*/

      do i=0,tally_size-1
         output_all[i][o_var]=sqrt(output_all[i][o_var])/max(abs(output_all[i][o_mean]),const(1.0,-100))
         output_all[i][o_mean]*=tot_scale_curr
         do is=1,so_grps
            output_grp[is][i][o_var]=sqrt(output_grp[is][i][o_var])/max(abs(output_grp[is][i][o_mean]),const(1.0,-100))
            output_grp[is][i][o_mean]*=tot_scale_curr
         end do
      end do

/*
   Post-process scores
*/
      var_alloc(out_post_grp)
      var_alloc(out_post_all)
      stat_comp_flt=FALSE.               // To get diagonal pointers
      if (stat_dim_flt < tally_size) then
         var_realloc(stat_flt,stat_dim_flt-1,tally_size-1)
         stat_dim_flt=tally_size
         stat_size_flt=tally_size
      end if

/*
   Since the post-processing routines eventually call |add_scores|, which
   now increments |stat_flt|, we must use the |stat_flt| array to hold
   the scores for the current source group. We could have chosen to
   to pass |stat_flt| to the post-processing arrays by common, but
   retained this interface to minimize changes. To do so, it must 
   be full-size!
*/
      need_scores=.false.
      do i=1,tally_type_num[tl_type_reaction]
         do pr_reac=1,pr_reaction_num
            jscore=tally_type_base[tl_type_reaction]+i-1
            if (tally_est_reaction[jscore][tl_est_post_process][pr_reac] 
     $                     > zero) then
               need_scores=.true.
            end if
         end do
      end do

      do is=1,so_grps 

         do i=0,tally_size-1
            stat_flt[i][o_mean]=output_grp[is][i][o_mean]
         end do
         assert(stat_size_flt==tally_size)
         call final_conversions(tl_cv_post,stat_flt)
            
         if (need_scores) then
            call post_process_test_scores(is,stat_flt,estimator_factors)
            if (so_type(is) == so_recomb) then      
               call post_process_back_scores(is,stat_flt,estimator_factors)
            end if
         end if

         call final_conversions(tl_cv_output,stat_flt)

         do i=0,tally_size-1
            out_post_grp[is][i][o_mean]=stat_flt[i][o_mean]
            out_post_grp[is][i][o_var]=zero
            if (is == 1) then
               out_post_all[i][o_mean]=stat_flt[i][o_mean]
               out_post_all[i][o_var]=zero
            else
               out_post_all[i][o_mean]+=stat_flt[i][o_mean]
            end if
         end do
      end do       // is

@#if MPI
      do j=0,nslaves-1          // Kill off the slaves
         slave=j+1
         call slave_send(slave,0,0,so_args(0),seed)
      end do
@#endif

/*
   Need to determine these parameters here since they are used in defining
   a local array in |fill_coupling_arrays|.
*/

      init=.true.
      do zone=1,zn_num
         if (zone_type[zone] == zn_plasma) then
            if (init) then
               output_index_1_min=zone_index[zone][1]
               output_index_1_max=zone_index[zone][1]
               output_index_2_min=zone_index[zone][2]
               output_index_2_max=zone_index[zone][2]
               init=.false.
            else
               output_index_1_min=min(output_index_1_min,zone_index[zone][1])
               output_index_1_max=max(output_index_1_max,zone_index[zone][1])
               output_index_2_min=min(output_index_2_min,zone_index[zone][2])
               output_index_2_max=max(output_index_2_max,zone_index[zone][2])
            end if
         end if
      end do
      call fill_coupling_arrays

/* 
   Example text output file
*/

      open(unit=diskout,file='density.out',status='unknown')
      dummy=zero
      if (string_lookup('neutral pressure',tally_name,tl_num) > 0) then
         have_pressure=.true.
      else
         have_pressure=.false.   // Not kept with minimal set of scores
      end if
      do test=2,pr_test_num    // Exclude ``0'' test species
         do zone=1,zn_num
            if (zone_type[zone] == zn_plasma) then
                  index_parameters[tl_index_test]=test
                  index_parameters[tl_index_zone]=zone
                  density=extract_output_datum(index_parameters,1,
     $                 out_post_all,o_mean,'neutral density')
                  dens_rsd=extract_output_datum(index_parameters,1,
     $                 output_all,o_var,'neutral density')
                  if (have_pressure) then
                     pressure=extract_output_datum(index_parameters,1,
     $                    out_post_all,o_mean,'neutral pressure')
                     pres_rsd=extract_output_datum(index_parameters,1,
     $                    output_all,o_var,'neutral pressure')
                  else
                     pressure=zero
                     pres_rsd=zero
                  end if
                  write(diskout,'(2i6,1p6e13.4)') zone_index[zone][1],
     $              zone_index[zone][2],density,dens_rsd,pressure,pres_rsd,
     $              dummy,dummy
            end if
         end do
      end do
      close(unit=diskout)

      jscore=string_lookup('Dalpha chord integrals',tally_name,tl_num)
      if (jscore > 0) then
         open(unit=diskout,file='chords.out',status='unknown')
         assert(tally_rank[jscore] == 1)
         do iview=1,tally_tab_index[jscore][1]
            index_parameters[tl_index_detector]=iview
            signal=extract_output_datum(index_parameters,1,
     $           out_post_all,o_mean,'Dalpha chord integrals')
            write(diskout,'(2x,i3,6x,1pe13.4)') iview,signal
         end do
         close(unit=diskout)
      end if

      jscore=string_lookup('Dalpha spectrum detail',tally_name,tl_num)
      if (jscore > 0) then
         open(unit=diskout,file='spectrum.out',status='unknown')
         assert(tally_indep_var[jscore][3] == tl_index_wavelength_bin)
         assert(tally_indep_var[jscore][2] == tl_index_test_author)
         assert(tally_tab_index[jscore][1] >= 1)
         det=de_lookup('Halpha spectrum')
         assert(detector_spacing[det] == de_spacing_linear)
         assert(detector_tab_index[det] == tally_tab_index[jscore][3])
         assert(tally_tab_index[jscore][2] <= 20)   // |sig_det| dimension
         do iview=1,tally_tab_index[jscore][1]
            index_parameters[tl_index_detector]=iview
            write(diskout,*) 'Spectrum view number ',iview
            do ibin=1,tally_tab_index[jscore][3]
               index_parameters[tl_index_wavelength_bin]=ibin
               do iauth=1,tally_tab_index[jscore][2]
                  index_parameters[tl_index_test_author]=iauth
                  signal=extract_output_datum(index_parameters,1,
     $                 out_post_all,o_mean,'Dalpha spectrum detail')
                  sig_det[iauth]=signal
                  assert(sig_det[iauth] == signal)
               end do
               signal=extract_output_datum(index_parameters,1,
     $              out_post_all,o_mean,'Dalpha spectrum')
               wavelength=detector_min[det]+(areal(ibin)-0.5)*detector_delta[det]
               write(diskout,'(1pe16.6,21e13.4)') wavelength,signal,(sig_det[iauth],iauth=1,tally_tab_index[jscore][2])
            end do
            write(diskout,*) '-----------------------------------------------------'
         end do
         close(unit=diskout)
      end if

      call nc_write_output
      call clear_output

      call clear_stat

      var_free(estimator_factors)
      var_free(weight_grp)

      return
      end

@ Merge results from a fragment.

@<Merge results@>=

            if (min(stat_size_fin+stat_size_frag,tally_size)>stat_dim_fin) then
               assert(stat_comp_fin == TRUE) 
               mult=max(one,areal(stat_size_flt)/areal(stat_mem_inc_fin))
               new_dim=min(stat_dim_fin+int(mult*stat_mem_inc_fin),tally_size)
               var_realloc(stat_fin,stat_dim_fin-1,new_dim-1)
               var_realloc(stat_ptr2full_fin,stat_pf_dim_fin-1,new_dim-1)
               var_realloc(stat_wt_fin,stat_wt_dim_fin-1,new_dim-1)
               stat_dim_fin=new_dim
               stat_pf_dim_fin=new_dim
               stat_wt_dim_fin=new_dim
            end if
                                  // Accumulating directly into |output_grp|! 
            assert(stat_comp_fin == FALSE && stat_dim_fin == tally_size) 
            call stat_acc(stat_comp_frag,stat_wt_tot_frag,stat_size_frag,
     $           stat_dim_frag,stat_frag,stat_pf_dim_frag,stat_ptr2full_frag,
     $           stat_ps_dim_frag,stat_ptr2short_frag,
     $           stat_comp_fin,stat_wt_tot_fin,stat_size_fin,stat_dim_fin,
     $           output_grp[is][0][o_mean],
     $           stat_pf_dim_fin,stat_ptr2full_fin,
     $           stat_ps_dim_fin,stat_ptr2short_fin,stat_wt_dim_fin,
     $           stat_wt_fin)

@ Send data to slave.

@<Functions...@>=
@#if MPI
      subroutine slave_send(slave,nstart,nflights,so_dummy(isource),seed)
      implicit_none_f77
      mp_common
      sa_common
      implicit_none_f90
      mp_decls
      integer slave,nstart,nflights
      so_decl(isource)
      rn_seed_decl(seed)
      integer tag
      @<Memory allocation interface@>

      tag=100
      call MPI_send(nflights,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)
      if (nflights == 0) goto break
      tag++
      call MPI_send(nstart,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(isource,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(seed,4,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)
      
break:  continue
      return
      end
@#endif

@ Receive data from slave.

@<Functions...@>=
@#if MPI
      subroutine slave_receive(slave)
      implicit_none_f77
      mp_common
      sa_common
      implicit_none_f90
      mp_decls
      integer slave,nstart,nflights
      integer tag,new_dim
      @<Memory allocation interface@>

      tag=200
      call MPI_recv(stat_comp_frag,1,mpi_int,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      slave=mpi_status(MPI_SOURCE);
      tag++
      call MPI_recv(stat_wt_tot_frag,1,mpi_real,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag++
      call MPI_recv(stat_size_frag,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      tag++
      call MPI_recv(new_dim,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (new_dim>stat_dim_frag) then
         var_realloc(stat_frag,stat_dim_frag-1,new_dim-1)
         stat_dim_frag=new_dim
      end if
      tag++
      call MPI_recv(stat_frag,array_size(stat_frag),mpi_real,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      tag++
      call MPI_recv(new_dim,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (new_dim>stat_pf_dim_frag) then
         var_realloc(stat_ptr2full_frag,stat_pf_dim_frag-1,new_dim-1)
         stat_pf_dim_frag=new_dim
      end if
      tag++
      call MPI_recv(stat_ptr2full_frag,array_size(stat_ptr2full_frag),mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      tag++
      call MPI_recv(new_dim,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (new_dim>stat_ps_dim_frag) then
         var_realloc(stat_ptr2short_frag,stat_ps_dim_frag-1,new_dim-1)
         stat_ps_dim_frag=new_dim
      end if
      tag++
      call MPI_recv(stat_ptr2short_frag,array_size(stat_ptr2short_frag),mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      tag++
      call MPI_recv(new_dim,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (new_dim>stat_wt_dim_frag) then
         var_realloc(stat_wt_frag,stat_wt_dim_frag-1,new_dim-1)
         stat_wt_dim_frag=new_dim
      end if
      tag++
      call MPI_recv(stat_wt_frag,array_size(stat_wt_frag),mpi_real,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)


break:  continue
      return
      end
@#endif

@ The slave routine.  This loops waiting for work and sending the
results back to the master.  It's only defined for MPI.

@<Functions...@>=
@#if MPI
      subroutine do_flights_slave
      implicit_none_f77
      mp_common
      sa_common
      pr_common
      tl_common
      implicit_none_f90
      mp_decls
      integer nstart,nflights,tag
      so_decl(isource)
      rn_seed_decl(seed)
      @<Memory allocation interface@>
      tl_decls
      declare_varp(estimator_factors)
      integer i
      
      var_alloc(estimator_factors)

      stat_comp_flt=TRUE
      stat_comp_frag=TRUE // Set using |nfrag| and |nflights|?
      stat_comp_fin=FALSE  // Additional code changes required if set = TRUE

      call stat_init

loop: continue
      tag=100
      call MPI_recv(nflights,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (nflights == 0) goto break
      tag++
      call MPI_recv(nstart,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag++
      call MPI_recv(isource,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag++
      call MPI_recv(seed,4,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      call do_flights(nstart,nflights,so_args(isource),seed,
     $     estimator_factors)

      tag=200

      call MPI_send(stat_comp_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_wt_tot_frag,1,mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_size_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

      tag++
      call MPI_send(stat_dim_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_frag,array_size(stat_frag),mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

      tag++
      call MPI_send(stat_pf_dim_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_ptr2full_frag,array_size(stat_ptr2full_frag),mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

      tag++
      call MPI_send(stat_ps_dim_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_ptr2short_frag,array_size(stat_ptr2short_frag),mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

      tag++
      call MPI_send(stat_wt_dim_frag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
      tag++
      call MPI_send(stat_wt_frag,array_size(stat_wt_frag),mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

// Reinitialize |stat_frag|.
      stat_wt_tot_frag=zero
      if (stat_comp_frag == TRUE) then
         stat_size_frag=0
         do i=0,stat_ps_dim_frag-1
            stat_ptr2short_frag[i]=int_uninit
         end do
      end if
      if (stat_comp_frag == FALSE) then 
         do i=0,stat_dim_frag-1
            stat_frag[i][o_mean]=zero
            stat_frag[i][o_var]=zero
         end do
         do i=0,stat_wt_dim_frag-1
            stat_wt_frag[i]=zero
         end do
      end if


      goto loop
break:  continue
      call clear_stat
      var_free(estimator_factors)
      return
      end
@#else
      subroutine do_flights_slave
// dummy
      return
      end
@#endif

@ Fill coupling arrays. This needs to be in a separate subroutine since
we don't set the dimensions until just before the call.

@m i_dens 1
@m i_temp 2
@m i_flux1 3
@m i_flux2 4
@m i_flux3 5
@m list_max 5  // However many of these there are 

@<Functions...@>=
      subroutine fill_coupling_arrays

      define_dimen(list_ind,list_max)

      define_varp(zone_map,INT,output_ind_1,output_ind_2)
      define_varp(test_data,FLOAT,output_ind_1,output_ind_2,problem_test_ind,list_ind)

      implicit_none_f77
      zn_common
      sp_common
      pr_common
      so_common
      tl_common
      ou_common                                                // Common
      implicit_none_f90
      
      integer zone,back,e_back,ix,iy,i,ix_1,ix_n,iy_1,iy_n,    // Local
     $        test,is,i_list,first_back
      integer index_parameters[tl_index_max]
      real multiplier
      logical have_pressure

      @<Memory allocation interface@>
      st_decls
      tl_decls

      external extract_output_datum                            // External
      real extract_output_datum

      declare_varp(zone_map)
      declare_varp(test_data)

      var_alloc(zone_map)
      var_alloc(test_data)

      var_alloc(output_2D_coupling)

      do zone=1,zn_num
         if (zone_type[zone] == zn_plasma) then
            zone_map(zone_index[zone][1],zone_index[zone][2])=zone
         end if
      end do

/* 
   Note: with present configuration, these are volume-integrated.
   Also, this assumes that the tallies are all rank 2 (back and zone).
   If they are larger, the following could be readily generalized to
   sum over the extra dimensions.
*/

      ix_1=output_index_1_min
      ix_n=output_index_1_max
      iy_1=output_index_2_min
      iy_n=output_index_2_max

      if (string_lookup('neutral pressure',tally_name,tl_num) > 0) then
         have_pressure=.true.
      else
         have_pressure=.false.   // Not kept with minimal set of scores
      end if
      do test=2,pr_test_num    // Exclude ``0'' test species
         index_parameters[tl_index_test]=test
         do iy=iy_1,iy_n
            do ix=ix_1,ix_n
               if (zn_check(zone_map(ix,iy))) then
                  index_parameters[tl_index_zone]=zone_map(ix,iy)
                  test_data(ix,iy,test,i_dens)
     $                 =extract_output_datum(index_parameters,1,
     $                 out_post_all,o_mean,'neutral density')
                  if (have_pressure 
     $                 && test_data(ix,iy,test,i_dens) != zero) then
                     test_data(ix,iy,test,i_temp)
     $                    =extract_output_datum(index_parameters,1,
     $                    out_post_all,o_mean,'neutral pressure')
     $                    /test_data(ix,iy,test,i_dens)
                  else
                     test_data(ix,iy,test,i_temp)=zero
                  end if
                  do i=1,3
                     test_data(ix,iy,test,i_flux1+i-1)
     $                    =extract_output_datum(index_parameters,i,
     $                    out_post_all,o_mean,'neutral flux vector')
                  end do
               end if
            end do
         end do
      end do

      open(unit=diskout,file='testdata.out',status='unknown')
      do test=2,pr_test_num
         write(diskout,*) sp_sy(pr_test(test))
      end do
      multiplier=one
      do test=2,pr_test_num
         call write_sources(test_data(ix_1,iy_1,test,i_dens),multiplier,
     $        ix_1,ix_n,iy_1,iy_n,diskout)
         call write_sources(test_data(ix_1,iy_1,test,i_temp),multiplier,
     $        ix_1,ix_n,iy_1,iy_n,diskout)
      end do
      do test=2,pr_test_num
         do i_list=i_flux1,i_flux3
            call write_sources(test_data(ix_1,iy_1,test,i_list),multiplier,
     $           ix_1,ix_n,iy_1,iy_n,diskout)
         end do
      end do
      close(unit=diskout)
         
      if (pr_reaction_num > 0) then      // else: these tallies undefined 
         e_back=pr_background_lookup(sp_lookup('e'))
         open(unit=diskout,file='sources.out',status='unknown')
         do is=1,so_grps
            first_back=0
            do back=1,pr_background_num
               index_parameters[tl_index_back]=back
               do iy=iy_1,iy_n
                  do ix=ix_1,ix_n
                     if (zn_check(zone_map(ix,iy))) then
                        index_parameters[tl_index_zone]=zone_map(ix,iy)
                        output_2D_coupling(ix,iy,back,ou_coupling_mass,is)=
     $                       extract_output_datum(index_parameters,1,
     $                       out_post_grp[is][0][o_mean],o_mean,
     $                       'ion source rate')
                        output_2D_coupling(ix,iy,back,
     $                       ou_coupling_momentum_1,is)=
     $                       extract_output_datum(index_parameters,1,
     $                       out_post_grp[is][0][o_mean],o_mean,
     $                       'ion momentum source vector')
                        output_2D_coupling(ix,iy,back,
     $                       ou_coupling_momentum_2,is)=
     $                       extract_output_datum(index_parameters,2,
     $                       out_post_grp[is][0][o_mean],o_mean,
     $                       'ion momentum source vector')
                        output_2D_coupling(ix,iy,back,
     $                       ou_coupling_momentum_3,is)=
     $                       extract_output_datum(index_parameters,3,
     $                       out_post_grp[is][0][o_mean],o_mean,
     $                       'ion momentum source vector')
/*
   Fluid codes presently track just one ion temperature. Sum all of the
   energy sources to non-electron background species into the
   |first_back| entry (others will be 0).
*/
                        if (first_back == 0 || back == e_back) then
                           output_2D_coupling(ix,iy,back,
     $                          ou_coupling_energy,is)=
     $                          extract_output_datum(index_parameters,1,
     $                          out_post_grp[is][0][o_mean],o_mean,
     $                          'ion energy source')
                        else
                           output_2D_coupling(ix,iy,first_back,
     $                          ou_coupling_energy,is)+=
     $                          extract_output_datum(index_parameters,1,
     $                          out_post_grp[is][0][o_mean],o_mean,
     $                          'ion energy source')
                        end if
                     else
                        do i=1,ou_coupling_max
                           output_2D_coupling(ix,iy,back,i,is)=zero
                        end do
                     end if
                  end do      // ix
               end do         // iy
               if (first_back == 0 && back != e_back) first_back = back
            end do            // back

            multiplier=one
            write(diskout,'(e12.6)') -so_scale(is)*so_tot_curr(is)
            do back=1,pr_background_num
               if (back != e_back) then
                  call write_sources(output_2D_coupling(ix_1,iy_1,back,
     $                 ou_coupling_mass,is),multiplier,ix_1,ix_n,
     $                 iy_1,iy_n,diskout)
                  call write_sources(output_2D_coupling(ix_1,iy_1,back,
     $                 ou_coupling_momentum_1,is),multiplier,ix_1,ix_n,
     $                 iy_1,iy_n,diskout)
                  call write_sources(output_2D_coupling(ix_1,iy_1,back,
     $                 ou_coupling_momentum_2,is),multiplier,ix_1,ix_n,
     $                 iy_1,iy_n,diskout)
                  call write_sources(output_2D_coupling(ix_1,iy_1,back,
     $                 ou_coupling_momentum_3,is),multiplier,ix_1,ix_n,
     $                 iy_1,iy_n,diskout)
               end if
            end do
            call write_sources(output_2D_coupling(ix_1,iy_1,e_back,
     $           ou_coupling_energy,is),multiplier,ix_1,ix_n,iy_1,iy_n,diskout)
            call write_sources(output_2D_coupling(ix_1,iy_1,first_back,
     $           ou_coupling_energy,is),multiplier,ix_1,ix_n,iy_1,iy_n,diskout)
         end do
         close(unit=diskout)
      end if

      var_free(zone_map)
     
      return
      end

@ Routine to write text data similar to EIRENE's \verb+fort.32+ and
\verb+fort.44+ files.

@<Functions...@>=
      subroutine write_sources(two_D_data,multiplier,ix_1,ix_n,
     $           iy_1,iy_n,unit_num)

      implicit_none_f77
      implicit_none_f90

      integer ix_1,ix_n,iy_1,iy_n,unit_num          // Input
      real two_D_data[ix_1:ix_n,iy_1:iy_n]
      real multiplier

      integer lim,iy,ix,j                           // Local

      lim=((ix_n-ix_1+1)/5)*5-4
      do iy=iy_1,iy_n
         do ix=ix_1,lim,5
            write(unit_num,'(5(e16.8))') SP 
     $           (multiplier*two_D_data[ix-ix_1+j,iy],j=1,5)
         end do
         if (lim+4 != ix_n) then
            write(unit_num,'(5(e16.8))') SP 
     $           (multiplier*two_D_data[ix,iy],ix=lim+5,ix_n)
         end if
      end do

      return
      end
     
@ Write out data into netcdf file \verb+output.nc+ 

@<Functions...@>=
      subroutine nc_write_output
      implicit_none_f77
      rf_common                  // Common
      so_common
      pr_common
      tl_common
      ou_common
      implicit_none_f90
      nc_decls
      st_decls
      tl_decls
      integer fileid             // Local
      ou_ncdecl
      character*LINELEN description,program_version
      character*FILELEN tempfile

      program_version=
     $     '$Id$'

      tempfile=filenames_array[outputfile]
      fileid=nccreate(tempfile,NC_CLOBBER,nc_stat)

      description = 'Output from DEGAS 2'

      call ncattputc(fileid,NC_GLOBAL,'description',NC_CHAR,
     $     string_length(description),
     $     description,nc_stat)

      call ncattputc(fileid,NC_GLOBAL,'program_version',NC_CHAR,
     $     string_length(program_version),
     $     program_version,nc_stat)

      ou_ncdef(fileid)
      call ncendef(fileid,nc_stat)
      ou_ncwrite(fileid)

      call ncclose(fileid,nc_stat)

      return
      end

