\ID{$Id$}

Declarations of the string routines.

@f st_common integer
@m st_common
      external string_length,read_string,parse_string,next_token,string_lookup,int_lookup,read_real,read_integer;
      integer string_length,parse_string,string_lookup,int_lookup,read_integer;
      real read_real;
      logical read_string,next_token @;

@ A string without its trailing blanks

@m SP _UNQUOTE(' ')
@m trim(s) s SP (1:string_length(s))

