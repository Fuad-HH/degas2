@ The unnamed module.

@a
      program reactionsetup
      implicit_none

      call nc_read_species
      call read_reactions
      call nc_write_reaction

      stop
      end

      @<Functions and Subroutines@>

@ Read is data from \verb+reactions.input+.

@<Functions...@>=
      subroutine read_reactions
      implicit_none
      rc_common                 // Common
      sp_common
      integer length,p,b,e,i,j      // Local
      character*LINELEN line
      character*FILELEN file
      sy_common
      st_common

      rc_num=0
      xs_base_max=0
      reaction_version='unknown'
      open(unit=diskin,file='../data/reactions.input',
     $     form='formatted',status='old')
      assert( read_string(diskin,line,length) )
      assert(length<=len(line))
      reaction_version=line(:length)
loop1: continue
      if (! read_string(diskin,line,length) ) goto eof
      rc_num=rc_num+1
      rc_tn_num=rc_num          // Temporary kludge
      rc_te_num=rc_num
      var_realloca(reaction_name)
      var_realloca(reaction_sy)
      var_realloca(reaction_reagant_num)
      var_realloca(reaction_product_num)
      var_realloca(reaction_reagant)
      var_realloca(reaction_product)
      var_realloca(reaction_type)
      var_realloca(tn_cross_section_table)
      var_realloca(te_cross_section_table)

      length=parse_string(line(:length))
      reaction_name[rc_num]=line(:length)
      reaction_type[rc_num]='unknown'
      assert(read_string(diskin,line,length))
      length=parse_string(line(:length))
      
      p=0
      assert( next_token(line,b,e,p) )
      read(line(b:e),'(a)') rc_sy(rc_num)
      rc_reagant_num(rc_num) = 0
loop2: continue
      rc_reagant_num(rc_num) = rc_reagant_num(rc_num) + 1
      assert( rc_reagant_num(rc_num) <= rc_reagant_max )
      assert( next_token(line,b,e,p) )
      rc_reagant(rc_num,rc_reagant_num(rc_num)) = sp_lookup(line(b:e))
      assert( next_token(line,b,e,p) )
      assert( line(b:e) == '+' || line(b:e) == '->' )
      if (line(b:e) == '+') goto loop2
      
      rc_product_num(rc_num) = 0
loop3: continue
      rc_product_num(rc_num) = rc_product_num(rc_num) + 1
      assert( rc_product_num(rc_num) <= rc_product_max )
      assert( next_token(line,b,e,p) )
      rc_product(rc_num,rc_product_num(rc_num)) = sp_lookup(line(b:e))
      if ( next_token(line,b,e,p) ) then
         assert( line(b:e) == '+' )
         goto loop3
      end if

      assert( read_string(diskin,file,length) )
      assert(length<=len(file))
      
      call xs_read(file)

      var_realloca(reaction_organization)
      var_realloca(reaction_xs_min)
      var_realloca(reaction_xs_delta)
      var_realloca(reaction_xs_rank)
      var_realloca(reaction_xs_spacing)
      var_realloca(reaction_xs_base)
      var_realloca(reaction_xs_tab_index)
      var_realloca(reaction_xs_var)

      call xs_copy

      if (rc_sy(rc_num)=='hionize') then
         open(unit=diskin+1,file='../data/eh.dat',form='formatted',status='old')
         read(diskin+1,*) SP ((tn_cross_section_table[i,j,rc_num],i=0,rc_energy_num),j=0,rc_density_num)
         close(unit=diskin+1)
         do j=0,rc_density_num
            do i=0,rc_energy_num
               tn_cross_section_table[i,j,rc_num]=tn_cross_section_table[i,j,rc_num]*const(1.0,-6)
            end do
         end do
      else if (rc_sy(rc_num)=='hchex') then
         open(unit=diskin+1,file='../data/atmc.dat',form='formatted',status='old')
loop:    continue
         read(diskin+1,'(a)') line
         if (line != 'h0 + h+ -> h+ + h0') goto loop
         read(diskin+1,*) SP ((te_cross_section_table[i,j,rc_num],i=0,rc_energy_num),j=0,rc_energy_num)
         close(unit=diskin+1)
         do j=0,rc_energy_num
            do i=0,rc_energy_num
               te_cross_section_table[i,j,rc_num]=te_cross_section_table[i,j,rc_num]*const(1.0,-6)
            end do
         end do
      end if
      goto loop1
eof:  continue
      close(unit=diskin)
      var_reallocb(reaction_name)
      var_reallocb(reaction_sy)
      var_reallocb(reaction_reagant_num)
      var_reallocb(reaction_product_num)
      var_reallocb(reaction_reagant)
      var_reallocb(reaction_product)
      var_reallocb(reaction_type)
      var_reallocb(tn_cross_section_table)
      var_reallocb(te_cross_section_table)

      var_reallocb(reaction_organization)
      var_reallocb(reaction_xs_min)
      var_reallocb(reaction_xs_delta)
      var_reallocb(reaction_xs_rank)
      var_reallocb(reaction_xs_spacing)
      var_reallocb(reaction_xs_base)
      var_reallocb(reaction_xs_tab_index)
      var_reallocb(reaction_xs_var)

      return
      end

@ Read in cross-section information from a netcdf file.

@<Functions...@>=
      subroutine xs_read(file)
      implicit_none
      character*(*) file        // Input
      integer fileid // Local
      xs_common
      xs_ncdecl
      nc_common
      sy_common
      
      fileid = ncopen(file,NC_NOWRITE,nc_stat)
      
      xs_ncread(fileid)
      
      call ncclose(fileid,nc_stat)
      
      return
      end

@ Copy cross-section information into reaction arrays.

@<Functions...@>=
      subroutine xs_copy
      implicit_none
      integer i,j,k,size // Local
      xs_common
      rc_common
      sy_common
      implicit_none
      
      assert(xs_name==rc_sy(rc_num))
      assert(xs_organization==xs_organization_table)
      reaction_organization[rc_num]=xs_organization
      assert(xs_rank > 0 && xs_rank <= xs_table_rank_max)
      reaction_xs_rank[rc_num]=xs_rank
      assert(xs_spacing[0] == xs_spacing_linear || xs_spacing[0] == xs_spacing_log)
      reaction_xs_spacing[0,rc_num]=xs_spacing[0]
      assert(xs_var[0] == xs_var_rate)
      reaction_xs_var[0,rc_num]=xs_var[0]
      size=1
      do i=1,xs_rank
         assert(xs_tab_index[i] > 1)
         reaction_xs_tab_index[i,rc_num] = xs_tab_index[i]
         size=size*xs_tab_index[i]
         if (xs_spacing[i] == xs_spacing_linear) then
            reaction_xs_min[i,rc_num]=xs_min[i]*xs_mult[i]
            reaction_xs_delta[i,rc_num]=
     $           (xs_max[i]-xs_min[i])*xs_mult[i]/areal(xs_tab_index[i]-1)
         else if (xs_spacing[i] == xs_spacing_log) then
            reaction_xs_min[i,rc_num]=log(xs_min[i]*xs_mult[i])
            reaction_xs_delta[i,rc_num]=
     $           log(xs_max[i]/xs_min[i])/areal(xs_tab_index[i]-1)
         else
            assert('Unknown spacing type' == ' ')
         end if
         reaction_xs_spacing[i,rc_num]=xs_spacing[i]
         reaction_xs_var[i,rc_num]=xs_var[i]
      end do
      do i=xs_rank+1,xs_table_rank_max
         reaction_xs_tab_index[i,rc_num]=1
      end do
      reaction_xs_base[rc_num]=xs_base_max
      var_reallocc(reaction_xsection_table,xs_base_max-1,xs_base_max-1+size)
      do k=0,xs_tab_index[3]-1
         do j=0,xs_tab_index[2]-1
            do i=0,xs_tab_index[1]-1
               if (xs_spacing[0] == xs_spacing_linear) then
                  rc_xsection3(rc_num,i,j,k)=xs_table[i,j,k]*xs_mult[0]
               else
                  rc_xsection3(rc_num,i,j,k)=log(xs_table[i,j,k]*xs_mult[0])
               end if
c               reaction_xsection_table[xs_base_max+i+xs_tab_index[1]*(j+k*xs_tab_index[2])]=xs_table[i,j,k]*xs_mult[0]
            end do
         end do
      end do
      xs_base_max=xs_base_max+size

      var_free(xs_table)
      return
      end

@ Write out data into netcdf file \verb+reactions.nc+
      
@<Functions...@>=
      subroutine nc_write_reaction
      implicit_none
      integer fileid
      rc_common                   // Common
      rc_ncdecl
      nc_common
      st_common
      character*LINELEN description,program_version

      program_version=
     $     '$Id$'

      fileid = nccreate('../data/reactions.nc',NC_CLOBBER,nc_stat)

      description = 'Data for reaction in degas 2'
      call ncattputc(fileid,NC_GLOBAL,'description',NC_CHAR,
     $     string_length(description),
     $     description,nc_stat)

      call ncattputc(fileid,NC_GLOBAL,'data_version',NC_CHAR,
     $     string_length(reaction_version),
     $     reaction_version,nc_stat)
      
      call ncattputc(fileid,NC_GLOBAL,'program_version',NC_CHAR,
     $     string_length(program_version),
     $     program_version,nc_stat)
      
      rc_ncdef(fileid)
      call ncendef(fileid,nc_stat)
      rc_ncwrite(fileid)
      call ncclose(fileid,nc_stat)
      
      return
      end

      



