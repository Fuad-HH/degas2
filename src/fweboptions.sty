% Set up some fonts

% \def\ttdefault{pcr} % Use Courier for typewriter
\def\vect#1{{\mathbf #1}}   % Vectors

\SetMathAlphabet{\mathsf}{normal}{\encodingdefault}{\sfdefault}%
	{\bfdefault}{n}
\def\tens#1{{\mathsf #1}}   % Tensors

% Change some of FWEB's formatting macros.

%\def\4{\ifvmode\else\copy\bak\fi}% Backspace one notch
%\let \.=\?

\def\\#1{\leavevmode\hbox{\def\${{\sl \char`\$}}\def\%{\char`\%}%
                          \it#1\/\kern.05em}} % Italic type for identifiers
\def\@#1{\leavevmode\hbox{\def\${\char`\$}\def\%{\char`\%}%
                           \rm#1\kern.05em}} % Roman intrinsic functions
\def\FALSE{\hbox{\SC FALSE}}% '$\FALSE$'.
\def\TRUE{\hbox{\SC TRUE}}% '$\TRUE$'.
{\catcode`\$=12 \catcode`\_=12 \catcode`\%=12
 \gdef\idprintx#1{\tt #1 \special{"% #1} \egroup}}
\def\ID{\bgroup \catcode`\$=12 \catcode`\_=12 \idprintx}
\let\idprint=\ID
\let\WARRAY=\WSUB
\def\abs#1{\left|#1\right|}
\def\ave#1{\left<#1\right>}
\def\sign{\mathop{\rm sign}\nolimits}
