% Set up some fonts

\def\ttdefault{pcr} % Use Courier for typewriter
\let\vect=\mathbf   % Vectors

\SetMathAlphabet{\mathsf}{normal}{\encodingdefault}{\sfdefault}%
	{\bfdefault}{n}
\let\tens=\mathsf   % Tensors

% Update some stuff in fwebmac.sty

% Use \mathit{ } instead of {\it }
\def\WXA#1{\begingroup
%% We don't want the identifiers to be in hboxes, because we want to get
%% |\scriptstyle| for subscripts.  (We should always be in math mode here.)
	\def\Wshort##1{##1}%
	\def\Wid##1{\mathit{##1\/\kern.05em}}%
	\global\WARRAYarga{#1}%
	\futurelet\Wnext\WARRAYm}

% Use \mathrm{ } instead of {\rm }
\def\defin#1#2{\4\saveind
	\1\Wreserved{#1}\hbox{$^{\mathrm{#2}}$}\Hspace}% Begin @d, @m, or @f.

% Use \mathrm{ } instead of {\rm }
\def\WX#1:#2\X#3\X{\ifmmode\gdef\XX{\null$\null}\else\gdef\XX{}\fi
	\XX$\langle\,$#2{\eightrm\kern.5em#1}$\,\rangle^{\mathrm{#3}}$\XX}

% Use $\S$ instead of \tensy x
\def\lheader{\mainfont\the\pageno\eightrm\qquad\Whead\hfill\Wtitle\qquad
	\ifnum\pageno=\contentspageno\else
		$\S$\mainfont\Wmodno
	\fi}


\def\rheader{\ifnum\pageno=\contentspageno\else
		$\S$\mainfont\Wmodno
	\fi
	\eightrm\qquad\Wtitle\hfill\Whead
	\qquad\mainfont\the\pageno}

% Change some of FWEB's formatting macros.

%\def\4{\ifvmode\else\copy\bak\fi}% Backspace one notch
%\let \.=\?

\def\\#1{\leavevmode\hbox{\def\${{\sl \char`\$}}\def\%{\char`\%}%
                          \it#1\/\kern.05em}} % Italic type for identifiers
\def\@#1{\leavevmode\hbox{\def\${\char`\$}\def\%{\char`\%}%
                           \rm#1\kern.05em}} % Roman intrinsic functions
\def\FALSE{\hbox{\SC FALSE}}% '$\FALSE$'.
\def\TRUE{\hbox{\SC TRUE}}% '$\TRUE$'.
{\catcode`\$=12 \catcode`\_=12 \catcode`\%=12
 \gdef\idprintx#1{\tt #1 \special{"% #1} \egroup}}
\def\ID{\bgroup \catcode`\$=12 \catcode`\_=12 \idprintx}
\let\idprint=\ID
\let\WARRAY=\WSUB
\def\abs#1{\left|#1\right|}
\def\ave#1{\left<#1\right>}
\def\sign{\mathop{\rm sign}\nolimits}
