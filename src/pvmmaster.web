@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'pvmmaster.web'
@m SP _UNQUOTE(' ')
@I macros.hweb
@I pvm.hweb

@ The main program.

@a
      program pvm_master
      implicit_none

      call master_init
      call pvm_flights_master(100000,500,13)

      stop
      end

      @<Functions and Subroutines@>

@ Initialize common blocks.

@<Functions...@>=
      subroutine master_init
      implicit_none
      
      call read_geometry
      
      return
      end
      
@ The master controller.

@<Functions...@>=
      subroutine pvm_flights_master(nflights,nfrag,nslaves)
      implicit_none
      integer nflights,nfrag,nslaves     // Input
      integer seed[0:1],i,j,num,nparcel // Local
      integer mytid,tids[0:99],numt,ret,msgtag,tid,buf,bytes
      zn_common
      sy_common
      real weight,weight1
      ptr_decl(stat)
      ptr_decl(stat1)
      real stat(2,zn_num)
      real stat1(2,zn_num)
      
      real_alloc(stat,2*zn_num)
      real_alloc(stat1,2*zn_num)

      seed[0]=1
      seed[1]=2
      
      weight=zero
      do i=1,zn_num
         do j=1,2
            stat[j,i]=zero
         end do
      end do

      call pvmfmytid(mytid)
      call pvmfspawn('pvmslave',PVMDEFAULT,'*',nslaves,tids,numt)
      assert(numt == nslaves)

      nparcel=(nflights+nfrag-1)/nfrag

      do j=0,min(nparcel,nslaves)-1
         num=min(nfrag,nflights-j*nfrag)
         assert(num>0)
         call pvmfinitsend(PVMDEFAULT,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,j*nfrag,1,1,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,seed,2,1,ret); assert(ret >= 0)
         msgtag=1
         call pvmfsend(tids[j],msgtag,ret); assert(ret >= 0)
         call next_seed(nfrag,seed,seed)
      end do

      do j=min(nparcel,nslaves),nparcel-1
         msgtag=2
         call pvmfrecv(-1,msgtag,buf); assert(ret >= 0)
         call pvmfbufinfo(buf,bytes,msgtag,tid,ret)
         call pvmfunpack(pvm_real,stat1,2*zn_num,1,ret); assert(ret >= 0)
         call pvmfunpack(pvm_real,weight1,1,1,ret); assert(ret >= 0)
         num=min(nfrag,nflights-j*nfrag)
         assert(num>0)
         call pvmfinitsend(PVMDEFAULT,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,j*nfrag,1,1,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
         call pvmfpack(pvm_int,seed,2,1,ret); assert(ret >= 0)
         msgtag=1
         call pvmfsend(tid,msgtag,ret); assert(ret >= 0)
         call next_seed(nfrag,seed,seed)
         call stat_add(zn_num,weight1,stat1,weight,stat,weight,stat)
      end do
      
      do j=0,min(nparcel,nslaves)-1
         msgtag=2
         call pvmfrecv(-1,msgtag,buf); assert(ret >= 0)
         call pvmfbufinfo(buf,bytes,msgtag,tid,ret)
         call pvmfunpack(pvm_real,stat1,2*zn_num,1,ret); assert(ret >= 0)
         call pvmfunpack(pvm_real,weight1,1,1,ret); assert(ret >= 0)
         call stat_add(zn_num,weight1,stat1,weight,stat,weight,stat)
      end do
         
      num=0
      call pvmfinitsend(PVMDEFAULT,ret); assert(ret >= 0)
      call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
      call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
      call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
      call pvmfpack(pvm_int,num,1,1,ret); assert(ret >= 0)
      msgtag=1
      call pvmfmcast(nslaves,tids,msgtag,ret); assert(ret >= 0)

      call pvmfexit(ret); assert(ret >= 0)

      real_free(stat,2*zn_num)
      real_free(stat1,2*zn_num)

      open(unit=diskout,file='stat.dat')
      write(diskout,*) stat
      close(unit=diskout)

      return
      end


@* Index.
