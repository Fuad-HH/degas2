@* Target particle definitions.

% $Id$

\ID{$Id$}

Information about target particles is held in arrays in common blocks.  An
target is identified by an integer indexing into these arrays.

@f tg_decl integer

@m tg_args(x) x

@m tg_dummy(x) x

@m tg_decl(x) integer x @;

@m tg_copy(x,y) y=x @;

@m tg_check(x) (x > 0 && x <= tg_num)

@m tg_sp(x) target_sp[x]

@ Variable definitions.

@a
      package_init(tg)
      define_dimen_pk(tg,target_ind,tg_num)
      define_var_pk(tg,tg_num,INT)
      define_varp_pk(tg,target_sp,INT,target_ind)
      package_end(tg)

