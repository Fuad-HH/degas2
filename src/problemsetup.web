      @<Functions and Subroutines@>

@ Read in data from \verb+problem.input+.

@<Functions...@>=
      subroutine read_problem
      implicit_none

      integer length            // Local
      character*LINELEN line
      character*FILELEN tempfile     //local
      sy_common
      st_common
      pr_common
      rf_common

      problem_version='unknown'
      tempfile = filenames_array[problem_infile]
      open(unit=diskin,file=tempfile,
     $     form='formatted',status='old')
      assert( read_string(diskin,line,length) )
      assert(length<=len(line))
      problem_version=line(:length)
      
      call init_problem
      if ( ! read_string(diskin,line,length) ) then
         line = 'END'
      end if
      
loop1: continue

      if ( line == 'END' ) goto eof
      if (line == 'TEST') then
         call read_test(diskin,line)
      else if (line == 'BACKGROUND') then
         call read_background(diskin,line)
      else if (line == 'REACTION') then
         call read_reaction(diskin,line)
      else if (line == 'MATERIALS') then
         call read_materials(diskin,line)
      else if (line == 'PMI') then
         call read_pmi(diskin,line)
      end if
      
      goto loop1
      
eof:  continue      

/* Need to set |pr_max_equiv| before |check_problem|
is called for arrays to work properly. */
      pr_max_equiv=max(pr_test_num,pr_background_num)
      call check_problem
      
      return
      end

@ Initialize problem.

@<Functions...@>=
      subroutine init_problem
      implicit_none
      integer i                // Local
      pr_common
      sp_common
      sy_common
      
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      call nc_read_materials
      call nc_read_pmi
      pr_test_num=0
      pr_background_num=0
      pr_reaction_num=0
      pr_materials_num=0
      pr_pmi_num=0
      pr_num_generics=0
      var_alloc(problem_generics)
      do i=1,sp_num
         pr_gen(i)=0
      end do
      
      return
      end

@ Read in test particle labels.
      
@<Functions...@>=
      subroutine read_test(unit,line)
      implicit_none
      integer unit              // Input
      character*(*) line        // Output
      integer length,p,b,e,i    // Local
      pr_common
      sp_common
      sy_common
      st_common

      var_alloc(problem_species_test)
      do i=1,sp_num
         problem_species_test[i]=0
      end do

loop1: continue
      if ( ! read_string(unit,line,length) ) line='END'
      if ( line == 'END' || line == 'TEST' || line == 'BACKGROUND' || line == 'REACTION' || line == 'MATERIALS' || line == 'PMI')
     $     goto eof
      assert(length<=len(line))
      length=parse_string(line(:length))
      
      p=0
loop2: continue
      if ( ! next_token(line(:length),b,e,p) ) goto loop1
      pr_test_num++
      var_realloca(problem_test_sp)
      pr_test(pr_test_num) = sp_lookup(line(b:e))
      assert(pr_test(pr_test_num) > 0)
      problem_species_test(pr_test(pr_test_num)) = pr_test_num
      
      if (pr_gen(sp_generic(pr_test(pr_test_num)))==0) then  
/* New generic species: increment count of generic species and make
   corresponding entry in |pr_gen| which provides a map from entries 
   in the species list to this index of generic species represented in 
   the test and background lists. */
         pr_num_generics++                            
         pr_gen(sp_generic(pr_test(pr_test_num)))=pr_num_generics

/* The following two assignments treat tests which are not generic. */
         if (pr_test(pr_test_num) != sp_generic(pr_test(pr_test_num))) 
     $        pr_gen(pr_test(pr_test_num))=pr_num_generics
      else
         pr_gen(pr_test(pr_test_num))=pr_gen(sp_generic(pr_test(pr_test_num)))
      end if

      goto loop2

eof:  return
      end

