@m FILE 'problemsetup.web'

@I macros.hweb
@I readfilenames.hweb
@ The unnamed module.

@a
      program problemsetup
      implicit_none
      
      call readfilenames
      call read_problem
      call init_reaction
      call nc_write_problem

      stop
      end

      @<Functions and Subroutines@>

@ Read is data from \verb+problem.input+.

@<Functions...@>=
      subroutine read_problem
      implicit_none

      integer length            // Local
      character*LINELEN line
      sy_common
      st_common
      pr_common

      problem_version='unknown'
      open(unit=diskin,file='../data/problem.input',
     $     form='formatted',status='old')
      assert( read_string(diskin,line,length) )
      assert(length<=len(line))
      problem_version=line(:length)
      
      call init_problem
      if ( ! read_string(diskin,line,length) ) then
         line = 'END'
      end if
      
loop1: continue

      if ( line == 'END' ) goto eof
      if (line == 'TEST') then
         call read_test(diskin,line)
      else if (line == 'BACKGROUND') then
         call read_background(diskin,line)
      else if (line == 'REACTION') then
         call read_reaction(diskin,line)
      end if
      
      goto loop1
      
eof:  continue      

      call check_problem
      
      return
      end

@ Initialize problem.

@<Functions...@>=
      subroutine init_problem
      implicit_none
      pr_common
      
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      pr_test_num=0
      pr_background_num=0
      pr_reaction_num=0
      pr_num_test_generics=0
      pr_num_background_generics=0
      
      return
      end

@ Read in test particle labels.
      
@<Functions...@>=
      subroutine read_test(unit,line)
      implicit_none
      integer unit              // Input
      character*(*) line        // Output
      integer length,p,b,e,i    // Local
      pr_common
      sp_common
      sy_common
      st_common

/* Eventually, |problem_species_test| can be removed */
      var_alloc(problem_species_test)
      var_alloc(problem_test_generics)
      do i=1,sp_num
         problem_species_test[i]=0
         pr_ts_gen(i)=0
      end do

loop1: continue
      if ( ! read_string(unit,line,length) ) line='END'
      if ( line == 'END' || line == 'TEST' || line == 'BACKGROUND' || line == 'REACTION')
     $     goto eof
      assert(length<=len(line))
      length=parse_string(line(:length))
      
      p=0
loop2: continue
      if ( ! next_token(line(:length),b,e,p) ) goto loop1
      pr_test_num++
      var_realloca(problem_test_sp)
      pr_test(pr_test_num) = sp_lookup(line(b:e))
      assert(pr_test(pr_test_num) > 0)
      problem_species_test(pr_test(pr_test_num)) = pr_test_num
      
      if (pr_ts_gen(sp_generic(pr_test(pr_test_num)))==0) then  
/* New generic species: increment count of generic test species and make
   corresponding entry in |pr_ts_gen| which provides a map from generic entries 
   in the species list to this index of generic species represented in 
   the test list */
         pr_num_test_generics++                            
         pr_ts_gen(sp_generic(pr_test(pr_test_num)))=pr_num_test_generics
      end if

      goto loop2

eof:  return
      end

@ Read in background particle labels.
      
@<Functions...@>=
      subroutine read_background(unit,line)
      implicit_none
      integer unit              // Input
      character*(*) line        // Output
      integer length,p,b,e,i    // Local
      pr_common
      sp_common
      sy_common
      st_common
      
/* Eventually, |problem_species_background| can be removed. */
      var_alloc(problem_species_background)
      var_alloc(problem_background_generics)
      do i=1,sp_num
         problem_species_background[i]=0
         pr_bk_gen(i)=0
      end do

loop1: continue
      if ( ! read_string(unit,line,length) ) line='END'
      if ( line == 'END' || line == 'TEST' || line == 'BACKGROUND' || line == 'REACTION')
     $     goto eof
      
      assert(length<=len(line))
      length=parse_string(line)
      
      p=0
loop2: continue
      if ( ! next_token(line(:length),b,e,p) ) goto loop1
      pr_background_num++
      var_realloca(problem_background_sp)
      pr_background(pr_background_num) = sp_lookup(line(b:e))
      assert(pr_background(pr_background_num) > 0)
      problem_species_background(pr_background(pr_background_num)) = pr_background_num
      
      if (pr_bk_gen(sp_generic(pr_background(pr_background_num)))==0) then 
/* New generic species: increment count of generic background species and make
   corresponding entry in |pr_bk_gen| which provides a map from generic entries 
   in the species list to this index of generic species represented in 
   the background list */
         pr_num_background_generics++
         pr_bk_gen(sp_generic(pr_background(pr_background_num)))=pr_num_background_generics
      end if

      goto loop2

eof:  return
      end

@ Read in reaction particle labels.
      
@<Functions...@>=
      subroutine read_reaction(unit,line)
      implicit_none
      integer unit              // Input
      character*(*) line        // Output
      integer length,p,b,e      // Local
      pr_common
      rc_common
      sy_common
      st_common
      
loop1: continue
      if ( ! read_string(unit,line,length) ) line='END'
      if ( line == 'END' || line == 'TEST' || line == 'BACKGROUND' || line == 'REACTION')
     $     goto eof
      
      assert(length<=len(line))
      length=parse_string(line)
      
      p=0
loop2: continue
      if ( ! next_token(line(:length),b,e,p) ) goto loop1
      pr_reaction_num++
      var_realloca(problem_rc)
      pr_reaction(pr_reaction_num) = rc_lookup(line(b:e))
      assert(pr_reaction(pr_reaction_num) > 0)
      goto loop2

eof:  return
      end

@ Check problem specification.

@<Functions...@>=
      subroutine check_problem
      implicit_none
      integer i,j,k,l,test,background,generic_ts,generic_bk       // Local
      integer temp_gen_ts[rc_reagent_max],temp_gen_bk[rc_reagent_max]
      pr_common
      sp_common
      rc_common
      sy_common
      st_common

      var_reallocb(problem_test_sp)
      var_reallocb(problem_background_sp)
      var_reallocb(problem_rc)

      write(stdout,*) pr_test_num,pr_background_num,pr_reaction_num
      write(stdout,*) SP (pr_test(i),i=1,pr_test_num)
      write(stdout,*) SP (trim(sp_name(pr_test(i))),'; ',i=1,pr_test_num)
      write(stdout,*) SP (pr_background(i),i=1,pr_background_num)
      write(stdout,*) SP (trim(sp_name(pr_background(i))),'; ',i=1,pr_background_num)
      write(stdout,*) SP (pr_reaction(i),i=1,pr_reaction_num)
      write(stdout,*) SP (trim(rc_name(pr_reaction(i))),'; ',i=1,pr_reaction_num)
      
      var_alloc(problem_reaction_num)
      var_alloc(problem_test_reaction)
      var_alloc(problem_test_background)
      var_alloc(problem_num_equiv_tests)
      var_alloc(problem_num_equiv_bks)
      var_alloc(problem_equiv_test)
      var_alloc(problem_equiv_background)

      do i=1,pr_num_test_generics
         pr_num_eq_ts(i)=0
         do j=1,pr_test_num
            pr_eq_ts(i,j)=0
         end do
      end do

/* For each generic species, first obtain the index for the
   list of generics |generic_ts|, then count the number 
   of equivalent test species, and store the corresponding 
   test index in |pr_eq_ts|. */
      do i=1,pr_test_num
         generic_ts=pr_ts_gen(sp_generic(pr_test(i)))
         pr_num_eq_ts(generic_ts)++
         pr_eq_ts(generic_ts,pr_num_eq_ts(generic_ts))=i
      end do

      do i=1,pr_num_background_generics
         pr_num_eq_bk(i)=0
         do j=1,pr_background_num
            pr_eq_bk(i,j)=0
         end do
      end do

/* Do same for generics of background species */
      do i=1,pr_background_num
         generic_bk=pr_bk_gen(sp_generic(pr_background(i)))
         pr_num_eq_bk(generic_bk)++
         pr_eq_bk(generic_bk,pr_num_eq_bk(generic_bk))=i
      end do
      
 /* We can only deal with binary collisions currently */
      do j=1,pr_reaction_num
         assert(rc_reagent_num(pr_reaction(j)) == 2)
      end do
      
      do i=1,pr_test_num
         pr_rc_num(i)=0
      end do

      do j=1,pr_reaction_num

/* Allow for arbitrary ordering of |test| and |background| in reagent 
   specification. Despite a general appearance, this still assumes 
   binary collisions. */
         generic_ts=0
         generic_bk=0
         do i=1,rc_reagent_num(pr_reaction(j))
            temp_gen_ts[i]=pr_ts_gen(sp_generic(rc_reagent(pr_reaction(j),i)))
            temp_gen_bk[i]=pr_bk_gen(sp_generic(rc_reagent(pr_reaction(j),i)))
            if (temp_gen_ts[i] == 0) then              

/* If not a test, then it must be a background */
               assert(temp_gen_bk[i]!=0 && generic_bk==0)
               generic_bk=temp_gen_bk[i]

/* Check for the converse, as well */
            else if (temp_gen_bk[i] == 0) then
               assert(temp_gen_ts[i]!=0 && generic_ts==0)
               generic_ts=temp_gen_ts[i]
            end if
         end do

/* If one of |generic_ts| or |generic_bkd| remains unset, it is because one generic
   species is on both test and background lists. Loop through reagents again to find 
   it and assignment to either |generic_ts| or |generic_bk|, whichever is unset. */
         if (generic_ts==0 || generic_bk==0) then
            do i=1,rc_reagent_num(pr_reaction(j))
               if (temp_gen_ts[i]!=0 && temp_gen_bk[i]!=0) then
                  if (generic_bk == 0) then
                     generic_bk=temp_gen_bk[i]
                  else if (generic_ts == 0) then
                     generic_ts=temp_gen_ts[i]
                  end if
               end if
            end do
         end if

/* Done setting |generic_ts| and |generic_bk|; use to assign remaining |pr| arrays */
         do k=1,pr_num_eq_ts(generic_ts)
            test=pr_eq_ts(generic_ts,k)
            do l=1,pr_num_eq_bk(generic_bk)
               background=pr_eq_bk(generic_bk,l)
               assert( pr_test_check(test) && pr_background_check(background) )
               pr_rc_num(test)=pr_rc_num(test)+1
               assert(pr_rc_num(test) <= pr_reaction_max)
               pr_ts_rc(test,pr_rc_num(test))=j
               pr_ts_bk(test,pr_rc_num(test))=background
            end do
         end do
      end do

      return
      end

@ Write out data into netcdf file \verb+elements.nc+
      
@<Functions...@>=
      subroutine nc_write_problem
      implicit_none
      pr_common                 // Common
      rd_common
      sp_common
      nc_common                 // Local
      integer fileid
      pr_ncdecl
      rd_ncdecl
      st_common
      rf_common
      character*LINELEN description,program_version
      character*FILELEN tempfile     //local

      program_version=
     $     '$Id$'

      tempfile = filenames_array[problemfile]
      fileid = nccreate(tempfile,NC_CLOBBER,nc_stat)

      description = 'Data for problem in degas 2'
      call ncattputc(fileid,NC_GLOBAL,'description',NC_CHAR,
     $     string_length(description),
     $     description,nc_stat)

      call ncattputc(fileid,NC_GLOBAL,'data_version',NC_CHAR,
     $     string_length(problem_version),
     $     problem_version,nc_stat)
      
      call ncattputc(fileid,NC_GLOBAL,'program_version',NC_CHAR,
     $     string_length(program_version),
     $     program_version,nc_stat)
      
      pr_ncdef(fileid)
      rd_ncdef(fileid)
      call ncendef(fileid,nc_stat)
      pr_ncwrite(fileid)
      rd_ncwrite(fileid)
      
      call ncclose(fileid,nc_stat)
      
      return
      end

      
