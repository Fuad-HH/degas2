% $Id:
\Title{cramdadd}

% $Log:

@* Calculate CRAMD Data. 

\ID{$Id: }

Use Pigarov's Collisional-Radiative Atomic and
Molecular Data code to generate CR rates and miscellaneous data for a 
specific problem. Because of the complexity of the CR model, the data
are best represented as a function of position, rather than an N-dimensional
table, where N could well be 10 or even more. This code reads in the plasma
data for a specific problem (i.e., the background class), loops through
each plasma zone (the geometry is read in just to get the number of zones
explicitly), and calls CRAMD at each point. The ``problem'' file is also
read in at the start; at this point, entries corresponding to the CRAMD
data have been made in the problem file and in the reactions list. However,
the data in those tables are just placeholders, their locations denoted 
by |organization| = ``CRAMD''. In this code, the data table array is 
reallocated to make room for the data (the number of data values is
problem-specific) and the new data are added in following the loop over
zones. Finally, the problem file is written out again and the code run
can proceed normally.

Presently, this program is set up to correspond explicitly to the version of
CRAMD which treats H atoms and molecules. There are consequently a number
of hardwired components:
\begin{itemize}
  \item Input to CRAMD, |plasma_parameters| array. Its contents are described
        below. Its dimension |num_plasma_param| and the constants
        used to fill it are also hardwired.
  \item Output is also hardwired. See CRAMD.readme for more details.
\end{itemize}


@m FILE 'cramdadd.web'

@I macros.hweb
@I reactiondata.hweb
@I readfilenames.hweb
@I zone.hweb
@I xsection.hweb
@I problem.hweb
@I background.hweb
@I sysdep.hweb
@I reaction.hweb
@I string.hweb
@I species.hweb

@m tmp_rd_data(x,m,i,j,k) tmp_rd_table[tmp_rd_base[x][m]+i+tmp_rd_tab_index[x][m][1]*(j+tmp_rd_tab_index[x][m][2]*k)]
@m tmp_rm_data(x,m,i,j,k) tmp_rm_table[tmp_rm_base[x][m]+i+tmp_rm_tab_index[x][m][1]*(j+tmp_rm_tab_index[x][m][2]*k)]

@m bt const(2.0)
@m h_of const(1.0)
@m cha const(0.1)
@m cta const(1.0)
@m chm const(0.1)
@m ctm const(0.5)
@m num_plasma_params 9
@m num_output_params 20
@m num_test_species 2

@ The main program.

@a
      @<Functions and subroutines@>

@ Add CRAMD Data to problem data.

@<Functions...@>=
      subroutine add_cramd_data
      implicit_none

      integer pr_reac, jdep, jrank, i, j, k, i_elec, i_ion,
     $        pr_reac_eion, jd_eion_e_los, jd_eion_ha, pr_reac_iion, 
     $        jd_iion_e_los, pr_reac_rec, jd_rec_ha, jd_rec_e_los, jd_rec_i_los, 
     $        jd_rec_e_gain, pr_reac_dis, jd_dis_hf, jd_dis_ha, 
     $        jd_dis_e_los, jd_dis_i_los, jd_dis_mar, zone, ierr
      real n_ion, t_ion, t_elec
      real output_data[num_output_params,num_test_species]
      logical have_cramd_data
      character*LINELEN cwd
      character*FILELEN tempfile

      integer tmp_rd_size
      ptr_decl(tmp_rd_tab_index) 
      ptr_decl(tmp_rd_base)
      ptr_decl(tmp_rd_table)

      integer tmp_rm_size
      ptr_decl(tmp_rm_tab_index)
      ptr_decl(tmp_rm_base)
      ptr_decl(tmp_rm_table)

      external cramd_ini
      integer cramd_ini

      rd_common
      zn_common
      pr_common
      integer tmp_rd_tab_index[pr_reaction_num][xs_dep_var_max][xs_table_rank_max]
      integer tmp_rd_base[pr_reaction_num][xs_dep_var_max]
      real tmp_rd_table[0:reaction_data_size-1]

      integer tmp_rm_tab_index[pr_reaction_num][xs_dep_var_max][xs_table_rank_max]
      integer tmp_rm_base[pr_reaction_num][xs_dep_var_max]
      real tmp_rm_table[0:reaction_misc_size-1]

      bk_common
      sy_common
      rc_common
      st_common
      sp_common
      rf_common

      have_cramd_data=.false.
      do pr_reac=1,pr_reaction_num
         do jdep=1,xs_dep_var_max
            if (reaction_organization[pr_reac][jdep] == xs_organization_cramd)
     $           have_cramd_data=.true.
         end do
      end do
      if (!have_cramd_data) return

// SHOULD CHANGE background.hweb!!!
// I.e., the dimension of the background arrays should be expressly zn_num,
// not just the number of plasma zones. Since in general the plasma zones
// are mixed in with the others, shortening the background arrays implies
// a different (and confusing) index for a given plasma zone to be used in
// referencing a background array than with the geometry zone.

      int_alloc(tmp_rd_tab_index,pr_reaction_num*xs_dep_var_max*xs_table_rank_max)
      int_alloc(tmp_rd_base,pr_reaction_num*xs_dep_var_max)
      real_alloc(tmp_rd_table,reaction_data_size)

      int_alloc(tmp_rm_tab_index,pr_reaction_num*xs_dep_var_max*xs_table_rank_max)
      int_alloc(tmp_rm_base,pr_reaction_num*xs_dep_var_max)
      real_alloc(tmp_rm_table,reaction_misc_size)

      tmp_rd_size=reaction_data_size
      tmp_rm_size=reaction_misc_size
      do pr_reac=1,pr_reaction_num
         do jdep=1,xs_dep_var_max
            tmp_rd_base[pr_reac][jdep]=reaction_data_base[pr_reac][jdep]
            tmp_rm_base[pr_reac][jdep]=reaction_misc_base[pr_reac][jdep]
            do jrank=1,xs_table_rank_max
               tmp_rd_tab_index[pr_reac][jdep][jrank]=reaction_data_tab_index[pr_reac][jdep][jrank]
               tmp_rm_tab_index[pr_reac][jdep][jrank]=reaction_misc_tab_index[pr_reac][jdep][jrank]
            end do
            do k=0,reaction_data_tab_index[pr_reac][jdep][3]-1
               do j=0,reaction_data_tab_index[pr_reac][jdep][2]-1
                  do i=0,reaction_data_tab_index[pr_reac][jdep][1]-1
                     tmp_rd_data(pr_reac,jdep,i,j,k)=rd_data3(pr_reac,jdep,i,j,k)
                  end do
               end do
            end do
            do k=0,reaction_misc_tab_index[pr_reac][jdep][3]-1
               do j=0,reaction_misc_tab_index[pr_reac][jdep][2]-1
                  do i=0,reaction_misc_tab_index[pr_reac][jdep][1]-1
                     tmp_rm_data(pr_reac,jdep,i,j,k)=rd_misc_data3(pr_reac,jdep,i,j,k)
                  end do
               end do
            end do
         end do
      end do
      
      var_free(reaction_data_table)
      var_free(reaction_misc_table)

      rd_ragged_alloc(reaction_data)
      rd_ragged_alloc(reaction_misc)
      do pr_reac=1,pr_reaction_num
         do jdep=1,xs_dep_var_max
            if (reaction_organization[pr_reac][jdep] == xs_organization_cramd) then
               reaction_data_tab_index[pr_reac][jdep][1]=zn_num
               
            end if
            rd_ragged_realloc(reaction_data,reaction_data_tab_index,[pr_reac][jdep])
            if (reaction_misc_organization[pr_reac][jdep] == xs_organization_cramd) then
               reaction_misc_tab_index[pr_reac][jdep][1]=zn_num
            end if
            rd_ragged_realloc(reaction_misc,reaction_misc_tab_index,[pr_reac][jdep])
         end do
      end do

/* Replace old data first */

      do pr_reac=1,pr_reaction_num
            do jdep=1,xs_dep_var_max
               if (reaction_organization[pr_reac][jdep] != xs_organization_cramd) then
                  do k=0,reaction_data_tab_index[pr_reac][jdep][3]-1
                     do j=0,reaction_data_tab_index[pr_reac][jdep][2]-1
                        do i=0,reaction_data_tab_index[pr_reac][jdep][1]-1
                           rd_data3(pr_reac,jdep,i,j,k)=tmp_rd_data(pr_reac,jdep,i,j,k)
                        end do
                     end do
                  end do
               end if
               if (reaction_misc_organization[pr_reac][jdep] != xs_organization_cramd) then
                  do k=0,reaction_misc_tab_index[pr_reac][jdep][3]-1
                     do j=0,reaction_misc_tab_index[pr_reac][jdep][2]-1
                        do i=0,reaction_misc_tab_index[pr_reac][jdep][1]-1
                           rd_misc_data3(pr_reac,jdep,i,j,k)=tmp_rm_data(pr_reac,jdep,i,j,k)
                        end do
                     end do
                  end do
               end if
            end do
      end do
/* Loop over zones, calculate CRAMD data and insert into data tables.
   Contents of |plasma_parameters| are (constant multipliers are defined
   as macros at top of file):
 */

/* Background species */

      i_elec=problem_species_background[sp_lookup('e')]
      i_ion=problem_species_background[sp_lookup('D+')]
      assert(i_elec != 0 && i_ion != 0)

/* Determine array indices corresponding to CRAMD reactions and dependent
   variables.
 */

      pr_reac_eion=int_lookup(rc_lookup('heioncramd'),
     $     problem_rc,pr_reaction_num)
      if (pr_reac_eion != 0) then
         jd_eion_ha=string_lookup('halpha_rate',
     $        reaction_misc_var_dep[1,pr_reac_eion],xs_dep_var_max)
         jd_eion_e_los=string_lookup('elec_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_eion],xs_dep_var_max)
      end if

      pr_reac_iion=int_lookup(rc_lookup('hiioncramd'),
     $     problem_rc,pr_reaction_num)
      if (pr_reac_iion != 0) then
         jd_iion_e_los=string_lookup('ion_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_iion],xs_dep_var_max)
      end if

      pr_reac_rec=int_lookup(rc_lookup('herecramd'),
     $     problem_rc,pr_reaction_num)
      if (pr_reac_rec != 0) then
         jd_rec_ha=string_lookup('halpha_rate',
     $        reaction_misc_var_dep[1,pr_reac_rec],xs_dep_var_max)
         jd_rec_e_los=string_lookup('elec_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_rec],xs_dep_var_max)
         jd_rec_i_los=string_lookup('ion_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_rec],xs_dep_var_max)
         jd_rec_e_gain=string_lookup('3body_e_gain_rate',
     $        reaction_misc_var_dep[1,pr_reac_rec],xs_dep_var_max)
      end if

      pr_reac_dis=int_lookup(rc_lookup('h2discramd'),
     $     problem_rc,pr_reaction_num)
      if (pr_reac_dis != 0) then
         jd_dis_hf=string_lookup('hfrac',
     $        reaction_misc_var_dep[1,pr_reac_dis],xs_dep_var_max)
         jd_dis_ha=string_lookup('halpha_rate',
     $        reaction_misc_var_dep[1,pr_reac_dis],xs_dep_var_max)
         jd_dis_e_los=string_lookup('elec_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_dis],xs_dep_var_max)
         jd_dis_i_los=string_lookup('ion_e_loss_rate',
     $        reaction_misc_var_dep[1,pr_reac_dis],xs_dep_var_max)
         jd_dis_mar=string_lookup('mar_rate',
     $        reaction_misc_var_dep[1,pr_reac_dis],xs_dep_var_max)
      end if

      call get_cwd(cwd)
      cwd=trim(cwd)\/'/../CRAMD/DATA/'
      call null_terminate(cwd)
@#if ALPHA
      ierr=cramd_ini(cwd)
@#else
      assert("CRAMD only available on DEC-Alpha" == " ")
@#endif
      assert(ierr == 0)

      do zone=1,zn_num
         if (zn_type(zone) == zn_plasma) then
            n_ion=background_n[zone][i_ion]
            t_ion=background_temp[zone][i_ion]
            t_elec=background_temp[zone][i_elec]
            
            call cramd_do_fort(n_ion,t_ion,t_elec,output_data)

/* Hardwired transfers using above-defined indices and
   knowledge of contents of |output_data|. Factor in units
   conversions to bring everything into MKS units.
 */
            if (pr_reac_eion != 0) then
               rd_data3(pr_reac_eion,rd_rate,zone-1,0,0)=
     $              output_data[1][1]*const(1.,-6)
               rd_misc_data3(pr_reac_eion,jd_eion_ha,zone-1,0,0)=
     $              output_data[1][6]*const(1.,-6)*electron_charge
               rd_misc_data3(pr_reac_eion,jd_eion_e_los,zone-1,0,0)=
     $              output_data[1][3]*const(1.,-6)*electron_charge
            end if

            if (pr_reac_iion != 0) then
               rd_data3(pr_reac_iion,rd_rate,zone-1,0,0)=
     $              output_data[1][2]*const(1.,-6)
               rd_misc_data3(pr_reac_iion,jd_iion_e_los,zone-1,0,0)=
     $              output_data[1][4]*const(1.,-6)*electron_charge
            end if

            if (pr_reac_rec != 0) then
               rd_data3(pr_reac_rec,rd_rate,zone-1,0,0)=
     $              output_data[1][7]*const(1.,-6)
               rd_misc_data3(pr_reac_rec,jd_rec_ha,zone-1,0,0)=
     $              output_data[1][15]*const(1.,-6)*electron_charge
               rd_misc_data3(pr_reac_rec,jd_rec_e_los,zone-1,0,0)=
     $              output_data[1][8]*const(1.,-6)*electron_charge
               rd_misc_data3(pr_reac_rec,jd_rec_i_los,zone-1,0,0)=
     $              output_data[1][9]*const(1.,-6)*electron_charge
               rd_misc_data3(pr_reac_rec,jd_rec_e_gain,zone-1,0,0)=
     $              output_data[1][13]*const(1.,-6)*electron_charge
            end if

            if (pr_reac_dis != 0) then
               rd_data3(pr_reac_dis,rd_rate,zone-1,0,0)=
     $              output_data[2][1]*const(1.,-6)
               if (jd_dis_hf != 0) 
     $              rd_misc_data3(pr_reac_dis,jd_dis_hf,zone-1,0,0)=
     $              output_data[2][3] 
               if (jd_dis_ha != 0) 
     $              rd_misc_data3(pr_reac_dis,jd_dis_ha,zone-1,0,0)=
     $              output_data[2][8]*const(1.,-6)*electron_charge
               if (jd_dis_e_los != 0) 
     $              rd_misc_data3(pr_reac_dis,jd_dis_e_los,zone-1,0,0)=
     $              output_data[2][5]*const(1.,-6)*electron_charge
               if (jd_dis_i_los != 0)
     $              rd_misc_data3(pr_reac_dis,jd_dis_i_los,zone-1,0,0)=
     $              output_data[2][6]*const(1.,-6)*electron_charge
               if (jd_dis_mar != 0)
     $              rd_misc_data3(pr_reac_dis,jd_dis_mar,zone-1,0,0)=
     $              output_data[2][2]*const(1.,-6)
            end if
            
         end if
      end do
      
@#if ALPHA
      call cramd_finish()
@#else
      assert("CRAMD only available on DEC-Alpha" == " ")
@#endif

      do pr_reac=1,pr_reaction_num
         do jdep=1,xs_dep_var_max
            if (reaction_organization[pr_reac][jdep] == xs_organization_cramd) then
               reaction_organization[pr_reac][jdep]=xs_organization_table
            end if
            if (reaction_misc_organization[pr_reac][jdep] == xs_organization_cramd) then
               reaction_misc_organization[pr_reac][jdep]=xs_organization_table
            end if
         end do
      end do
                     
      int_free(tmp_rd_tab_index,pr_reaction_num*xs_dep_var_max*xs_table_rank_max)
      
      int_free(tmp_rd_base,pr_reaction_num*xs_dep_var_max)
      real_free(tmp_rd_table,tmp_rd_size)

      int_free(tmp_rm_tab_index,pr_reaction_num*xs_dep_var_max*xs_table_rank_max)
      int_free(tmp_rm_base,pr_reaction_num*xs_dep_var_max)
      real_free(tmp_rm_table,tmp_rm_size)

      tempfile=filenames_array[problemfile]
      filenames_array[problemfile]=filenames_array[cramdproblemfile]
      call nc_write_problem
      filenames_array[problemfile]=tempfile

      return
      end

@ Simple CRAMD FORTRAN Interface.

@<Functions...@>=
      subroutine cramd_do_fort(n_ion,t_ion,t_elec,output_data)
      implicit_none

      real n_ion,t_ion,t_elec                                 // Input
      real output_data[num_output_params,num_test_species]    // Output
      real plasma_parameters[num_plasma_params]               // Local
      real n_i_norm,t_e_norm,t_i_norm
      integer ierr, i, j

      external cramd_do
      integer cramd_do

/* Hardwire Sasha's input normalizations */
      n_i_norm=n_ion*const(1.,-19)
      t_i_norm=t_ion/electron_charge
      t_e_norm=t_elec/electron_charge

      plasma_parameters[1]=bt
      plasma_parameters[2]=h_of
      plasma_parameters[3]=t_e_norm
      plasma_parameters[4]=cha*n_i_norm
      plasma_parameters[5]=cta*t_i_norm
      plasma_parameters[6]=n_i_norm
      plasma_parameters[7]=t_i_norm
      plasma_parameters[8]=chm*n_i_norm
      plasma_parameters[9]=ctm*t_i_norm

@#if ALPHA
      ierr=cramd_do(plasma_parameters,output_data)
@#else
      assert("CRAMD only available on DEC-Alpha" == " ")
@#endif
      assert(ierr==0)
/* And undo his output normalizations. Things should
   now be in cm$^{3}/$s and eV cm$^{3}/$s.
 */
      do i=1,num_test_species
         do j=1,num_output_params
/* Exclude dissociation H- and H$^{+}$-fractions */
            if (i != 2 || (j != 3 && j != 4)) then
               output_data[i][j]*=const(1.,-8)
            end if
         end do
      end do
      
      return
      end

@* INDEX.
