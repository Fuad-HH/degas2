         zone_data[i]=zero
      end do

      do test=1,pr_test_num
         if (string_lookup('Dalpha emission rate by species',tally_name,tl_num) > 0) then
            name_clean(sp_sy(pr_test(test)),clean_sy)
            ha_temp=zero
            index_parameters[tl_index_test]=test
            do zone=1,zn_num
               if (zn_type(zone) == zn_plasma) then
