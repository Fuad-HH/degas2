     $                 /(const(2.109566)*electron_charge)
                  zone_data[zone]+=ha_rate
                  ha_temp+=ha_rate*zn_volume(zone)
@#if 0
               else if (zn_type(zone) == zn_solid) then  // Can plot solid
                  zone_data[zone]=-one                    // regions 
@#endif
               else
