@* Memory allocation.  Allocate memory (Fortran 77 versions).

@m magic const(314159.265358979)
@#if CRAY
  @m mem_unit 1
@#else
  @m mem_unit 8
@#endif

@<Functions...@>=
@#if FORTRAN77
      function mem_alloc(size)
      address mem_alloc         // Function
      integer size              // Input
      integer sizea             // Local
      real data
      pointer (ptr,data(*))
@#if DEBUG
      integer i
@#endif
@#if !CRAY
      address malloc           // External
@#else
      integer stat              // Local
@#endif

      assert(size >= 0)

      if (size == 0) then
         mem_alloc=0
         return
      end if
      
@#if DEBUG
      sizea=size+2
@#else
      sizea=size
@#endif

@#if !CRAY
@#if IBM
      ptr=malloc(%val(mem_unit*sizea))
@#else
      ptr=malloc(mem_unit*sizea)
@#endif
      assert(ptr != 0)
@#else
      call hpalloc(ptr,mem_unit*sizea,stat,0)
      assert(stat == 0)
@#endif

@#if DEBUG
      do i=1,sizea
         data(i)=magic
      end do

      mem_alloc=ptr+mem_unit
@#else
      mem_alloc=ptr
@#endif
      
      return
      end
@#endif /* FORTRAN77 */

@ Reallocate memory.

@<Functions...@>=
@#if FORTRAN77
      function mem_realloc(oldptr,oldsize,newsize)
      address mem_realloc       // Function
      address oldptr            // Input
      integer oldsize,newsize
      integer newsizea,oldsizea // Local
      real odata,ndata
      pointer (optr,odata(*)),(nptr,ndata(*))
@#if DEBUG || !CRAY
      integer i
@#endif
@#if !CRAY
      address malloc            // External
@#else
      integer stat              // Local
@#endif
      external mem_alloc        // External
      address mem_alloc

      assert(oldsize >=0 && newsize > 0)

      if (oldsize == 0) then
         mem_realloc = mem_alloc(newsize)
         return
      end if

@#if DEBUG
      optr=oldptr-mem_unit
      newsizea=newsize+2
      oldsizea=oldsize+2
      assert(odata(1) == magic && odata(oldsizea) == magic)
@#else
      optr=oldptr
      newsizea=newsize
      oldsizea=oldsize
@#endif

      if (oldsize == newsize) then
         mem_realloc=oldptr
         return
      end if


@#if !CRAY
@#if IBM
      nptr=malloc(%val(mem_unit*newsizea))
@#else
      nptr=malloc(mem_unit*newsizea)
@#endif
      assert(nptr != 0)

      do i=1,min(newsizea,oldsizea)
         ndata(i)=odata(i)
      end do
      call free(optr)
@#else
      call hpclmove(optr,mem_unit*newsizea,stat,0)
      assert(stat == 0 || stat == 1)
      nptr = optr
@#endif

@#if DEBUG
      do i=min(newsizea,oldsizea),newsizea
         ndata(i)=magic
      end do

      mem_realloc=nptr+mem_unit
@#else
      mem_realloc=nptr
@#endif

      return
      end
@#endif /* FORTRAN77 */

@ Free memory

@<Functions...@>=
@#if FORTRAN77
      subroutine mem_free(oldptr,size)
      address oldptr       // Input
      integer size
      integer sizea             // Local
      real data
      pointer (optr,data(*))
@#if CRAY
      integer stat              // Local
@#endif
      
      assert(size >= 0)
      if (size == 0) return

@#if DEBUG
      optr=oldptr-mem_unit
      sizea = size + 2
      assert(data(1) == magic && data(sizea) == magic)
@#else
      optr=oldptr
      sizea = size
@#endif
      
@#if !CRAY
      call free(optr)
@#else
      call hpdeallc(optr,stat,0)
      assert(stat == 0)
@#endif

      return
      end
@#endif /* FORTRAN77 */

@* Fortran 90 memory allocation.  In Fortran 90 we need a separate call
for each type and rank of data.  So the basic routines are named
|mem_alloc|, |mem_realloc|, |mem_free|, with |_TYPE&RANK|, (e.g., |_r2|
appended).  WE can'T conveniently IMPLEMENT guard cells (since we can't
do pointer arithmetic).

@m char_magic "314159.265358979"
@m int_magic 314159
@m real_magic const(314159.265358979)

@<Functions...@>=
@#if FORTRAN90
      function mem_alloc_c1(size,l1,u1) result(p)
      implicit_none_f77
      implicit_none_f90
      integer, intent(in) :: size,l1,u1
      character(len=size), dimension(:), pointer :: p
      assert(size > 0 && l1 <= u1)
      allocate(p(l1:u1))
      p=char_magic
      return
      end function

      function mem_alloc_c2(size,l1,u1,l2,u2) result(p)
      implicit_none_f77
      implicit_none_f90
      integer, intent(in) :: size,l1,u1,l2,u2
      character(len=size), dimension(:,:), pointer :: p
      assert(size > 0 && l1 <= u1 && l2 <= u2)
      allocate(p(l1:u1,l2:u2))
      p=char_magic
      return
      end function

      function mem_alloc_c3(size,l1,u1,l2,u2,l3,u3) result(p)
      implicit_none_f77
      implicit_none_f90
      integer, intent(in) :: size,l1,u1,l2,u2,l3,u3
      character(len=size), dimension(:,:,:), pointer :: p
      assert(size > 0 && l1 <= u1 && l2 <= u2 && l3 <= u3)
      allocate(p(l1:u1,l2:u2,l3:u3))
      p=char_magic
      return
      end function

      function mem_alloc_c4(size,l1,u1,l2,u2,l3,u3,l4,u4) result(p)
      implicit_none_f77
      implicit_none_f90
      integer, intent(in) :: size,l1,u1,l2,u2,l3,u3,l4,u4
      character(len=size), dimension(:,:,:,:), pointer :: p
      assert(size > 0 && l1 <= u1 && l2 <= u2 && l3 <= u3 && l4 <= u4)
      allocate(p(l1:u1,l2:u2,l3:u3,l4:u4))
      p=char_magic
      return
      end function

      function mem_alloc_i1(l1,u1) result(p)
      implicit_none_f77
      implicit_none_f90
