@ Return current working directory.

@<Functions...@>=
      subroutine get_cwd(cwd)
      implicit_none_f77
      implicit_none_f90
      character*(*) cwd         // Output
      integer getcwd            // External

@#if CRAY
      if (getcwd(cwd) <= 0) cwd='UNKNOWN'
@#elif SGI || HP || IBM
      if (getcwd(cwd) == 0) then
         cwd='UNKNOWN'
      else
         call string_pad(cwd)
      end if
@#else
      if (getcwd(cwd) != 0) cwd='UNKNOWN'
@#endif
      if (cwd == ' ') cwd='UNKNOWN'

      return
      end

@ Set working directory.  Returns |.true.| if successful.

@<Functions...@>=
      function set_cwd(dir)
      implicit_none_f77
      implicit_none_f90
      logical set_cwd
      character*(*) dir         // Input
      integer chdir             // External

      set_cwd = chdir(dir) == 0

      return
      end

@ Get user name.

@<Functions...@>=
      subroutine user_name(user)
      implicit_none_f77
      implicit_none_f90
      character*(*) user       // Output
      logical get_env          // External

      if (!get_env('LOGNAME',user)) then
         if (!get_env('USER',user)) then
            user='UNKNOWN'
         end if
      end if

      return
      end

@ Return host name.

@#if HP || IBM
  @m hostnm gethostname
@#endif

@<Functions...@>=
      subroutine host_name(host)
      implicit_none_f77
      implicit_none_f90
      character*20 host         // Local
@#if CRAY
      character dummy[4]        // Local
@#endif
@#if CRAY
      integer uname            // External
@#else
      integer hostnm           // External
@#endif

@#if CRAY
      if (uname(dummy[1],host,dummy[2],dummy[3],dummy[4]) == -1) host='UNKNOWN'
@#else
      if (hostnm(host) != 0) host='UNKNOWN'
@#if HP || IBM
      call string_pad(host)
@#endif
@#endif
      if (host==' ') host='UNKNOWN'

      return
      end

