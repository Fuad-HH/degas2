@* Memory allocation.  Allocate memory.

@m magic const(314159.0)

@#if CRAY
  @m mem_unit 1
@#else
  @m mem_unit 8
@#endif

@<Functions...@>=
      function mem_alloc(size)
      integer mem_alloc         // Function
      integer size              // Input
      integer sizea             // Local
      real data
      pointer (ptr,data(*))
@#if DEBUG
      integer i
@#endif
@#if !CRAY
      integer malloc           // External
@#else
      integer stat              // Local
@#endif

      assert(size >= 0)

      if (size == 0) then
         mem_alloc=0
         return
      end if
      
@#if DEBUG
      sizea=size+2
@#else
      sizea=size
@#endif

@#if !CRAY
@#if IBM
      ptr=malloc(%val(mem_unit*sizea))
@#else
      ptr=malloc(mem_unit*sizea)
@#endif
      assert(ptr != 0)
@#else
      call hpalloc(ptr,mem_unit*sizea,stat,0)
      assert(stat == 0)
@#endif

@#if DEBUG
      do i=1,sizea
         data(i)=magic
      end do

      mem_alloc=ptr+mem_unit
@#else
      mem_alloc=ptr
@#endif
      
      return
      end

@ Reallocate memory.

@<Functions...@>=
      function mem_realloc(oldptr,oldsize,newsize)
      integer mem_realloc       // Function
      integer oldptr,oldsize,newsize // Input
      integer newsizea,oldsizea // Local
      real odata,ndata
      pointer (optr,odata(*)),(nptr,ndata(*))
@#if DEBUG || !CRAY
      integer i
@#endif
@#if !CRAY
      integer malloc            // External
@#else
      integer stat              // Local
@#endif
      integer mem_alloc        // External

      assert(oldsize >=0 && newsize > 0)

      if (oldsize == 0) then
         mem_realloc = mem_alloc(newsize)
         return
      end if

@#if DEBUG
      optr=oldptr-mem_unit
      newsizea=newsize+2
      oldsizea=oldsize+2
      assert(odata(1) == magic && odata(oldsizea) == magic)
@#else
      optr=oldptr
      newsizea=newsize
      oldsizea=oldsize
@#endif

      if (oldsize == newsize) then
         mem_realloc=oldptr
         return
      end if


@#if !CRAY
@#if IBM
      nptr=malloc(%val(mem_unit*newsizea))
@#else
      nptr=malloc(mem_unit*newsizea)
@#endif
      assert(nptr != 0)

      do i=1,min(newsizea,oldsizea)
         ndata(i)=odata(i)
      end do
      call free(optr)
@#else
      call hpclmove(optr,mem_unit*newsizea,stat,0)
      assert(stat == 0 || stat == 1)
      nptr = optr
@#endif

@#if DEBUG
      do i=min(newsizea,oldsizea),newsizea
         ndata(i)=magic
      end do

      mem_realloc=nptr+mem_unit
@#else
      mem_realloc=nptr
@#endif

      return
      end

@ Free memory

@<Functions...@>=
      subroutine mem_free(oldptr,size)
      integer oldptr,size       // Input
      integer sizea             // Local
      real data
      pointer (optr,data(*))
@#if CRAY
      integer stat              // Local
@#endif
      
      assert(size >= 0)
      if (size == 0) return

@#if DEBUG
      optr=oldptr-mem_unit
      sizea = size + 2
      assert(data(1) == magic && data(sizea) == magic)
@#else
      optr=oldptr
      sizea = size
@#endif
      
@#if !CRAY
      call free(optr)
@#else
      call hpdeallc(optr,stat,0)
      assert(stat == 0)
@#endif

      return
      end

@* Error handling.

@<Functions...@>=
      subroutine error(message)
      implicit_none
      character*(*) message

      write(stderr,*) message
      pause

      return
      end

