
@* a program to read filenames for various inputs and outputs from an
external file. The syntax for the file is 
{\bf symbolic-filename} [actual filename] 
The symbolic name is assigned the filename. symbolic filenames are self 
explanatory as to what the files may contain.
To add more symbolic filenames simply change the assert stmt that checks 
whether the symbolic name is a valid one, and add another 'elseif' block. The
new index in the file name  array has to be included in the header file.

A sample input file for this is as follows : 

\begin{verbatim}
\# file names for degas2 
\# the name of this file is passed as argument to readfilenames 
\# syntax is : symbolic filename \em {actual filename} 
\# the filenames can be in any order, comments (starting with \#) and blank 
\# lines will be ignored. 

elementsfile  ../data/elements.nc 
backgroundfile background.nc 
testfile  test.nc 
geometryfile geometry.nc 
problemfile ../data/problem.nc 
reactionfile ../data/reactions.nc 
speciesfile ../data/species.nc 
aladinfile ../data/aladinput.nc
aladoutfile ../data/aladoutput.nc 
elements_infile ../data/elements.input 
problem_infile  ../data/problem.input
reaction_infile ../data/reactions.input
species_infile ../data/species.input
\end{verbatim}


\ID{$Id$}

@m FILE 'readfilenames.web'
@I macros.hweb
@I readfilenames.hweb
@I sysdep.hweb
@I string.hweb

@f namelist integer
@ The unnamed module.

@a
      @<Functions and Subroutines@>
@ The main program

@<Functions...@>=

      subroutine readfilenames
      implicit none
      
      character*FILELEN filename ,symbolic_fname	
      character*LINELEN line
      integer length,p,b,e // Local
      sy_common
      st_common
      rf_common

/* this is hard coded for now, for want of a better means */
      filename ='degas2.in'
      open(unit=diskin,file=filename,status='old',form='formatted')

/* read the file containing filenames */
      filenames_max =0
loop:      if (! read_string(diskin,line,length) ) goto eof 
      assert(length<=len(line))

      length=parse_string(line(:length))
      p=0
      assert( next_token(line,b,e,p) )
      symbolic_fname = line(b:e)
      assert( next_token(line,b,e,p) )
      assert ( symbolic_fname == 'elementsfile' || symbolic_fname ==
     $     'backgroundfile' || symbolic_fname ==  'testfile' ||
     $     symbolic_fname == 'geometryfile' || symbolic_fname ==
     $     'problemfile' || symbolic_fname == 'reactionfile' ||
     $     symbolic_fname == 'speciesfile' || symbolic_fname ==
     $     'aladinfile' || symbolic_fname == 'aladoutfile' ||
     $     symbolic_fname == 'elements_infile' || symbolic_fname ==
     $     'problem_infile' || symbolic_fname =='reaction_infile' ||
     $     symbolic_fname == 'species_infile' || symbolic_fname == 
     $     'materials_infile' || symbolic_fname == 'materialsfile' ||
     $     symbolic_fname == 'pmi_infile' || symbolic_fname == 'pmifile' 
     $     || symbolic_fname == 'cramdproblemfile' 
     $     || symbolic_fname == 'tallyfile'
     $     || symbolic_fname == 'outputfile')
      
      filenames_max = filenames_max +1
      var_realloca(filenames_array)
      if ( symbolic_fname == 'elementsfile') then
         filenames_array[elementsfile]  = line(b:e)
      elseif ( symbolic_fname == 'backgroundfile') then
         filenames_array[backgroundfile] = line(b:e)
      elseif ( symbolic_fname == 'testfile') then 
         filenames_array[testfile] = line(b:e)
      elseif ( symbolic_fname == 'geometryfile') then
         filenames_array[geometryfile] = line(b:e)
      elseif ( symbolic_fname == 'problemfile')  then
         filenames_array[problemfile] =line(b:e)
      elseif ( symbolic_fname == 'reactionfile') then
         filenames_array[reactionfile] = line(b:e)
      elseif ( symbolic_fname == 'speciesfile')  then
         filenames_array[speciesfile] = line(b:e)
      elseif ( symbolic_fname == 'aladinfile')  then
         filenames_array[aladinfile] = line(b:e)
      elseif ( symbolic_fname == 'aladoutfile')  then
         filenames_array[aladoutfile] = line(b:e)
      elseif ( symbolic_fname == 'elements_infile')  then
         filenames_array[elements_infile] = line(b:e)
      elseif ( symbolic_fname == 'problem_infile')  then
         filenames_array[problem_infile] = line(b:e)
      elseif ( symbolic_fname == 'reaction_infile')  then
         filenames_array[reaction_infile] = line(b:e)
      elseif ( symbolic_fname == 'species_infile')  then
         filenames_array[species_infile] = line(b:e)
      elseif ( symbolic_fname == 'materials_infile')  then
         filenames_array[materials_infile] = line(b:e)
      elseif ( symbolic_fname == 'materialsfile')  then
         filenames_array[materialsfile] = line(b:e)
      elseif ( symbolic_fname == 'pmi_infile')  then
         filenames_array[pmi_infile] = line(b:e)
      elseif ( symbolic_fname == 'pmifile')  then
         filenames_array[pmifile] = line(b:e)
      elseif ( symbolic_fname == 'cramdproblemfile') then
         filenames_array[cramdproblemfile] = line(b:e)
      elseif ( symbolic_fname == 'tallyfile') then
         filenames_array[tallyfile] = line(b:e)
      elseif ( symbolic_fname == 'outputfile') then
         filenames_array[outputfile] = line(b:e)
      endif

      goto loop
eof:  continue
      close(diskin)
      var_reallocb(filenames_array)
      return
      end


@* INDEX


