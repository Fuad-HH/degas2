@* Introduction.

\ID{$Id$}

Reads in a text file of reaction data and writes out a file in NETCDF
format with a complete specification of the reaction.

@m FILE 'reactionwrite.web'

@I macros.hweb
@I xsection.hweb
@I netcdf.hweb
@I sysdep.hweb
@I string.hweb

@ The unnamed module.



@a
      program reactionwrite
      implicit_none
      call reaction_write('hionize')
      call reaction_write('hchex')
      stop
      end
      
      @<Functions and subroutines@>
      
@ Set up array sizes to read in data for a particular reaction.

@<Functions...@>=
      subroutine reaction_write(name)
      implicit_none
      character*(*) name        // length at most |rc_sy_len|
      integer i,j,fileid          // Local
      real delta
      character*FILELEN filein,fileout
      character*LINELEN tag
      xs_common                 // Common
      nc_common
      xs_ncdecl
      sy_common
      st_common 
      
      xs_name=name
      xs_num_dep_var=1

      xs_tab_index(1,1)=1
      xs_tab_index(2,1)=1
      xs_tab_index(3,1)=1
      xs_tab_index(1,2)=1
      xs_tab_index(2,2)=1
      xs_tab_index(3,2)=1
      xs_tab_index(1,3)=1
      xs_tab_index(2,3)=1
      xs_tab_index(3,3)=1
      xs_tab_index(1,4)=1
      xs_tab_index(2,4)=1
      xs_tab_index(3,4)=1
      xs_tab_index(1,5)=1
      xs_tab_index(2,5)=1
      xs_tab_index(3,5)=1

      if (name == 'hionize' || name == 'hchex') then

         xs_organization[1]='table'
         xs_rank[1]=2          //2 indept. variables.

         xs_var[0,1]='rate'   //dependent is rate for both
         xs_spacing[0,1]='linear'     //spacing linear for both
         xs_units[0,1]='cm^3 s^-1'    //same units obviously
         xs_mult[0,1]=const(1.0,-6)    // and same multiplication factor

         xs_var[1,1]='temperature'    //1st indept. is temp. for both
         xs_spacing[1,1]='log'        //it is on a log scale
         xs_units[1,1]='eV'              //units are eV
         xs_mult[1,1]=electron_charge     // factor is el. charge.
         xs_tab_index(1,1)=48            // no. of temp. values
         delta=const(10.0)**const(0.1)
         xs_min[1,1]=const(1.0)
         xs_max[1,1]=xs_min[1,1]*delta**(xs_tab_index(1,1)-1)

      end if

      if (name == 'hionize') then

         xs_var[2,1]='density'      // 2nd indept. is density here.
         xs_spacing[2,1]='log'        
         xs_units[2,1]='cm^-3'
         xs_mult[2,1]=const(1.0,6)
         xs_tab_index(2,1)=11           //11 density values
         delta=const(10.0)**const(0.5)
         xs_min[2,1]=const(1.0,10)
         xs_max[2,1]=xs_min[2,1]*delta**(xs_tab_index(2,1)-1)

         filein='../data/eh.dat'
         tag=' '
         
      else if (name == 'hchex') then

         xs_var[2,1]='energy'     //2nd indept. is energy here.
         xs_spacing[2,1]='log'
         xs_units[2,1]='eV'
         xs_mult[2,1]=electron_charge
         xs_tab_index(2,1)=48         //48 energy values
         delta=const(10.0)**const(0.1)
         xs_min[2,1]=const(1.0)
         xs_max[2,1]=xs_min[2,1]*delta**(xs_tab_index(2,1)-1)

         filein='../data/atmc.dat'
         tag='h0 + h+ -> h+ + h0'
         

      end if

/* nothing is known about all the other independent variables */
      do i=xs_rank[1]+1,xs_table_rank_max

         xs_var[i,1]='unknown'
         xs_spacing[i,1]='unknown'
         xs_units[i,1]='unknown'
         xs_mult[i,1]=zero
         xs_min[i,1]=zero
         xs_max[i,1]=zero

      end do

/* nothing known about the other dependent variables */
      do j=xs_num_dep_var+1,xs_dep_var_max

         xs_rank[j]=1
         xs_organization[j]='unknown'
         xs_var[0,j]='unknown'
         xs_spacing[0,j]='unknown'
         xs_units[0,j]='unknown'
         xs_mult[0,j]=zero
         do i=1,xs_table_rank_max
            xs_var[i,j]='unknown'
            xs_spacing[i,j]='unknown'
            xs_units[i,j]='unknown'
            xs_mult[i,j]=zero
            xs_min[i,j]=zero
            xs_max[i,j]=zero
         end do
      end do

      do j=1,xs_dep_var_max
         xs_eval_name[j]='unknown'
      end do
      
      var_alloc(xs_tab1)
      var_alloc(xs_tab2)
      var_alloc(xs_tab3)
      var_alloc(xs_tab4)
      var_alloc(xs_tab5)

      xs_table1(0,0,0)=zero
      xs_table2(0,0,0)=zero
      xs_table3(0,0,0)=zero
      xs_table4(0,0,0)=zero
      xs_table5(0,0,0)=zero

      call file_read(filein,tag)
      fileout='../data/'\/trim(name)\/'.nc'
      fileid = nccreate(fileout,NC_CLOBBER,nc_stat)
      xs_ncdef(fileid)
      call ncendef(fileid,nc_stat)
      xs_ncwrite(fileid)
      var_free(xs_tab1)
      var_free(xs_tab2)
      var_free(xs_tab3)
      var_free(xs_tab4)
      var_free(xs_tab5)
      call ncclose(fileid,nc_stat)

      return
      end

@ Read in the data from the file.

@<Functions...@>=
      subroutine file_read(filename,tag)
      implicit_none
      character*(*) filename,tag // Input
      integer i,j,k             // Local
      character*80 line
      xs_common                 // Common
      
      open(unit=diskin,file=filename,status='old',form='formatted')
      if (tag != ' ')then
loop:    continue
         read(diskin,'(a)') line
         if (line != tag) goto loop
      end if
      read(diskin,*) SP (((xs_table1(i,j,k),i=0,xs_tab_index(1,1)-1),
     $     j=0,xs_tab_index(2,1)-1),
     $     k=0,xs_tab_index(3,1)-1)
      close(unit=diskin)
      return
      end

