@* A program to read a background specification from a degas file.

\ID{$Id$}

@m FILE 'readbackground.web'

@I macros.hweb
@I degas.hweb
@I geomint.hweb
@I readfilenames.hweb
@I sysdep.hweb
@I zone.hweb
@I problem.hweb
@I background.hweb
@I species.hweb
@I element.hweb
@I reaction.hweb
@I sources.hweb
@I string.hweb
@I netcdf.hweb
@I sector.hweb
@I materials.hweb

@ The unnamed module.
@f namelist integer

@a
      @<Functions and Subroutines@>

@ The main program

@<Functions...@>=
      program readbackground
      implicit_none_f77
      implicit_none_f90
      character*FILELEN datafilename

      call command_arg(1,datafilename)

      call process_background(datafilename)

      stop
      end

@ The main subroutine.

@<Functions...@>=
      subroutine process_background(datafilename)
      implicit_none_f77
      zn_common
      pr_common
      bk_common
      gi_common
      implicit_none_f90
      character*FILELEN datafilename,degasfilename,uedgefilename
      logical uedge,degas
      integer i,ii
      @<Memory allocation interface@>

      call readfilenames
      
      degas = .false. ; uedge =.false.

/* find out whether the data file is degas or uedge depending on the extension 
of the file name (x.d is degas and x.u for uedge) */

      do i=1,FILELEN
         if (datafilename(i:i) == '.') then 
            ii =i
            goto 5
         endif
      enddo
      assert(.false.)
 5       if (ii+2 < FILELEN) then
            assert (datafilename(ii+2:ii+2)== ' ')
         endif
         if (datafilename(ii+1:ii+1) == 'd') then
            degasfilename = datafilename
            degas = .true.
         elseif (datafilename(ii+1:ii+1) == 'u') then
            uedgefilename = datafilename
            uedge = .true.
         else
            assert (.false.)
         endif

      call read_geometry
            
      call nc_read_elements
      call nc_read_species
      call nc_read_materials
      call nc_read_reactions
      call nc_read_pmi
      call nc_read_problem
      bk_num=pr_background_num
      var_alloc(background_n)
      var_alloc(background_v)
      var_alloc(background_temp)

      if (degas) then
         call read_degas_background(degasfilename)
      elseif (uedge) then
         call read_uedge_background(uedgefilename)         
      endif

      call add_cramd_data         // So we'll have recomb. rates

      call set_background_sources

      call write_background

      return
      end

@ Set the background data

@<Functions...@>=
      subroutine read_degas_background(file)

      implicit_none_f77
      zn_common
      pr_common
      bk_common
      sp_common
      el_common
      rc_common
      so_common
      gi_common
      sc_common
      implicit_none_f90

      st_decls
      @<Memory allocation interface@>

      integer zone,jh,jv,js,jsp,jwall,jseg,seg // Local
      real xmin,xmax,zmin,zmax,curr_tot
      character*FILELEN file
      logical new_group
      sp_decl(sp_hyd[3])
      sp_decl(degas_species[9])
      sc_decl(sector)
      vc_decl(x1)
      vc_decl(x2)

      external lookup_sector
      integer lookup_sector

      @<pardef.h@>
      @<combal.h@>
      @<comst.h@>
      @<comgeo.h@>
      @<compls.h@>
      @<comflg.h@>
      @<comrfl.h@>
      @<comrat.h@>
      @<comsv.h@>
      @<comstat.h@>
      @<compar.h@>

      open(unit=diskin,file=file,status='old',form='formatted')

      call inpt(diskin,geometry_symmetry,xmin,xmax,zmin,zmax)
      close(unit=diskin)

      sp_hyd[1]=sp_lookup('H')
      sp_hyd[2]=sp_lookup('D')
      sp_hyd[3]=sp_lookup('T')
      nohyds=0                                                       
      do js=1,nphyd
         if (nhyd[js] != 0) nohyds=nohyds+1
      end do
      if (nohyds == 1) then
         degas_species[1]=sp_hyd[nhyd[1]]
         degas_species[2]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[1]])) \/ '2')
      else if (nohyds == 2) then
         degas_species[1]=sp_hyd[nhyd[1]]
         degas_species[2]=sp_hyd[nhyd[2]]
         degas_species[3]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[1]])) \/ '2')
         degas_species[4]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[1]])) \/ 
     $        trim(sp_sy(sp_hyd[nhyd[2]])))
         if (degas_species[4] == 0) then
            degas_species[4]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[2]])) \/ 
     $           trim(sp_sy(sp_hyd[nhyd[1]])))
         end if
         degas_species[5]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[2]])) \/ '2')
      else if (nohyds == 3) then
         degas_species[1]=sp_hyd[nhyd[1]]
         degas_species[2]=sp_hyd[nhyd[2]]
         degas_species[3]=sp_hyd[nhyd[3]]
         degas_species[4]=sp_lookup(sp_sy(sp_hyd[nhyd[1]]) \/ '2')
         degas_species[5]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[1]])) \/ 
     $        trim(sp_sy(sp_hyd[nhyd[2]])))
         if (degas_species[5] == 0) then
            degas_species[5]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[2]])) \/ 
     $           trim(sp_sy(sp_hyd[nhyd[1]])))
         end if
         degas_species[6]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[2]])) \/ '2')
         degas_species[7]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[1]])) \/ 
     $        trim(sp_sy(sp_hyd[nhyd[3]])))
         if (degas_species[7] == 0) then
            degas_species[7]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[3]])) \/ 
     $           trim(sp_sy(sp_hyd[nhyd[1]])))
         end if
         degas_species[8]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[2]])) \/ 
     $        trim(sp_sy(sp_hyd[nhyd[3]])))
         if (degas_species[8] == 0) then
            degas_species[8]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[3]])) \/ 
     $           trim(sp_sy(sp_hyd[nhyd[2]])))
         end if
         degas_species[9]=sp_lookup(trim(sp_sy(sp_hyd[nhyd[3]])) \/ '2')
      end if
      assert(npis <= 9)    // Assume no impurity species !!

      assert(sp_sy(pr_background(1))=='e')
      do zone=1,zn_num
         if (zn_type(zone) == zn_plasma) then
            jh=zn_index(zone,1)
            jv=zn_index(zone,2)
/* Check that both |jh| and |jv| are valid. If not, could set some default */
            assert(jh*jv != 0)       
            bk_n(1,zone)=denehvt[jh,jv,1]
            bk_temp(1,zone)=electron_charge*tehvt[jh,jv,1]
            vc_set(bk_v(1,zone),zero,zero,zero)
            do js=1,nohyds
/* This assumes only singly charged ions. Same assumption made below. */
               jsp=pr_background_lookup(sp_lookup(trim(sp_sy(degas_species[js])) \/ '+'))
               assert(jsp > 1)
               bk_n(jsp,zone)=denihvt[jh,jv,1,js]
               bk_temp(jsp,zone)=electron_charge*tihvt[jh,jv,1,js]
               vc_set(bk_v(jsp,zone),zero,zero,zero)
            end do
         end if
      end do

/* DEGAS only uses cartesian flow velocities */
      background_coords=plasma_coords_cartesian
                                                       
      so_grps=0
      so_seg_tot=0
      do js=1,npis
         do jwall=1,nowals
            new_group=.true.
            curr_tot=zero
            do jseg=1,nosegsxz[jwall]
               curr_tot+=abs(currxzt[jseg,1,jwall,js])
            end do
            if (curr_tot > zero) then
               do jseg=1,nosegsxz[jwall]
                  if (new_group) then
                     so_grps++
                     var_realloca(source_base_ptr)
                     var_realloca(source_num_segments)
                     var_realloca(source_type)
                     var_realloca(source_geometry)
                     var_realloca(source_num_flights)
                     var_realloca(source_species)
                     var_realloca(source_total_current)
                     var_realloca(source_weight_norm)
                     var_realloca(source_scale_factor)
                     so_base(so_grps)=so_seg_tot+1
                     so_nseg(so_grps)=nosegsxz[jwall]
                     so_nflights(so_grps)=100
/* Assume these are same for all segments: 
 */
                     if (currxzt[jseg,1,jwall,js] > zero) then 
                        so_type(so_grps)=so_plate  
                        so_species(so_grps)=
     $                       sp_lookup(trim(sp_sy(degas_species[js])) \/ '+')
                     else                                    
                        so_type(so_grps)=so_puff 
                        so_species(so_grps)=degas_species[js]
                     end if
                     assert(so_species(so_grps) > 0)
                     so_geom(so_grps)=so_surface
                     so_tot_curr(so_grps)=zero
                     so_scale(so_grps)=one       // Default
                     seg=so_seg_tot
                     so_seg_tot+=nosegsxz[jwall]
                     var_reallocc(source_current,seg,so_seg_tot)
                     var_reallocc(source_segment_ptr,seg,so_seg_tot)
                     var_reallocc(source_segment_rel_wt,seg,so_seg_tot)
                     var_reallocc(source_segment_prob_alias,seg,so_seg_tot)
                     var_reallocc(source_segment_ptr_alias,seg,so_seg_tot)
                     new_group=.false.
                  end if

                  if (xwall(jseg,jwall) != xwall(jseg+1,jwall)
     $                 || zwall(jseg,jwall) != zwall(jseg+1,jwall)) then
                     seg++
                     source_current[seg]=abs(currxzt[jseg,1,jwall,js])
                     so_tot_curr(so_grps)+=source_current[seg]
                     source_segment_rel_wt[seg]=one     // Default
                     vc_set(x1,xwall(jseg,jwall),zero,zwall(jseg,jwall))
                     vc_set(x2,xwall(jseg+1,jwall),zero,zwall(jseg+1,jwall))
                     sector=lookup_sector(x1,x2)
                     if (zn_type(sector_zone(sector)) == zn_solid) then
                        sector=lookup_sector(x2,x1)
                     end if
                     if (zn_type(sector_zone(sector)) == zn_vacuum) then
                        assert(so_type(so_grps) == so_puff)
                     else
                        assert(zn_type(sector_zone(sector)) == zn_plasma)
                     end if
                     source_segment_ptr[seg]=sector
                  else
                     so_nseg(so_grps)--
                  end if
               end do
               call set_prob_alias(so_nseg(so_grps),
     $              source_current[so_base(so_grps)],
     $              source_segment_rel_wt[so_base(so_grps)],
     $              source_segment_ptr[so_base(so_grps)],
     $              source_segment_prob_alias[so_base(so_grps)],
     $              source_segment_ptr_alias[so_base(so_grps)],
     $              so_wt_norm(so_grps))

            end if
         end do
      end do

      return
      end

@ read uedge background data 
@<Functions...@>=
      subroutine read_uedge_background(file)

      implicit_none_f77
      zn_common
      pr_common
      bk_common
      sp_common
      el_common
      rc_common
      so_common
      sc_common
      implicit_none_f90
      st_decls
      @<Memory allocation interface@>
      integer mx,my
      parameter (mx=120,my=100)
      integer nu,nx,ny,ixpt1,ixpt2,iysptrx,i,j1,j2,j3,max_rc,test
      real rm[mx,my,0:4],zm[mx,my,0:4],ni[mx,my],vr[mx,my],vz[mx,my],
     $     vphi[mx,my],te[mx,my],ti[mx,my],
     $     flux1[my],flux2[my],dummy
      character*FILELEN file
      vc_decl(x1)
      vc_decl(x2)
      sc_decl(sector)
      
      external lookup_sector
      integer lookup_sector

      
      print *, 'in read_uedge'

      open(unit=diskin,file=file,status='old',form='formatted')
      nu =diskin
/* skip first comment line */
      read(nu,*)
      read(nu,*) nx
      read(nu,*) ny
      assert(nx <= mx && ny <= my)
      read(nu,*) ixpt1
      read(nu,*) ixpt2
      read(nu,*) iysptrx

      read(nu,*) SP (((rm[j1,j2,j3],j1=1,nx),j2=1,ny),j3=0,4)
      read(nu,*) SP (((zm[j1,j2,j3],j1=1,nx),j2=1,ny),j3=0,4)

         /* skip data for br,bz,bphi */

      do i=1,3
         read(nu,*) SP (((dummy,j1=1,nx),j2=1,ny),j3=0,4)
      enddo
      print*,'last  dummy', dummy
      read (nu,*,err= 6)SP ((ni[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP ((vr[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP ((vz[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP ((vphi[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP ((ti[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP ((te[j1,j2],j1=1,nx),j2=1,ny)
      read (nu,*,err= 6)SP (flux1[j2],j2=1,ny)
      read (nu,*,err= 6)SP (flux2[j2],j2=1,ny)

      i=0
      do j1=1,nx
         do j2=1,ny
            i++
            assert(i<=zone_type_num[zn_plasma])
            assert(j1==zn_index(i,1) && j2==zn_index(i,2))
            background_n[1,i]= ni[j1,j2]
            background_n[2,i]= ni[j1,j2]
            background_temp[1,i]= te[j1,j2]
            background_temp[2,i]= ti[j1,j2]
            vc_set(background_v[1,i],vr[j1,j2],vphi[j1,j2],vz[j1,j2])
            vc_copy(background_v[1,i],background_v[2,i])
         enddo
      enddo
      assert(i==zone_type_num[zn_plasma])
      background_coords=plasma_coords_cylindrical
      
      so_grps=2
      so_seg_tot=2*ny
      var_alloc(source_base_ptr)
      var_alloc(source_num_segments)
      var_alloc(source_type)
      var_alloc(source_geometry)
      var_alloc(source_num_flights)
      var_alloc(source_species)
      var_alloc(source_total_current)
      var_alloc(source_weight_norm)
      var_alloc(source_scale_factor)
/*
   Note: using |var_reallocc| here rather than |var_alloc| since
   we use |var_realloca| in |set_background_sources|. This way we
   are allocating memory in |mem_inc| chunks in every case. This
   is the way it's done in |read_degas_background| as well.
*/
      var_reallocc(source_segment_ptr,0,so_seg_tot)
      var_reallocc(source_current,0,so_seg_tot)
      var_reallocc(source_segment_rel_wt,0,so_seg_tot)
      var_reallocc(source_segment_prob_alias,0,so_seg_tot)
      var_reallocc(source_segment_ptr_alias,0,so_seg_tot)

/* Figure what the test species by searching for the
   one which participates in the most reactions. This
   reasoning probably needs to be improved.
 */
/*      max_rc=0
      test=0
      do i=1,pr_test_num
         if (pr_rc_num(i) > max_rc) then
            test = i
            max_rc = pr_rc_num(i)
         end if
      end do
      assert(test > 0)
*/
      do i=1,so_grps
         so_type(i)=so_plate
//         so_species(i)=pr_test(test)
         so_species(i)=sp_lookup('D+')
         so_nseg(i)=ny
         so_nseg(i)=ny
         so_geom(i)=so_surface
         so_tot_curr(i)=zero
         so_scale(i)=one
         so_nflights(i)=100
      end do

      so_base(1)=1
      i=0
      j1=1
      do j2=ny,1,-1
         i++
         source_current[i]=flux1[j2]
         so_tot_curr(1)+=source_current[i]
         source_segment_rel_wt[i]=one
         vc_set(x1,rm[j1,j2,3],zero,zm[j1,j2,3])
         vc_set(x2,rm[j1,j2,1],zero,zm[j1,j2,1])
         sector=lookup_sector(x1,x2)
         if (zn_type(sector_zone(sector)) == zn_solid) then
            sector=lookup_sector(x2,x1)
         end if
         source_segment_ptr[i]=sector
      end do
      call set_prob_alias(so_nseg(1),
     $     source_current[so_base(1)],
     $     source_segment_rel_wt[so_base(1)],
     $     source_segment_ptr[so_base(1)],
     $     source_segment_prob_alias[so_base(1)],
     $     source_segment_ptr_alias[so_base(1)],so_wt_norm(1))

      so_base(2)=ny+1
      j1=nx
      do j2=1,ny
         i++
         source_current[i]=flux2[j2]
         so_tot_curr(2)+=source_current[i]
         source_segment_rel_wt[i]=one
         vc_set(x1,rm[j1,j2,2],zero,zm[j1,j2,2])
         vc_set(x2,rm[j1,j2,4],zero,zm[j1,j2,4])
         sector=lookup_sector(x1,x2)
         if (zn_type(sector_zone(sector)) == zn_solid) then
            sector=lookup_sector(x2,x1)
         end if
         source_segment_ptr[i]=sector
      end do
      call set_prob_alias(so_nseg(2),
     $     source_current[so_base(2)],
     $     source_segment_rel_wt[so_base(2)],
     $     source_segment_ptr[so_base(2)],
     $     source_segment_prob_alias[so_base(2)],
     $     source_segment_ptr_alias[so_base(2)],so_wt_norm(2))

      return
 6    write (stderr,*) 'error occurred in reading uedge data file'
      assert (.false.)
      return
      end


