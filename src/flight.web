@ The main program.

@a
      @<Functions and subroutines@>

@ Follow a bunch of flights.

@<Functions...@>=
      subroutine do_flights(nstart,nflights,so_dummy(isource),seed0,scores,weight,scores1,estimator_factors)
      implicit_none_f77
      zn_common
      pr_common
      tl_common
      implicit_none_f90
      tl_decls
      integer nstart,nflights   // Input
      rn_seed_decl(seed0)
      so_decl(isource)
      @<Memory allocation interface@>
      real scores[0:*][o_mean:o_var],weight // Output
      real scores1[0:*][o_mean:o_var],estimator_factors[0:*]       // Scratch
      integer i,j               // Local 
      rn_seed_decl(seed)
      fl_decl(x)
      real weight1
      
      rn_seed_copy(seed0,seed)

      weight=zero
      do i=0,tally_size-1
         scores[i][o_mean]=zero
         scores[i][o_var]=zero
      end do
      
      do j=nstart,nstart+nflights-1
         fl_label(x,j,isource)
         call follow(fl_args(x),scores1,weight1,seed,estimator_factors)
         call stat_acc(tally_size,weight1,scores1,weight,scores)
         call next_seed(1,seed)
      end do
      
      return
      end
      
@ Follow a single particle.

@<Functions...@>=
      subroutine follow(fl_dummy(x),scores,rel_wt,seed,estimator_factors)
      implicit_none_f77
      bk_common
      sp_common
      zn_common
      pr_common
      so_common
      rc_common
      tl_common
      implicit_none_f90
      pt_decls
      fl_decl(x)
      real rel_wt
      integer i,nprod
      rn_seed_decl(seed)
      real scores(o_mean:o_var,0:*),t,tmax,ionize_rate,rnd,other_rate,
     $     rate[pr_reaction_max],rate_all[pr_reaction_max],sum,t_fac
      real estimator_factors         // Scratch
      logical done

      pt_decl(prod[0:rc_product_max])
      rn_decls
      st_decls
      lc_decls
      tl_decls
      external find_rate
      real find_rate
      

      rn_init(seed,fl_rand(x))  // Initialize random numbers for flight

      do i=0,tally_size-1
         scores[i][o_mean]=zero
         scores[i][o_var]=zero
      end do

      call sample_sources(fl_args(x),rel_wt,scores,estimator_factors)

loop1: continue                 // Start a new 

 /* The computation of the ionization rate and any other rate that
 does not depend on the neutral energy could go here. */

loop: continue                  // Still in same zone

      ionize_rate=zero
      other_rate=zero
      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            rate[i]=find_rate(pt_args(fl_current(x)),pr_background_args(pr_ts_bk(pt_test(fl_current(x)),i)),pr_reaction_args(pr_ts_rc(pt_test(fl_current(x)),i)),rn_args(fl_rand(x)))
            rate_all[i]=rate[i]
            if (rc_reaction_type(pr_reaction(pr_ts_rc(pt_test(fl_current(x)),i)))=='ionize_suppress') then
               ionize_rate=ionize_rate+rate[i]
               rate[i]=zero
            else
               other_rate=other_rate+rate[i]
            end if
         end do
      end if         

      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         tmax=-log(random(rn_args(fl_rand(x))))/other_rate
      else
         tmax=geom_infinity
      end if         

      if (pt_w(fl_current(x)) < const(0.001)) then
         if (random(rn_args(fl_rand(x))) > half) then
            fl_pointer(x)--
            if (fl_pointer(x) <= 0) goto break
            assert(fl_check(x))
            goto loop1
         else
            pt_w(fl_current(x)) = two*pt_w(fl_current(x))
         end if
      end if

      done=pt_track(tmax,t,fl_current(x))

      if (ionize_rate > epsilon) then
         t_fac=(one-exp(-ionize_rate*t))/ionize_rate
      else
         t_fac=t
      end if   
         
      call score_test(tl_est_track,t_fac,pt_args(fl_current(x)),scores,estimator_factors)

      pt_copy(fl_current(x),prod[0])
      do i=1,pr_rc_num(pt_test(fl_current(x)))
         call score_reaction(tl_est_track,t_fac,
     $        pr_reaction_args(i),rate_all[i],
     $        nprod,pt_args(prod[0]),scores,estimator_factors,
     $        rn_args(fl_rand(x)))
         assert(nprod == 0)
      end do

      pt_w(fl_current(x))=exp(-ionize_rate*t)*pt_w(fl_current(x))
      
      if (done) then            // Have a collision
         assert(zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma)

         rn_next(rnd,fl_rand(x))
         rnd=rnd*other_rate
         sum=zero
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            sum=sum+rate[i]
            if (sum >= rnd) then
               assert(rate[i] > zero)
  //             call score_test(tl_est_collision,one/rate[i],
               call score_test(tl_est_collision,one/other_rate,
     $              pt_args(fl_current(x)),
     $              scores,estimator_factors)

               pt_copy(fl_current(x),prod[0])
               call score_reaction(tl_est_collision,  // {\em And process!}
     $              one/rate[i],pr_reaction_args(i),rate[i],
     $              nprod,pt_args(prod[0]),scores,estimator_factors,
     $              rn_args(fl_rand(x)))
               goto break1
            end if
         end do
         assert(.false.)
break1:  continue
         fl_pointer(x)--
         if (nprod > 0) then
            do i=1,nprod
               if (pt_test(prod[i]) > 0) then
                  fl_pointer(x)++
                  pt_copy(prod[i],fl_current(x))
               end if
            end do
         end if
         if (fl_pointer(x) <= 0) goto break
         assert(fl_check(x))

         goto loop
      else               

/* 
   Go to next zone or process a sector.
   Universal cell crossings should have been handled by a transformation or
   an explicit exit. 
*/
         if (lc_cell_next(pt_loc(fl_current(x))) == 0) then
            assert("Leaving universal cell" == " ")
         else if (lc_sector(pt_loc(fl_current(x))) != 0 
     $           || lc_sector_next(pt_loc(fl_current(x))) != 0) then
            call score_sector(fl_args(x),scores,estimator_factors)
            if (fl_pointer(x) <= 0) goto break
            assert(fl_check(x))
         else
            pt_thru_face(fl_current(x))
         end if
         goto loop1
      end if

break: continue     // End of flight!

      return
      end

@ Carry out sector-related tasks. Principally, this includes processing
plasma-material interactions and scoring at ``diagnostic'' surfaces.

@<Functions...@>=
      subroutine score_sector(fl_dummy(x),scores,estimator_factors)

      implicit_none_f77
      sc_common                                        // Common
      implicit_none_f90

      fl_decl(x)                                       // Input / Output
      real scores[0:*][o_mean:o_var]
      real estimator_factors[0:*]                      // Scratch

      integer type,type_ptr_1,type_ptr_2,type_ptr       // Local
      real mat_temp
      sc_decl(sector1)
      sc_decl(sector2)
      ma_decl(mat_ref)
      

      sector1=lc_sector(pt_loc(fl_current(x)))
      sector2=lc_sector_next(pt_loc(fl_current(x)))

      call score_diagnostics(pt_args(fl_current(x)),scores,estimator_factors) // Do diagnostic types

      do type=1,sc_diagnostic(0)            // Loop over non-diagnostic types
         type_ptr_1=sector_type_pointer[sector1][type]
         type_ptr_2=sector_type_pointer[sector2][type]
         if (type_ptr_1 != 0) then
            assert(type_ptr_2 == 0)
            type_ptr=type_ptr_1
         else if (type_ptr_2 != 0) then
            assert(type_ptr_1 == 0)
            type_ptr=type_ptr_2
         else
            type_ptr=0
         end if

         if (type_ptr != 0) then
            if (type == sc_exit) then
               fl_pointer(x)--          // Need to add corresponding PMI
            else if (type == sc_wall) then
               mat_ref=wall_material[type_ptr]
               mat_temp=wall_temperature[type_ptr]
               call process_pmi(fl_args(x),mat_ref,mat_temp)
            else if (type == sc_target) then
               mat_ref=target_material[type_ptr]
               mat_temp=target_temperature[type_ptr]
               call process_pmi(fl_args(x),mat_ref,mat_temp)
            end if
         end if
      end do

      return
      end

@ Select and execute a plasma-material interaction.

@<Functions...@>=
      subroutine process_pmi(fl_dummy(x),mat_ref,mat_temp)

      implicit_none_f77
      pr_common
      sp_common
      pm_common
      implicit_none_f90

      fl_decl(x)                         // Input
      ma_decl(mat_ref)
      real mat_temp

      integer i,nprod                    // Local
      real yield[pr_pmi_max],independent_parameters[pf_max_indep_params]
      real cos_angle,sum,rnd

      pr_pmi_decl(ts_pmi)
      pr_pmi_decl(default_pmi)
      pt_decl(prod[pm_product_max])
      

      external find_yield,intersection_direction
      real find_yield,intersection_direction

      assert(mat_ref != 0)
               
      do i=1,pf_max_indep_params
         independent_parameters[i]=zero
      end do
      
      independent_parameters[pf_var_energy_in]=
     $     half*sp_m(pr_test(pt_test(fl_current(x))))
     $     *vc_abs2(pt_v(fl_current(x)))
      independent_parameters[pf_var_vel_1_in]=pt_v(fl_current(x))[1]
      independent_parameters[pf_var_vel_2_in]=pt_v(fl_current(x))[2]
      independent_parameters[pf_var_vel_3_in]=pt_v(fl_current(x))[3]
      cos_angle=intersection_direction(lc_face(pt_loc(fl_current(x))),
     $     lc_x(pt_loc(fl_current(x)))[1],pt_v(fl_current(x))[1])
      independent_parameters[pf_var_polar_angle_in]=acos(cos_angle)
      independent_parameters[pf_var_t_wall]=mat_temp
               
      sum=zero
      default_pmi=0
      assert(pr_pm_case_num(pt_test(fl_current(x))) > 0)
      do ts_pmi=1,pr_pm_case_num(pt_test(fl_current(x)))
         if (pm_materials(pr_pm_ref(pr_pm_cases(pt_test(fl_current(x)),ts_pmi))) == mat_ref) then
            yield[ts_pmi]=find_yield(pt_args(fl_current(x)),
     $           pr_pmi_args(ts_pmi),independent_parameters,
     $           rn_args(fl_rand(x)))
            if (yield[ts_pmi] < zero) then
               default_pmi=ts_pmi
               yield[ts_pmi]=zero
            end if
         else
            yield[ts_pmi]=zero
         end if
         sum=sum+yield[ts_pmi]
      end do

/* Factor in adsorption as probability[i+1]=one-sum? !!! */
      if (pr_pm_case_num(pt_test(fl_current(x))) > 1) then 
         rn_next(rnd,x)
      else            
         rnd=zero     
      end if          
      rnd=rnd*max(sum,one)      // region from sum to ``one'' is default
      sum=zero
      do i=1,pr_pm_case_num(pt_test(fl_current(x)))
         sum=sum+yield[i]
         if (sum >= rnd) then
            ts_pmi=i
            goto break1
         end if
      end do
      ts_pmi=default_pmi
break1:     continue
      assert(ts_pmi > 0)
      call pick_pmi(pt_args(fl_current(x)),pr_pmi_args(ts_pmi),
     $     independent_parameters,
     $     nprod,pt_args(prod[1]),rn_args(fl_rand(x)))
      fl_pointer(x)--
      do i=1,nprod
         if (pt_test(prod[i]) > 0) then
            fl_pointer(x)++
            pt_copy(prod[i],fl_current(x))
         end if
      end do

      return
      end

