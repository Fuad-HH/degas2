@ The main program.

@a
      @<Functions and subroutines@>

@ Follow a bunch of flights.

@<Functions...@>=
      subroutine do_flights(nstart,nflights,so_dummy(isource),seed0,stat,weight,stat1)
      implicit_none
      integer nstart,nflights,seed0[0:1] // Input
      so_decl(isource)
      zn_common
      sy_common
      pr_common
      real stat(2,zn_num,2*(pr_test_num-1)),weight // Output
      real stat1(2,zn_num,2*(pr_test_num-1))      // Scratch
      integer seed[0:1],i,j,k,sp_dim     // Local
      real weight1
      
      seed[0]=seed0[0]
      seed[1]=seed0[1]

      sp_dim=2*(pr_test_num-1)
      weight=zero
      do i=1,sp_dim
         do j=1,zn_num
            do k=1,2
               stat[i][j][k]=zero
            end do
         end do
      end do
      
      do j=nstart,nstart+nflights-1
         call follow(j,so_args(isource),stat1,weight1,seed)
//         call stat_add(zn_num,one,stat1,weight,stat,weight,stat)
         call stat_add(zn_num,sp_dim,weight1,stat1,weight,stat,weight,stat)
         call next_seed(1,seed,seed)
      end do
      
      return
      end
      
@ Follow a single particle.

@<Functions...@>=
      subroutine follow(num,so_dummy(isource),stat,rel_wt,seed)
      implicit_none
      zn_common
      pr_common
      so_decl(isource)
      real rel_wt
      integer seed[0:1],num,i,j,nprod
      real stat[2,zn_num,2*(pr_test_num-1)],t,tmax,ionize_rate,rnd,other_rate,
     $     rate[pr_reaction_max],albedo,sum,energy,t_fac
      logical done

      fl_decl(x)
      pt_decl(prod[rc_product_max])
      rn_common
      bk_common
      sp_common
      st_common
      pt_common
      lc_common
      rc_common
      external reaction_rate
      real reaction_rate
      
      albedo=one             // SHOULD BE REMOVED!!!
//      albedo=const(0.95)  
      rn_init(seed,fl_rand(x))  // Initialize random numbers for flight
//      pt_init(x,'0')            // Initialize geometry locator

      call sample_sources(num,so_args(isource),fl_args(x),rel_wt)

      do i=1,2*(pr_test_num-1)
         do j=1,zn_num
            stat[i][j][1]=zero
            stat[i][j][2]=zero
         end do
      end do


loop1: continue                 // Start a new 

 /* The computation of the ionization rate and any other rate that
 does not depend on the neutral energy could go here. */

loop: continue                  // Still in same zone

      ionize_rate=zero
      other_rate=zero
      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            rate[i]=reaction_rate(pt_args(fl_current(x)),pr_reaction_args(i))
            if (rc_reaction_type(pr_reaction(pr_ts_rc(pt_test(fl_current(x)),i)))=='ionize_suppress') then
               ionize_rate=ionize_rate+rate[i]
               rate[i]=zero
            else
               other_rate=other_rate+rate[i]
            end if
         end do
      end if         

      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         tmax=-log(random(rn_args(fl_rand(x))))/other_rate
      else
         tmax=geom_infinity
      end if         

      if (pt_w(fl_current(x)) < const(0.001)) then
         if (random(rn_args(fl_rand(x))) > half) then
            fl_pointer(x)--
            if (fl_pointer(x) <= 0) goto break
            assert(fl_check(x))
            goto loop1
         else
            pt_w(fl_current(x)) = two*pt_w(fl_current(x))
         end if
      end if

      done=pt_track(tmax,t,fl_current(x))

@#if 0
      stat[1,lc_zone(pt_loc(fl_current(x)))]=
     $     stat[1,lc_zone(pt_loc(fl_current(x)))]+
     $     ionize_rate*t*pt_w(fl_current(x))
@#else
      if (ionize_rate > epsilon) then
         t_fac=(one-exp(-ionize_rate*t))/ionize_rate
      else
         t_fac=t
      end if   
         
      stat[1,lc_zone(pt_loc(fl_current(x))),2*pt_test(fl_current(x))-3]=
     $stat[1,lc_zone(pt_loc(fl_current(x))),2*pt_test(fl_current(x))-3]+
     $     t_fac*pt_w(fl_current(x))
      energy=(half*sp_m(pr_test(pt_test(fl_current(x))))
     $         *vc_abs2(pt_v(fl_current(x))))*(two/const(3.0))
      stat[1,lc_zone(pt_loc(fl_current(x))),2*pt_test(fl_current(x))-2]=
     $     stat[1,lc_zone(pt_loc(fl_current(x))),2*pt_test(fl_current(x))-2]+
     $     energy*t_fac*pt_w(fl_current(x))    // pressure in Pascals
@#endif
      pt_w(fl_current(x))=exp(-ionize_rate*t)*pt_w(fl_current(x))
      
      if (done) then            // Process a charge exchange
         assert(zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma)
@#if 1
         rn_next(rnd,fl_rand(x))
         rnd=rnd*other_rate
         sum=zero
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            sum=sum+rate[i]
            if (sum >= rnd) then
               call process_reaction(pt_args(fl_current(x)),pr_reaction_args(i),
     $              nprod,pt_args(prod[1]),
     $              rn_args(fl_rand(x)))
               goto break1
            end if
         end do
         assert(.false.)
break1:  continue
         fl_pointer(x)--
         do i=1,nprod
            if (pt_test(prod[i]) > 0) then
               fl_pointer(x)++
               pt_copy(prod[i],fl_current(x))
            end if
         end do
         if (fl_pointer(x) <= 0) goto break
         assert(fl_check(x))
@#else
         wa=sqrt(bk_temp(2,lc_zone(pt_loc(fl_current(x))))/sp_m(pt_sp(fl_current(x))))
         do i=1,3
            rn_gauss_next(rnd,fl_rand(x))
            pt_v(fl_current(x))[i]=wa*rnd
         end do
@#endif

         goto loop
      else                      // Go to next zone or reflect
@#if 1                          // Proposed revision for treating sectors here
         if (lc_cell_next(pt_loc(fl_current(x))) == 0) then

/* Universal cell crossings should have been handled by a transformation or
   an explicit exit. So, indicate an error here now? */
            assert("Leaving universal cell" == " ")
         else if (lc_sector(pt_loc(fl_current(x))) != 0 
     $           || lc_sector_next(pt_loc(fl_current(x))) != 0) then
            call process_sector(fl_args(x))
            if (fl_pointer(x) <= 0) goto break
            assert(fl_check(x))
            pt_w(fl_current(x))=albedo*pt_w(fl_current(x))  // TEST!!!!
         else
            pt_thru_face(fl_current(x))
         end if
         goto loop1
@#else
         if (lc_cell_next(pt_loc(fl_current(x))) == 0 ||
     $        zn_type(lc_zone_next(pt_loc(fl_current(x)))) == zn_exit) then
            fl_pointer(x)--
            if (fl_pointer(x) <= 0) goto break
         else if (zn_type(lc_zone_next(pt_loc(fl_current(x)))) == zn_solid) then
            assert(lc_check(pt_loc(fl_current(x))))
            pt_specular(fl_current(x))
            pt_w(fl_current(x))=albedo*pt_w(fl_current(x))
         else
            pt_thru_face(fl_current(x))
         end if
         goto loop1
@#endif
      end if
break: continue

      return
      end
@#if 1        // Temporary location for this routine?
      subroutine process_sector(fl_dummy(x))

      implicit_none

      fl_decl(x)

      integer i,nprod
      real yield[pr_pmi_max],independent_parameters[pf_max_indep_params]
      real cos_angle,sum,rnd

      sc_decl(sector1)
      sc_decl(sector2)
      sr_decl(stratum)
      ma_decl(mat_ref)
      pr_pmi_decl(ts_pmi)
      pr_pmi_decl(default_pmi)
      pt_decl(prod[pm_product_max])
      
      sc_common
      sr_common
      pr_common
      sp_common
      pm_common

      external find_yield,intersection_direction
      real find_yield,intersection_direction

      sector1=lc_sector(pt_loc(fl_current(x)))
      sector2=lc_sector_next(pt_loc(fl_current(x)))

      if (sector1 != 0) then
         stratum=strata[sector1]
         if (sr_type(stratum) == sr_exit) then
            assert(sector2 != 0 && stratum == strata[sector2])
            fl_pointer(x)--                     // What we had before,
 //           handle_exit(pt_args(fl_current(x)))  Can do better!!!
         else if (sr_type(stratum) == sr_wall 
     $           || sr_type(stratum) == sr_target) then
            assert(sector2 != 0 && stratum == strata[sector2])

/* Explicitly included |sector1| in the argument list with the idea that we
   we use it to obtain the zone information we will need for $T_{e}$, etc.
   But, clearly, we could just as easily have gotten this from |pt_loc(fl_current(x))|,
   right? If so, do we really need two sectors / default stratum? */
// Implement 3Te for now!!       if (sr_type(stratum) == sr_target) cross_sheath(pt_args(fl_current(x)),sector1)  <--Should neutralize ions, do nothing to neutrals.
            mat_ref=sc_solid_mat(sector_solid[sector2])
            do i=1,pf_max_indep_params
               independent_parameters[i]=zero
            end do
            independent_parameters[pf_var_energy_in]=
     $           half*sp_m(pr_test(pt_test(fl_current(x))))
     $           *vc_abs2(pt_v(fl_current(x)))
            independent_parameters[pf_var_vel_1_in]=pt_v(fl_current(x))[1]
            independent_parameters[pf_var_vel_2_in]=pt_v(fl_current(x))[2]
            independent_parameters[pf_var_vel_3_in]=pt_v(fl_current(x))[3]
            cos_angle=intersection_direction(lc_face(pt_loc(fl_current(x))),
     $           lc_x(pt_loc(fl_current(x)))[1],pt_v(fl_current(x))[1])
            independent_parameters[pf_var_polar_angle_in]=acos(cos_angle)
            independent_parameters[pf_var_t_wall]=
     $           sc_solid_temp(sector_solid[sector2])

            sum=zero
            default_pmi=0
            assert(pr_pm_case_num(pt_test(fl_current(x))) > 0)
            do ts_pmi=1,pr_pm_case_num(pt_test(fl_current(x)))
               if (pm_materials(pr_pm_ref(pr_pm_cases(pt_test(fl_current(x)),ts_pmi))) == mat_ref) then
                  yield[ts_pmi]=find_yield(pt_args(fl_current(x)),
     $                 pr_pmi_args(ts_pmi),independent_parameters,
     $                 rn_args(fl_rand(x)))
                  if (yield[ts_pmi] < zero) then
                     default_pmi=ts_pmi
                     yield[ts_pmi]=zero
                  end if
               else
                  yield[ts_pmi]=zero
               end if
               sum=sum+yield[ts_pmi]
            end do

/* Factor in adsorption as probability[i+1]=one-sum? !!! */
            if (pr_pm_case_num(pt_test(fl_current(x))) > 1) then     // TEST!!!
               rn_next(rnd,x)
            else                // TEST!!!
               rnd=zero         // TEST!!!
            end if              // TEST!!!
            rnd=rnd*max(sum,one)      // region from sum to ``one'' is default
            sum=zero
            do i=1,pr_pm_case_num(pt_test(fl_current(x)))
               sum=sum+yield[i]
               if (sum >= rnd) then
                  ts_pmi=i
                  goto break1
               end if
            end do
            ts_pmi=default_pmi
break1:     continue
            assert(ts_pmi > 0)
            call process_pmi(pt_args(fl_current(x)),pr_pmi_args(ts_pmi),
     $                       independent_parameters,
     $                       nprod,pt_args(prod[1]),rn_args(fl_rand(x)))
            fl_pointer(x)--
            do i=1,nprod
               if (pt_test(prod[i]) > 0) then
         //         pt_thru_face(prod[j]) Have to do this somewhere; here? WHY?
                  fl_pointer(x)++
                  pt_copy(prod[i],fl_current(x))
               end if
            end do
         else if (sr_type(stratum) == sr_diagnostic) then
            assert("No diagnostic stratum routines yet" == 0)
         else 
            assert("Undefined stratum" == 0)
         end if
      else if (sector2 != 0) then
         stratum=strata[sector2]
         if (sr_type(stratum) == sr_diagnostic) then
            assert("No diagnostic stratum routines yet" == 0)
         else
            assert("Unhandled sector" == 0)
         end if
      end if

      return
      end
@#endif

