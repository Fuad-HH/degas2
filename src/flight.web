@n/

@* Routines to follow flights.

\ID{$Id$}

@m FILE 'flight.web'

@m MANDREKAS 0


@I macros.hweb

@ The main program.

@a
      @<Functions and subroutines@>

@ Follow a bunch of flights.

@<Functions...@>=
      subroutine do_flights(nstart,nflights,seed0,stat,weight,stat1)
      implicit_none
      integer nstart,nflights,seed0[0:1] // Input
      zn_common
      sy_common
      real stat(2,zn_num),weight // Output
      real stat1(2,zn_num)      // Stratch
      integer seed[0:1],i,j     // Local
      
      seed[0]=seed0[0]
      seed[1]=seed0[1]

      weight=zero
      do i=1,zn_num
         do j=1,2
            stat[j,i]=zero
         end do
      end do
      
      do j=nstart,nstart+nflights-1
         call follow(j,stat1,seed)
         call stat_add(zn_num,one,stat1,weight,stat,weight,stat)
         call next_seed(1,seed,seed)
      end do
      
      return
      end
      
@ Follow a single particle.

@<Functions...@>=
      subroutine follow(num,stat,seed)
      implicit_none
      zn_common
      integer seed[0:1],num,i,j,nprod
      real stat[2,zn_num],w[3],r,phi,wa,t,tmax,ionize_rate,rnd,other_rate,
     $     rate[pr_reaction_max],albedo,sum
      logical done

      pt_decl(x)
      fl_decl(x)
      pt_decl(prod[rc_product_max])
      rn_common
      bk_common
      sp_common
      st_common
      pt_common
      pr_common
      lc_common
      rc_common
      external reaction_rate
      real reaction_rate
      
      albedo=const(0.95)
      rn_init(seed,fl_rand(x))  // Initialize random numbers for flight
      pt_init(x,'0')            // Initialize geometry locator
@#if 0
      rn_next(rnd,fl_rand(x))
      r=2.2+0.2*rnd
      r=const(0.01)*((169-170*half)+44+13*rnd)
      rn_next(rnd,fl_rand(x))
      phi=2*PI*rnd
      vc_set(lc_x(pt_loc(x)),r*cos(phi),r*sin(phi),const(0.2))
      lc_set(pt_loc(x))
      vc_set(pt_v(x),zero,zero,one)

loop2: continue                 // Track to plasma
      pt_thru_face(x)
      done=pt_track(geom_infinity,t,x)
      assert(!done)
      assert( lc_cell(pt_loc(x)) != 0 )
      if (zn_type(lc_zone_next(pt_loc(x))) != zn_plasma) goto loop2

      rn_cos_next(w,fl_rand(x))
      pt_scatter_thru(x,w)
@#else
      rn_iso_next(pt_v(x),fl_rand(x))
      call sample_sources(rn_args(fl_rand(x)),lc_args(pt_loc(x)))
@#endif

      do j=1,zn_num
         stat[1,j]=zero
         stat[2,j]=zero
      end do

      lc_copy(pt_loc(x),pt_loc(fl_origin(x))) // Copy location

      rn_gauss_next(rnd,fl_rand(x)) // Copy and scale velocity
      wa=abs(rnd)*sqrt(electron_charge*const(0.03)/atomic_mass_unit)

      vc_scale(wa,pt_v(x),pt_v(fl_origin(x)))

      fl_init(x,num,sp_sy(pr_test(2)))

loop1: continue                 // Start a new 

 /* The computation of the ionization rate and any other rate that
 does not depend on the neutral energy could go here. */

loop: continue                  // Still in same zone

      ionize_rate=zero
      other_rate=zero
      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            rate[i]=reaction_rate(pt_args(fl_current(x)),
     $           pr_ts_rc(pt_test(fl_current(x)),i),
     $           pr_ts_tg(pt_test(fl_current(x)),i))
            if (rc_reaction_type(pr_ts_rc(pt_test(fl_current(x)),i))=='ionize') then
               ionize_rate=ionize_rate+rate[i]
               rate[i]=zero
            else
               other_rate=other_rate+rate[i]
            end if
         end do
      end if         

      if (zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma) then
         tmax=-log(random(rn_args(fl_rand(x))))/other_rate
      else
         tmax=geom_infinity
      end if         

      if (pt_w(fl_current(x)) < const(0.001)) then
         if (random(rn_args(fl_rand(x))) > half) then
            fl_pointer(x)--
            if (fl_pointer(x) <= 0) goto break
         else
            pt_w(fl_current(x)) = two*pt_w(fl_current(x))
         end if
      end if

      done=pt_track(tmax,t,fl_current(x))

@#if 0
      stat[1,lc_zone(pt_loc(fl_current(x)))]=
     $     stat[1,lc_zone(pt_loc(fl_current(x)))]+
     $     ionize_rate*t*pt_w(fl_current(x))
@#else
      stat[1,lc_zone(pt_loc(fl_current(x)))]=
     $     stat[1,lc_zone(pt_loc(fl_current(x)))]+
     $     t*pt_w(fl_current(x))
@#endif
      pt_w(fl_current(x))=exp(-ionize_rate*t)*pt_w(fl_current(x))
      
      if (done) then            // Process a charge exchange
         assert(zn_type(lc_zone(pt_loc(fl_current(x)))) == zn_plasma)
@#if 1
         rn_next(rnd,fl_rand(x))
         rnd=rnd*other_rate
         sum=zero
         do i=1,pr_rc_num(pt_test(fl_current(x)))
            sum=sum+rate[i]
            if (sum >= rnd) then
               call process_reaction(pt_args(fl_current(x)),
     $              pr_ts_rc(pt_test(fl_current(x)),i),
     $              pr_ts_tg(pt_test(fl_current(x)),i),
     $              nprod,pt_args(prod[1]),
     $              rn_args(fl_rand(x)))
               goto break1
            end if
         end do
         assert(.false.)
break1:  continue
         fl_pointer(x)--
         j=0
         do i=1,nprod
            if (pt_test(prod[i]) > 0) then
               j++
               fl_pointer(x)++
               pt_copy(prod[j],fl_current(x))
            end if
         end do
@#else
         wa=sqrt(bk_temp(2,lc_zone(pt_loc(fl_current(x))))/sp_m(pt_sp(fl_current(x))))
         do i=1,3
            rn_gauss_next(rnd,fl_rand(x))
            pt_v(fl_current(x))[i]=wa*rnd
         end do
@#endif

         goto loop
      else                      // Go to next zone or reflect
         if (lc_cell_next(pt_loc(fl_current(x))) == 0 ||
     $        zn_type(lc_zone_next(pt_loc(fl_current(x)))) == zn_exit) then
            fl_pointer(x)--
            if (fl_pointer(x) <= 0) goto break
         else if (zn_type(lc_zone_next(pt_loc(fl_current(x)))) == zn_solid) then
            assert(lc_check(pt_loc(fl_current(x))))
            pt_specular(fl_current(x))
            pt_w(fl_current(x))=albedo*pt_w(fl_current(x))
         else
            pt_thru_face(fl_current(x))
         end if
         goto loop1
      end if
break: continue

      return
      end

