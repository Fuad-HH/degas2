\ID{$Id$}

@#if defined(CRAY)
    @m CRAY 1
    @m SUN 0
    @m IBM 0
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(SUN)
    @m CRAY 0
    @m SUN 1
    @m IBM 0
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(IBM)
    @m CRAY 0
    @m SUN 0
    @m IBM 1
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(HP)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m HP 1
    @m SGI 0
    @m VAX 0
@#elif defined(SGI)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m HP 0
    @m SGI 1
    @m VAX 0
@#elif defined(VAX)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m HP 0
    @m SGI 0
    @m VAX 1
@#endif

@ Define precision.

@f single_precision real
@f short_integer integer

@#if CRAY                       // Use single precision on the Cray
  @m real     REAL
  @m areal    REAL
  @m const(x,...) x@&_IFCASE(#0,e0,e###1)
  @m epsilon  1.0e-16
  @m single_precision REAL
  @m single   REAL
@#else
  @m real     DOUBLE PRECISION  // Default precision
  @m areal    DBLE              // Coerce to default precision
  @m const(x,...) x@&_IFCASE(#0,d0,d###1) // Constant in default precision
  @m epsilon  1.0d-16           // Approximate round-off error
  @m single_precision REAL      // Declare single precision
  @m single   REAL              // Coerce to single precision
@#endif

@ The sizes of integers and characters in terms of reals.

@#if CRAY
  @m int_mem(n) n
@#else
  @m int_mem(n) ((n)+1)/2
@#endif

@m char_mem(n) ((n)+7)/8

@ The Sun uses |implicit undefined(a-z)| instead of |implicit none|.
(Actually it accepts |implicit none| now.)

@f pointer integer
@f implicit_none implicit
@m implicit_none implicit none @;


@ Declarations for system dependent routines.

@f sy_common integer
@m sy_common
      external get_env,wall_time,cpu_time,get_pid,arg_count,mem_alloc,mem_realloc,set_cwd;
      logical get_env,set_cwd;
      integer wall_time,get_pid,arg_count,mem_alloc,mem_realloc;
      real cpu_time @;
