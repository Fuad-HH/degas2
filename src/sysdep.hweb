@* Macros for machine dependencies.
% $Id$
% $Log$
% Revision 1.6  1995/07/19 20:12:14  dstotler
% Raised value of epsilon to 1.e-15 since roundoff is a few times
% 1.e-16.
%
% Revision 1.5  1995/07/14 13:46:16  karney
% Minor mods to run on 64-bit SGI machine at NERSC.
%
% Revision 1.4  1995/05/26 04:02:00  karney
% Upgrade to fweb 1.51beta.
% Initial implementation of surface segments.
%
% Revision 1.3  1994/01/03 19:30:57  karney
% Update to include ALPHA support
%
% Revision 1.2  1993/10/26  22:22:20  karney
% Add set_cwd.
%
% Revision 1.1  1993/09/23  12:17:11  karney
% Checkin under RCS
%

\ID{$Id$}

@#if defined(CRAY)
    @m CRAY 1
    @m SUN 0
    @m IBM 0
    @m ALPHA 0
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(SUN)
    @m CRAY 0
    @m SUN 1
    @m IBM 0
    @m ALPHA 0
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(IBM)
    @m CRAY 0
    @m SUN 0
    @m IBM 1
    @m ALPHA 0
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(ALPHA)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m ALPHA 1
    @m HP 0
    @m SGI 0
    @m VAX 0
@#elif defined(HP)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m ALPHA 0
    @m HP 1
    @m SGI 0
    @m VAX 0
@#elif defined(SGI)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m ALPHA 0
    @m HP 0
    @m SGI 1
    @m VAX 0
@#elif defined(VAX)
    @m CRAY 0
    @m SUN 0
    @m IBM 0
    @m ALPHA 0
    @m HP 0
    @m SGI 0
    @m VAX 1
@#endif

@ Define precision.

@f single_precision real
@f address integer

                       // Use single precision on the Cray
@#if CRAY
  @m real     REAL
  @m areal    REAL
  @m const(x,...) x@&$IFCASE(#0,e0,e###1)
  @m epsilon  1.0e-15
  @m single_precision REAL
  @m single   REAL
@#else
  @m real     DOUBLE PRECISION  // Default precision
  @m areal    DBLE              // Coerce to default precision
  @m const(x,...) x@&$IFCASE(#0,d0,d###1) // Constant in default precision
  @m epsilon  1.0d-15           // Approximate round-off error
  @m single_precision REAL      // Declare single precision
  @m single   REAL              // Coerce to single precision
@#endif

                      // Pointers are 64-bits on Alphas
@#if ALPHA
  @m address INTEGER*8
@#elif SGI
  @m address INTEGER*8
@#else
  @m address INTEGER
@#endif 

@ Fortran 77 vs. 90.

@#if defined(FORTRAN90)
    @m FORTRAN90 1
    @m FORTRAN77 0
    @m ASSIGN $UNQUOTE('=>')
@#else
    @m FORTRAN77 1
    @m FORTRAN90 0
@#endif

@ The sizes of integers and characters in terms of reals.

@#if CRAY
  @m int_mem(n) n
@#else
  @m int_mem(n) ((n)+1)/2
@#endif

@m char_mem(n) ((n)+7)/8

@ The Sun uses |implicit undefined(a-z)| instead of |implicit none|.
(Actually it accepts |implicit none| now.)

@f pointer integer
@f implicit_none_f77 implicit
@f implicit_none_f90 implicit
@#if FORTRAN77
@m implicit_none_f77 implicit none @;
@m implicit_none_f90
@#else
@m implicit_none_f77
@m implicit_none_f90 implicit none @;
@#endif

@ Declarations for system dependent routines.

@f sy_decls integer
@m sy_decls
      external get_env,wall_time,cpu_time,get_pid,arg_count,set_cwd;
      logical get_env,set_cwd;
      integer wall_time,get_pid,arg_count;
      real cpu_time;

@ Interface for memory allocation.

@<Memory allocation interface@>=
@#if FORTRAN77
      external mem_alloc, mem_realloc, mem_free;
      address mem_alloc, mem_realloc @;
@#else
      interface

         function mem_alloc_c1(size,l1,u1) result(p)
         integer, intent(in) :: size,l1,u1
         character(len=size), dimension(:), pointer :: p
         end function

         function mem_alloc_c2(size,l1,u1,l2,u2) result(p)
         integer, intent(in) :: size,l1,u1,l2,u2
         character(len=size), dimension(:,:), pointer :: p
         end function

         function mem_alloc_c3(size,l1,u1,l2,u2,l3,u3) result(p)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3
         character(len=size), dimension(:,:,:), pointer :: p
         end function

         function mem_alloc_c4(size,l1,u1,l2,u2,l3,u3,l4,u4) result(p)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3,l4,u4
         character(len=size), dimension(:,:,:,:), pointer :: p
         end function

         function mem_alloc_i1(l1,u1) result(p)
         integer, intent(in) :: l1,u1
         integer, dimension(:), pointer :: p
         end function

         function mem_alloc_i2(l1,u1,l2,u2) result(p)
         integer, intent(in) :: l1,u1,l2,u2
         integer, dimension(:,:), pointer :: p
         end function

         function mem_alloc_i3(l1,u1,l2,u2,l3,u3) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3
         integer, dimension(:,:,:), pointer :: p
         end function

         function mem_alloc_i4(l1,u1,l2,u2,l3,u3,l4,u4) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4
         integer, dimension(:,:,:,:), pointer :: p
         end function

         function mem_alloc_i5(l1,u1,l2,u2,l3,u3,l4,u4,l5,u5) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5
         integer, dimension(:,:,:,:,:), pointer :: p
         end function

         function mem_alloc_r1(l1,u1) result(p)
         integer, intent(in) :: l1,u1
         real, dimension(:), pointer :: p
         end function

         function mem_alloc_r2(l1,u1,l2,u2) result(p)
         integer, intent(in) :: l1,u1,l2,u2
         real, dimension(:,:), pointer :: p
         end function

         function mem_alloc_r3(l1,u1,l2,u2,l3,u3) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3
         real, dimension(:,:,:), pointer :: p
         end function

         function mem_alloc_r4(l1,u1,l2,u2,l3,u3,l4,u4) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4
         real, dimension(:,:,:,:,:), pointer :: p
         end function

         function mem_alloc_r5(l1,u1,l2,u2,l3,u3,l4,u4,l5,u5) result(p)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5
         real, dimension(:,:,:,:,:), pointer :: p
         end function

         function mem_realloc_c1(p,size,l1,u1,nu) result(np)
         integer, intent(in) :: size,l1,u1,nu
         character(len=size), dimension(:), pointer :: p,np
         end function

         function mem_realloc_c2(p,size,l1,u1,l2,u2,nu) result(np)
         integer, intent(in) :: size,l1,u1,l2,u2,nu
         character(len=size), dimension(:,:), pointer :: p,np
         end function

         function mem_realloc_c3(p,size,l1,u1,l2,u2,l3,u3,nu) result(np)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3,nu
         character(len=size), dimension(:,:,:), pointer :: p,np
         end function

         function mem_realloc_c4(p,size,l1,u1,l2,u2,l3,u3,l4,u4,nu) result(np)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3,l4,u4,nu
         character(len=size), dimension(:,:,:,:), pointer :: p,np
         end function

         function mem_realloc_i1(p,l1,u1,nu) result(np)
         integer, intent(in) :: l1,u1,nu
         integer, dimension(:), pointer :: p,np
         end function

         function mem_realloc_i2(p,l1,u1,l2,u2,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,nu
         integer, dimension(:,:), pointer :: p,np
         end function

         function mem_realloc_i3(p,l1,u1,l2,u2,l3,u3,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,nu
         integer, dimension(:,:,:), pointer :: p,np
         end function

         function mem_realloc_i4(p,l1,u1,l2,u2,l3,u3,l4,u4,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,nu
         integer, dimension(:,:,:,:), pointer :: p,np
         end function

         function mem_realloc_i5(p,l1,u1,l2,u2,l3,u3,l4,u4,l5,u5,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5,nu
         integer, dimension(:,:,:,:,:), pointer :: p,np
         end function

         function mem_realloc_r1(p,l1,u1,nu) result(np)
         integer, intent(in) :: l1,u1,nu
         real, dimension(:), pointer :: p,np
         end function

         function mem_realloc_r2(p,l1,u1,l2,u2,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,nu
         real, dimension(:,:), pointer :: p,np
         end function

         function mem_realloc_r3(p,l1,u1,l2,u2,l3,u3,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,nu
         real, dimension(:,:,:), pointer :: p,np
         end function

         function mem_realloc_r4(p,l1,u1,l2,u2,l3,u3,l4,u4,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,nu
         real, dimension(:,:,:,:), pointer :: p,np
         end function

         function mem_realloc_r5(p,l1,u1,l2,u2,l3,u3,l4,u4,l5,u5,nu) result(np)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5,nu
         real, dimension(:,:,:,:,:), pointer :: p,np
         end function

         subroutine mem_free_c1(p,size,l1,u1)
         integer, intent(in) :: size,l1,u1
         character(len=size), dimension(:), pointer :: p
         end subroutine

         subroutine mem_free_c2(p,size,l1,u1,l2,u2)
         integer, intent(in) :: size,l1,u1,l2,u2
         character(len=size), dimension(:,:), pointer :: p
         end subroutine

         subroutine mem_free_c3(p,size,l1,u1,l2,u2,l3,u3)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3
         character(len=size), dimension(:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_c4(p,size,l1,u1,l2,u2,l3,u3,l4,u4)
         integer, intent(in) :: size,l1,u1,l2,u2,l3,u3,l4,u4
         character(len=size), dimension(:,:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_i1(p,l1,u1)
         integer, intent(in) :: l1,u1
         integer, dimension(:), pointer :: p
         end subroutine

         subroutine mem_free_i2(p,l1,u1,l2,u2)
         integer, intent(in) :: l1,u1,l2,u2
         integer, dimension(:,:), pointer :: p
         end subroutine

         subroutine mem_free_i3(p,l1,u1,l2,u2,l3,u3)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3
         integer, dimension(:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_i4(p,l1,u1,l2,u2,l3,u3,l4,u4)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4
         integer, dimension(:,:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_i5(p,l1,u1,l2,u2,l3,u3,l4,u4,l5,u5)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5
         integer, dimension(:,:,:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_r1(p,l1,u1)
         integer, intent(in) :: l1,u1
         real, dimension(:), pointer :: p
         end subroutine

         subroutine mem_free_r2(p,l1,u1,l2,u2)
         integer, intent(in) :: l1,u1,l2,u2
         real, dimension(:,:), pointer :: p
         end subroutine

         subroutine mem_free_r3(p,l1,u1,l2,u2,l3,u3)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3
         real, dimension(:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_r4(p,l1,u1,l2,u2,l3,u3,l4,u4)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4
         real, dimension(:,:,:,:), pointer :: p
         end subroutine

         subroutine mem_free_r5(p,l1,u1,l2,u2,l3,u3,l4,u4,l5,u5)
         integer, intent(in) :: l1,u1,l2,u2,l3,u3,l4,u4,l5,u5
         real, dimension(:,:,:,:,:), pointer :: p
         end subroutine

      end interface
@#endif
