@* Crosssection tables.

% $Id$

% $Log$
% Revision 1.10  1995/06/27 13:24:47  dstotler
% Begin using specific energy and temperature variable types.
%
% Revision 1.9  1995/06/12 13:07:22  karney
% Add in dummy elements into common blocks to avoid complaints from
% Alpha.
%
% Revision 1.8  1995/03/02 18:45:56  karney
% Change layout of xs_tablen arrays to be 1-d (called xs_tabn).  Define
% macros to access like a 3-d array.
%
% Revision 1.7  1995/02/01 13:44:17  dstotler
% Extend ratecalc to treat fits; modified xs class accordingly.
%
% Revision 1.6  1995/01/26 14:55:16  dstotler
% First complete version of ratecalc. Presently, input is done in
% subroutine setup_netcdf. Changes to other files at this update are for
% insertion of or changes to comments only.
%
% Revision 1.5  1994/11/21 15:52:25  dstotler
% Interim update associated with ratecalc. ratecalc.hweb and
% xsection.hweb have undergone substantial revision, but should be
% relatively stable from here on. Note also that all of the "ncreada", etc.
% macros have been combined into a single ncread macro. The user is
% responsible for ensuring that dimensions and variables are defined /
% used in the proper order (although the built-in "assert"s should
% help).
%
% Revision 1.4  1994/07/05 11:56:20  karney
% Sync with repository
%
% Revision 1.3  1994/02/16 18:55:26  karney
% Remove redundant xs_tab_index array.
% Convert crosssection files to use strings for variables and spacings.
%
% Revision 1.2  1994/02/14  22:26:28  karney
% First working version.
%
% Revision 1.1  1994/02/13  21:41:23  karney
% Initial revision
%
%

\ID{$Id$}

Information about crosssections.

@I reaction.hweb

@ Constant definitions.

@m xs_organization_unknown 0    // Types of data organization
@m xs_organization_table 1
@m xs_organization_fit 2

@m xs_spacing_unknown 0          // Types of spacing in TABLES
@m xs_spacing_linear 1
@m xs_spacing_log 2

@m xs_var_unknown 0             // Indices for the independent variables
@m xs_var_density 1             // Indices for the independent variables
@m xs_var_energy 2
@m xs_var_temperature 3
@m xs_var_sp_energy 4
@m xs_var_sp_temperature 5
@m xs_var_rate 6                // Indices for dependent variables
@m xs_var_cross_section 7

@m xs_unit_string_length 12     // The length of the unit specifications
@m xs_tag_string_length 20      // The length of variable names and spacings
@m xs_eval_name_length 40       // Routine used to evaluate FITS

@m xs_table_rank_max 3          // The biggest rank table
@m xs_dep_var_max 5             // Maximum number of dependent variables

@ Accessor functions for |xs_tabn| to make them look like 3-dimensional arrays.

@m xs_table1(i,j,k) xs_tab1[i+xs_tab_index[1][1]*(j+xs_tab_index[1][2]*k)]
@m xs_table2(i,j,k) xs_tab2[i+xs_tab_index[2][1]*(j+xs_tab_index[2][2]*k)]
@m xs_table3(i,j,k) xs_tab3[i+xs_tab_index[3][1]*(j+xs_tab_index[3][2]*k)]
@m xs_table4(i,j,k) xs_tab4[i+xs_tab_index[4][1]*(j+xs_tab_index[4][2]*k)]
@m xs_table5(i,j,k) xs_tab5[i+xs_tab_index[5][1]*(j+xs_tab_index[5][2]*k)]

@ variable definitions.

@a
      package_init(xs)

      define_dimen_pk(xs,rank_ind,xs_table_rank_max)
      define_dimen_pk(xs,rank_ind0,0,xs_table_rank_max)
      define_dimen_pk(xs,dep_var_ind,xs_dep_var_max)

      define_var_pk(xs,xs_tab_index,INT,rank_ind,dep_var_ind)
/*
   Note: the ``5'' and ``3'' used below and in |xs_tablej| below correspond
   to |xs_dep_var_max| and |xs_table_rank_max|, respectively. 
*/

      define_dimen_pk(xs,indexv1_ind,0,xs_tab_index[1][1]*xs_tab_index[1][2]*xs_tab_index[1][3]-1)
      define_dimen_pk(xs,indexv2_ind,0,xs_tab_index[2][1]*xs_tab_index[2][2]*xs_tab_index[2][3]-1)
      define_dimen_pk(xs,indexv3_ind,0,xs_tab_index[3][1]*xs_tab_index[3][2]*xs_tab_index[3][3]-1)
      define_dimen_pk(xs,indexv4_ind,0,xs_tab_index[4][1]*xs_tab_index[4][2]*xs_tab_index[4][3]-1)
      define_dimen_pk(xs,indexv5_ind,0,xs_tab_index[5][1]*xs_tab_index[5][2]*xs_tab_index[5][3]-1)

      define_dimen_pk(xs,unit_string,xs_unit_string_length)
      define_dimen_pk(xs,tag_string,xs_tag_string_length)
      define_dimen_pk(xs,xs_symbol_string,rc_sy_len)
      define_dimen_pk(xs,eval_name,xs_eval_name_length)

      define_var_pk(xs,xs_name,CHAR,xs_symbol_string)
      define_var_pk(xs,xs_num_dep_var,INT)
      define_var_pk(xs,xs_min,FLOAT,rank_ind,dep_var_ind)
      define_var_pk(xs,xs_max,FLOAT,rank_ind,dep_var_ind)
      define_var_pk(xs,xs_mult,FLOAT,rank_ind0,dep_var_ind)
      define_var_pk(xs,xs_organization,CHAR,tag_string,dep_var_ind)
      define_var_pk(xs,xs_rank,INT,dep_var_ind)
      define_dummy_pk(xs,xs_ignore,INT)

      define_var_pk(xs,xs_spacing,CHAR,tag_string,rank_ind0,dep_var_ind)
      define_var_pk(xs,xs_var,CHAR,tag_string,rank_ind0,dep_var_ind)
      define_var_pk(xs,xs_units,CHAR,unit_string,rank_ind0,dep_var_ind)
      define_var_pk(xs,xs_eval_name,CHAR,eval_name,dep_var_ind)

      define_varp_pk(xs,xs_tab1,FLOAT,indexv1_ind)
      define_varp_pk(xs,xs_tab2,FLOAT,indexv2_ind)
      define_varp_pk(xs,xs_tab3,FLOAT,indexv3_ind)
      define_varp_pk(xs,xs_tab4,FLOAT,indexv4_ind)
      define_varp_pk(xs,xs_tab5,FLOAT,indexv5_ind)

@ Common blocks definitions.

@f xs_common integer
@m xs_common
      xs_common_a;
      xs_common_b @;

