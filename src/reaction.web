@ Return the reaction rate for a particular location and reaction.
      
@<Functions...@>=
      function reaction_rate(pt_dummy(p),rc_dummy(r),bk_dummy(b))
      implicit_none
      real reaction_rate        // Function
      pt_decl(p)                // Input
      rc_decl(r)
      bk_decl(b)
      zn_common
      rc_common
      bk_common
      sp_common
      external reaction_rate_a
      real reaction_rate_a
      
      reaction_rate=reaction_rate_a(pt_sp(p),pt_v(p),bk_sp(b),
     $     bk_n(b,lc_zone(pt_loc(p))),
     $     bk_v(b,lc_zone(pt_loc(p)))[1],
     $     bk_temp(b,lc_zone(pt_loc(p))))
      
      return
      end
      
@ Low-level routine for the reaction rate.
      
@<Functions...@>=
      function reaction_rate_a(sp_dummy(t),vt,sp_dummy(b),nb,vb,tb,rc_dummy(r))
      implicit_none
      real reaction_rate_a        // Function
      sp_decl(t)                // Input
      rc_decl(r)
      sp_decl(b)
      real vt[3],nb,vb[3],tb
      rc_common
      rd_common
      pr_common
      sp_common
      integer i // Local
      real cross_section,fvar[xs_table_rank_max]
      external interpolate1,interpolate2,interpolate3 // External
      real interpolate1,interpolate2,interpolate3
      
      assert( reaction_organization[r] == xs_organization_table )
      assert( reaction_xs_var[0,r] == xs_var_rate )

      do i=1,reaction_xs_rank[r]
         if (reaction_xs_var[i,r] == xs_var_density) then
            fvar[i] = nb
         else if (reaction_xs_var[i,r] == xs_var_energy) then
            fvar[i] = half*sp_m(t)*atomic_mass_unit*vc_abs2(vt)
         else if (reaction_xs_var[i,r] == xs_var_temperature) then
            fvar[i] = electron_charge*tb
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_xs_spacing[i,r] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_xs_min[i,r])/reaction_xs_delta[i,r]
      end do
      
      if (reaction_xs_rank[r] == 1) then
         cross_section=interpolate1(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      else if (reaction_xs_rank[r] == 2) then
         cross_section=interpolate2(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      else if (reaction_xs_rank[r] == 3) then
         cross_section=interpolate3(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      end if
      
      if (reaction_xs_spacing[0,r] == xs_spacing_log) cross_section=exp(cross_section)
      
      reaction_rate_a=cross_section*nb
      
      return
      end
      
@ The interpolation routines.  The one-dimensional one interpolates in
an array dimensioned |0:n-1| according to a floating point index |f|.
If |f| is out of range then we imagine the table continued as a
constant.
      
@<Functions...@>=
      function interpolate1(f,array,n)
      implicit_none
      real interpolate1         // Function
      integer n                 // Input
      real f,array[0:n-1]
      integer ia,ib           // Local
      real fx

      ia=int(f)
      if (f < areal(ia)) ia=ia-1
      fx=f-areal(ia)
      ib=ia+1
      ia=min(max(0,ia),n-1)
      ib=min(max(0,ib),n-1)
      interpolate1=array[ia]*(one-fx)+array[ib]*fx
      
      return
      end

@ The two-dimensional version.

@<Functions...@>=
      function interpolate2(f,array,n)
      implicit_none
      real interpolate2         // Function
      integer n[2]              // Input
      real f[2],array[0:n[1]-1,0:n[2]-1]
      integer i,ia[2],ib[2]   // Local
      real fx[2]

      do i=1,2
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate2=
     $     array[ia[1],ia[2]]*(one-fx[1])*(one-fx[2])+
     $     array[ia[1],ib[2]]*(one-fx[1])*fx[2]+
     $     array[ib[1],ia[2]]*fx[1]*(one-fx[2])+
     $     array[ib[1],ib[2]]*fx[1]*fx[2]

      return
      end

@ The three-dimensional version.

@<Functions...@>=
      function interpolate3(f,array,n)
      implicit_none
      real interpolate3         // Function
      integer n[3]              // Input
      real f[3],array[0:n[1]-1,0:n[2]-1,0:n[3]-1]
      integer i,ia[3],ib[3]   // Local
      real fx[3]

      do i=1,3
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate3=
     $     array[ia[1],ia[2],ia[3]]*(one-fx[1])*(one-fx[2])*(one-fx[3])+
     $     array[ia[1],ia[2],ib[3]]*(one-fx[1])*(one-fx[2])*fx[3]+
     $     array[ia[1],ib[2],ia[3]]*(one-fx[1])*fx[2]*(one-fx[3])+
     $     array[ia[1],ib[2],ib[3]]*(one-fx[1])*fx[2]*fx[3]+
     $     array[ib[1],ia[2],ia[3]]*fx[1]*(one-fx[2])*(one-fx[3])+
     $     array[ib[1],ia[2],ib[3]]*fx[1]*(one-fx[2])*fx[3]+
     $     array[ib[1],ib[2],ia[3]]*fx[1]*fx[2]*(one-fx[3])+
     $     array[ib[1],ib[2],ib[3]]*fx[1]*fx[2]*fx[3]
      
      return
      end
      
@ Read in the reaction data from a file.  (This routine used to be in |reactionsetup.web|.)

@<Functions...@>=
      subroutine reaction_read(num)
      implicit none
      integer num
      integer fileid // Local
      xs_common
      xs_ncdecl
      nc_common
      sy_common
      rc_common
      pr_common
      
      fileid = ncopen(rc_filename(pr_reaction(num)),NC_NOWRITE,nc_stat)
      
      xs_ncread(fileid)
      
      call ncclose(fileid,nc_stat)
      
      call xs_copy(num)

      var_free(xs_tab1)
      var_free(xs_tab2)
      var_free(xs_tab3)
      var_free(xs_tab4)
      var_free(xs_tab5)

      return
      end

@ Copy cross-section information into reaction arrays.

@<Functions...@>=
      subroutine xs_copy(num)
      implicit_none
      integer num                     // Input
      integer i,j,jdep,k,size        // Local
      real table_entry
      xs_common
      pr_common
      rc_common
      rd_common
      sy_common
      
      assert(xs_name==rc_sy(pr_reaction(num)))

      do j=1,xs_num_dep_var
         if (xs_var[0,j] == 'rate') jdep=j
      end do

      assert(xs_organization[jdep]=='table')
      if (xs_organization[jdep]=='table') then
         reaction_organization[num]=xs_organization_table
      end if
      assert(xs_rank[jdep] > 0 && xs_rank[jdep] <= xs_table_rank_max)
      reaction_xs_rank[num]=xs_rank[jdep]
      i=0
      assert(xs_spacing[i,jdep] == 'linear' || xs_spacing[i,jdep] == 'log')
      
      if (xs_spacing[i,jdep] == 'linear') then
         reaction_xs_spacing[i,num]=xs_spacing_linear
      else if (xs_spacing[i,jdep] == 'log') then
         reaction_xs_spacing[i,num]=xs_spacing_log
      end if
      if (xs_var[i,jdep] == 'rate') then
         reaction_xs_var[i,num]=xs_var_rate
      else if (xs_var[i,jdep] == 'density') then
         reaction_xs_var[i,num]=xs_var_density
      else if (xs_var[i,jdep] == 'temperature') then
         reaction_xs_var[i,num]=xs_var_temperature
      else if (xs_var[i,jdep] == 'energy') then
         reaction_xs_var[i,num]=xs_var_energy
      end if
      size=1
      do i=1,xs_rank[jdep]
         reaction_xs_tab_index[i,num] = xs_tab_index[i,jdep]
         assert(reaction_xs_tab_index[i,num] > 1)
         if (xs_spacing[i,jdep] == 'linear') then
            reaction_xs_spacing[i,num]=xs_spacing_linear
         else if (xs_spacing[i,jdep] == 'log') then
            reaction_xs_spacing[i,num]=xs_spacing_log
         end if
         if (xs_var[i,jdep] == 'rate') then
            reaction_xs_var[i,num]=xs_var_rate
         else if (xs_var[i,jdep] == 'density') then
            reaction_xs_var[i,num]=xs_var_density
         else if (xs_var[i,jdep] == 'temperature') then
            reaction_xs_var[i,num]=xs_var_temperature
         else if (xs_var[i,jdep] == 'energy') then
            reaction_xs_var[i,num]=xs_var_energy
         end if
         size=size*reaction_xs_tab_index[i,num]
         if (reaction_xs_spacing[i,num] == xs_spacing_linear) then
            reaction_xs_min[i,num]=xs_min[i,jdep]*xs_mult[i,jdep]
            reaction_xs_delta[i,num]=
     $           (xs_max[i,jdep]-xs_min[i,jdep])*xs_mult[i,jdep]/
     $           areal(reaction_xs_tab_index[i,num]-1)
         else if (reaction_xs_spacing[i,num] == xs_spacing_log) then
            reaction_xs_min[i,num]=log(xs_min[i,jdep]*xs_mult[i,jdep])
            reaction_xs_delta[i,num]=
     $           log(xs_max[i,jdep]/xs_min[i,jdep])/
     $           areal(reaction_xs_tab_index[i,num]-1)
         else
            assert('Unknown spacing type' == ' ')
         end if
      end do
      do i=xs_rank[jdep]+1,xs_table_rank_max
         reaction_xs_tab_index[i,num]=1
      end do
      reaction_xs_base[num]=xs_base_max
      var_reallocc(reaction_xsection_table,xs_base_max-1,xs_base_max-1+size)
      do k=0,xs_tab_index[3,jdep]-1
         do j=0,xs_tab_index[2,jdep]-1
            do i=0,xs_tab_index[1,jdep]-1
               if (jdep == 1) then
                  table_entry=xs_table1(i,j,k)
               else if (jdep == 2) then
                  table_entry=xs_table2(i,j,k)
               else if (jdep == 3) then
                  table_entry=xs_table3(i,j,k)
               else if (jdep == 4) then
                  table_entry=xs_table4(i,j,k)
               else if (jdep == 5) then
                  table_entry=xs_table5(i,j,k)
               end if
               if (reaction_xs_spacing[0,num] == xs_spacing_linear) then
                  rc_xsection3(num,i,j,k)=table_entry*xs_mult[0,jdep]
               else
                  rc_xsection3(num,i,j,k)=log(table_entry*xs_mult[0,jdep])
               end if
            end do
         end do
      end do
      xs_base_max=xs_base_max+size

      return
      end

