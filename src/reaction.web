@ The main program.

@a
      @<Functions and Subroutines@>

@ Return the reaction rate for a particular location and reaction. The 
arguments here are |p|, the particle index and |ts_reac|, the reaction
index into the list of reactions participated in by the test species
corresponding to |p|. This routine uses |p| to pull together all of
the more specific information required by the lower level routine.
      
@<Functions...@>=
      function reaction_rate(pt_dummy(p),pr_reaction_dummy(ts_reac))
      implicit_none
      real reaction_rate               // Function
      pt_decl(p)                       // Input
      pr_reaction_decl(ts_reac)

      bk_decl(back)                    // Local
      vc_decl(vb_flow)
      real rr
      zn_common
      bk_common
      sp_common
      pr_common
      external reaction_rate_a         // External
      real reaction_rate_a
      
      back=pr_ts_bk(pt_test(p),ts_reac)
/* Transform the velocity vector into cartesian coords.  This is a
candidate for moving into an outer routine, since it should only be done
once per point. */

      if (background_coords == plasma_coords_cartesian) then
         vc_copy(bk_v(back,lc_zone(pt_loc(p))),vb_flow)
      else if (background_coords == plasma_coords_cylindrical) then
         rr=sqrt(lc_x(pt_loc(p))[1]**2+lc_x(pt_loc(p))[2]**2)
         vb_flow[1]=(bk_v(back,lc_zone(pt_loc(p)))[1]*lc_x(pt_loc(p))[1]-
     $        bk_v(back,lc_zone(pt_loc(p)))[2]*lc_x(pt_loc(p))[2])/rr
         vb_flow[2]=(bk_v(back,lc_zone(pt_loc(p)))[1]*lc_x(pt_loc(p))[2]+
     $        bk_v(back,lc_zone(pt_loc(p)))[2]*lc_x(pt_loc(p))[1])/rr
         vb_flow[3]=bk_v(back,lc_zone(pt_loc(p)))[3]
      else
         assert(.false.)
      end if

      reaction_rate=reaction_rate_a(pr_test_args(pt_test(p)),vc_args(pt_v(p)),
     $     bk_args(back),bk_n(back,lc_zone(pt_loc(p))),
     $     vc_args(vb_flow),bk_temp(back,lc_zone(pt_loc(p))),
     $     pr_reaction_args(ts_reac))
      
      return
      end
      
@ Low-level routine for the reaction rate. The arguments here are:
\begin{description}
  \item[|test|] test particle index,
  \item[|v_test|] its velocity,
  \item[|back|] background particle index,
  \item[|nb|] its density,
  \item[|vb_flow|] its flow velocity,
  \item[|tb|] and its temperature,
  \item[|ts_reac|] reaction index into the list of reactions participated 
in by |test|.
\end{description}
The intention here is to make these variables as ``physical'' as possible
so this routine can easily be used in standalone codes, such as |reaction_test|.
      
@<Functions...@>=
      function reaction_rate_a(pr_test_dummy(test),vc_dummy(v_test),
     $    pr_background_dummy(back),nb,vc_dummy(vb_flow),tb,
     $    pr_reaction_dummy(ts_reac))

      implicit_none
      real reaction_rate_a                               // Function
      pr_test_decl(test)                                 // Input
      real v_test[3]
      pr_background_decl(back)
      real nb,vb_flow[3],tb
      pr_reaction_decl(ts_reac)

      pr_reaction_decl(pr_reac)  
      integer i                                         // Local
      real sigma_v,fvar[xs_table_rank_max],vrel[3]
      external interpolate1,interpolate2,interpolate3   // External
      real interpolate1,interpolate2,interpolate3
      
      rd_common
      pr_common
      sp_common

      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list

      assert( reaction_organization[pr_reac][rd_rate] == xs_organization_table )
      assert( reaction_data_var[pr_reac][rd_rate][0] == xs_var_rate )

      do i=1,reaction_data_rank[pr_reac][rd_rate]
         if (reaction_data_var[pr_reac][rd_rate][i] == xs_var_density) then
            fvar[i] = nb
         else if (reaction_data_var[pr_reac][rd_rate][i] == xs_var_energy) then
            vc_difference(v_test,vb_flow,vrel)
            fvar[i] = half*sp_m(pr_test(test))*vc_abs2(vrel)
         else if (reaction_data_var[pr_reac][rd_rate][i] == xs_var_sp_energy) then
            vc_difference(v_test,vb_flow,vrel)
            fvar[i] = half*vc_abs2(vrel)
         else if (reaction_data_var[pr_reac][rd_rate][i] == xs_var_temperature) then
            fvar[i] = tb
         else if (reaction_data_var[pr_reac][rd_rate][i] == xs_var_sp_temperature) then
            fvar[i] = tb/sp_m(pr_background(back))
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_data_spacing[pr_reac][rd_rate][i] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_data_min[pr_reac][rd_rate][i])/reaction_data_delta[pr_reac][rd_rate][i]
      end do
      
      if (reaction_data_rank[pr_reac][rd_rate] == 1) then
         sigma_v=interpolate1(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_rate]],
     $        reaction_data_tab_index[pr_reac][rd_rate][1])
      else if (reaction_data_rank[pr_reac][rd_rate] == 2) then
         sigma_v=interpolate2(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_rate]],
     $        reaction_data_tab_index[pr_reac][rd_rate][1])
      else if (reaction_data_rank[pr_reac][rd_rate] == 3) then
         sigma_v=interpolate3(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_rate]],
     $        reaction_data_tab_index[pr_reac][rd_rate][1])
      end if
      
      if (reaction_data_spacing[pr_reac][rd_rate][0] == xs_spacing_log) sigma_v=exp(sigma_v)
      
      reaction_rate_a=sigma_v*nb
      
      return
      end
      
@ A similar routine for the cross-section.  This returns $\sigma(v)v$. 
Arguments are same as for |reaction_rate_a|.    
      
@<Functions...@>=
      function cross_section_a(pr_test_dummy(test),vc_dummy(v_test),
     $    pr_background_dummy(back),nb,vc_dummy(vb_flow),tb,
     $    pr_reaction_dummy(ts_reac))

      implicit_none
      real cross_section_a                              // Function
      pr_test_decl(test)                                // Input
      vc_decl(v_test)
      pr_background_decl(back)
      real nb,tb
      vc_decl(vb_flow)
      pr_reaction_decl(ts_reac)

      pr_reaction_decl(pr_reac)  
      integer i                                         // Local
      vc_decl(vrel)
      real cross_section,fvar[xs_table_rank_max],vr
      external interpolate1,interpolate2,interpolate3   // External
      real interpolate1,interpolate2,interpolate3
      
      rd_common
      pr_common
      sp_common

      pr_reac=pr_ts_rc(test,ts_reac)    // Index to problem-reaction list

      assert( reaction_organization[pr_reac][rd_xs] == xs_organization_table )
      assert( reaction_data_var[pr_reac][rd_xs][0] == xs_var_cross_section )

      vc_difference(v_test,vb_flow,vrel)
      vr=vc_abs(vrel)

      do i=1,reaction_data_rank[pr_reac][rd_xs]
         if (reaction_data_var[pr_reac][rd_xs][i] == xs_var_energy) then
            fvar[i] = half*sp_m(pr_test(test))*vr**2
         else if (reaction_data_var[pr_reac][rd_xs][i] == xs_var_sp_energy) then
            fvar[i] = half*vr**2
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_data_spacing[pr_reac][rd_xs][i] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_data_min[pr_reac][rd_xs][i])/reaction_data_delta[pr_reac][rd_xs][i]
      end do
      
      if (reaction_data_rank[pr_reac][rd_xs] == 1) then
         cross_section=interpolate1(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_xs]],
     $        reaction_data_tab_index[pr_reac][rd_xs][1])
      else if (reaction_data_rank[pr_reac][rd_xs] == 2) then
         cross_section=interpolate2(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_xs]],
     $        reaction_data_tab_index[pr_reac][rd_xs][1])
      else if (reaction_data_rank[pr_reac][rd_xs] == 3) then
         cross_section=interpolate3(fvar,
     $        reaction_data_table[reaction_data_base[pr_reac][rd_xs]],
     $        reaction_data_tab_index[pr_reac][rd_xs][1])
      end if
      
      if (reaction_data_spacing[pr_reac][rd_xs][0] == xs_spacing_log) cross_section=exp(cross_section)
      
      cross_section_a=cross_section*vr
      
      return
      end
      
@ The interpolation routines.  The one-dimensional one interpolates in
an array dimensioned |0:n-1| according to a floating point index |f|.
If |f| is out of range then we imagine the table continued as a
constant.

@m array1(i) array[i]
      
@<Functions...@>=
      function interpolate1(f,array,n)
      implicit_none
      real interpolate1         // Function
      integer n                 // Input
      real f,array[0:*]
      integer ia,ib           // Local
      real fx

      ia=int(f)
      if (f < areal(ia)) ia=ia-1
      fx=f-areal(ia)
      ib=ia+1
      ia=min(max(0,ia),n-1)
      ib=min(max(0,ib),n-1)
      interpolate1=array1(ia)*(one-fx)+array1(ib)*fx
      
      return
      end

@ The two-dimensional version.

@m array2(i,j) array[i+n[1]*j]

@<Functions...@>=
      function interpolate2(f,array,n)
      implicit_none
      real interpolate2         // Function
      integer n[2]              // Input
      real f[2],array[0:*]
      integer i,ia[2],ib[2]   // Local
      real fx[2]

      do i=1,2
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate2=
     $     array2(ia[1],ia[2])*(one-fx[1])*(one-fx[2])+
     $     array2(ia[1],ib[2])*(one-fx[1])*fx[2]+
     $     array2(ib[1],ia[2])*fx[1]*(one-fx[2])+
     $     array2(ib[1],ib[2])*fx[1]*fx[2]

      return
      end

@ The three-dimensional version.

@m array3(i,j,k) array[i+n[1]*(j+n[2]*k)]

@<Functions...@>=
      function interpolate3(f,array,n)
      implicit_none
      real interpolate3         // Function
      integer n[3]              // Input
      real f[3],array[0:*]
      integer i,ia[3],ib[3]   // Local
      real fx[3]

      do i=1,3
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate3=
     $     array3(ia[1],ia[2],ia[3])*(one-fx[1])*(one-fx[2])*(one-fx[3])+
     $     array3(ia[1],ia[2],ib[3])*(one-fx[1])*(one-fx[2])*fx[3]+
     $     array3(ia[1],ib[2],ia[3])*(one-fx[1])*fx[2]*(one-fx[3])+
     $     array3(ia[1],ib[2],ib[3])*(one-fx[1])*fx[2]*fx[3]+
     $     array3(ib[1],ia[2],ia[3])*fx[1]*(one-fx[2])*(one-fx[3])+
     $     array3(ib[1],ia[2],ib[3])*fx[1]*(one-fx[2])*fx[3]+
     $     array3(ib[1],ib[2],ia[3])*fx[1]*fx[2]*(one-fx[3])+
     $     array3(ib[1],ib[2],ib[3])*fx[1]*fx[2]*fx[3]
      
      return
      end
      
@ Read in the reaction data from a file.  (This routine used to be in |reactionsetup.web|.)

@<Functions...@>=
      subroutine reaction_read(num)
      implicit none
      integer num
      integer fileid // Local
      xs_common
      xs_ncdecl
      nc_common
      sy_common
      rc_common
      pr_common
      
      fileid = ncopen(rc_filename(pr_reaction(num)),NC_NOWRITE,nc_stat)
      
      xs_ncread(fileid)
      
      call ncclose(fileid,nc_stat)
      
      call xs_copy(num)

      var_free(xs_tab1)
      var_free(xs_tab2)
      var_free(xs_tab3)
      var_free(xs_tab4)
      var_free(xs_tab5)

      return
      end

@ Copy cross-sections and other dependent variable
information into reaction data and miscellaneous arrays.

@<Functions...@>=
      subroutine xs_copy(num)
      implicit_none
      integer num                                         // Input
      integer i,j,jdep,k,rd_ind,rm_ind,organization       // Local
      integer spacing[0:xs_dep_var_max],var[xs_dep_var_max]
      real table_entry,min[xs_dep_var_max],delta[xs_dep_var_max]
      xs_common
      pr_common
      rc_common
      rd_common
      sy_common
      
      assert(xs_name==rc_sy(pr_reaction(num)))

/* Initialize */
      rm_ind=0
      do j=1,xs_dep_var_max
         reaction_organization[num][j]=xs_organization_unknown
         reaction_misc_organization[num][j]=xs_organization_unknown
         reaction_data_rank[num][j]=0
         reaction_misc_rank[num][j]=0
         reaction_data_var[num][j][0]=xs_var_unknown
         reaction_misc_var_dep[num][j]='unknown'
         reaction_data_spacing[num][j][0]=xs_spacing_unknown
         reaction_misc_spacing[num][j][0]=xs_spacing_unknown
         do i=1,xs_table_rank_max
            reaction_data_var[num][j][i]=xs_var_unknown
            reaction_misc_var_indep[num][j][i]=xs_var_unknown
            reaction_data_spacing[num][j][i]=xs_spacing_unknown
            reaction_misc_spacing[num][j][i]=xs_spacing_unknown
            reaction_data_min[num][j][i]=zero
            reaction_misc_min[num][j][i]=zero
            reaction_data_delta[num][j][i]=zero
            reaction_misc_delta[num][j][i]=zero
            reaction_data_tab_index[num][j][i]=0
            reaction_misc_tab_index[num][j][i]=0
         end do
      end do

/* Main loop over dependent variables in this data file. First use local
   variables to store internal representations of data. */
      do jdep=1,xs_num_dep_var

         assert(xs_organization[jdep]SP(1:5)=='table')
         if (xs_organization[jdep]SP(1:5)=='table') then
            organization=xs_organization_table
         end if

         i=0
         if (xs_spacing[i,jdep] == 'linear') then
            spacing[i]=xs_spacing_linear
         else if (xs_spacing[i,jdep] == 'log') then
            spacing[i]=xs_spacing_log
         else if (xs_spacing[i,jdep] == 'unknown') then
            spacing[i]=xs_spacing_unknown
         end if
         if (xs_rank[jdep] > 0) then
            do i=1,xs_rank[jdep]
            
               if (xs_spacing[i,jdep] == 'linear') then
                  spacing[i]=xs_spacing_linear
               else if (xs_spacing[i,jdep] == 'log') then
                  spacing[i]=xs_spacing_log
               else if (xs_spacing[i,jdep] == 'unknown') then
                  spacing[i]=xs_spacing_unknown
               end if
        
               if (xs_var[i,jdep] == 'density') then
                  var[i]=xs_var_density
               else if (xs_var[i,jdep] == 'temperature') then
                  var[i]=xs_var_temperature
               else if (xs_var[i,jdep] == 'energy') then
                  var[i]=xs_var_energy
               else if (xs_var[i,jdep] == 'specific_temperature') then
                  var[i]=xs_var_sp_temperature
               else if (xs_var[i,jdep] == 'specific_energy') then
                  var[i]=xs_var_sp_energy
               end if

               if (spacing[i] == xs_spacing_linear) then
                  min[i]=xs_min[i,jdep]*xs_mult[i,jdep]
                  delta[i]=
     $                 (xs_max[i,jdep]-xs_min[i,jdep])*xs_mult[i,jdep]/
     $                 areal(xs_tab_index[jdep][i]-1)
               else if (spacing[i] == xs_spacing_log) then
                  min[i]=log(xs_min[i,jdep]*xs_mult[i,jdep])
                  delta[i]=
     $                 log(xs_max[i,jdep]/xs_min[i,jdep])/
     $                 areal(xs_tab_index[jdep][i]-1)
               else
                  min[i]=zero
                  delta[i]=zero
               end if
            end do
         end if

/* 
   Now treat separately two types of dependent variables: (1) reaction rates
   and cross-sections, (2) miscellaneous (variable labels retained) data.
   Here we segregate the |xs| data (some stored in the local variables above)
   into the |reaction_data| and |reaction_misc| arrays, respectively. 
*/
         if (xs_var[0,jdep] == 'rate' || xs_var[0,jdep] == 'reaction_rate' 
     $        || xs_var[0,jdep] == 'cross_section') then
            if (xs_var[0,jdep] == 'cross_section') then
               rd_ind=rd_xs
               reaction_data_var[num][rd_ind][0]=xs_var_cross_section
            else
               rd_ind=rd_rate
               reaction_data_var[num][rd_ind][0]=xs_var_rate
            end if
                                                              // Reaction rates
            reaction_organization[num][rd_ind]=organization
            reaction_data_rank[num][rd_ind]=xs_rank[jdep]
            assert(xs_rank[jdep] > 0 || xs_rank[jdep] <= xs_table_rank_max)
            reaction_data_spacing[num][rd_ind][0]=spacing[0]
            do i=1,xs_rank[jdep]
               reaction_data_tab_index[num][rd_ind][i]=xs_tab_index[jdep][i]
               reaction_data_spacing[num][rd_ind][i]=spacing[i]
               reaction_data_var[num][rd_ind][i]=var[i]
               reaction_data_min[num][rd_ind][i]=min[i]
               reaction_data_delta[num][rd_ind][i]=delta[i]
            end do
            if (xs_rank[jdep] < xs_table_rank_max) then
               do i=xs_rank[jdep]+1,xs_table_rank_max
                  reaction_data_tab_index[num][rd_ind][i]=1
               end do
            end if
            rd_ragged_realloc(reaction_data,reaction_data_tab_index,rd_ind,num)

         else if (xs_var[0,jdep] == 'unknown') then
            goto skip
         else
            rm_ind++                                          // Miscellaneous
            reaction_misc_var_dep[num][rm_ind]=xs_var[0,jdep]
            reaction_misc_organization[num][rm_ind]=organization
            reaction_misc_rank[num][rm_ind]=xs_rank[jdep]
            reaction_misc_spacing[num][rm_ind][0]=spacing[0]
            if (xs_rank[jdep] > 0) then
               do i=1,xs_rank[jdep]
                  reaction_misc_tab_index[num][rm_ind][i]=xs_tab_index[jdep][i]
                  reaction_misc_spacing[num][rm_ind][i]=spacing[i]
                  reaction_misc_var_indep[num][rm_ind][i]=var[i]
                  reaction_misc_min[num][rm_ind][i]=min[i]
                  reaction_misc_delta[num][rm_ind][i]=delta[i]
               end do
            end if
            if (xs_rank[jdep] < xs_table_rank_max) then
               do i=xs_rank[jdep]+1,xs_table_rank_max
                  reaction_misc_tab_index[num][rm_ind][i]=1
               end do
            end if
            rd_ragged_realloc(reaction_misc,reaction_misc_tab_index,rm_ind,num)
         end if

/*
   Now retrieve the tabular data for this dependent variable...
*/
         do k=0,xs_tab_index[3,jdep]-1
            do j=0,xs_tab_index[2,jdep]-1
               do i=0,xs_tab_index[1,jdep]-1
                  if (jdep == 1) then
                     table_entry=xs_table1(i,j,k)
                  else if (jdep == 2) then
                     table_entry=xs_table2(i,j,k)
                  else if (jdep == 3) then
                     table_entry=xs_table3(i,j,k)
                  else if (jdep == 4) then
                     table_entry=xs_table4(i,j,k)
                  else if (jdep == 5) then
                     table_entry=xs_table5(i,j,k)
                  end if
                  if (spacing[0] == xs_spacing_log) then
                     table_entry=log(table_entry*xs_mult[0,jdep])
                  else
                     table_entry=table_entry*xs_mult[0,jdep]
                  end if
                
/*
   And store in the appropriate |rd| data table again distinguishing reaction
   rate / cross section from miscellaneous data.
*/
                  if (xs_var[0,jdep] == 'rate' || xs_var[0,jdep] == 'reaction_rate' 
     $                 || xs_var[0,jdep] == 'cross_section') then
                     rd_data3(num,rd_ind,i,j,k)=table_entry
                  else
                     rd_misc_data3(num,rm_ind,i,j,k)=table_entry
                  end if
               end do
            end do
         end do
skip: continue
      end do

      return
      end

