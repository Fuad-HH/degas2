@ Return the reaction rate for a particular location and reaction.
      
@<Functions...@>=
      function reaction_rate(pt_dummy(p),rc_dummy(r),bk_dummy(b))
      implicit_none
      real reaction_rate        // Function
      pt_decl(p)                // Input
      rc_decl(r)
      bk_decl(b)
      real vb[3],rr
      zn_common
      rc_common
      bk_common
      sp_common
      pr_common
      external reaction_rate_a
      real reaction_rate_a
      
/* Transform the velocity vector into cartesian coords.  This is a
candidate for moving into an outer routine, since it should only be done
once per point. */

      if (background_coords == plasma_coords_cartesian) then
         vc_copy(bk_v(b,lc_zone(pt_loc(p))),vb)
      else if (background_coords == plasma_coords_cylindrical) then
         rr=sqrt(lc_x(pt_loc(p))[1]**2+lc_x(pt_loc(p))[2]**2)
         vb[1]=(bk_v(b,lc_zone(pt_loc(p)))[1]*lc_x(pt_loc(p))[1]-
     $        bk_v(b,lc_zone(pt_loc(p)))[2]*lc_x(pt_loc(p))[2])/rr
         vb[2]=(bk_v(b,lc_zone(pt_loc(p)))[1]*lc_x(pt_loc(p))[2]+
     $        bk_v(b,lc_zone(pt_loc(p)))[2]*lc_x(pt_loc(p))[1])/rr
         vb[3]=bk_v(b,lc_zone(pt_loc(p)))[3]
      else
         assert(.false.)
      end if

      reaction_rate=reaction_rate_a(pt_sp(p),pt_v(p),pr_background(b),
     $     bk_n(b,lc_zone(pt_loc(p))),
     $     vb,
     $     bk_temp(b,lc_zone(pt_loc(p))),
     $     pr_reaction(r))
      
      return
      end
      
@ Low-level routine for the reaction rate.
      
@<Functions...@>=
      function reaction_rate_a(sp_dummy(t),vt,sp_dummy(b),nb,vb,tb,rc_dummy(r))
      implicit_none
      real reaction_rate_a        // Function
      sp_decl(t)                // Input
      rc_decl(r)
      sp_decl(b)
      real vt[3],nb,vb[3],tb
      rc_common
      rd_common
      pr_common
      sp_common
      integer i // Local
      real sigma_v,fvar[xs_table_rank_max],vrel[3]
      external interpolate1,interpolate2,interpolate3 // External
      real interpolate1,interpolate2,interpolate3
      
      assert( reaction_organization[r][rd_rate] == xs_organization_table )
      assert( reaction_data_var[r][rd_rate][0] == xs_var_rate )

      do i=1,reaction_data_rank[r][rd_rate]
         if (reaction_data_var[r][rd_rate][i] == xs_var_density) then
            fvar[i] = nb
         else if (reaction_data_var[r][rd_rate][i] == xs_var_energy) then
            vc_difference(vt,vb,vrel)
            fvar[i] = half*sp_m(t)*vc_abs2(vrel)
         else if (reaction_data_var[r][rd_rate][i] == xs_var_sp_energy) then
            vc_difference(vt,vb,vrel)
            fvar[i] = half*vc_abs2(vrel)
         else if (reaction_data_var[r][rd_rate][i] == xs_var_temperature) then
            fvar[i] = tb
         else if (reaction_data_var[r][rd_rate][i] == xs_var_sp_temperature) then
            fvar[i] = tb/sp_m(b)
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_data_spacing[r][rd_rate][i] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_data_min[r][rd_rate][i])/reaction_data_delta[r][rd_rate][i]
      end do
      
      if (reaction_data_rank[r][rd_rate] == 1) then
         sigma_v=interpolate1(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_rate]],
     $        reaction_data_tab_index[r][rd_rate][1])
      else if (reaction_data_rank[r][rd_rate] == 2) then
         sigma_v=interpolate2(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_rate]],
     $        reaction_data_tab_index[r][rd_rate][1])
      else if (reaction_data_rank[r][rd_rate] == 3) then
         sigma_v=interpolate3(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_rate]],
     $        reaction_data_tab_index[r][rd_rate][1])
      end if
      
      if (reaction_data_spacing[r][rd_rate][0] == xs_spacing_log) sigma_v=exp(sigma_v)
      
      reaction_rate_a=sigma_v*nb
      
      return
      end
      
@ A similar routine for the cross-section.  This returns $\sigma(v)v$.
      
@<Functions...@>=
      function cross_section_a(sp_dummy(t),vt,sp_dummy(b),vb,rc_dummy(r))
      implicit_none
      real cross_section_a        // Function
      sp_decl(t)                // Input
      rc_decl(r)
      sp_decl(b)
      real vt[3],vb[3]
      rc_common
      rd_common
      pr_common
      sp_common
      integer i // Local
      real cross_section,fvar[xs_table_rank_max],vrel[3],vr
      external interpolate1,interpolate2,interpolate3 // External
      real interpolate1,interpolate2,interpolate3
      
      assert( reaction_organization[r][rd_xs] == xs_organization_table )
      assert( reaction_data_var[r][rd_xs][0] == xs_var_cross_section )

      vc_difference(vt,vb,vrel)
      vr=vc_abs(vrel)

      do i=1,reaction_data_rank[r][rd_xs]
         if (reaction_data_var[r][rd_xs][i] == xs_var_energy) then
            fvar[i] = half*sp_m(t)*vr**2
         else if (reaction_data_var[r][rd_xs][i] == xs_var_sp_energy) then
            fvar[i] = half*vr**2
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_data_spacing[r][rd_xs][i] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_data_min[r][rd_xs][i])/reaction_data_delta[r][rd_xs][i]
      end do
      
      if (reaction_data_rank[r][rd_xs] == 1) then
         cross_section=interpolate1(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_xs]],
     $        reaction_data_tab_index[r][rd_xs][1])
      else if (reaction_data_rank[r][rd_xs] == 2) then
         cross_section=interpolate2(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_xs]],
     $        reaction_data_tab_index[r][rd_xs][1])
      else if (reaction_data_rank[r][rd_xs] == 3) then
         cross_section=interpolate3(fvar,
     $        reaction_data_table[reaction_data_base[r][rd_xs]],
     $        reaction_data_tab_index[r][rd_xs][1])
      end if
      
      if (reaction_data_spacing[r][rd_xs][0] == xs_spacing_log) cross_section=exp(cross_section)
      
      cross_section_a=cross_section*vr
      
      return
      end
      
@ The interpolation routines.  The one-dimensional one interpolates in
an array dimensioned |0:n-1| according to a floating point index |f|.
If |f| is out of range then we imagine the table continued as a
constant.

@m array1(i) array[i]
      
@<Functions...@>=
      function interpolate1(f,array,n)
      implicit_none
      real interpolate1         // Function
      integer n                 // Input
      real f,array[0:*]
      integer ia,ib           // Local
      real fx

      ia=int(f)
      if (f < areal(ia)) ia=ia-1
      fx=f-areal(ia)
      ib=ia+1
      ia=min(max(0,ia),n-1)
      ib=min(max(0,ib),n-1)
      interpolate1=array1(ia)*(one-fx)+array1(ib)*fx
      
      return
      end

@ The two-dimensional version.

@m array2(i,j) array[i+n[1]*j]

@<Functions...@>=
      function interpolate2(f,array,n)
      implicit_none
      real interpolate2         // Function
      integer n[2]              // Input
      real f[2],array[0:*]
      integer i,ia[2],ib[2]   // Local
      real fx[2]

      do i=1,2
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate2=
     $     array2(ia[1],ia[2])*(one-fx[1])*(one-fx[2])+
     $     array2(ia[1],ib[2])*(one-fx[1])*fx[2]+
     $     array2(ib[1],ia[2])*fx[1]*(one-fx[2])+
     $     array2(ib[1],ib[2])*fx[1]*fx[2]

      return
      end

@ The three-dimensional version.

@m array3(i,j,k) array[i+n[1]*(j+n[2]*k)]

@<Functions...@>=
      function interpolate3(f,array,n)
      implicit_none
      real interpolate3         // Function
      integer n[3]              // Input
      real f[3],array[0:*]
      integer i,ia[3],ib[3]   // Local
      real fx[3]

      do i=1,3
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate3=
     $     array3(ia[1],ia[2],ia[3])*(one-fx[1])*(one-fx[2])*(one-fx[3])+
     $     array3(ia[1],ia[2],ib[3])*(one-fx[1])*(one-fx[2])*fx[3]+
     $     array3(ia[1],ib[2],ia[3])*(one-fx[1])*fx[2]*(one-fx[3])+
     $     array3(ia[1],ib[2],ib[3])*(one-fx[1])*fx[2]*fx[3]+
     $     array3(ib[1],ia[2],ia[3])*fx[1]*(one-fx[2])*(one-fx[3])+
     $     array3(ib[1],ia[2],ib[3])*fx[1]*(one-fx[2])*fx[3]+
     $     array3(ib[1],ib[2],ia[3])*fx[1]*fx[2]*(one-fx[3])+
     $     array3(ib[1],ib[2],ib[3])*fx[1]*fx[2]*fx[3]
      
      return
      end
      
@ Read in the reaction data from a file.  (This routine used to be in |reactionsetup.web|.)

@<Functions...@>=
      subroutine reaction_read(num)
      implicit none
      integer num
      integer fileid // Local
      xs_common
      xs_ncdecl
      nc_common
      sy_common
      rc_common
      pr_common
      
      fileid = ncopen(rc_filename(pr_reaction(num)),NC_NOWRITE,nc_stat)
      
      xs_ncread(fileid)
      
      call ncclose(fileid,nc_stat)
      
      call xs_copy(num)

      var_free(xs_tab1)
      var_free(xs_tab2)
      var_free(xs_tab3)
      var_free(xs_tab4)
      var_free(xs_tab5)

      return
      end

@ Copy cross-section information into reaction arrays.

@<Functions...@>=
      subroutine xs_copy(num)
      implicit_none
      integer num                     // Input
      integer i,j,jdep,k,size,rd_ind        // Local
      real table_entry
      xs_common
      pr_common
      rc_common
      rd_common
      sy_common
      
      assert(xs_name==rc_sy(pr_reaction(num)))

      do j=1,xs_dep_var_max
         reaction_organization[num][j]=xs_organization_unknown
         reaction_data_rank[num][j]=0
         reaction_data_base[num][j]=0
         do i=0,xs_table_rank_max
            reaction_data_var[num][j][i]=xs_var_unknown
            reaction_data_spacing[num][j][i]=xs_spacing_unknown
         end do
      end do

      do j=1,xs_dep_var_max
         do i=1,xs_table_rank_max
            reaction_data_min[num][j][i]=zero
            reaction_data_delta[num][j][i]=zero
            reaction_data_tab_index[num][j][i]=zero
         end do
      end do

      do jdep=1,xs_num_dep_var
         if (xs_var[0,jdep] == 'rate' || xs_var[0,jdep] == 'reaction_rate' ) then
            rd_ind=rd_rate
         else if (xs_var[0,jdep] == 'cross_section') then
            rd_ind=rd_xs
         else
            goto skip
         end if

         assert(xs_organization[jdep]SP(1:5)=='table')
         if (xs_organization[jdep]SP(1:5)=='table') then
            reaction_organization[num][rd_ind]=xs_organization_table
         end if
         assert(xs_rank[jdep] > 0 && xs_rank[jdep] <= xs_table_rank_max)
         reaction_data_rank[num][rd_ind]=xs_rank[jdep]
         i=0
         assert(xs_spacing[i,jdep] == 'linear' || xs_spacing[i,jdep] == 'log')

         if (xs_spacing[i,jdep] == 'linear') then
            reaction_data_spacing[num][rd_ind][i]=xs_spacing_linear
         else if (xs_spacing[i,jdep] == 'log') then
            reaction_data_spacing[num][rd_ind][i]=xs_spacing_log
         end if
         if (xs_var[i,jdep] == 'rate' || xs_var[i,jdep] == 'reaction_rate') then
            reaction_data_var[num][rd_ind][i]=xs_var_rate
         else if (xs_var[i,jdep] == 'density') then
            reaction_data_var[num][rd_ind][i]=xs_var_density
         else if (xs_var[i,jdep] == 'temperature') then
            reaction_data_var[num][rd_ind][i]=xs_var_temperature
         else if (xs_var[i,jdep] == 'energy') then
            reaction_data_var[num][rd_ind][i]=xs_var_energy
         else if (xs_var[i,jdep] == 'specific_temperature') then
            reaction_data_var[num][rd_ind][i]=xs_var_sp_temperature
         else if (xs_var[i,jdep] == 'specific_energy') then
            reaction_data_var[num][rd_ind][i]=xs_var_sp_energy
         else if (xs_var[i,jdep] == 'cross_section') then
            reaction_data_var[num][rd_ind][i]=xs_var_cross_section
         end if
         size=1
         do i=1,xs_rank[jdep]
            reaction_data_tab_index[num][rd_ind][i] = xs_tab_index[i,jdep]
            assert(reaction_data_tab_index[num][rd_ind][i] > 1)
            if (xs_spacing[i,jdep] == 'linear') then
               reaction_data_spacing[num][rd_ind][i]=xs_spacing_linear
            else if (xs_spacing[i,jdep] == 'log') then
               reaction_data_spacing[num][rd_ind][i]=xs_spacing_log
            end if
            if (xs_var[i,jdep] == 'rate' || xs_var[i,jdep] == 'reaction_rate') then
               reaction_data_var[num][rd_ind][i]=xs_var_rate
            else if (xs_var[i,jdep] == 'density') then
               reaction_data_var[num][rd_ind][i]=xs_var_density
            else if (xs_var[i,jdep] == 'temperature') then
               reaction_data_var[num][rd_ind][i]=xs_var_temperature
            else if (xs_var[i,jdep] == 'energy') then
               reaction_data_var[num][rd_ind][i]=xs_var_energy
            else if (xs_var[i,jdep] == 'specific_temperature') then
               reaction_data_var[num][rd_ind][i]=xs_var_sp_temperature
            else if (xs_var[i,jdep] == 'specific_energy') then
               reaction_data_var[num][rd_ind][i]=xs_var_sp_energy
            end if
            size=size*reaction_data_tab_index[num][rd_ind][i]
            if (reaction_data_spacing[num][rd_ind][i] == xs_spacing_linear) then
               reaction_data_min[num][rd_ind][i]=xs_min[i,jdep]*xs_mult[i,jdep]
               reaction_data_delta[num][rd_ind][i]=
     $              (xs_max[i,jdep]-xs_min[i,jdep])*xs_mult[i,jdep]/
     $              areal(reaction_data_tab_index[num][rd_ind][i]-1)
            else if (reaction_data_spacing[num][rd_ind][i] == xs_spacing_log) then
               reaction_data_min[num][rd_ind][i]=log(xs_min[i,jdep]*xs_mult[i,jdep])
               reaction_data_delta[num][rd_ind][i]=
     $              log(xs_max[i,jdep]/xs_min[i,jdep])/
     $              areal(reaction_data_tab_index[num][rd_ind][i]-1)
            else
               assert('Unknown spacing type' == ' ')
            end if
         end do
         do i=xs_rank[jdep]+1,xs_table_rank_max
            reaction_data_tab_index[num][rd_ind][i]=1
         end do
         reaction_data_base[num][rd_ind]=rd_table_size
         var_reallocc(reaction_data_table,rd_table_size-1,rd_table_size-1+size)
         do k=0,xs_tab_index[3,jdep]-1
            do j=0,xs_tab_index[2,jdep]-1
               do i=0,xs_tab_index[1,jdep]-1
                  if (jdep == 1) then
                     table_entry=xs_table1(i,j,k)
                  else if (jdep == 2) then
                     table_entry=xs_table2(i,j,k)
                  else if (jdep == 3) then
                     table_entry=xs_table3(i,j,k)
                  else if (jdep == 4) then
                     table_entry=xs_table4(i,j,k)
                  else if (jdep == 5) then
                     table_entry=xs_table5(i,j,k)
                  end if
                  if (reaction_data_spacing[num][rd_ind][0] == xs_spacing_linear) then
                     rd_data3(num,rd_ind,i,j,k)=table_entry*xs_mult[0,jdep]
                  else
                     rd_data3(num,rd_ind,i,j,k)=log(table_entry*xs_mult[0,jdep])
                  end if
               end do
            end do
         end do
         rd_table_size=rd_table_size+size
skip: continue
      end do

      return
      end

@ Read in stuff.

@<Functions...@>=
      subroutine init_reaction
      implicit_none
      integer i                 // Local
      pr_common
      rd_common
      sy_common
            
      rd_table_size=0
      var_alloc(reaction_organization)
      var_alloc(reaction_data_min)
      var_alloc(reaction_data_delta)
      var_alloc(reaction_data_rank)
      var_alloc(reaction_data_spacing)
      var_alloc(reaction_data_base)
      var_alloc(reaction_data_tab_index)
      var_alloc(reaction_data_var)

      do i=1,pr_reaction_num
         write(stdout,*) pr_reaction(i)
         call reaction_read(i)
      end do
      return
      end

@* INDEX.
