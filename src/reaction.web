@ Return the reaction rate for a particular location and reaction.  This
uses the old hardwired scheme.
      
@<Functions...@>=
      function reaction_rate_old(pt_dummy(p),rc_dummy(r),bk_dummy(b))
      implicit_none
      real reaction_rate_old        // Function
      pt_decl(p)                // Input
      rc_decl(r)
      bk_decl(b)
      zn_common
      rc_common
      bk_common
      sp_common
      integer itemp,iden,ien    // Local
      real temp,den,en,ftemp,fden,fen,c00,c01,c10,c11,c0,c1,cross_section
      
      if (r == 1) then          // hionize
         den=log10(bk_n(b,lc_zone(pt_loc(p))))
         temp=log10(bk_temp(b,lc_zone(pt_loc(p))))
         den=(den-rc_logdensity_min)/rc_logdensity_delta
         den=min(max(zero,den),areal(rc_density_num))
         temp=(temp-rc_logenergy_min)/rc_logenergy_delta
         temp=min(max(zero,temp),areal(rc_energy_num))
         iden=min(rc_density_num-1,int(den))
         fden=den-areal(iden)
         itemp=min(rc_energy_num-1,int(temp))
         ftemp=temp-areal(itemp)
         c00=tn_cross_section_table[itemp,iden,r]
         c01=tn_cross_section_table[itemp,iden+1,r]
         c10=tn_cross_section_table[itemp+1,iden,r]
         c11=tn_cross_section_table[itemp+1,iden+1,r]
         c0=c00+fden*(c01-c00)
         c1=c10+fden*(c11-c10)
         cross_section=c0+ftemp*(c1-c0)
c         write(stdout,*) 'ionize',temp,den,cross_section
      else if (r == 2) then     // hchex
         en=log10(half*sp_m(pt_sp(p))*atomic_mass_unit/electron_charge*vc_abs(pt_v(p))**2)
         temp=log10(bk_temp(b,lc_zone(pt_loc(p))))
         en=(en-rc_logenergy_min)/rc_logenergy_delta
         en=min(max(zero,en),areal(rc_energy_num))
         temp=(temp-rc_logenergy_min)/rc_logenergy_delta
         temp=min(max(zero,temp),areal(rc_energy_num))
         ien=min(rc_energy_num-1,int(en))
         fen=en-areal(ien)
         itemp=min(rc_energy_num-1,int(temp))
         ftemp=temp-areal(itemp)
         c00=te_cross_section_table[itemp,ien,r]
         c01=te_cross_section_table[itemp,ien+1,r]
         c10=te_cross_section_table[itemp+1,ien,r]
         c11=te_cross_section_table[itemp+1,ien+1,r]
         c0=c00+fen*(c01-c00)
         c1=c10+fen*(c11-c10)
         cross_section=c0+ftemp*(c1-c0)
c         write(stdout,*) 'cx',temp,en,cross_section
      end if
      reaction_rate_old=cross_section*bk_n(b,lc_zone(pt_loc(p)))
      
      return
      end
      
      
@ Return the reaction rate for a particular location and reaction.
      
@<Functions...@>=
      function reaction_rate(pt_dummy(p),rc_dummy(r),bk_dummy(b))
      implicit_none
      real reaction_rate        // Function
      pt_decl(p)                // Input
      rc_decl(r)
      bk_decl(b)
      zn_common
      rc_common
      bk_common
      sp_common
      integer i // Local
      real cross_section,fvar[xs_table_rank_max]
      external interpolate1,interpolate2,interpolate3 // External
      real interpolate1,interpolate2,interpolate3
      
      assert( reaction_organization[r] == xs_organization_table )
      assert( reaction_xs_var[0,r] == xs_var_rate )

      do i=1,reaction_xs_rank[r]
         if (reaction_xs_var[i,r] == xs_var_density) then
            fvar[i] = bk_n(b,lc_zone(pt_loc(p)))
         else if (reaction_xs_var[i,r] == xs_var_energy) then
            fvar[i] = half*sp_m(pt_sp(p))*atomic_mass_unit*vc_abs(pt_v(p))**2
         else if (reaction_xs_var[i,r] == xs_var_temperature) then
            fvar[i] = electron_charge*bk_temp(b,lc_zone(pt_loc(p)))
         else
            assert('Unknown variable' == ' ')
         end if
         if (reaction_xs_spacing[i,r] == xs_spacing_log) fvar[i] = log(fvar[i])
         fvar[i] = (fvar[i]-reaction_xs_min[i,r])/reaction_xs_delta[i,r]
      end do
      
      if (reaction_xs_rank[r] == 1) then
         cross_section=interpolate1(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      else if (reaction_xs_rank[r] == 2) then
         cross_section=interpolate2(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      else if (reaction_xs_rank[r] == 3) then
         cross_section=interpolate3(fvar,
     $        reaction_xsection_table[reaction_xs_base[r]],
     $        reaction_xs_tab_index[1,r])
      end if
      
      if (reaction_xs_spacing[0,r] == xs_spacing_log) cross_section=exp(cross_section)
      
      reaction_rate=cross_section*bk_n(b,lc_zone(pt_loc(p)))
      
      return
      end
      
@ The interpolation routines.  The one-dimensional one interpolates in
an array dimensioned |0:n-1| according to a floating point index |f|.
If |f| is out of range then we imagine the table continued as a
constant.
      
@<Functions...@>=
      function interpolate1(f,array,n)
      implicit_none
      real interpolate1         // Function
      integer n                 // Input
      real f,array[0:n-1]
      integer ia,ib           // Local
      real fx

      ia=int(f)
      if (f < areal(ia)) ia=ia-1
      fx=f-areal(ia)
      ib=ia+1
      ia=min(max(0,ia),n-1)
      ib=min(max(0,ib),n-1)
      interpolate1=array[ia]*(one-fx)+array[ib]*fx
      
      return
      end

@ The two-dimensional version.

@<Functions...@>=
      function interpolate2(f,array,n)
      implicit_none
      real interpolate2         // Function
      integer n[2]              // Input
      real f[2],array[0:n[1]-1,0:n[2]-1]
      integer i,ia[2],ib[2]   // Local
      real fx[2]

      do i=1,2
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate2=
     $     array[ia[1],ia[2]]*(one-fx[1])*(one-fx[2])+
     $     array[ia[1],ib[2]]*(one-fx[1])*fx[2]+
     $     array[ib[1],ia[2]]*fx[1]*(one-fx[2])+
     $     array[ib[1],ib[2]]*fx[1]*fx[2]

      return
      end

@ The three-dimensional version.

@<Functions...@>=
      function interpolate3(f,array,n)
      implicit_none
      real interpolate3         // Function
      integer n[3]              // Input
      real f[3],array[0:n[1]-1,0:n[2]-1,0:n[3]-1]
      integer i,ia[3],ib[3]   // Local
      real fx[3]

      do i=1,3
         ia[i]=int(f[i])
         if (f[i] < areal(ia[i])) ia[i]=ia[i]-1
         fx[i]=f[i]-areal(ia[i])
         ib[i]=ia[i]+1
         ia[i]=min(max(0,ia[i]),n[i]-1)
         ib[i]=min(max(0,ib[i]),n[i]-1)
      end do
      interpolate3=
     $     array[ia[1],ia[2],ia[3]]*(one-fx[1])*(one-fx[2])*(one-fx[3])+
     $     array[ia[1],ia[2],ib[3]]*(one-fx[1])*(one-fx[2])*fx[3]+
     $     array[ia[1],ib[2],ia[3]]*(one-fx[1])*fx[2]*(one-fx[3])+
     $     array[ia[1],ib[2],ib[3]]*(one-fx[1])*fx[2]*fx[3]+
     $     array[ib[1],ia[2],ia[3]]*fx[1]*(one-fx[2])*(one-fx[3])+
     $     array[ib[1],ia[2],ib[3]]*fx[1]*(one-fx[2])*fx[3]+
     $     array[ib[1],ib[2],ia[3]]*fx[1]*fx[2]*(one-fx[3])+
     $     array[ib[1],ib[2],ib[3]]*fx[1]*fx[2]*fx[3]
      
      return
      end
      
      
      
      
      
      

      
