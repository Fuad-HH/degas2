@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'geomtest.web'

@I macros.hweb

@I geomint.hweb

@ The main program.

@a
      program geometry_test
      implicit_none

      call exercise_setup
      call read_geometry
      call exercise_track

      stop
      end

      @<Functions and Subroutines@>

@ Exercise the setup functions

@<Functions...@>=
      subroutine exercise_setup
      implicit_none
      integer nzones,nproc
      parameter (nzones=1158,nproc=8)
      zn_common
      bk_common
      sy_common
      real coeff[NCOEFFS],x1[3],x2[3],x[2,0:4],vol // Local
      integer face,cell1,cell2,n,zone
      gi_ext
      external init_geometry,
     $     add_surface,plane,end_geometry,check_geometry,print_geometry,
     $     erase_geometry       // External

      call readfilenames
      call init_geometry
      vc_set(x1,-one,-one,-one)
      vc_set(x2,one,one,one)
      call universal_cell(geometry_symmetry_plane,x1,x2,vol)
      write(stdout,*) vol
      zone=1
      n=0
      x[1,n]=x1[1]; x[2,n]=x1[2]; n++
      x[1,n]=x1[1]; x[2,n]=x2[2]; n++
      x[1,n]=x2[1]; x[2,n]=x2[2]; n++
      x[1,n]=x2[1]; x[2,n]=x1[2]; n++
      x[1,n]=x1[1]; x[2,n]=x1[2]
      call decompose_polygon(n,x,zone)
      zn_type_set(zone,zn_plasma)
      zn_volume(zone)=polygon_volume(n,x)

      call end_geometry
      call print_geometry(stdout)
      call check_geometry
            
      call write_geometry
      call erase_geometry

      return
      end

@ Exercise tracking.

@<Functions...@>=
      subroutine exercise_track
      implicit_none
      pt_decl(x)
      logical done
      real t
      integer i
      lc_common
      pt_common

      vc_set(lc_x(pt_loc(x)),zero,zero,zero)
      lc_set(pt_loc(x))
      pt_type(x)=pt_neutral
      vc_set(pt_v(x),zero,one,const(0.1))
      
      done=pt_track(const(5.0),t,x)
      write(stderr,*) t,(lc_x(pt_loc(x))[i],i=1,3)
      
      return
      end

@* INDEX.
