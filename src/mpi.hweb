@ Macro definitions for MPI.

\ID{$Id$}

@#if MPI

@m mp_decls
      include 'mpif.h';
      integer mpi_err ;
      integer mpi_status ;
      dimension mpi_status(MPI_STATUS_SIZE) @:

@m mpi_init
      call MPI_init(mpi_err);
      mpi_root=0;
      call MPI_comm_rank(MPI_COMM_WORLD, mpi_rank, mpi_err);
      call MPI_comm_size(MPI_COMM_WORLD, mpi_size, mpi_err) @;

@m mpi_end
      call MPI_finalize(mpi_err) @;

@m mpi_char MPI_CHARACTER
@m mpi_int MPI_INTEGER
@m mpi_real MPI_DOUBLE_PRECISION

@m mpi_broadcast(name)
      call MPI_bcast(name, array_size(name), $IFCASE(type_##name,mpi_char,mpi_int, mpi_real), mpi_root, MPI_COMM_WORLD, mpi_err) @;

@m mpi_send(name,dest,tag)
      call MPI_send(name, array_size(name), $IFCASE(type_##name,mpi_char,mpi_int, mpi_real), dest, tag, MPI_COMM_WORLD, mpi_err) @;

@m mpi_receive(name,source,tag)
      call MPI_recv(name, array_size(name), $IFCASE(type_##name,mpi_char,mpi_int, mpi_real), MPI_ANY_SOURCE, MPI_ANY_TAG, MPI_COMM_WORLD, mpi_status, mpi_err);
      source=mpi_status(MPI_SOURCE);
      tag=mpi_status(MPI_TAG) @;

@m mpi_master (mpi_rank==mpi_root)
@#else
@m mp_decls
@m mp_common
@m mpi_init
@m mpi_end
@m mpi_broadcast(name)
@m mpi_send(name dest,tag)
@m mpi_receive(name,source,tag)
@m mpi_master .true.
@#endif

@a
      package_init(mp)
@#if MPI      
      define_var_pk(mp,mpi_root,INT)
      define_var_pk(mp,mpi_size,INT)
      define_var_pk(mp,mpi_rank,INT)
@#endif
      package_end(mp)
