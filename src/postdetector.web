% $Id$
\Title{postdetector}

% $Log$
% Revision 1.1  2006/01/19 19:56:03  dstotler
% Added to repository.  Designed to reuse subroutines written for
% usr2ddetector.  Works with MPI.  Presently is specific for NSTX
% GPI, including computation of specific quantities that may only
% be of interest for those simulations.
%

@* Compute detector signals in a post-processing mode.  At present, this
code is specifically used for emulating the NSTX (2004) GPI camera view
(see also |gpicamera.web|).  In addition, a number of other diagnostic
data, some specific to this application, are also computed.

\ID{$Id$}

@m FILE 'postdetector.web'

@m MPI_messages 0

@I macros.hweb
@I string.hweb
@I geomint.hweb
@I zone.hweb
@I background.hweb
@I problem.hweb
@I species.hweb
@I detector.hweb
@I tally.hweb
@I output.hweb
@I netcdf.hweb
@I sysdep.hweb
@I readfilenames.hweb
@I reaction.hweb
@I materials.hweb
@I mpi.hweb

@ The main program.

@a
      program postdetector

      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls

      mpi_init

      if (mpi_master) call readfilenames
      call degas_init   // In |degasinit.web|

      if (mpi_master) then
/*
   This is not MPI-aware.  Instead, just need to extract the required
   data and broadcast it to the slaves.
*/
         call nc_read_output  // In |pmimatread.web|
         call fill_views_master
      else
         call fill_views_slave
      end if

      mpi_end

      stop
      end

      @<Functions and Subroutines@>

@ The mater routine for evaluating the views.

@#if 1
@m nx 64
@m ny 64
@#else
@m nx 5
@m ny 5
@#endif
@m a0 -const(3.60752)  // Coefficients of the camera's ``target plane''
@m a1 const(2.11865)
@m a2 const(3.17544)
@m phi const(6.146,1)*PI/const(1.8,2)  // Toroidal shift to my system

@<Functions...@>=
      subroutine fill_views_master

      define_varp(ha_data,FLOAT,zone_ind)
      define_varp(he_density,FLOAT,zone_ind)
      define_varp(zone_frags,FLOAT,zone_ind)

      implicit_none_f77
      sp_common
      pr_common
      tl_common
      ou_common
      bk_common
      zn_common
      de_common
      mp_common
      implicit_none_f90

      integer zone,test,ix,iy,inverted_iy,algorithm,nviews,nfrag,nparcel,
     $        nslaves,j,nstart,num,slave,send_data,iview,close_zone,
     $        nx_peak,iy_peak
      integer index_parameters[tl_index_max],target_map[nx][ny],
     $        target_map_slave[nx][ny]
      real ha_temp,ha_rate,halfwidth,signal,a0_p,a1_p,a2_p,dist,min_dist,
     $     nhe_eff2_sum,opt,max_opt,ha_avg,nhe_avg,
     $     peak,cy_l,cy_r
      real x_array[nx],y_array[ny],signal_array[nx][ny],
     $     signal_array_slave[nx][ny],
     $     target_r[nx][ny],target_z[nx][ny],target_nhe[nx][ny],
     $     w_per_atom[nx][ny],nhe_eff1[nx][ny],nhe_eff2[nx][ny],
     $     nhe_eff2_slave[nx][ny],fwpa_avg[nx][ny],fwpa_avg_slave[nx][ny],
     $     nhe_eff3[nx][ny],target_te[nx][ny],target_ne[nx][ny],
     $     profile[ny]
      vc_decl(points[de_view_start:de_view_end])
      external extract_output_datum,gpi_views
      real extract_output_datum

      declare_varp(ha_data)
      declare_varp(he_density)
      declare_varp(zone_frags)
      
      @<Memory allocation interface@>
      st_decls
      tl_decls
      vc_decls
      mp_decls
      
      var_alloc(ha_data)
      var_alloc(he_density)
      var_alloc(zone_frags)

      do zone=1,zn_num
         ha_data[zone]=zero
         he_density[zone]=zero
      end do

      do test=1,pr_test_num
         if (((sp_sy(pr_test(test)) == 'He')          // NEUTRAL He 5877 line
     $        && string_lookup('He 5877 emission rate',
     $        tally_name,tl_num) > 0)) then
            index_parameters[tl_index_test]=test
            ha_temp=zero
            do zone=1,zn_num
               if (zn_type(zone) == zn_plasma) then
                  index_parameters[tl_index_zone]=zone
                  ha_rate=extract_output_datum(index_parameters,1,
     $                 out_post_all,o_mean,
     $                 'He 5877 emission rate')
                  ha_data[zone]+=ha_rate
                  ha_temp+=ha_rate*zn_volume(zone)
                  he_density[zone]=extract_output_datum(index_parameters,1,
     $                 out_post_all,o_mean,'neutral density')
               else
                  ha_data[zone]=zero
                  he_density[zone]=zero
               end if
            end do
         end if
      end do

@#if MPI
      call MPI_bcast(ha_data,zn_num,mpi_real,mpi_root,MPI_COMM_WORLD,mpi_err)
      call MPI_bcast(he_density,zn_num,mpi_real,mpi_root,MPI_COMM_WORLD,mpi_err)
@#endif

      if (ha_temp > zero) then
         nviews=nx*ny
/*
   Copied this logic directly from |do_flights_master|.
*/
@#if MPI
         nslaves=mpi_size-1
@#else
         nslaves=0
@#endif
         nfrag=max(nviews/max(100,10*nslaves),1)  // Size of each chunk
         nparcel=(nviews+nfrag-1)/nfrag  // Number of chunks

@#if MPI
         do j=0,min(nparcel,nslaves)-1   // Send out the initial chunks
            nstart=j*nfrag
            num=min(nfrag,nviews-nstart)
            slave=j+1
@#if MPI_messages 
            write(stderr,*) 'Send initial batch of ', num, ' to slave ',slave
@#endif
            call slave_send_views(slave,nstart,num)
         end do
@#endif

         do j=min(nparcel,nslaves),nparcel-1  // Loop reading results and making additional requests
            nstart=j*nfrag
            num=min(nfrag,nviews-nstart)

@#if MPI
            if (nslaves > 0) then
               call slave_receive_flag(slave)
@#if MPI_messages
               write(stderr,*) 'Slave ',slave,' is done with a batch'
               write(stderr,*) 'Sending ',nfrag,' more to slave ',slave
@#endif 
               send_data=FALSE
               call slave_send_flag(slave,send_data)
               call slave_send_views(slave,nstart,num)
            else
               assert('Why is nslaves = 0 in an MPI run?' == ' ')
            end if
@#else
            @<Compute Signal@>
@#endif 

         end do

@#if MPI
         do j=0,min(nparcel,nslaves)-1   // Retrieve data from slaves this time
            call slave_receive_flag(slave)
            send_data=TRUE
            call slave_send_flag(slave,send_data)
            call slave_receive_data(slave,signal_array_slave,
     $           target_map_slave,nhe_eff2_slave,fwpa_avg_slave)

            do iy=1,ny
               do ix=1,nx
                  if (signal_array_slave[ix][iy] != real_unused) then
                     signal_array[ix][iy]=signal_array_slave[ix][iy]
                     assert(target_map_slave[ix][iy] != int_unused)
                     target_map[ix][iy]=target_map_slave[ix][iy]
                     assert(nhe_eff2_slave[ix][iy] != real_unused)
                     nhe_eff2[ix][iy]=nhe_eff2_slave[ix][iy]
                     fwpa_avg[ix][iy]=fwpa_avg_slave[ix][iy]
                  end if
               end do
            end do
            
         end do

         do j=0,nslaves-1     // Kill off slaves
            slave=j+1
            call slave_send_views(slave,0,0)
         end do
@#endif
      
         do ix=1,nx
            x_array[ix]=areal(ix-1)
         end do

         do iy=1,ny
            inverted_iy=ny-iy+1
            y_array[inverted_iy]=areal(iy-1)
         end do

         call wrdatap(signal_array,x_array,y_array,1,nx,1,ny,
     $        'he 5877 emission rate','ph/(s m^2 ster)','5877',1,1,'E11.3')

         nx_peak=33   // I.e., at cx = 32
         iy_peak=0
         peak=zero
         do iy=1,ny
            profile[iy]=signal_array[nx_peak][iy]
            if (profile[iy] > peak) then
               peak=profile[iy]
               iy_peak=iy
            end if
         end do
         assert(peak > zero)
         assert(iy_peak > 0)
         
         assert(half*peak > profile[1])
         cy_l=zero
         cy_r=zero
         do iy=1,ny
            if ((cy_l == zero) && (profile[iy] > half*peak)) then
               cy_l=y_array[iy-1]-(half*peak-profile[iy-1])
     $              /(profile[iy]-profile[iy-1])
            end if
            if ((cy_r == 0) && (cy_l > zero) && (profile[iy] < half*peak)) then
               cy_r=y_array[iy-1]-(half*peak-profile[iy-1])
     $              /(profile[iy]-profile[iy-1])
            end if
         end do
         open(unit=diskout,file='detectorprofile.txt',status='unknown')
         write(diskout,*) ' At cx = ',x_array[nx_peak],', peak = ',peak,
     $        ', at cy = ',y_array[iy_peak]
         write(diskout,*) ' Half peak at cy = ',cy_l,', and ',cy_r,
     $        ', FWHM = ',cy_r-cy_l
         write(diskout,*) 'iy   profile'
         do iy=1,ny
            write(diskout,*) y_array[iy],profile[iy]
         end do
         close(unit=diskout)

         do iy=1,ny
            do ix=1,nx
               assert(zn_check(target_map[ix][iy]))
               zone=target_map[ix][iy]
               target_r[ix][iy]=sqrt(zone_center[zone][1]**2
     $              +zone_center[zone][2]**2)
               target_z[ix][iy]=zone_center[zone][3]
               target_nhe[ix][iy]=he_density[zone]
               target_te[ix][iy]=bk_temp(1,zone)/electron_charge
               target_ne[ix][iy]=bk_n(1,zone)
               if (he_density[zone] > zero) then
                  w_per_atom[ix][iy]=ha_data[zone]/he_density[zone]
               else
                  w_per_atom[ix][iy]=zero
               end if
               if (w_per_atom[ix][iy] > zero) then
                  nhe_eff1[ix][iy]=signal_array[ix][iy]/w_per_atom[ix][iy]
               else
                  nhe_eff1[ix][iy]=zero
               end if
               if (fwpa_avg[ix][iy] > zero) then
                  nhe_eff3[ix][iy]=signal_array[ix][iy]/fwpa_avg[ix][iy]
               end if
            end do
         end do
      end if

      call wrdatap(target_r,x_array,y_array,1,nx,1,ny,
     $     'target major radius','m','tarr',1,1,'E11.3')
      call wrdatap(target_z,x_array,y_array,1,nx,1,ny,
     $     'target vertical coord','m','tarz',1,1,'E11.3')
      call wrdatap(target_nhe,x_array,y_array,1,nx,1,ny,
     $     'target He density','m^-3','tnhe',1,1,'E11.3')
      call wrdatap(target_te,x_array,y_array,1,nx,1,ny,
     $     'target electron temperature','eV','tate',1,1,'E11.3')
      call wrdatap(target_ne,x_array,y_array,1,nx,1,ny,
     $     'target electron density','m^-3','tane',1,1,'E11.3')
      call wrdatap(w_per_atom,x_array,y_array,1,nx,1,ny,
     $     'emission rate per atom','W','fwpa',1,1,'E11.3')
      call wrdatap(nhe_eff1,x_array,y_array,1,nx,1,ny,
     $     'effective helium density 1','m^-2 st^-1','nef1',1,1,'E11.3')
      call wrdatap(nhe_eff2,x_array,y_array,1,nx,1,ny,
     $     'effective helium density 2','m^-2 st^-1','nef2',1,1,'E11.3')
      call wrdatap(fwpa_avg,x_array,y_array,1,nx,1,ny,
     $     'avg emission rate per atom','W','favg',1,1,'E11.3')
      call wrdatap(nhe_eff3,x_array,y_array,1,nx,1,ny,
     $     'effective helium density 3','m^-2 st^-1','nef3',1,1,'E11.3')

      var_free(ha_data)
      var_free(he_density)
      var_free(zone_frags)

      return
      end

@* Compute signal.  This code is repeated in the master and slave |fill_views|
routines.

@m d_l0 const(5.,-2)     // Range for averaging about target plane
@m d_opt const(2.5,-1)   // Range for searching for a close zone

@<Compute Signal@>=
/*
   Rotate Ricky's ``target plane'' to my coordinate system.  The ``p''
   denotes ``prime''.
*/
      a0_p=a0*cos(phi)+a1*sin(phi)
      a1_p=a1*cos(phi)-a0*sin(phi)
      a2_p=a2
      do iview=nstart,nstart+num-1
         if (mod(iview+1,nx) != 0) then
            iy=(iview+1)/nx+1
            ix=(iview+1)-(iy-1)*nx
         else
            iy=(iview+1)/nx
            ix=nx
         end if
         call gpi_views(ix,nx,iy,ny,
     $        vc_args(points[de_view_start]),halfwidth,
     $        algorithm,zone_frags)
         signal=zero
         nhe_eff2_sum=zero
         ha_avg=zero
         nhe_avg=zero
         min_dist=const(1.,16)
         max_opt=const(1.,-16)
         close_zone=int_undef
         do zone=1,zn_num
            signal+=ha_data[zone]*zone_frags[zone]*zn_volume(zone)
            nhe_eff2_sum+=he_density[zone]*zone_frags[zone]*zn_volume(zone)
/*
   Hack to distill out zone closest to target plane.
*/
            dist=abs(a0_p*zone_center[zone][1]+a1_p*zone_center[zone][2]
     $              +a2_p*zone_center[zone][3]-one)
     $            /sqrt(a0_p**2+a1_p**2+a2_p**2)
            if (dist != zero) then
               opt=zone_frags[zone]*zn_volume(zone)/dist
            else
               assert(' Why is dist == 0?' == ' ')
            end if
@#if 0
            if ((zone_frags[zone] > zero) && (dist < min_dist)) then
@#endif
            if ((opt > max_opt) && (dist <= d_opt)) then
               max_opt=opt
               min_dist=dist
               close_zone=zone
            end if
/*
   Sums restricted to region around target plane.
*/
            if (dist <= d_l0) then
               ha_avg+=ha_data[zone]*zone_frags[zone]*zn_volume(zone)
               nhe_avg+=he_density[zone]*zone_frags[zone]*zn_volume(zone)
            end if
         end do
         inverted_iy=ny-iy+1
         signal_array[ix][inverted_iy]=signal
         nhe_eff2[ix][inverted_iy]=nhe_eff2_sum
         assert(close_zone != int_undef)
         assert(min_dist < const(1.,16))
         target_map[ix][inverted_iy]=close_zone
         assert(nhe_avg > zero)
         fwpa_avg[ix][inverted_iy]=ha_avg/nhe_avg
      end do

@ Slave version for filling views.

@<Functions...@>=
@#if MPI
      subroutine fill_views_slave

      define_varp(ha_data,FLOAT,zone_ind)
      define_varp(he_density,FLOAT,zone_ind)
      define_varp(zone_frags,FLOAT,zone_ind)

      implicit_none_f77
      mp_common
      zn_common
      implicit_none_f90

      integer iy,ix,tag,num,nstart,iview,algorithm,zone,inverted_iy,done_flag,
     $        send_data,close_zone
      integer target_map[nx][ny]
      real halfwidth,signal,a0_p,a1_p,a2_p,dist,min_dist,nhe_eff2_sum,
     $     opt,max_opt,ha_avg,nhe_avg
      real signal_array[nx][ny],nhe_eff2[nx][ny],fwpa_avg[nx][ny]
      vc_decl(points[de_view_start:de_view_end])

      declare_varp(ha_data)
      declare_varp(he_density)
      declare_varp(zone_frags)
      
      @<Memory allocation interface@>
      vc_decls
      mp_decls

      var_alloc(ha_data)
      var_alloc(he_density)
      var_alloc(zone_frags)

      call MPI_bcast(ha_data,zn_num,mpi_real,mpi_root,MPI_COMM_WORLD,mpi_err)
      call MPI_bcast(he_density,zn_num,mpi_real,mpi_root,MPI_COMM_WORLD,mpi_err)

      do iy=1,ny
         do ix=1,nx
            signal_array[ix][iy]=real_unused
            target_map[ix][iy]=int_unused
            nhe_eff2[ix][iy]=real_unused
            fwpa_avg[ix][iy]=real_unused
         end do
      end do

loop: continue
      tag=100
      call MPI_recv(num,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (num == 0) goto break
      tag++
      call MPI_recv(nstart,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      @<Compute Signal@>

      done_flag=TRUE
      tag=200
      call MPI_send(done_flag,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)

      tag=300
      call MPI_recv(send_data,1,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      if (send_data == FALSE) then
         goto loop
      else if (send_data == TRUE) then
         
         tag=400

         call MPI_send(signal_array,nx*ny,mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
         tag=401
         call MPI_send(target_map,nx*ny,mpi_int,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
         tag=402
         call MPI_send(nhe_eff2,nx*ny,mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
         tag=403
         call MPI_send(fwpa_avg,nx*ny,mpi_real,mpi_root,tag,MPI_COMM_WORLD,mpi_err)
         do iy=1,ny
            do ix=1,nx
               signal_array[ix][iy]=real_unused
               target_map[ix][iy]=int_unused
               nhe_eff2[ix][iy]=real_unused
               fwpa_avg[ix][iy]=real_unused
            end do
         end do

         goto loop
      else
         assert('Illegal value of send_data' == ' ')
      end if

break: continue

      var_free(ha_data)
      var_free(he_density)
      var_free(zone_frags)
      return
      end
@#else
      subroutine fill_views_slave
// dummy
      return
      end
@#endif

@ Send data to slave.

@<Functions...@>=
@#if MPI
      subroutine slave_send_views(slave,nstart,num)
      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls
      integer slave,nstart,num
      integer tag
      @<Memory allocation interface@>

      tag=100
      call MPI_send(num,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)
      if (num == 0) goto break
      tag++
      call MPI_send(nstart,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)

break: continue
      return
      end
@#endif

@ Receive notice from a slave indicating that it's done with current batch.

@<Functions...@>=
@#if MPI
      subroutine slave_receive_flag(slave)
      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls
      integer slave
      integer tag,done_flag
      @<Memory allocation interface@>

      tag=200
      call MPI_recv(done_flag,1,mpi_int,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      slave=mpi_status(MPI_SOURCE)
      assert(done_flag == TRUE)
      return
      end
@#endif

@ Send a flag to a slave instructing it to send back data from its flights.

@<Functions...@>=
@#if MPI
      subroutine slave_send_flag(slave,send_data)
      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls
      integer slave,send_data         // Input
      integer tag                     // Local
      @<Memory allocation interface@>

      tag=300
      call MPI_send(send_data,1,mpi_int,slave,tag,MPI_COMM_WORLD,mpi_err)

      return
      end
@#endif

@ Receive data from flights run by a slave.

@<Functions...@>=
@#if MPI
      subroutine slave_receive_data(slave,signal_array,target_map,nhe_eff2,fwpa_avg)
      implicit_none_f77
      mp_common
      implicit_none_f90
      mp_decls
      integer slave
      integer target_map[nx][ny]
      real signal_array[nx][ny],nhe_eff2[nx][ny],fwpa_avg[nx][ny]
      integer tag
      @<Memory allocation interface@>

      tag=400
      call MPI_recv(signal_array,nx*ny,mpi_real,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag=401
      call MPI_recv(target_map,nx*ny,mpi_int,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag=402
      call MPI_recv(nhe_eff2,nx*ny,mpi_real,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)
      tag=403
      call MPI_recv(fwpa_avg,nx*ny,mpi_real,MPI_ANY_SOURCE,tag,MPI_COMM_WORLD,mpi_status,mpi_err)

      return
      end
@#endif

@ Rearrange 2D array prior to writing.  This configuration is specific
to the 2004 NSTX Gas Puff Imaging experiments.

@<Functions...@>=
      subroutine wrdatap(pb2dat,xdat,ydat,kxmin,kx,kymin,ky,clabel,cunits,
     $                  cfilrt,kcount,kfilno,cformt)
      implicit_none_f77
      implicit_none_f90

      integer kcount,kfilno,kxmin,kx,ky,kymin     // Input
      character*(*) cunits,clabel
      character*4 cfilrt,cformt
      real xdat[kx],ydat[ky],pb2dat[kx][ky]

      integer ix,iy,ixprime,iyprime                // Local
      real xprime[ny],yprime[nx],pb2prime[ny][nx]

      assert(kx == nx)
      assert(ky == ny)
      assert(kx == ky)
/*
   The required mapping is equivalent to |rowflip(transpose(q))| in
   Transform.  Namely, swap |ix| and |iy|, and then invert the
   horizontal coordinate.  Note that we just assume that the
   dimensions are the same in both directions.
*/
      do iy=kymin,ky
         do ix=kxmin,kx
            ixprime=iy
            iyprime=kx-ix+1
            pb2prime[ixprime][iyprime]=pb2dat[ix][iy]
         end do
      end do
/*
   Apply equivalent transformations to the scales.
*/
      do ix=kxmin,kx
         xprime[ix]=ydat[ix]
      end do

      do iy=kymin,ky
         ixprime=ky-iy+1
         yprime[iy]=xdat[ixprime]
      end do
/*
   Call |wrdata| with the revised arrays
*/
      call wrdata(pb2prime,xprime,yprime,kxmin,kx,kymin,ky,clabel,cunits,
     $                  cfilrt,kcount,kfilno,cformt)

      return
      end

@ Write 2D array to HDF file.  Borrowed this from the H collisional
radiative code, irls.

@<Functions...@>=
      subroutine wrdata(pb2dat,xdat,ydat,kxmin,kx,kymin,ky,clabel,cunits,
     $                  cfilrt,kcount,kfilno,cformt)
      implicit_none_f77
      implicit_none_f90

      integer kcount,kfilno,kxmin,kx,ky,kymin     // Input
      character*(*) cunits,clabel
      character*4 cfilrt,cformt
      real xdat[kx],ydat[ky],pb2dat[kx][ky]

      integer icount,iret,ix,iy,irank              // Local
      integer*4 idim[2]
      character*9 cfile
      single_precision zdatic,zmax,zmin
      single_precision zxdat[kx],zydat[ky],zdata[kx*ky]

      integer dssdast,dssdims,dssdisc,dssrang,dspdata
      external dssdast,dssdims,dssdisc,dssrang,dspdata,xerrab
/*
   Set dimension sizes
*/
      irank=2
      idim[1]=kx-kxmin+1
      idim[2]=ky-kymin+1
/*
   Determine maximum and minimum; assign data to 1-D work array.
*/
      zmax=-const(1.,20)
      zmin=const(1.,20)
      icount=0

      do iy=kymin,ky
         zydat[iy]=single(ydat[iy])
         do ix=kxmin,kx
            zxdat[ix]=single(xdat[ix])
            icount++
            zdatic=pb2dat[ix][iy]
            zmax=max(zmax,zdatic)
            zmin=min(zmin,zdatic)
            zdata[icount]=zdatic
         end do
      end do
/*
   HDF set calls
*/
      iret=dssdims(irank,idim)
      assert(iret == 0)
      iret=dssdisc(1,idim[1],zxdat)
      assert(iret == 0)
      iret=dssdisc(2,idim[2],zydat)
      assert(iret == 0)
      iret=dssdast(clabel,cunits,cformt,'cartesian')
      assert(iret == 0)

      iret=dssrang(zmax,zmin)
      assert(iret == 0)
/*
   Construct filename
*/
      write (cfile,'(a4,i2.2,i3.3)') cfilrt,kcount,kfilno
/*
   Write 2-D data
*/
      iret=dspdata(cfile\/'.hdf',2,idim,zdata)
      assert(iret == 0)

      return
      end

