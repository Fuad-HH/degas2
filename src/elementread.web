@m FILE 'elementread.web'

@I macros.hweb

@i elements.hweb
@i netcdf.hweb

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Read in data from netcdf file \verb+elements.nc+
      
@<Functions...@>=
      subroutine nc_read_elements
      implicit_none
      decl_elements
      decl_netcdf
      integer fileid
      integer nelements_id,element_sy_id,element_m_id,element_z_id,
     $     element_name_id,element_symbol_string_id,element_name_string_id,
     $     element_ind_id
      external mem_alloc,ncopen,ncvarid,ncdimid
      integer mem_alloc,ncopen,ncvarid,ncdimid

      fileid = ncopen('../data/elements.nc',NC_NOWRITE,nc_stat)
      call ncattgetc(fileid,NC_GLOBAL,'data_version',
     $     elements_version,len(elements_version),nc_stat)
      var_inq(fileid,nelements)
      var_read(fileid,nelements)

      dimen_inq(fileid,element_symbol_string)
      dimen_inq(fileid,element_name_string)
      dimen_inq(fileid,element_ind)

      var_inq(fileid,element_sy)
      var_inq(fileid,element_name)
      var_inq(fileid,element_z)
      var_inq(fileid,element_m)
      
      var_alloc(element_sy)
      var_alloc(element_name)
      var_alloc(element_z)
      var_alloc(element_m)
      var_read(fileid,element_sy)
      var_read(fileid,element_name)
      var_read(fileid,element_z)
      var_read(fileid,element_m)
      
      call ncclose(fileid,nc_stat)

      return
      end

      



