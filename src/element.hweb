@* Element definitions.

% $Id$

% $Log$
% Revision 1.1  1992/11/13  17:58:50  karney
% Initial checkin
%

\ID{$Id$}

Information about elements is held in arrays in
common blocks.  An element is identified by an integer indexing into
these arrays.

@f el_decl integer

@m el_args(x) x

@m el_dummy(x) x

@m el_decl(x) integer x @;

@m el_copy(x,y) y=x @;

@m el_check(x) (x > 0 && x <= el_num)

@m el_name(x) element_name[x]
@m el_sy(x)   element_sy[x]
@m el_m(x)    element_m[x]
@m el_z(x)    element_z[x]

@ Length specifications.

@m el_sy_len 3
@m el_name_len 16

@ Variable definitions.

@a
      define_dimen(element_symbol_string,el_sy_len)
      define_dimen(element_name_string,el_name_len)
      define_dimen(element_ind,el_num)
      define_var(el_num,INT)
      define_var(element_name,CHAR,element_name_string,element_ind)
      define_var(element_sy,CHAR,element_symbol_string,element_ind)
      define_var(element_z,INT,element_ind)
      define_var(element_m,FLOAT,element_ind)

@ Common blocks definitions.

@f el_common integer
@m el_common
      declare_var(el_num);
      declare_varp(element_name);
      declare_varp(element_sy);
      declare_varp(element_z);
      declare_varp(element_m);
      common /com_element/ el_num,ptr_element_m,ptr_element_z,ptr_element_name,ptr_element_sy;
      character*80 element_version;
      common /com_element_c/ element_version;
      save /com_element/,/com_element_c/ @;
