@ The main program

@a
      @<Functions and subroutines@>

@ Handle scores of type ``test''.

@<Functions...@>=
      subroutine score_test(est,est_fac,pt_dummy(p),scores,estimator_factors)

      implicit_none_f77
      tl_common                                        // Common
      pr_common
      implicit_none_f90

      tl_decls
      integer est                                      // Input
      real est_fac
      pt_decl(p)
      real scores[0:*][o_mean:o_var]                   // Output

      integer back,i,jscore,num_scoring_data,pr_reac   // Local
      real scoring_data[scoring_data_max],
     $     background_sources[ou_back_max][ou_coupling_max]
      real estimator_factors[0:*]                      // Scratch
      character*tl_tag_length scoring_data_label[scoring_data_max]
      logical need_scores

      @<Memory allocation interface@>

      need_scores=.false.
      do i=1,tally_type_num[tl_type_test]
         jscore=tally_type_base[tl_type_test]+i-1
         estimator_factors[jscore]=tally_est_test[jscore][est]*est_fac*pt_w(p)
         if (estimator_factors[jscore] > zero) then
            need_scores=.true.
         end if
      end do

      if (need_scores) then

         num_scoring_data=0
         do i=1,scoring_data_max
            scoring_data[i]=zero
            scoring_data_label[i]='unknown'
         end do
         do back=1,pr_background_num
            do i=1,ou_coupling_max
               background_sources[back][i]=zero
            end do
         end do

         call test_scoring_data(pt_args(p),num_scoring_data,
     $        scoring_data,scoring_data_label,background_sources)

         pr_reac=0
         call add_scores(tl_type_test,pt_args(p),pr_reaction_args(pr_reac),
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        background_sources,estimator_factors,
     $        scores)
      end if

      return
      end

@ Fill in |scoring_data| for test species.

@<Functions...@>=
      subroutine test_scoring_data(pt_dummy(p),num_scoring_data,
     $     scoring_data,scoring_data_label,background_sources)

      implicit_none_f77
      sp_common                                     // Common
      implicit_none_f90

      pt_decl(p)                                    // Input
      integer num_scoring_data                      // Output
      real scoring_data[scoring_data_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      real background_sources[*][ou_coupling_max]


      num_scoring_data++
      scoring_data_label[num_scoring_data]='mass'
      scoring_data[num_scoring_data]=sp_m(pt_sp(p))

      num_scoring_data++
      scoring_data_label[num_scoring_data]='momentum 1'
      scoring_data[num_scoring_data]=sp_m(pt_sp(p))*pt_v(p)[1]

      num_scoring_data++
      scoring_data_label[num_scoring_data]='momentum 2'
      scoring_data[num_scoring_data]=sp_m(pt_sp(p))*pt_v(p)[2]

      num_scoring_data++
      scoring_data_label[num_scoring_data]='momentum 3'
      scoring_data[num_scoring_data]=sp_m(pt_sp(p))*pt_v(p)[3]

      num_scoring_data++
      scoring_data_label[num_scoring_data]='energy'
      scoring_data[num_scoring_data]=half*sp_m(pt_sp(p))*vc_abs2(pt_v(p))

      return
      end

@ Handle scores at diagnostic sectors.

@<Functions...@>=
      subroutine score_diagnostics(pt_dummy(p),scores,estimator_factors)

      implicit_none_f77
      tl_common                                        // Common
      pr_common
      sc_common
      implicit_none_f90
      
      tl_decls

      pt_decl(p)                                       // Input
      real scores[0:*][o_mean:o_var]                   // Output
      real estimator_factors[0:*]                      // Scratch

      integer back,i,jscore,num_scoring_data,pr_reac   // Local
      real scoring_data[scoring_data_max],
     $     background_sources[ou_back_max][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      logical need_scores

      @<Memory allocation interface@>

      need_scores=.false.
      do i=1,tally_type_num[tl_type_sector]
         jscore=tally_type_base[tl_type_sector]+i-1
/*
   This assumes that only scores involving |lc_sector| and |lc_sector_next|
   are being updated here. This is as in |handle_diagnostics|.
*/
         if ((sector_type_pointer[lc_sector(pt_loc(p))][sc_diagnostic(tally_geometry_ptr[jscore])] != 0) ||
     $        (sector_type_pointer[lc_sector_next(pt_loc(p))][sc_diagnostic(tally_geometry_ptr[jscore])] != 0)) then
            estimator_factors[jscore]=pt_w(p)
            need_scores=.true.
         else
            estimator_factors[jscore]=zero
         end if
      end do

      if (need_scores) then

         num_scoring_data=0
         do i=1,scoring_data_max
            scoring_data[i]=zero
            scoring_data_label[i]='unknown'
         end do
         do back=1,pr_background_num
            do i=1,ou_coupling_max
               background_sources[back][i]=zero
            end do
         end do

         call sector_scoring_data(pt_args(p),num_scoring_data,
     $        scoring_data,scoring_data_label,background_sources)

         pr_reac=0
         call add_scores(tl_type_sector,pt_args(p),pr_reaction_args(pr_reac),
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        background_sources,estimator_factors,
     $        scores)
      end if

      return
      end

@ Fill in |scoring_data| for sector diagnostics.

@<Functions...@>=
      subroutine sector_scoring_data(pt_dummy(p),num_scoring_data,
     $     scoring_data,scoring_data_label,background_sources)

      implicit_none_f77
      sp_common                                     // Common
      implicit_none_f90

      pt_decl(p)                                    // Input
      integer num_scoring_data                      // Output
      real scoring_data[scoring_data_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      real background_sources[*][ou_coupling_max]

      real cos_angle                                // Local


      external intersection_direction               // External
      real intersection_direction      

/* 
   Should we take these instead from |independent_parameters|? 
*/
      num_scoring_data++
      scoring_data_label[num_scoring_data]='mass'
      scoring_data[num_scoring_data]=sp_m(pt_sp(p))

      num_scoring_data++
      scoring_data_label[num_scoring_data]='angle'
      cos_angle=intersection_direction(lc_face(pt_loc(p)),lc_x(pt_loc(p))[1],
     $     pt_v(p)[1])
      scoring_data[num_scoring_data]=acos(cos_angle)

      num_scoring_data++
      scoring_data_label[num_scoring_data]='energy'
      scoring_data[num_scoring_data]=half*sp_m(pt_sp(p))*vc_abs2(pt_v(p))

      return
      end

@ Subroutine to score and process a reaction. The arguments here are |p|, 
the particle
index, |ts_reac|, the reaction index into the list of reactions participated
in by the test species corresponding to |p|, |nprod|, the number of products,
|prod|, their corresponding particle tags, and |x|, the current random
number thread. This routine uses |p| to pull together all of the more
specific information required by the lower level routines. The individual
pieces of data about the products they produce are incorporated into 
instances of the particle class.
      
@<Functions...@>=
      subroutine score_reaction(est,est_fac,
     $   pr_reaction_dummy(ts_reac),rate,
     $   nprod,pt_dummy(prod),scores,estimator_factors,rn_dummy(x))

      implicit_none_f77
      sp_common                             // Common
      pr_common
      rc_common
      rd_common
      tl_common
      implicit_none_f90

      rd_decls
      integer est                          // Input
      real est_fac,rate
      pr_reaction_decl(ts_reac)
      integer nprod                        // Output
      pt_decl(prod[0:rc_product_max])
      real scores[0:*][o_mean:o_var]
      real estimator_factors[0:*]          // Scratch
      rn_decl(x)                           // Input/output

      pr_reaction_decl(pr_reac)            // Local
      logical need_scores
      integer back,i,jscore,num_scoring_data
      real independent_parameters[xs_max_indep_params],
     $     scoring_data[scoring_data_max],
     $     background_sources[ou_back_max][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]

      st_decls
      @<Memory allocation interface@>

      pr_reac=pr_ts_rc(pt_test(prod[0]),ts_reac)

      need_scores=.false.
      nprod=0
      do i=1,tally_type_num[tl_type_reaction]
         jscore=tally_type_base[tl_type_reaction]+i-1
         assert(rate > zero)
         estimator_factors[jscore]=tally_est_reaction[jscore][est][pr_reac]
     $        *pt_w(prod[0])*est_fac
         if (estimator_factors[jscore] > zero) then
            need_scores=.true.
         end if
      end do

      if (need_scores || est == tl_est_collision) then
         num_scoring_data=0
         do i=1,scoring_data_max
            scoring_data[i]=zero
            scoring_data_label[i]='unknown'
         end do
         do back=1,pr_background_num
            do i=1,ou_coupling_max
               background_sources[back][i]=zero
            end do
         end do

         call set_indep_params(pt_args(prod[0]),
     $        pr_background_args(pr_ts_bk(pt_test(prod[0]),ts_reac)),
     $        reaction_handling_num_rand[pr_reac],
     $        rn_args(x),independent_parameters)

         if (est == tl_est_track || est == tl_est_post_process) then
            call pick_track_reaction(pr_test_args(pt_test(prod[0])),
     $           pr_reaction_args(ts_reac),rate,independent_parameters,
     $           num_scoring_data,scoring_data,scoring_data_label,
     $           background_sources,rn_args(x))
         else if (est == tl_est_collision) then
            call pick_reaction(pr_test_args(pt_test(prod[0])),
     $           pr_reaction_args(ts_reac),rate,independent_parameters,
     $           nprod,sp_args(pt_sp(prod[1])),vc_args(pt_v(prod[1])),
     $           pt_w(prod[1]),num_scoring_data,scoring_data,
     $           scoring_data_label,background_sources,rn_args(x))
         else
            assert('Unsupported estimator' == '')
         end if

         call add_scores(tl_type_reaction,pt_args(prod[0]),
     $        pr_reaction_args(pr_ts_rc(pt_test(prod[0]),ts_reac)),
     $        num_scoring_data,
     $        scoring_data,scoring_data_label,background_sources,
     $        estimator_factors,
     $        scores)
      end if

/*
   Create particle instances from products. 
*/
      if (nprod > 0) then
         do i=1,nprod
            pt_test(prod[i])=problem_species_test[pt_sp(prod[i])]
            lc_copy(pt_loc(prod[0]),pt_loc(prod[i]))
            pt_t(prod[i])=pt_t(prod[0])
            pt_w(prod[i])=pt_w(prod[0])*pt_w(prod[i])
            pt_author_rc(prod[i],pr_reac)
            if (sp_z(pt_sp(prod[i])) == 0) then
               pt_type(prod[i])=pt_neutral
            else
               pt_type(prod[i])=pt_ion
            end if
         end do
      end if

      return
      end

@ Score source group data. This is mostly a place-holder for future expansion.
For now it only handles recombination.

@<Functions...@>=
      subroutine score_sources(fl_dummy(x),scores,estimator_factors)

      implicit_none_f77
      so_common                                    // Common
      pr_common
      implicit_none_f90

      fl_decl(x)                                   // Input / Output

      real scores[0:*][o_mean:o_var]               // Output
      real estimator_factors[0:*]

      integer i,is,bk_rc_is                        // Local
      real rate


      external find_rate                           // External
      real find_rate

      is=fl_source(x)

      if (so_type(is) == so_recomb) then
         bk_rc_is=0
         do i=1,pr_bkrc_num
            if (pr_bkrc_prod(i,1) == so_species(is)) then
               assert(bk_rc_is == 0)
               bk_rc_is=i
            end if
         end do
         assert(bk_rc_is != 0)
         rate=find_rate(pt_args(fl_current(x)),   // OK?
     $                 pr_background_args(pr_bkrc_rg(bk_rc_is,1)),
     $                 pr_reaction_args(pr_bk_rc(bk_rc_is)),rn_args(x))
         call score_recombination(tl_est_collision,one/rate,pr_reaction_args(bk_rc_is),
     $        rate,pt_args(fl_current(x)),scores,estimator_factors,
     $        rn_args(fl_rand(x)))
//  No other source types being scored now
      end if

      return
      end

@ Scoring for recombination. 

@<Functions...@>=
      subroutine score_recombination(est,est_fac,pr_reaction_dummy(bk_rc_is),
     $     rate,pt_dummy(p),scores,estimator_factors,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rd_common
      tl_common
      so_common
      ou_common
      implicit_none_f90
      
      pt_decls
      rd_decls

      integer est                                      // Input
      real est_fac,rate
      pr_reaction_decl(bk_rc_is)
      pt_decl(p)
      real scores[0:*][o_mean:o_var]                   // Output
      real estimator_factors[0:*]                      // Scratch
      rn_decl(x)                                       // Input/output

      integer jscore,back,i,num_scoring_data  // Local
      real independent_parameters[xs_max_indep_params],
     $     scoring_data[scoring_data_max],
     $     background_sources[ou_back_max][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      logical need_scores
      pr_reaction_decl(pr_reac) 
      pr_background_decl(back_1)

      rn_decls
      @<Memory allocation interface@>

      pr_reac=pr_bk_rc(bk_rc_is)

      need_scores=.false.
      do i=1,tally_type_num[tl_type_reaction]
         jscore=tally_type_base[tl_type_reaction]+i-1
         assert(rate > zero)
         estimator_factors[jscore]=tally_est_reaction[jscore][est][pr_reac]
     $        *pt_w(p)*est_fac
         if (estimator_factors[jscore] > zero) then
            need_scores=.true.
         end if
      end do

      if (need_scores) then
         num_scoring_data=0
         do i=1,scoring_data_max
            scoring_data[i]=zero
            scoring_data_label[i]='unknown'
         end do
         do back=1,pr_background_num
            do i=1,ou_coupling_max
               background_sources[back][i]=zero
            end do
         end do

         back_1=pr_bkrc_rg(bk_rc_is,1)

         call set_indep_params(pt_args(p),
     $        pr_background_args(back_1),
     $        reaction_rate_num_rand[pr_reac],
     $        rn_args(x),independent_parameters)

         call recombination_data(pr_test_args(pt_test(p)),
     $        pr_reaction_args(bk_rc_is),est,
     $        rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        background_sources,rn_args(x))

         call add_scores(tl_type_reaction,pt_args(p),pr_reaction_args(pr_reac),
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        background_sources,estimator_factors,
     $        scores)

      end if      // |need_scores|
      
      return
      end

@ Loop through and fill all of the scores of this type.    
The geometry segments may be: a zone, a (diagnostic) sector, or a detector.
   Since more than one detector may be affected by this reaction, this routine
   actually returns an array |segments|. Likewise, in the simulation of certain
   detectors (e.g., spectrometers), it might be desirable to score signals on
   more than one scoring bin. Again, the affected bins are in an array |bins|.


@<Functions...@>=
      subroutine add_scores(type,pt_dummy(p),
     $   pr_reaction_dummy(pr_reac),num_scoring_data,
     $   scoring_data,scoring_data_label,background_sources,
     $   estimator_factors,
     $   scores)

      implicit_none_f77
      pr_common
      tl_common
      sc_common
      implicit_none_f90
      
      tl_decls

      integer type,num_scoring_data              // Input
      pt_decl(p)
      pr_reaction_decl(pr_reac)
      real scoring_data[scoring_data_max],
     $     background_sources[*][ou_coupling_max],estimator_factors[0:*]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      real scores[0:*][o_mean:o_var]             // Output

                                                 // Local
      integer i,k,l,jscore,back,number_segments,geom_seg_label,geom_seg,
     $     number_bins,bin_label,ibin,dep_index
      integer index_parameters[tl_index_unknown:tl_index_max],
     $     segments[max_segments],ind_val[tl_rank_max],bins[max_bins] 
      real geom_mult[max_segments][max_bins]

      integer match_back_source                   // External
      external match_back_source

      @<Memory allocation interface@>

      do i=1,tl_index_max
         index_parameters[i]=0
      end do

      index_parameters[tl_index_test]=pt_test(p)
      index_parameters[tl_index_test_author]=pt_author(p)
      index_parameters[tl_index_reaction]=pr_reac
      index_parameters[tl_index_sector]=lc_sector(pt_loc(p))
      index_parameters[tl_index_strata]=strata[lc_sector(pt_loc(p))]
      index_parameters[tl_index_strata_segment]=sector_strata_segment[lc_sector(pt_loc(p))]

      do i=1,tally_type_num[type]
         jscore=tally_type_base[type]+i-1
         if (tally_dep_var[jscore]SP(1:4) == 'back') then
            dep_index=match_back_source(tally_dep_var[jscore])
         else
            dep_index=0
/*
  The flip side of having the flexibility to specify |scoring_data| for
  some reactions and not for others is that |dep_index| is legitimately
  zero for the latter. Hence, we can't treat that as an error condition.
  Should we disable these scores (via |estimator_factors|) at a higher level?
*/
            if (num_scoring_data > 0) then
               assert(num_scoring_data <= scoring_data_max)
               do l=1,num_scoring_data
                  if (tally_dep_var[jscore] 
     $                 == scoring_data_label[l]) then
                     dep_index=l
                     go to break
                  end if
               end do
break:         continue
            end if
         end if

         if (estimator_factors[jscore] > zero && dep_index > 0) then

            call handle_geometry(pt_args(p),tally_geometry[jscore],
     $           tally_geometry_ptr[jscore],tally_dep_var[jscore],
     $           num_scoring_data,scoring_data,scoring_data_label,
     $           number_segments,segments,geom_seg_label,
     $           number_bins,bins,bin_label,geom_mult)

            do geom_seg=1,number_segments
               index_parameters[geom_seg_label]=segments[geom_seg]
               do ibin=1,number_bins
                  index_parameters[bin_label]=bins[ibin]
/*    Background scores: */
                  if (tally_dep_var[jscore]SP(1:4) == 'back') then
                     do back=1,pr_background_num
                        index_parameters[tl_index_back]=back
                        do k=1,tl_rank_max
                           if (k <= tally_rank[jscore]) then
                              ind_val[k]
     $                          =index_parameters[tally_indep_var[jscore][k]]-1
                              assert(ind_val[k] >= 0 
     $                          && ind_val[k] < tally_tab_index[jscore][k])
                           else
                              ind_val[k]=0
                           end if
                        end do
                        out_array(scores,ind_val[1],ind_val[2],ind_val[3],
     $                       ind_val[4],ind_val[5],jscore,o_mean)
     $                       += background_sources[back][dep_index]
     $                       *geom_mult[geom_seg][ibin]
     $                       *estimator_factors[jscore]
                     end do

                  else
/*     Other scores:  */
                     do k=1,tl_rank_max
                        if (k <= tally_rank[jscore]) then
                           ind_val[k]
     $                          =index_parameters[tally_indep_var[jscore][k]]-1
                           assert(ind_val[k] >= 0 
     $                          && ind_val[k] < tally_tab_index[jscore][k])
                        else
                           ind_val[k]=0
                        end if
                     end do
                     out_array(scores,ind_val[1],ind_val[2],ind_val[3],
     $                    ind_val[4],ind_val[5],jscore,o_mean)
     $                    += scoring_data[dep_index]
     $                    *geom_mult[geom_seg][ibin]*estimator_factors[jscore]
                  end if
               end do     // |ibin|
            end do        // |geom_seg|
         end if
      end do              // |jscore|

      return
      end

@ Determine which (one or more) geometrical elements are involved in this
score. Set also the ``bin'' numbers associated with any independent variable
tracked by those elements.

@<Functions...@>=
      subroutine handle_geometry(pt_dummy(p),geometry,
     $     pointer,dep_var,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     number_segments,segments,geom_seg_label,
     $     number_bins,bins,bin_label,geom_mult)

      implicit_none_f77
      tl_common
      pr_common
      implicit_none_f90
      
      tl_decls

      pt_decl(p)                                   // Input
      integer geometry,pointer,num_scoring_data
      real scoring_data[scoring_data_max]
      character*tl_tag_length dep_var
      character*tl_tag_length scoring_data_label[scoring_data_max]

                                                   // Output
      integer number_segments,geom_seg_label,number_bins,bin_label
      integer segments[max_segments],bins[max_bins]
      real geom_mult[max_segments][max_bins]


      number_segments=0
      segments[1]=0
      if (geometry == tl_geom_volume) then
         number_segments=1
         segments[1]=lc_zone(pt_loc(p))
         geom_seg_label=tl_index_zone
         number_bins=1
         bins[1]=0
         bin_label=tl_index_unknown
         geom_mult[1][1]=one
      else if (geometry == tl_geom_detector) then
         call handle_detectors(pt_args(p),pointer,dep_var,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        number_segments,segments,
     $        number_bins,bins,bin_label,geom_mult)
         geom_seg_label=tl_index_detector
      else if (geometry == tl_geom_surface) then
         call handle_diagnostics(pt_args(p),pointer,dep_var,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        number_segments,segments,
     $        number_bins,bins,bin_label,geom_mult)
         geom_seg_label=tl_index_diagnostic
      else
         assert("Untreated scoring geometry" == " ")
      end if

      return
      end

@ Determine which detectors (one or more) are involved in this score. The
only independent variable tracked on these detectors presently is the
wavelength of emissions. 

@<Functions...@>=
      subroutine handle_detectors(pt_dummy(p),pointer,dep_var,
     $   num_scoring_data,scoring_data,scoring_data_label,
     $   number_segments,segments,
     $   number_bins,bins,bin_label,geom_mult)

      implicit_none_f77
      de_common                                       // Common
      tl_common
      pr_common
      implicit_none_f90
      
      pt_decls
      tl_decls

      pt_decl(p)                                      // Input
      integer pointer,num_scoring_data
      real scoring_data[scoring_data_max]
      character*tl_tag_length dep_var
      character*tl_tag_length scoring_data_label[scoring_data_max]

      integer number_segments,number_bins,bin_label   // Output
      integer segments[max_segments],bins[max_bins]
      real geom_mult[max_segments][max_bins]

      integer de_group,iview,i,ibin                   // Local
      real lambda0,lambda,lambda_f,dl,vth,delta_l_th,f
      character*tl_tag_length line
      logical v1_set,v2_set,v3_set,vf1_set,vf2_set,vf3_set,vth_set
      vc_decl(v)
      
      lc_decls

      external find_lambda                            // External
      real find_lambda

      de_group=pointer
      number_segments=0
      assert(dep_var(1:13) == 'emission_rate')
      line=dep_var(14:)
      if (detector_var[de_group] == de_var_wavelength) then
         bin_label=tl_index_wavelength_bin
/*
   Flags to check for single particle velocity
*/
         v1_set=.false.
         v2_set=.false.
         v3_set=.false.
/*
   Flags to check for Maxwellian distributed velocity profile
*/
         vf1_set=.false.
         vf2_set=.false.
         vf3_set=.false.
         vth_set=.false.

         do i=1,num_scoring_data
            if (scoring_data_label[i] == 'emitter_v_1') then 
               v[1]=scoring_data[i]
               v1_set=.true.
            else if (scoring_data_label[i] == 'emitter_v_2') then 
               v[2]=scoring_data[i]
               v2_set=.true.
            else if (scoring_data_label[i] == 'emitter_v_3') then 
               v[3]=scoring_data[i]
               v3_set=.true.
            else if (scoring_data_label[i] == 'emitter_vf-Maxwell_1') then 
               v[1]=scoring_data[i]
               vf1_set=.true.
            else if (scoring_data_label[i] == 'emitter_vf-Maxwell_2') then 
               v[2]=scoring_data[i]
               vf2_set=.true.
            else if (scoring_data_label[i] == 'emitter_vf-Maxwell_3') then 
               v[3]=scoring_data[i]
               vf3_set=.true.
            else if (scoring_data_label[i] == 'emitter_vth-Maxwell') then
               vth=scoring_data[i]
               vth_set=.true.
            else if (scoring_data_label[i] == 'wavelength'\/line) then
               lambda0=scoring_data[i]
            end if
         end do
         assert(lambda0 > zero)
      else
         bin_label=tl_index_unknown
         number_bins=1
         bins[1]=0
      end if

      do i=1,detector_num_views[de_group]
         iview=de_view_pointer(i,de_group)
         if (de_zone_frags[lc_zone(pt_loc(p))][iview] != zero) then
            number_segments++
            segments[number_segments]=i
            if (detector_var[de_group] == de_var_wavelength) then
/*
   Single Particle Velocity
*/
               if (v1_set && v2_set && v3_set) then
                  lambda=find_lambda(vc_args(lc_x(pt_loc(p))),vc_args(v),
     $                 vc_args(de_view_points[iview][de_view_start]),lambda0)
                  number_bins=1
                  if (detector_spacing[de_group] == de_spacing_log)
     $                 lambda=log(lambda)
                  if (detector_spacing[de_group] == de_spacing_log
     $                 || detector_spacing[de_group] == de_spacing_linear) then
/*
   ``one'' inside ``int()'' $\Rightarrow$ get |lambda| < |detector_min| right.
*/
                     bins[1]=int((lambda-detector_min[de_group])
     $                    /detector_delta[de_group]+one) 
                  else
                     assert('Unsupported spacing' == ' ')
                  end if
                  if (bins[1] > 0 
     $                 && bins[1] <= detector_tab_index[de_group]) then
                     geom_mult[number_segments][1]=de_zone_frags[lc_zone(pt_loc(p))][iview]
                  else
                     bins[1]=1            
                     geom_mult[number_segments][1]=zero  // Outside bin range: throw out
                  end if
/*
   Maxwellian Distributed Profile
*/
               else if (vf1_set && vf2_set && vf3_set && vth_set) then
                  lambda_f=find_lambda(vc_args(lc_x(pt_loc(p))),vc_args(v),
     $                 vc_args(de_view_points[iview][de_view_start]),lambda0)
                  delta_l_th=lambda0*vth/speed_of_light
                  number_bins=detector_tab_index[de_group]
                  do ibin=1,number_bins
                     bins[ibin]=ibin
                     lambda=detector_min[de_group]
     $                    +(ibin-half)*detector_delta[de_group]
                     if (detector_spacing[de_group] == de_spacing_log) then
                        lambda=exp(lambda)
                        dl=lambda*detector_delta[de_group]
                     else
                        assert(detector_spacing[de_group] == de_spacing_linear)
                        dl=detector_delta[de_group]
                     end if
                     f=(exp(-half*(lambda-lambda_f)^2/delta_l_th^2))
     $                    /(delta_l_th*sqrt(two*PI))
                     geom_mult[number_segments][ibin]=f*dl
     $                    *de_zone_frags[lc_zone(pt_loc(p))][iview]
                  end do
               else
                  assert('Incomplete emitter velocity specification' == ' ')
               end if
            else
               bins[1]=0
               geom_mult[number_segments][1]=de_zone_frags[lc_zone(pt_loc(p))][iview]
            end if
         end if
      end do

      return
      end
                  
@ Calculate the Doppler-shifted wavelength of a photon emitted from a moving 
body relative to a detector. This code is conceptually identical to that 
employed in the original DEGAS code. 

@<Functions...@>=
      function find_lambda(vc_dummy(x),vc_dummy(v),
     $                 vc_dummy(x0_detector),lambda0)

      implicit_none_f77
      gi_common                               // Common
      implicit_none_f90

      real find_lambda                        // Function
      vc_decl(x)                              // Input
      vc_decl(v)
      vc_decl(x0_detector)
      real lambda0

      real rr,toroidal_angle,vrel             // Local
      vc_decl(vp) 
      vc_decl(xp)
      vc_decl(line_of_sight)

      vc_decls

      if (geometry_symmetry == geometry_symmetry_plane) then
         vc_set(xp,x[1],zero,x[3])
         vc_copy(v,vp)
      else if (geometry_symmetry == geometry_symmetry_cylindrical) then
         rr=sqrt(x[1]**2+x[2]**2)
         vc_set(xp,rr,zero,x[3])
         if (x[1] == zero && x[2] == zero) then
            toroidal_angle=half*PI
         else
            toroidal_angle=atan2(x[2],x[1])
            if (toroidal_angle < zero) then
               toroidal_angle+=two*PI
            end if
         end if
         vc_set(vp,v[1]*cos(toroidal_angle)+v[2]*sin(toroidal_angle),
     $        -v[1]*sin(toroidal_angle)+v[2]*cos(toroidal_angle),v[3])
      else
         vc_copy(x,xp)
         vc_copy(v,vp)
      end if
      vc_difference(xp,x0_detector,line_of_sight)
      vc_unit(line_of_sight,line_of_sight)
      vrel=vc_product(vp,line_of_sight)
      find_lambda=lambda0*(one+vrel/speed_of_light)

      return
      end

@ Translates between integer and string labels for the background sources.

@<Functions...@>=
      function match_back_source(dep_var)
      implicit_none_f77
      implicit_none_f90

      integer match_back_source            // Function
      character*tl_tag_length dep_var      // Input

      integer jdep                         // Local

      if (dep_var == 'back mass') then
         jdep=ou_coupling_mass
      else if (dep_var == 'back 1 momentum') then
         jdep=ou_coupling_momentum_1
      else if (dep_var == 'back 2 momentum') then
         jdep=ou_coupling_momentum_2
      else if (dep_var == 'back 3 momentum') then
         jdep=ou_coupling_momentum_3
      else if (dep_var == 'back energy') then
         jdep=ou_coupling_energy
      end if
      
      assert(jdep > 0 && jdep <= ou_coupling_max)

      match_back_source=jdep
      
      return
      end

@ Pick out the sectors involved in this score, and set the independent variable
bins. The treated variables thus far are energy and angle of incicidence.

@<Functions...@>=
      subroutine handle_diagnostics(pt_dummy(p),pointer,dep_var,
     $  num_scoring_data,scoring_data,scoring_data_label,
     $  number_segments,segments,
     $  number_bins,bins,bin_label,geom_mult)

      implicit_none_f77
      sc_common                                       // Common
      tl_common
      pr_common
      implicit_none_f90
      
      pt_decls
      tl_decls
      
      pt_decl(p)                                      // Input
      integer pointer,num_scoring_data
      real scoring_data[scoring_data_max]
      character*tl_tag_length dep_var
      character*tl_tag_length scoring_data_label[scoring_data_max]

      integer number_segments,number_bins,bin_label   // Output
      integer segments[max_segments],bins[max_bins]
      real geom_mult[max_segments][max_bins]

      integer diag_grp,i,j,idiag                     // Local
      real value
      sc_decl(sector1)
      sc_decl(sector2)

      lc_decls

      diag_grp=pointer
      number_segments=0
      number_bins=0
      sector1=lc_sector(pt_loc(p))
      sector2=lc_sector_next(pt_loc(p))

      if (diagnostic_var[diag_grp] == sc_diag_energy) then
         bin_label=tl_index_energy_bin
      else if (diagnostic_var[diag_grp] == sc_diag_angle) then
         bin_label=tl_index_angle_bin
      else
         bin_label=tl_index_unknown
         number_bins=1
         bins[1]=0
      end if

      do i=1,num_scoring_data
         if ((diagnostic_var[diag_grp] == sc_diag_energy
     $        && scoring_data_label[i] == 'energy') 
     $        || (diagnostic_var[diag_grp] == sc_diag_angle
     $        && scoring_data_label[i] == 'angle')) then
            value=scoring_data[i]

            if (diagnostic_spacing[diag_grp] == sc_diag_spacing_log) 
     $           value=log(value)
            if (diagnostic_spacing[diag_grp] == sc_diag_spacing_log
     $          || diagnostic_spacing[diag_grp] == sc_diag_spacing_linear) then
               number_bins++
               bins[number_bins]=int((value-diagnostic_min[diag_grp])
     $              /diagnostic_delta[diag_grp]+one)
            else
               assert('Unsupported spacing' == ' ')
            end if
            go to break
         end if
      end do
break: continue
               
/*
   {\em Note: if this code is modified so that sectors other than |lc_sector|
   or |lc_sector_next| are added to this |segments| list, a similar change
   needs to be made to |score_sector| where |estimator_factors| are set.}
*/
      idiag=sector_type_pointer[sector1][sc_diagnostic(diag_grp)]
      if (idiag != 0) then
         number_segments++
         segments[number_segments]=idiag
      end if

      idiag=sector_type_pointer[sector2][sc_diagnostic(diag_grp)]
      if (idiag != 0) then
         number_segments++
         segments[number_segments]=idiag
      end if

      assert(number_segments > 0 && number_bins > 0)
      do i=1,number_segments
         do j=1,number_bins
            if (bin_label != tl_index_unknown 
     $           && (bins[j] <= 0 
     $                || bins[j] > diagnostic_tab_index[diag_grp])) then
               bins[j]=1
               geom_mult[i][j]=zero  // Outside bin range: throw out
            else
               geom_mult[i][j]=one
            end if
         end do
      end do

      return
      end

@ Function to extract data from output arrays.

@<Functions...@>=
      function extract_output_datum(index_parameters,scores,name)

      implicit_none_f77
      tl_common                                  // Common
      pr_common
      implicit_none_f90
      
      tl_decls

      real extract_output_datum                  // Function
      integer index_parameters[tl_index_max]     // Input
      real scores[0:*][o_mean:o_var]  
      character*(*) name
      integer tally_number,i                     // Local
      integer ind_val[tl_rank_max]

      st_decls

      tally_number=string_lookup(name,tally_name,tl_num)
      assert(tally_number > 0)
      
      do i=1,tl_rank_max
         if (i <= tally_rank[tally_number]) then
            ind_val[i]=index_parameters[tally_indep_var[tally_number][i]]-1
            assert(ind_val[i] >= 0 
     $           && ind_val[i] < tally_tab_index[tally_number][i])
         else
            ind_val[i]=0
         end if
      end do

      extract_output_datum=out_array(scores,ind_val[1],ind_val[2],
     $              ind_val[3],ind_val[4],ind_val[5],tally_number,o_mean)

      return
      end




