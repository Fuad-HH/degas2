         x[1,i]=platea[1,1,j]; x[2,i]=platea[2,1,j]; i=i+1
         x[1,i]=platea[1,0,j]; x[2,i]=platea[2,0,j]; i=i+1
         x[1,i]=platea[1,3,j]; x[2,i]=platea[2,3,j]; i=i+1
      end do
      x[1,i]=x[1,0]
      x[2,i]=x[2,0]
/* write out points in file -- js */
