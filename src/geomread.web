      do j=1,9
         x[1,i]=plateb[1,4,j]; x[2,i]=plateb[2,4,j]; i=i+1
         x[1,i]=plateb[1,3,j]; x[2,i]=plateb[2,3,j]; i=i+1
         x[1,i]=plateb[1,2,j]; x[2,i]=plateb[2,2,j]; i=i+1
