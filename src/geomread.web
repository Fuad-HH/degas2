      zn_volume(zone)=zn_volume(zone)+polygon_volume(i,x)

      i=0
      do j=1,4
         x[1,i]=univ[1,j]; x[2,i]=univ[2,j]; i=i+1
      end do
      do j=16,9,-1
         x[1,i]=baffle[1,j]; x[2,i]=baffle[2,j]; i=i+1
      end do
      x[1,i]=x[1,0]
      x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_vacuum)
      zn_volume(zone)=zn_volume(zone)+polygon_volume(i,x)

      call end_geometry
@#if DEBUG
      call check_geometry
@#endif
      close(unit=20)
      
      call write_geometry
      call print_geometry(stdout)
      do i=1,zn_num
         assert(zn_volume(i)>0)
         vola=vola+zn_volume(i)
      end do
      write(stdout,*) vol,vola
      call erase_geometry
@#if 0
      call write_background
@#endif
      return
      end

@ New geometry input routine

@<Functions...@>=
      subroutine new_input_geometry
      implicit_none
      integer nx,ny

      open(unit=20,file='../data/b2specss',status='old',form='formatted')
      read(20,*) nx,ny
      read(20,*)
      read(20,*)
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      call init_background(nx,ny)
      call init_test
      call input_b2_geometry_a(nx,ny)
      call write_test
      close(unit=20)


      return
      end

@ Set up the background information.

@<Functions...@>=
      subroutine init_background(nx,ny)
      implicit_none
      integer nx,ny
      zn_common
      bk_common
      sp_common
      st_common
      sy_common
      vc_common
      
      bk_num=2
      var_alloc(background_sp)
      bk_sp(1)=sp_lookup('e')
      assert(bk_sp(1) > 0)
      bk_sp(2)=sp_lookup('H+')
      assert(bk_sp(2) > 0)
      
      return
      end

@ Write out background information.

@<Functions...@>=
      subroutine write_background
      implicit_none
      integer fileid
      zn_common
      bk_common
      bk_ncdecl
      vc_ncdecl
      nc_common

      fileid = nccreate('background.nc',NC_CLOBBER,nc_stat)
      vc_ncdef(fileid)
      bk_ncdef(fileid)
      call ncendef(fileid,nc_stat);
      vc_ncwrite(fileid)
      bk_ncwrite(fileid)
      call ncclose(fileid,nc_stat)

      return
      end

      
@ Set up test particle information.
      
@<Functions...@>=
      subroutine init_test
      implicit_none
      ts_common
      sp_common
      st_common
      sy_common
      rc_common
      zn_common
      bk_common
      integer i,j,k
      
      ts_num=2
      var_alloc(test_sp)
      var_alloc(test_reaction_num)
      var_alloc(test_reaction)
      var_alloc(test_target)
      
      ts_sp(1)=sp_lookup('0')
      assert(ts_sp(1) > 0)
      ts_sp(2)=sp_lookup('H')
      assert(ts_sp(2) > 0)
      
      do i=1,ts_num
         ts_rc_num(i)=0
         do j=1,rc_num
            if (rc_reagant_num(j) == 2) then
               do k=1,bk_num
                  if ( (rc_reagant(j,1)==ts_sp(i) && rc_reagant(j,2)==bk_sp(k))
     $                 || (rc_reagant(j,2)==ts_sp(i) && rc_reagant(j,1)==bk_sp(k)) ) then
                     ts_rc_num(i)=ts_rc_num(i)+1
                     ts_rc(i,ts_rc_num(i))=j
                     ts_tg(i,ts_rc_num(i))=k
                     goto break
                  end if
               end do
break:         continue
            end if
         end do
      end do
      
      return
      end

@ Write out test particle information.

@<Functions...@>=
      subroutine write_test
      implicit_none
      integer fileid
      ts_common
      ts_ncdecl
      nc_common

      fileid = nccreate('test.nc',NC_CLOBBER,nc_stat)
      ts_ncdef(fileid)
      call ncendef(fileid,nc_stat);
      ts_ncwrite(fileid)
      call ncclose(fileid,nc_stat)

      return
      end

      
      

