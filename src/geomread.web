@n/

@* A program to read in geometry from an external file and write out a
netcdf file.

\ID{$Id$}

@m FILE 'geomread.web'

@I macros.hweb

@I geomint.hweb

@I netcdf.hweb

@ The main program.

@a
      program geometry_read
      implicit_none

@#if 0
      call input_iter_geometry
@#else
      call new_input_geometry
@#endif
      stop
      end

      @<Functions and Subroutines@>

@ Read the geometry.

@<Functions...@>=
      subroutine input_geometry
      implicit_none
      gi_common
      real coeff[NCOEFFS],x1[3],x2[3],apex[3],x[2,0:99] // Local
      integer face,surf_type,zone,n,i,j
      external init_geometry,start_cell,sphere,define_surface,
     $     add_surface,plane,end_geometry,check_geometry,print_geometry,
     $     erase_geometry       // External
      integer define_surface,start_cell

      call init_geometry
      write(stdout,*) ncells
      open(unit=20,file='geometry.txt',status='old',form='formatted')
      read(20,*) zone,n
      assert(zone == 0 && n<=99)
      read(20,*) SP ((x[i,j],i=1,2),j=0,n)
      do j=0,n-1
         vc_set(x1,x[1,j],zero,x[2,j])
         vc_set(x2,x[1,j+1],zero,x[2,j+1])
         call conea(x1,x2,coeff,surf_type,apex)
         face=define_surface(coeff,.true.)
         call add_surface(face,0,.true.)
      end do
loop: continue
      read(20,*) zone,n
      if (zone == 0) goto break
      assert( n>0 && n<=99 )
      read(20,*) SP ((x[i,j],i=1,2),j=0,n)
      call decompose_polygon(n,x,zone)
      goto loop
break: continue
      call end_geometry
@#if DEBUG
      call check_geometry
@#endif
      close(unit=20)
      
      call write_geometry
      call erase_geometry
      return
      end

@ Secondary function to make memory allocation work
      
@<Functions...@>=
      subroutine input_b2_geometry_a(nx,ny)
      implicit_none
      integer nx,ny             // Input
      gi_common                 // Common
      zn_common
      vc_common
      bk_common
      sy_common
      integer ix,iy,i,j,n1,n2   // Local
      integer face,surf_type,zone
      real coeff[NCOEFFS],x1[3],x2[3],apex[3],x[2,0:99],a[3],x0[3]
      ptr_decl(ccr)
      ptr_decl(ccz)
      ptr_decl(ne)
      ptr_decl(te)
      ptr_decl(ti)
      ptr_decl(vi)
      real ccr[0:4,nx,ny],ccz[0:4,nx,ny],r0[0:4],z0[0:4],
     $     ne[nx,ny],te[nx,ny],ti[nx,ny],vi[3,nx,ny],dummyr,vol,vola
      character dummy
      external init_geometry,start_cell,sphere,define_surface,
     $     add_surface,plane,end_geometry,check_geometry,print_geometry,
     $     erase_geometry,polygon_volume // External
      integer define_surface,start_cell
      real polygon_volume

      
      real_alloc(ccr,nx*ny*5)
      real_alloc(ccz,nx*ny*5)
      real_alloc(ne,nx*ny)
      real_alloc(te,nx*ny)
      real_alloc(ti,nx*ny)
      real_alloc(vi,3*nx*ny)
      do j=1,nx*ny
         read(20,'(a11,2i3)') dummy,ix,iy
         read(20,*)
         read(20,*) SP (ccr[i,ix,iy],ccz[i,ix,iy],i=0,4)
         read(20,*)
         read(20,*) SP te[ix,iy],ne[ix,iy],ti[ix,iy]
         read(20,*)
         read(20,*) SP dummyr,(vi[i,ix,iy],i=1,3)
      end do

      call init_geometry

 /* Universe -- cell 0 */
      zone=0
      r0[0]=const(1.5); r0[1]=const(1.5); r0[2]=const(4.0); r0[3]=const(4.0)
      z0[0]=-const(2.5); z0[1]=const(0.5); z0[2]=const(0.5); z0[3]=-const(2.5)
      r0[4] = r0[0]
      z0[4] = z0[0]
      
      do j=0,3
         vc_set(x1,r0[j],zero,z0[j])
         vc_set(x2,r0[j+1],zero,z0[j+1])
         call conea(x1,x2,coeff,surf_type,apex)
         face=define_surface(coeff,.true.)
         call add_surface(face,0,.true.)
      end do
      
      vol=PI*(r0[2]^2-r0[0]^2)*(z0[2]-z0[0])

 /* Plasma zones */
      do iy=1,ny
         do ix=1,nx
            zone=zone+1
            x[1,0]=ccr[1,ix,iy]
            x[2,0]=ccz[1,ix,iy]
            x[1,1]=ccr[3,ix,iy]
            x[2,1]=ccz[3,ix,iy]
            x[1,2]=ccr[4,ix,iy]
            x[2,2]=ccz[4,ix,iy]
            x[1,3]=ccr[2,ix,iy]
            x[2,3]=ccz[2,ix,iy]
            x[1,4]=ccr[1,ix,iy]
            x[2,4]=ccz[1,ix,iy]
/* write out points in file -- js */
	do i=0,4
	 write (7,*)x[1,i],x[2,i]
	enddo
/*					*/
            call decompose_polygon(4,x,zone)
            zn_type_set(zone,zn_plasma)
            zn_volume(zone)=polygon_volume(4,x)
            zn_index(zone,1)=ix
            zn_index(zone,2)=iy
            bk_n(1,zone)=ne(ix,iy)
            bk_n(2,zone)=bk_n(1,zone)
            vc_copy(vi(ix,iy),bk_v(2,zone))
            vc_set(bk_v(1,zone),zero,zero,zero)
            bk_temp(1,zone)=te[ix,iy]
            bk_temp(2,zone)=ti[ix,iy]
         end do
      end do

 /* Central plasma region */
      zone=zone+1
      i=0
      do ix=1,nx/2
         x[1,i]=ccr[1,ix,1]; x[2,i]=ccz[1,ix,1]; i=i+1
      end do
      x[1,i]=ccr[2,nx/2,1]; x[2,i]=ccz[2,nx/2,1]; i=i+1
      x[1,i]=ccr[2,nx/2,1]; x[2,i]=ccz[1,1,1]; i=i+1
      x[1,i]=x[1,0]
      x[2,i]=x[2,0]
 /* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_plasma)
      zn_volume(zone)=polygon_volume(i,x)
      bk_n(1,zone)=const(5.0,20)
      bk_n(2,zone)=bk_n(1,zone)
      vc_set(bk_v(1,zone),zero,zero,zero)
      vc_set(bk_v(2,zone),zero,zero,zero)
      bk_temp(1,zone)=const(9.0,-17)
      bk_temp(2,zone)=const(9.0,-17)
      

 /* Divertor plate */
      zone=zone+1
      i=0
      x[1,i]=ccr[2,nx,1]; x[2,i]=-const(2.1); i=i+1
      do iy=1,ny
         x[1,i]=ccr[2,nx,iy]; x[2,i]=ccz[2,nx,iy]; i=i+1
      end do
      x[1,i]=ccr[4,nx,ny]; x[2,i]=ccz[4,nx,ny]; i=i+1
      x[1,i]=ccr[4,nx,ny]; x[2,i]=-const(2.1); i=i+1
      x[1,i]=x[1,0]
      x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_solid)
      zn_volume(zone)=polygon_volume(i,x)

 /* Excluded region */
      zone=zone+1
      i=0
      x[1,i]=r0[0]; x[2,i]=z0[0]; i=i+1
      x[1,i]=r0[1]; x[2,i]=z0[1]; i=i+1
      x[1,i]=r0[2]; x[2,i]=z0[2]; i=i+1
      x[1,i]=r0[2]-const(0.1); x[2,i]=ccz[3,1,ny]; i=i+1
      do iy=ny,1,-1
         x[1,i]=ccr[3,1,iy]; x[2,i]=ccz[3,1,iy]; i=i+1
      end do
      x[1,i]=ccr[1,1,1]; x[2,i]=ccz[1,1,1]; i=i+1
      x[1,i]=ccr[2,nx/2,1]; x[2,i]=ccz[1,1,1]; i=i+1
      do iy=1,6
         x[1,i]=ccr[2,nx/2,iy]; x[2,i]=ccz[2,nx/2,iy]; i=i+1
      end do
      do iy=6,1,-1
         x[1,i]=ccr[3,nx/2+1,iy]; x[2,i]=ccz[3,nx/2+1,iy]; i=i+1
      end do
      do ix=nx/2+1,nx
         x[1,i]=ccr[1,ix,1]; x[2,i]=ccz[1,ix,1]; i=i+1
      end do
      x[1,i]=ccr[2,nx,1]; x[2,i]=ccz[2,nx,1]; i=i+1
      x[1,i]=ccr[2,nx,1]; x[2,i]=-const(2.1); i=i+1
      x[1,i]=ccr[2,nx,1]; x[2,i]=z0[0]+const(0.1); i=i+1
      x[1,i]=x[1,0]
      x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_solid)
      zn_volume(zone)=polygon_volume(i,x)

 /* The wall */
      zone=zone+1
      i=0
      x[1,i]=r0[2]-const(0.1); x[2,i]=ccz[3,1,ny]; i=i+1
      x[1,i]=r0[2]; x[2,i]=z0[2]; i=i+1
      x[1,i]=r0[2]; x[2,i]=-1.7; i=i+1
      x[1,i]=2.7; x[2,i]=-1.7; i=i+1
      x[1,i]=3.3; x[2,i]=-1; i=i+1
      x[1,i]=3.5; x[2,i]=-.5; i=i+1
      x[1,i]=const(3.6); x[2,i]=ccz[3,1,ny]; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_volume(zone)=polygon_volume(i,x)

      i=0
      x[1,i]=r0[2]; x[2,i]=-1.7; i=i+1
      x[1,i]=r0[3]; x[2,i]=z0[3]; i=i+1
      x[1,i]=2.7; x[2,i]=z0[3]; i=i+1
      x[1,i]=3.5; x[2,i]=-1.7; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_solid)
      zn_volume(zone)=zn_volume(zone)+polygon_volume(i,x)

      n1=start_cell(zone+1)     // The vertical cylinder
      n2=start_cell(zone+1)     // The horizontal cylinder

      vc_set(x1,2.7,zero,z0[3])
      vc_set(x2,3.5,zero,-1.7)
      call conea(x1,x2,coeff,surf_type,apex)
      face=define_surface(coeff,.true.)
      call add_surface(face,n1,.true.)
      call add_surface(-face,n2,.true.)
      
      vc_set(x0,3.25,zero,zero)
      vc_set(a,zero,zero,one)
      call cylinder(x0,a,const(0.2),coeff)
      face=define_surface(coeff,.false.)
      call add_surface(-face,n1,.true.)
      call add_surface(face,n1-1,.true.)

      vc_set(x1,r0[3],zero,z0[3])
      vc_set(x2,r0[4],zero,z0[4])
      call conea(x1,x2,coeff,surf_type,apex)
      face=define_surface(coeff,.true.)
      call add_surface(face,n1,.true.)

      i=0
      x[1,i]=2.7; x[2,i]=z0[3]; i=i+1
      x[1,i]=2.7; x[2,i]=-1.7; i=i+1
      x[1,i]=3.5; x[2,i]=-1.7; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_volume(zone)=zn_volume(zone)+polygon_volume(i,x)

      vc_set(x0,zero,zero,-1.95)
      vc_set(a,one,zero,zero)
      call cylinder(x0,a,const(0.2),coeff)
      face=define_surface(coeff,.false.)
      call add_surface(-face,n2,.true.)
      call add_surface(face,n2+1,.true.)
      vc_set(x1,2.7,zero,z0[3])
      vc_set(x2,2.7,zero,-1.7)
      call conea(x1,x2,coeff,surf_type,apex)
      face=define_surface(coeff,.true.)
      call add_surface(face,n2,.true.)

      i=0
      x[1,i]=2.7; x[2,i]=z0[3]; i=i+1
      x[1,i]=r0[4]; x[2,i]=z0[4]; i=i+1
      x[1,i]=ccr[2,nx,1]; x[2,i]=z0[0]+const(0.1); i=i+1
      x[1,i]=ccr[2,nx,1]; x[2,i]=-const(2.1); i=i+1
      x[1,i]=ccr[4,nx,ny]; x[2,i]=-const(2.1); i=i+1
      x[1,i]=ccr[4,nx,ny]; x[2,i]=-2.2; i=i+1
      x[1,i]=2.7; x[2,i]=-2.2; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_volume(zone)=zn_volume(zone)+polygon_volume(i,x)

      zone=zone+1
      zn_type_set(zone,zn_vacuum)
      zn_volume(zone)=const(0.1)
      zn_volume(zone-1)=zn_volume(zone-1)-zn_volume(zone)

 /* Vacuum region */
      zone=zone+1
      i=0
      x[1,i]=const(3.6); x[2,i]=ccz[3,1,ny]; i=i+1

      x[1,i]=3.5; x[2,i]=-.5; i=i+1
      x[1,i]=3.3; x[2,i]=-1; i=i+1
      x[1,i]=2.7; x[2,i]=-1.7; i=i+1
      x[1,i]=2.7; x[2,i]=-2.2; i=i+1
      x[1,i]=ccr[4,nx,ny]; x[2,i]=-2.2; i=i+1

      x[1,i]=ccr[4,nx,ny]; x[2,i]=-const(2.1); i=i+1
      do ix=nx,1,-1
         x[1,i]=ccr[4,ix,ny]; x[2,i]=ccz[4,ix,ny]; i=i+1
      end do
      x[1,i]=ccr[3,1,ny]; x[2,i]=ccz[3,1,ny]; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
/* write out points in file -- js */
	do j=0,i
	 write (7,*)x[1,j],x[2,j]
	enddo
/*					*/
      call decompose_polygon(i,x,zone)
      zn_type_set(zone,zn_vacuum)
      zn_volume(zone)=polygon_volume(i,x)

      call end_geometry
@#if DEBUG
      call check_geometry
@#endif
      close(unit=20)
      
      call write_geometry
      vola=zero
      do i=1,zn_num
         assert(zn_volume(i)>0)
         vola=vola+zn_volume(i)
      end do
      write(stdout,*) vol,vola
      call erase_geometry
      call write_background
      return
      end

@ A fake ITER divertor

@<Functions...@>=
      subroutine input_iter_geometry
      implicit_none
      gi_common                 // Common
      zn_common
      vc_common
      bk_common
      sy_common
      real univ(2,0:4)
      data univ/0,0,0,20,16,20,16,0,0,0/
      real baffle(2,0:16)
      data baffle/5.5,1.1, 5,1.8, 13.8,8.9, 11,12.9, 6.5,11.8,
     $     6.5,13, 6.7,14, 7.1,15, 8,16, 9,16.5, 9.2,15.7,
     $     8.2,15, 7.6,14, 7.3,12.8, 11.5,13.9, 15,8.7, 5.5,1.1/
      real platea(2,0:4,6),plateb(2,0:4,9)
      integer i,j   // Local
      integer face,surf_type,zone
      real coeff[NCOEFFS],x1[3],x2[3],apex[3],x[2,0:99],vol,vola
      real d1[2],d2[2]
      external init_geometry,start_cell,sphere,define_surface,
     $     add_surface,plane,end_geometry,check_geometry,print_geometry,
     $     erase_geometry,polygon_volume // External
      integer define_surface,start_cell
      real polygon_volume

      
      call init_geometry

      do j=0,4
         univ[1,j] = 30 + univ[1,j]
      end do
      do j=0,16
         baffle[1,j] = 30 + baffle[1,j]
      end do

      d1[1]=-.05
      d1[2]=.1
      d2[1]=.8
      d2[2]=.4
      do j=1,6
         platea[1,0,j]=30 + 9.6+(j-1)*(7.9-9.6)/(6-1) + 0.01*sin(const(123.0)*j)
         platea[2,0,j]=6.4+(j-1)*(11.3-6.4)/(6-1)
         platea[1,1,j]=platea[1,0,j]+d1[1]
         platea[2,1,j]=platea[2,0,j]+d1[2]
         platea[1,2,j]=platea[1,1,j]+d2[1]
         platea[2,2,j]=platea[2,1,j]+d2[2]
         platea[1,3,j]=platea[1,2,j]-d1[1]
         platea[2,3,j]=platea[2,2,j]-d1[2]
         platea[1,4,j]=platea[1,0,j]
         platea[2,4,j]=platea[2,0,j]
      end do


      d1[1]=-.08
      d1[2]=.08
      d2[1]=.6
      d2[2]=.6
      do j=1,9
         plateb[1,0,j]=30 + 6.3+(j-1)*(0.9-6.3)/(9-1) + 0.01*sin(const(123.0)*j)
         plateb[2,0,j]=3.4+(j-1)*(9.7-3.4)/(9-1)
         plateb[1,1,j]=plateb[1,0,j]+d1[1]
         plateb[2,1,j]=plateb[2,0,j]+d1[2]
         plateb[1,2,j]=plateb[1,1,j]+d2[1]
         plateb[2,2,j]=plateb[2,1,j]+d2[2]
         plateb[1,3,j]=plateb[1,2,j]-d1[1]
         plateb[2,3,j]=plateb[2,2,j]-d1[2]
         plateb[1,4,j]=plateb[1,0,j]
         plateb[2,4,j]=plateb[2,0,j]
      end do

 /* Universe -- cell 0 */
      zone=0
      
      do j=0,3
         vc_set(x1,univ[1,j],zero,univ[2,j])
         vc_set(x2,univ[1,j+1],zero,univ[2,j+1])
         call conea(x1,x2,coeff,surf_type,apex)
         face=define_surface(coeff,.true.)
         call add_surface(face,zone,.true.)
      end do
      
      vol=PI*(univ[1,2]^2-univ[1,0]^2)*(univ[2,2]-univ[2,0])

 /* Divertor wall */
      zone=zone+1
      call decompose_polygon(16,baffle,zone)
      zn_type_set(zone,zn_solid)
      zn_volume(zone)=polygon_volume(16,baffle)

 /* Plates */
      zone=zone+1
      zn_volume(zone)=0
      do j=1,6
         call decompose_polygon(4,platea[1,0,j],zone)
         zn_volume(zone)=zn_volume(zone)+polygon_volume(4,platea[1,0,j])
      end do
      do j=1,9
         call decompose_polygon(4,plateb[1,0,j],zone)
         zn_volume(zone)=zn_volume(zone)+polygon_volume(4,plateb[1,0,j])
      end do
      zn_type_set(zone,zn_solid)
         
 /* Vacuum */
      zone=zone+1
      i=0
      do j=0,1
         x[1,i]=univ[1,j]; x[2,i]=univ[2,j]; i=i+1
      end do
      do j=9,4,-1
         x[1,i]=baffle[1,j]; x[2,i]=baffle[2,j]; i=i+1
      end do
      do j=9,1,-1
         x[1,i]=plateb[1,2,j]; x[2,i]=plateb[2,2,j]; i=i+1
         x[1,i]=plateb[1,1,j]; x[2,i]=plateb[2,1,j]; i=i+1
