@* A test program for the reaction routines.

\ID{$Id$}

@m FILE 'reactiontest.web'

@I macros.hweb

@ The main program.

@a
      program reactiontest
      implicit_none
      character*LINELEN line    // Local
      integer length,p,b,e
      real vt[3],vb[3],vrel,energy,density,temperature,rate
      external reaction_rate_a  // External
      real reaction_rate_a
      
      sp_decl(test)
      sp_decl(background)
      rc_decl(reaction)

      st_common
      el_common
      sp_common
      rc_common

      call readfilenames
      call init_reactiontest

loop: continue
      write(stdout,*) 'Enter symbols for test particle, background particle, reaction'

      if (! read_string(stdin,line,length)) goto eof
      assert(length<=len(line))
      length=parse_string(line(:length))
      p=0
      assert(next_token(line,b,e,p))
      test=sp_lookup(line(b:e))
      assert(next_token(line,b,e,p))
      background=sp_lookup(line(b:e))
      assert(next_token(line,b,e,p))
      reaction=rc_lookup(line(b:e))
      
      assert(test == rc_reagent(reaction,1))
      assert(background == rc_reagent(reaction,2))
      
      write(stdout,*) '     Test species is:       ',sp_name(test)
      write(stdout,*) '     Background species is: ',sp_name(background)
      write(stdout,*) '     Reaction name is:      ',rc_name(reaction)

loop1: continue

      write(stdout,'(/a)') 'Enter test energy, background density, temperature'
      
      if (! read_string(stdin,line,length)) goto loop
      assert(length<=len(line))
      length=parse_string(line(:length))
      p=0
      assert(next_token(line,b,e,p))
      energy=electron_charge*read_real(line(b:e))
      assert(next_token(line,b,e,p))
      density=read_real(line(b:e))
      assert(next_token(line,b,e,p))
      temperature=electron_charge*read_real(line(b:e))
      
      vrel=sqrt(two*energy/sp_m(test))
      vc_set(vt,vrel,zero,zero)
      vc_set(vb,zero,zero,zero)
      
      rate=reaction_rate_a(sp_args(test),vt,sp_args(background),density,vb,temperature,rc_args(reaction))
      write(stdout,*) '    Test energy = ',energy,' J'
      write(stdout,*) '    Background density = ',density,' m**-3'
      write(stdout,*) '    Background temperature = ',temperature,' J'
      write(stdout,*) '      => Reaction rate = ',rate,' m**3/s'
      
      goto loop1


eof:  continue
      stop
      end
      @<Functions and Subroutines@>

@* Initialize.

@<Functions...@>=
      subroutine init_reactiontest
      implicit_none
      
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      call nc_read_problem
      
      return
      end

@* INDEX.
      
