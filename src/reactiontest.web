% $Id$
\def\Wtitle{reaction}

% $Log$

@n/

@* A test program for the reaction routines.

\ID{$Id$}

@m FILE 'reactiontest.web'

@I macros.hweb

@ The main program.

@a
      program reactiontest
      implicit_none
      
      call init_reaction
      
      stop
      end
      @<Functions and Subroutines@>

@ Read in stuff.

@<Functions...@>=
      subroutine init_reaction
      implicit_none
      integer i                 // Local
      pr_common
      rd_common
      sy_common
            
      call nc_read_elements
      call nc_read_species
      call nc_read_reactions
      call nc_read_problem

      xs_base_max=0
      var_alloc(reaction_organization)
      var_alloc(reaction_xs_min)
      var_alloc(reaction_xs_delta)
      var_alloc(reaction_xs_rank)
      var_alloc(reaction_xs_spacing)
      var_alloc(reaction_xs_base)
      var_alloc(reaction_xs_tab_index)
      var_alloc(reaction_xs_var)

      do i=1,pr_reaction_num
         write(stdout,*) pr_reaction(i)
         call reaction_read(i)
      end do
      call reaction_data_write
      return
      end

      subroutine reaction_data_write
      implicit_none
      integer fileid            // Local
      pr_common
      pr_ncdecl
      rd_common
      rd_ncdecl
      nc_common
      
      fileid = nccreate('../data/test.nc',NC_CLOBBER,nc_stat)
      pr_ncdef(fileid)
      rd_ncdef(fileid)
      call ncendef(fileid,nc_stat)
      pr_ncwrite(fileid)
      rd_ncwrite(fileid)
      call ncclose(fileid,nc_stat)

      end

@* Index.
      
