      @<Functions and Subroutines@>

@ Look up an element based on it's symbol.  Returns the index into the
table of elements or zero if no such symbol.

@<Functions...@>=
      function element_lookup(symbol)
      integer element_lookup    // Function
      character*(*) symbol      // Input
      el_common                 // Common
      integer i                 // Local
      
      do i=1,el_num
         if (element_sy[i]==symbol) then
            element_lookup=i
            return
         end if
      end do
      
      element_lookup=0

      return
      end

@ A testing program

@<Functions...@>=
@#if 1
      program element_test
      implicit_none
      call element_testa
      stop
      end

      subroutine element_testa
      implicit_none
      character*(el_sy_len) sy
      integer key
      external string_length,element_lookup
      integer string_length,element_lookup
      el_common

      call nc_read_elements
      write(stdout,'(1x,a)') trim(element_version)

loop: write(stdout,'(1x,a)') 'Enter element'
      read(stdin,'(a)',end=eof) sy
      if (sy==' ') goto eof
      key=element_lookup(sy)
      if (key>0) write(stdout,'(1x,a,1x,a,i4,f10.5)')
     $     trim(sy),trim(element_name[key]),element_z[key],element_m[key]
      goto loop
eof:  continue

      stop
      end
@#endif

@ Read in data from netcdf file \verb+elements.nc+
      
@<Functions...@>=
      subroutine nc_read_elements
      implicit_none
      el_common
      decl_netcdf
      integer fileid
      el_ncdecl
      external mem_alloc,ncopen,ncvarid,ncdimid
      integer mem_alloc,ncopen,ncvarid,ncdimid

      fileid = ncopen('../data/elements.nc',NC_NOWRITE,nc_stat)
      call ncattgetc(fileid,NC_GLOBAL,'data_version',
     $     element_version,len(element_version),nc_stat)

      el_ncreada(fileid)
      el_ncreadb(fileid)
      el_ncreadc(fileid)
      
      call ncclose(fileid,nc_stat)

      return
      end

