@* Specification of the sources.  At present only surface sources are handled.


@m so_point 0
@m so_line 1
@m so_surface 2
@m so_volume 3

@ Definition of the common blocks.

@a
      package_init(so)
      define_var_pk(so,source_total,FLOAT)
      define_var_pk(so,so_num,INT)
      define_dimen_pk(so,source_ind,so_num)
      define_dimen_pk(so,source_ends,0,1)
      define_varp_pk(so,source_type,INT,source_ind)
      define_varp_pk(so,source_current,FLOAT,source_ind)
      define_varp_pk(so,source_pos,FLOAT,vc_ind,source_ends,source_ind)
      
      
@ Common blocks definitions.

@f so_common integer
@m so_common
      so_common_a @;


