@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Output a slice through the geometry to an HDF file, |hdffile|.  |first|
is |.true.| if this is the first image output.  Slice starts at $\vect x_0$
with the $x$ exis parallel to $\vect a$ and the $y$ axis parallel to $\vect
b$.  Size of the image is |alen| by |blen|.

@<Functions...@>=
      subroutine output_slice(hdffile,first,x0,a,b,alen,blen,func)
      implicit_none
      character*(*) hdffile     // File
      logical first             // Input
      real x0[3],a[3],b[3],alen,blen
      gi_common            // Input
      integer min_char,max_char,pixsize // Parameters
      parameter (min_char=2,max_char=255,pixsize=400000)
      integer DFTAG_RLE,DFTAG_IMC
      parameter (DFTAG_RLE=11, DFTAG_IMC=12)
      integer na,nb,i,j,ind,direction,ret,istart,istop,val // Local
      lc_decl(xx)
      lc_common
      real dx,v[3],vy[3],tmax,t,xpos
      logical done,ok
      character*1 ch[0:pixsize-1]
      character*1 palette(3,256)
      vc_common
      external DFR8putimage,DFR8addimage,DFR8setpalette,DFPgetpal // External
      integer DFR8putimage,DFR8addimage,DFR8setpalette,DFPgetpal
      external locate_point,track,func
      integer locate_point,func
      logical track

      assert(alen > 0 && blen > 0)
      dx = sqrt(alen*blen/areal(pixsize))
      na = int(alen/dx)
      nb = int(blen/dx)
      assert(na*nb <= pixsize)

      do j=0,na*nb-1
         ch[j]=char(0)
      end do

      vc_unit(b,vy)

      vc_xvt(x0,vy,half*dx,lc_x(xx))
/* write (stderr,*) 'lc_x(xx)',lc_x(xx) */
       lc_set(xx)

      assert(lc_cell(xx) > 0)

      vc_unit(a,v)
      direction=1
      xpos=zero
      
      do j=0,nb-1
         tmax=areal(na)*dx              // Go |alen| horizontally
loop:    continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),v,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         istart=int(xpos/dx+half)
         xpos=xpos+direction*t
         istop=int(xpos/dx+half)
         if (direction > 0) then
            istop = istop-1
         else
            istart = istart-1
         end if
         val=func(lc_args(xx),min_char,max_char)

         do i=istart,istop,direction
            ind=(nb-1-j)*na+i
            ch[ind]=char(val)
         end do
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then         // Still more to go
            assert(lc_cell(xx) != 0)
            goto loop
         end if
         assert(tmax == zero)
         tmax=dx                // Go |dx| vertically
loop1:   continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),vy,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then
            assert(lc_cell(xx) != 0)
            goto loop1
         end if
         assert(tmax == zero)
         direction=-direction   // Reversion horizontal direction
         if (direction > 0) then
            assert(abs(xpos) <= geom_epsilon)
            xpos = zero
         else
            assert(abs(xpos-areal(na)*dx) <= geom_epsilon)
            xpos = areal(na)*dx
         end if
         vc_scale(-one,v,v)
      end do

      ok=.true.
      do j=0,na*nb-1
         ok=ok && ch(j) != char(0)
      end do
      assert(ok)

      if (first) then
         ret = DFPgetpal('../output/rainbow.pal',palette)
         palette(1,256)=char(220)
         palette(2,256)=char(220)
         palette(3,256)=char(220)
         ret = DFR8setpalette(palette)
         ret = DFR8putimage(hdffile,ch,na,nb,DFTAG_RLE)
      else
         ret = DFR8addimage(hdffile,ch,na,nb,DFTAG_RLE)
      end if

      return
      end

@ The zone value.

@<Functions...@>=
      function zone_func(lc_dummy(x),min_char,max_char)
      implicit_none
      integer zone_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      
      zone_func=min_char+mod(97*lc_zone(x),max_char-min_char)
      
      return
      end

@ The electron density value.

@<Functions...@>=
      function density_func(lc_dummy(x),min_char,max_char)
      implicit_none
      integer density_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      zn_common
      bk_common
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         density_func=1
      else if (zn_type(lc_zone(x)) == zn_solid) then
         density_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         density_func=min_char+
     $        int( (log( bk_n(1,lc_zone(x)) )-log(const(2.0,16)))/
     $        (log(const(1.0,21))-log(const(2.0,16)))*
     $        (max_char-min_char))
         density_func=min(max(density_func,min_char),max_char-1)
      end if

      return
      end

@ The election temperature value.

@<Functions...@>=
      function te_func(lc_dummy(x),min_char,max_char)
      implicit_none
      integer te_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      zn_common
      bk_common
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         te_func=1
      else if (zn_type(lc_zone(x)) == zn_solid) then
         te_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         te_func=min_char+
     $        int((log( bk_temp(1,lc_zone(x)) )-log(const(1.0)))/
     $        (log(const(1000.0))-log(const(1.0)))*
     $        (max_char-min_char))
         te_func=min(max(te_func,min_char),max_char-1)
      end if

      return
      end

@ The ion temperature value.

@<Functions...@>=
      function ti_func(lc_dummy(x),min_char,max_char)
      implicit_none
      integer ti_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      zn_common
      bk_common
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         ti_func=1
      else if (zn_type(lc_zone(x)) == zn_solid) then
         ti_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         ti_func=min_char+
     $        int((log( bk_temp(2,lc_zone(x)) )-log(const(1.0)))/
     $        (log(const(1000.0))-log(const(1.0)))*
     $        (max_char-min_char))
         ti_func=min(max(ti_func,min_char),max_char-1)
      end if

      return
      end

@ The stat value.

@<Functions...@>=
      function stat_func(lc_dummy(x),min_char,max_char)
      implicit_none
      integer stat_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      zn_common
      bk_common
      ptr_decl(stat)
      real stat[2,zn_num],smin,smax
      common /stat_com/ smin,smax,ptr_stat
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         stat_func=1
      else if (zn_type(lc_zone(x)) == zn_solid) then
         stat_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         if (stat[1,lc_zone(x)] <= zero) then
            stat_func=min_char
         else
            stat_func=min_char+
     $           int((log( stat[1,lc_zone(x)] )-
     $           log(smin))/
     $           (log(smax)-log(smin))*
     $           (max_char-min_char))
            stat_func=min(max(stat_func,min_char),max_char-1)
         end if
      end if

      return
      end

      subroutine stat_read
      implicit_none
      zn_common
      sy_common
      integer j
      ptr_decl(stat)
      real stat[2,zn_num],smin,smax
      common /stat_com/ smin,smax,ptr_stat

      real_alloc(stat,2*zn_num)
      open(unit=diskin,file='stat.dat')
      read(diskin,*) stat
      close(diskin)
      smin=one
      smax=zero
      do j=1,zn_num
         stat[1,j]=stat[1,j]/zn_volume(j)
         if (stat[1,j]>0) then
            smin=min(smin,stat[1,j])
            smax=max(smax,stat[1,j])
         end if
      end do

      return
      end

