      @<Functions and Subroutines@>

@ Output a slice through the geometry to an HDF file, |hdffile|.  |first|
is |.true.| if this is the first image output.  Slice starts at $\vect x_0$
with the $x$ exis parallel to $\vect a$ and the $y$ axis parallel to $\vect
b$.  Size of the image is |alen| by |blen|. |x0| must be within the problem
space (i.e., not within a solid). The units of |alen| and |blen| are those
of the spatial dimensions (i.e., |x0| + |alen|,|blen| must also be within
the problem space).

@<Functions...@>=
      subroutine output_slice(hdffile,first,x0,a,b,alen,blen,func)
      implicit_none_f77
      gi_common            // Input
      implicit_none_f90
      character*(*) hdffile     // File
      logical first             // Input
      real x0[3],a[3],b[3],alen,blen
      integer min_char,max_char,pixsize // Parameters
      parameter (min_char=3,max_char=255,pixsize=6400000) // not pixsize: max. no. of pixels
      integer DFTAG_RLE,DFTAG_IMC
      parameter (DFTAG_RLE=11, DFTAG_IMC=12)
      integer na,nb,i,j,ind,direction,ret,istart,istop,val // Local
      lc_decl(xx)
      lc_decls
      real dx,v[3],vy[3],tmax,t,xpos
      logical done,ok
      character*1 ch[0:pixsize-1]
      character*1 palette[0:255][3]
      vc_decls
      external DFR8putimage,DFR8addimage,DFR8setpalette,DFPgetpal // External
      integer DFR8putimage,DFR8addimage,DFR8setpalette,DFPgetpal
      external track,func
      integer func
      logical track

      assert(alen > 0 && blen > 0)
      dx = sqrt(alen*blen/areal(pixsize))  // length of one pixel
      na = int(alen/dx)                    // na is the number of pixels in a
      nb = int(blen/dx)                    // nb .... in b
      assert(na*nb <= pixsize)

      do j=0,na*nb-1
         ch[j]=char(0)         // array ch will hold plot data; initialize here
      end do
/* Side note: |char(i)| is an intrinsic function which returns the |i|th
   entry in the character collating sequence, $0 \leq i \leq 255$; i.e.,
   character variables are effectively 8 bit integers. */

      vc_unit(b,vy)            // vy is unit vector corresponding to b

      vc_xvt(x0,vy,half*dx,lc_x(xx))       // step along b half a pixel

       lc_set(xx)

      assert(lc_cell(xx) > 0)

      vc_unit(a,v)
      direction=1
      xpos=zero
      
      do j=0,nb-1
         tmax=areal(na)*dx              // Go |alen| horizontally
loop:    continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),v,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx),lc_sector(xx),lc_sector_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         istart=int(xpos/dx+half)
         xpos=xpos+direction*t
         istop=int(xpos/dx+half)
/*         write(stderr,*) j,istart,istop,xpos,tmax */
         if (direction > 0) then
            istop = istop-1
         else
            istart = istart-1
         end if
         val=func(lc_args(xx),min_char,max_char)

         do i=istart,istop,direction
            ind=(nb-1-j)*na+i
            ch[ind]=char(val)
         end do
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then         // Still more to go
            if (lc_cell(xx) == 0) then
               write (stderr,*) j,istart,istop,xpos,tmax
            assert(lc_cell(xx) != 0)
            end if
            goto loop
         end if
         assert(tmax == zero)
         tmax=dx                // Go |dx| vertically
loop1:   continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),vy,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx),lc_sector(xx),lc_sector_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then
            assert(lc_cell(xx) != 0)
            goto loop1
         end if
         assert(tmax == zero)
         direction=-direction   // Reversion horizontal direction
         if (direction > 0) then
            assert(abs(xpos) <= geom_epsilon)
            xpos = zero
         else
            assert(abs(xpos-areal(na)*dx) <= geom_epsilon)
            xpos = areal(na)*dx
         end if
         vc_scale(-one,v,v)
      end do

      ok=.true.
      do j=0,na*nb-1
         ok=ok && ch(j) != char(0)
      end do
      assert(ok)

      if (first) then
         ret = DFPgetpal('../output/rainbow.pal',palette)
         palette[255][1]=char(220)
         palette[255][2]=char(220)
         palette[255][3]=char(220)
         palette[1][1]=char(255)
         palette[1][2]=char(255)
         palette[1][3]=char(255)
         palette[2][1]=char(0)
         palette[2][2]=char(0)
         palette[2][3]=char(0)
         ret = DFR8setpalette(palette)
         ret = DFR8putimage(hdffile,ch,na,nb,DFTAG_RLE)
      else
         ret = DFR8addimage(hdffile,ch,na,nb,DFTAG_RLE)
      end if

      return
      end

@ The zone value.

@<Functions...@>=
      function zone_func(lc_dummy(x),min_char,max_char)
      implicit_none_f77
      implicit_none_f90
      integer zone_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      
      zone_func=min_char+mod(97*lc_zone(x),max_char-min_char)
      
      return
      end

@ The electron density value.

@<Functions...@>=
      function density_func(lc_dummy(x),min_char,max_char)
      implicit_none_f77
      zn_common
      bk_common
      implicit_none_f90
      integer density_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         density_func=1
      else if (zn_type(lc_zone(x)) == zn_exit) then
         density_func=2
      else if (zn_type(lc_zone(x)) == zn_solid) then
         density_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         density_func=min_char+
     $        int( (log( bk_n(1,lc_zone(x)) )-log(const(2.0,16)))/
     $        (log(const(1.0,21))-log(const(2.0,16)))*
     $        (max_char-min_char))
         density_func=min(max(density_func,min_char),max_char-1)
      end if

      return
      end

@ The election temperature value.

@<Functions...@>=
      function te_func(lc_dummy(x),min_char,max_char)
      implicit_none_f77
      zn_common
      bk_common
      implicit_none_f90
      integer te_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         te_func=1
      else if (zn_type(lc_zone(x)) == zn_exit) then
         te_func=2
      else if (zn_type(lc_zone(x)) == zn_solid) then
         te_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         te_func=min_char+
     $        int((log( bk_temp(1,lc_zone(x))/electron_charge )-log(const(1.0)))/
     $        (log(const(1000.0))-log(const(1.0)))*
     $        (max_char-min_char))
         te_func=min(max(te_func,min_char),max_char-1)
      end if

      return
      end

@ The ion temperature value.

@<Functions...@>=
      function ti_func(lc_dummy(x),min_char,max_char)
      implicit_none_f77
      zn_common
      bk_common
      implicit_none_f90
      integer ti_func         // Function
      integer min_char,max_char // Input
      lc_decl(x)
      
      if (zn_type(lc_zone(x)) == zn_vacuum) then
         ti_func=1
      else if (zn_type(lc_zone(x)) == zn_exit) then
         ti_func=2
      else if (zn_type(lc_zone(x)) == zn_solid) then
         ti_func=max_char
      else
         assert(zn_type(lc_zone(x)) == zn_plasma)
         ti_func=min_char+
     $        int((log( bk_temp(2,lc_zone(x))/electron_charge )-log(const(1.0)))/
     $        (log(const(1000.0))-log(const(1.0)))*
     $        (max_char-min_char))
         ti_func=min(max(ti_func,min_char),max_char-1)
      end if

      return
      end

@ Data from a slice through the geometry. |hdffile|.  |first|
is |.true.| if this is the first image output.  Slice starts at $\vect x_0$
with the $x$ exis parallel to $\vect a$ and the $y$ axis parallel to $\vect
b$.  Size of the image is |alen| by |blen|. |x0| must be within the problem
space (i.e., not within a solid). The units of |alen| and |blen| are those
of the spatial dimensions (i.e., |x0| + |alen|,|blen| must also be within
the problem space).

@<Functions...@>=
      subroutine data_slice(hdffile,array,clabel,cunits,cformt,x0,a,b,alen,blen)
      implicit_none_f77
      zn_common
      gi_common            // Input
      implicit_none_f90
      character*(*) hdffile,clabel,cunits,cformt    // File
      real x0[3],a[3],b[3],alen,blen
      real array[zn_num]                // Index should be zone number
      integer pixsize // Parameters
      parameter (pixsize=40000) // not pixsize: max. no. of pixels
      integer DFACC_CREATE,DFNT_FLOAT64
      parameter (DFACC_CREATE=4, DFNT_FLOAT64=6)
      integer na,nb,i,j,ind,direction,ret,istart,istop,rank // Local
      integer*4 dims[2]
      lc_decl(xx)
      lc_decls
      real dx,v[3],vy[3],xx[3],tmax,t,xpos
      logical done
      single_precision val
      single_precision data[0:pixsize-1]
      single_precision xa[0:pixsize-1]     // Limiting size
      single_precision xb[0:pixsize-1]

      vc_decls
      external dspdata,dssdast,dssdims,dssdisc
      integer dspdata,dssdast,dssdims,dssdisc
      external track
      logical track

      assert(alen > 0 && blen > 0)
      dx = sqrt(alen*blen/areal(pixsize))  // length of one pixel
      na = int(alen/dx)                    // na is the number of pixels in a
      nb = int(blen/dx)                    // nb .... in b
      assert(na*nb <= pixsize)

      do j=0,na*nb-1
         data[j]=zero      
      end do

      vc_unit(b,vy)            // vy is unit vector corresponding to b

      vc_xvt(x0,vy,half*dx,lc_x(xx))       // step along b half a pixel

       lc_set(xx)

      assert(lc_cell(xx) > 0)

      vc_unit(a,v)
      direction=1
      xpos=zero
      
      do j=0,na-1                // Axis for writing to HDF file
         vc_xvt(x0,v,dx*j,xx)
         xa[j]=vc_product(xx,v)
      end do

      do j=0,nb-1
         vc_xvt(x0,vy,dx*(nb-1-j),xx)    // See |ind| below
         xb[j]=vc_product(xx,vy)
      end do

      do j=0,nb-1
         tmax=areal(na)*dx              // Go |alen| horizontally
loop:    continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),v,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx),lc_sector(xx),lc_sector_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         istart=int(xpos/dx+half)
         xpos=xpos+direction*t
         istop=int(xpos/dx+half)
/*         write(stderr,*) j,istart,istop,xpos,tmax */
         if (direction > 0) then
            istop = istop-1
         else
            istart = istart-1
         end if
         val=array[lc_zone(xx)]

         do i=istart,istop,direction
            ind=(nb-1-j)*na+i
            data[ind]=val
         end do
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then         // Still more to go
            if (lc_cell(xx) == 0) then
               write (stderr,*) j,istart,istop,xpos,tmax
            assert(lc_cell(xx) != 0)
            end if
            goto loop
         end if
         assert(tmax == zero)
         tmax=dx                // Go |dx| vertically
loop1:   continue
         done=track(TRACK_BASIC,tmax,lc_x(xx),vy,lc_cell(xx),t,
     $      lc_x(xx),lc_cell(xx),lc_face(xx),lc_cell_next(xx),lc_sector(xx),lc_sector_next(xx))
         if (lc_face(xx) != 0) then
            lc_zone_next(xx)=cells[c_zone,lc_cell_next(xx)]
         end if
         tmax=tmax-t
         lc_thru_face(xx)
         if (!done) then
            assert(lc_cell(xx) != 0)
            goto loop1
         end if
         assert(tmax == zero)
         direction=-direction   // Reversion horizontal direction
         if (direction > 0) then
            assert(abs(xpos) <= geom_epsilon)
            xpos = zero
         else
            assert(abs(xpos-areal(na)*dx) <= geom_epsilon)
            xpos = areal(na)*dx
         end if
         vc_scale(-one,v,v)
      end do

      rank=2
      dims[1]=na
      dims[2]=nb
      ret=dssdims(rank,dims)
      ret=dssdisc(1,dims[1],xa[0])
      ret=dssdisc(2,dims[2],xb[0])
      ret=dssdast(clabel,cunits,cformt,'cartesian')
      ret=dspdata(hdffile,rank,dims,data[0])

      return
      end

