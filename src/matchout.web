% $Id$
\Title{matchout}

% $Log$

@* Read in two output files and compare contents, both absolutely and 
relative to standard deviations.

\ID{$Id$}

@m FILE 'matchout.web'

@I macros.hweb 
@I tally.hweb
@I output.hweb
@I netcdf.hweb
@I sysdep.hweb
@I readfilenames.hweb
@I problem.hweb
@I background.hweb

@ The main program

@a
      program matchout
      implicit_none_f77
      implicit_none_f90
      character*FILELEN file2

      call readfilenames

      call read_geometry
      call nc_read_species
      call nc_read_reactions
      call nc_read_materials
      call nc_read_pmi
      call nc_read_problem
      call nc_read_background
      call nc_read_tally

      call nc_read_output

      call command_arg(1,file2)
      call match_data(file2)

      stop
      end

      @<Functions and Subroutines@>

@ Compare data in two output files. Having read in one, copy its contents to
local arrays, read in the data from the second file, and then do the
required comparisons.

@<Functions...@>=
      subroutine match_data(file2)

      define_varp(one_all,FLOAT,output_moments_ind,output_tab_ind)
      define_varp(one_grp,FLOAT,output_moments_ind,output_tab_ind,output_grps_ind)
      define_varp(one_post_all,FLOAT,output_moments_ind,output_tab_ind)
      define_varp(one_post_grp,FLOAT,output_moments_ind,output_tab_ind,output_grps_ind)

      implicit_none_f77
      pr_common
      so_common
      tl_common
      ou_common
      rf_common
      implicit_none_f90

      integer i,is,index_max,index_rel_max                         // Local
      real diff,diff_rel,delta_max,delta_rel_max
      character*FILELEN file2

      @<Memory allocation interface@>

      declare_varp(one_all)
      declare_varp(one_grp)
      declare_varp(one_post_all)
      declare_varp(one_post_grp)

      var_alloc(one_all)
      var_alloc(one_grp)
      var_alloc(one_post_all)
      var_alloc(one_post_grp)

      do i=0,tally_size-1
         one_all[i][o_mean]=output_all[i][o_mean]
         one_all[i][o_var]=output_all[i][o_var]
         one_post_all[i][o_mean]=out_post_all[i][o_mean]
         one_post_all[i][o_var]=out_post_all[i][o_var]
      end do

      do is=1,so_grps
         do i=0,tally_size-1
            one_grp[is][i][o_mean]=output_grp[is][i][o_mean]
            one_grp[is][i][o_var]=output_grp[is][i][o_var]
            one_post_grp[is][i][o_mean]=out_post_grp[is][i][o_mean]
            one_post_grp[is][i][o_var]=out_post_grp[is][i][o_var]
         end do
      end do

      filenames_array[outputfile]=file2
      call nc_read_output

      delta_max=-one
      delta_rel_max=-one
      index_max=-1
      index_rel_max=-1
      do i=0,tally_size-1
         if (one_all[i][o_mean] != zero) then
            diff=abs((one_all[i][o_mean]-output_all[i][o_mean])/one_all[i][o_mean])
            if (one_all[i][o_var] > zero) then
               diff_rel=diff/one_all[i][o_var]
            else
               diff_rel=zero
            end if
         else
            diff=zero
            diff_rel=zero
         end if
         if (diff > delta_max) then
            index_max=i
            delta_max=diff
         end if
         if (diff_rel > delta_rel_max) then
            index_rel_max=i
            delta_rel_max=diff_rel
         end if
      end do

      write(stdout,*) ' Largest differences in output_all: '
      write(stdout,*) ' At i = ',index_max,' % difference = ',
     $     delta_max*const(1.,2)
      write(stdout,*) ' At i = ',index_rel_max,' difference / std. dev. = ',
     $     delta_rel_max 

// Should really compute an average here? Compile statistics?

      do is=1,so_grps
         delta_max=-one
         delta_rel_max=-one
         index_max=-1
         index_rel_max=-1
         do i=0,tally_size-1
            if (one_grp[is][i][o_mean] != zero) then
               diff=abs((one_grp[is][i][o_mean]-output_grp[is][i][o_mean])/one_grp[is][i][o_mean])
               if (one_grp[is][i][o_var] > zero) then
                  diff_rel=diff/one_grp[is][i][o_var]
               else
                  diff_rel=zero
               end if
            else
               diff=zero
               diff_rel=zero
            end if
            if (diff > delta_max) then
               index_max=i
               delta_max=diff
            end if
            if (diff_rel > delta_rel_max) then
               index_rel_max=i
               delta_rel_max=diff_rel
            end if
         end do
      end do

      write(stdout,*) ' Largest differences in output_grp: '
      write(stdout,*) ' At i = ',index_max,' % difference = ',
     $     delta_max*const(1.,2)
      write(stdout,*) ' At i = ',index_rel_max,' difference / std. dev. = ',
     $     delta_rel_max 

      delta_max=-one
      delta_rel_max=-one
      index_max=-1
      index_rel_max=-1
      do i=0,tally_size-1
         if (one_post_all[i][o_mean] != zero) then
            diff=abs((one_post_all[i][o_mean]-out_post_all[i][o_mean])/one_post_all[i][o_mean])
            if (one_post_all[i][o_var] > zero) then
               diff_rel=diff/one_post_all[i][o_var]
            else
               diff_rel=zero
            end if
         else
            diff=zero
            diff_rel=zero
         end if
         if (diff > delta_max) then
            index_max=i
            delta_max=diff
         end if
         if (diff_rel > delta_rel_max) then
            index_rel_max=i
            delta_rel_max=diff_rel
         end if
      end do

      write(stdout,*) ' Largest differences in out_post_all: '
      write(stdout,*) ' At i = ',index_max,' % difference = ',
     $     delta_max*const(1.,2)
      write(stdout,*) ' At i = ',index_rel_max,' difference / std. dev. = ',
     $     delta_rel_max 

// Should really compute an average here? Compile statistics?

      do is=1,so_grps
         delta_max=-one
         delta_rel_max=-one
         index_max=-1
         index_rel_max=-1
         do i=0,tally_size-1
            if (one_post_grp[is][i][o_mean] != zero) then
               diff=abs((one_post_grp[is][i][o_mean]-out_post_grp[is][i][o_mean])/one_post_grp[is][i][o_mean])
               if (one_post_grp[is][i][o_var] > zero) then
                  diff_rel=diff/one_post_grp[is][i][o_var]
               else
                  diff_rel=zero
               end if
            else
               diff=zero
               diff_rel=zero
            end if
            if (diff > delta_max) then
               index_max=i
               delta_max=diff
            end if
            if (diff_rel > delta_rel_max) then
               index_rel_max=i
               delta_rel_max=diff_rel
            end if
         end do

         write(stdout,*) ' Largest differences in out_post_grp[is =',
     $        is,']'
         write(stdout,*) ' At i = ',index_max,' % difference = ',
     $        delta_max*const(1.,2)
         write(stdout,*) ' At i = ',index_rel_max,' difference / std. dev. = ',
     $        delta_rel_max 

      end do

      return
      end

         
