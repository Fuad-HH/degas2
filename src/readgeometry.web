@* External Geometry Interface. This program reads a geometry 
specification from an external file, and transforms it into the form
required by Degas 2. Namely, the hiearchy of geometry-related objects in
Degas 2 is, from the lowest level to the highest level is:
\begin{enumerate}
  \item surface,
  \item cell,
  \item polygon,
  \item zone.
\end{enumerate}
Individual cells are composed of surfaces, as discussed in the documentation
for the internal geometry (e.g., see |geometry.web|). The next level up
is a polygon. The code automatically breaks up (non-convex) polygons into
cells. Finally, a zone may consist of one or more polygons; properties
are constant across a zone. For example, a single zone might be used to
represent the vacuum region around the plasma which is comprised of several
(possibly disconnected) polygons. Or, a plasma flux surface on which density
and temperature are constant might be a single zone. Note that polygons
are used only within external interfaces such as this code. Cells and surfaces
are essentially used only by the code itself. Zones are used primarily for the
specification of input and output data.

The command line for the execution of this code must specify a file name.
The syntax for each line in that file is:

{\bf keyword} {\it arguments } 

In the following, keywords will be bold-faced, arguments will be italicized.

  \begin{enumerate}
    \item {\bf degasfile} {\it file\_name} provides the name of the 
Degas input file.
    \item  {\bf minx} {\it x\_value}  and  {\bf minz} {\it z\_value} tell the
code to exclude grid indices for which the gridx, gridz values lie 
below these {\it x} and {\it z}.
    \item {\bf mindensity} {\it density value} is used to exclude 
grid indices which correspond to cells having a plasma density less than the 
given value.
    \item {\bf grid} {\it j1 j2 j3 j4} is used to transform the gridx
and gridz arrays into Degas 2 zones.
    \begin{itemize}
      \item The vertical boundary (or horizontal zone, i.e., the
first index of gridx and gridz) 
and horizontal boundary (or vertical zone, the second index) limits are 
{\it j1}, {\it j2} and  {\it j3}, {\it j4}, repsectively.
      \item For each pair of integer coordinates in this implied list,
a separate Degas 2 zone of type |plasma| will be generated. Note that this
includes points at {\it j2 + 1} and {\it j4 + 1} (hence, these are more
properly referred to as the original Degas ``zone indices'').
      \item Zones can be excluded from this list by using {\bf minx},
{\bf minz}, or {\bf mindensity} entries in this input file. The code will
also ignore zones in which the Degas arrays kzone1 or kzone2 are $\leq 0$.
    \end{itemize}
    \item {\bf new\_zone} {\it zone\_type}  starts a new zone; {\it zone\_type}
is a string that indicates the type of  the zone. It can be 
      \begin{enumerate}
        \item {\it plasma},
        \item {\it vacuum}, 
        \item {\it solid}.
      \end{enumerate}
    \item {\bf new\_polygon} starts a new polygon. This line should be 
followed by one or more lines which provide the code with the polygon
coordinates, and then a line containing \ldots
    \item {\bf define\_polygon} which terminates the definition of the current
polygon begun by the previous {\bf new\_polygon} and adds it to the 
current zone. 
    \item {\bf wall} {\it wall\_number start stop direction} takes points
from the Degas xwall and zwall arrays and adds them to the current polygon.
    \begin{itemize}
      \item {\it start} \& {\it stop} can be replaced by ``*'' 
(meaning the whole wall segment),
      \item {\it direction} is optional (default = +1),
    \end{itemize}
    \item {\bf outer} {\it i j k} adds the $i$th $j$th $k$th points of the 
bounding rectangle of the problem (minimum, maximum $x$ and $z$ determined 
by the code) to the current polygon. The numbering of the corners is clockwise
starting from 0 at $(x_{min}, z_{min})$. There can be any number of arguments,
although typical usage will be with three.
    \item {\bf edge} {\it j1 j2 j3 j4} takes an ``edge'' (i.e., a section
of a horizontal or vertical boundary) from the Degas gridx, gridz arrays
and adds it to the current polygon. The 
arguments indicate the same things as in  grid except that here we must have 
either {\it j1} = {\it j2} or {\it j3} = {\it j4} in order for the edge to
lie on a single boundary.
  \end{enumerate}

A typical file might have lines in the following order:
\begin{verbatim}

degasfile ...

minx ...
minz ...
mindensity ...
grid

new_zone ...
  new_polygon
    wall ...
    outer ...
    edge ...
  define_polygon

  new_polygon
    .
    .
    .

new_zone
   .
   .
   .

end
\end{verbatim}

\ID{$Id$}

@m FILE 'readgeometry.web'

@I macros.hweb
@I degas.hweb
@I geomint.hweb

@f namelist integer
@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ The main program

@<Functions...@>=
      program readgeometry
      implicit_none
      integer mx,my
      parameter (mx=120,my=50)
      character*FILELEN filename,datafilename
      logical uedge,degas,sonnet
      integer length,p,b,e // Local
      integer datafile_diskin,zone,n,wall_no,wall_start,
     $     wall_stop,wall_direction,i,grid_startv,grid_stopv,j1,j2,
     $     grid_starth,grid_stoph,steph,stepv,h,v,num,nx,ny,nu,ixpt1,ixpt2,iysp
     $     trx,ix,iy

      character*LINELEN line,keyword
      logical complete
      real x[2,0:5000],xmin,xmax,zmin,zmax,vol,vola
      real mindensity,minx,minz
      real rm[mx,my,0:4],zm[mx,my,0:4]
      integer xcorner1,xcorner2,xcorner3,xcorner4, zcorner1,zcorner2
     $     ,zcorner3,zcorner4
      character*100 plot
      sy_common
      st_common
      gi_common
      gi_ext
      zn_common

      @<pardef.h@>
      @<combal.h@>
      @<comst.h@>
      @<comgeo.h@>
      @<compls.h@>
      @<comflg.h@>
      @<comrfl.h@>
      @<comrat.h@>
      @<comsv.h@>
      @<comstat.h@>
      @<compar.h@>

      call command_arg(1,filename)
      call readfilenames

      datafile_diskin=diskin+1


      open(unit=diskin,file=filename,status='old',form='formatted')

      /* read the file containing keywords that describe the way plotting has to be done */
      assert( read_string(diskin,line,length) )
      assert(length<=len(line))
      
      uedge =.false.
      degas =.false.
      sonnet=.false.

      length=parse_string(line(:length))
      p=0
      assert( next_token(line,b,e,p) )
      keyword = line(b:e)
      assert( next_token(line,b,e,p) )
      assert(keyword ==  'degasfile' || keyword == 'uedgefile' || keyword == 
     $     'sonnetfile'  )
      datafilename = line(b:e)
      open(unit=datafile_diskin,file=datafilename,status='old',
     $     form='formatted')

      if (keyword == 'degasfile') then
         degas =.true.
         call inpt(datafile_diskin,xmin,xmax,zmin,zmax)
      elseif (keyword == 'uedgefile') then
         uedge=.true.
         nu= datafile_diskin
         read(nu,*)
         read(nu,*) nx
         read(nu,*) ny
         read(nu,*) ixpt1
         read(nu,*) ixpt2
         read(nu,*) iysptrx
         read(nu,*)SP(((rm(ix,iy,i),ix=1,nx),iy=1,ny),i=0,4)
         read(nu,*)SP(((zm(ix,iy,i),ix=1,nx),iy=1,ny),i=0,4)

      elseif (keyword == 'sonnetfile') then
         call inpt_sonnet(datafilename,datafile_diskin,xmin,xmax,
     $        zmin,zmax,rm,zm,nx,ny,mx,my,ixpt1,ixpt2,iysptrx)
         sonnet= .true.
         uedge =.true.
      endif
         
      close(unit=datafile_diskin)

      call init_geometry

      if (! uedge) call universal_cell(xmin,xmax,zmin,zmax,vol)

loop2: continue
      if (! read_string(diskin,line,length) ) goto eof 
      assert(length <= len(line))
      length=parse_string(line(:length))
      p=0
      assert( next_token(line,b,e,p) )
      keyword = line(b:e)
      if (keyword == 'new_zone') then
         zone++
         zn_volume(zone)=zero
         assert(next_token(line,b,e,p))
         if (line(b:e) == 'solid') then
            zn_type_set(zone,zn_solid)
         else if (line(b:e) == 'exit') then
            zn_type_set(zone,zn_exit)
         else if (line(b:e) == 'vacuum') then
            zn_type_set(zone,zn_vacuum)
         else if (line(b:e) == 'plasma') then
            zn_type_set(zone,zn_plasma)
         else
            write(stderr,*) 'Unknown zone type: ',line(b:e)
            assert(.false.)
         end if
      elseif (keyword == 'new_polygon') then
         n=0
      elseif (keyword == 'define_polygon') then
         x[1,n]=x[1,0]; x[2,n]=x[2,0]
         call decompose_polygon(n,x,zone)
         zn_volume(zone)=zn_volume(zone)+polygon_volume(n,x)
      elseif (keyword == 'wall') then
         assert(next_token(line,b,e,p))
         wall_no=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         complete = line(b:e)=='*'
         if (! complete) then
            wall_start=read_integer(line(b:e))
            assert(next_token(line,b,e,p))
            wall_stop=read_integer(line(b:e))
         end if
         if (next_token(line,b,e,p)) then
            wall_direction=read_integer(line(b:e))
         else
            wall_direction=1
         end if
         if (complete) then
            if (wall_direction > 0) then
               wall_start=1
               wall_stop=nosegsxz[wall_no]+1
            else
               wall_start=nosegsxz[wall_no]+1
               wall_stop=1
            end if
         end if
         if (wall_direction > 0) then
            if (wall_stop<wall_start) wall_stop = wall_stop+nosegsxz[wall_no]+1
         else
            if (wall_stop>wall_start) wall_start = wall_start+nosegsxz[wall_no]+1
         end if
         do i=wall_start,wall_stop,wall_direction
            x[1,n]=xwall[mod(i-1,nosegsxz[wall_no]+1)+1,wall_no]
            x[2,n]=zwall[mod(i-1,nosegsxz[wall_no]+1)+1,wall_no]
            n++
            assert(n<=5000)
         end do
      elseif (keyword == 'outer') then
loop3:   continue
         if (next_token(line,b,e,p)) then
            i=read_integer(line(b:e))
            if (i==0 || i==4) then
               x[1,n]=xmin;x[2,n]=zmin
            else if (i==1) then
               x[1,n]=xmin;x[2,n]=zmax
            else if (i==2) then
               x[1,n]=xmax;x[2,n]=zmax
            else if (i==3) then
               x[1,n]=xmax;x[2,n]=zmin
            end if
            n++
            assert(n<=5000)
            goto loop3
         end if
      elseif (keyword=='grid') then
         assert(next_token(line,b,e,p))
         grid_startv=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_stopv=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_starth=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_stoph=read_integer(line(b:e))
         do j2=grid_starth,grid_stoph 
            plot=' '
            do j1=grid_startv,grid_stopv   
               if (kzone1(j1,j2) <= 0 || kzone2(j1,j2) <= 0) then
                  plot(j1:j1)='k'
                  goto skip
               else if (denehvt(j1,j2,1) <= mindensity) then
                  plot(j1:j1)='d'
                  goto skip
               else if (gridx(j1,j2,1)<=minx || gridx(j1,j2+1,1)<=minx ||
     $                 gridx(j1+1,j2+1,1)<=minx || gridx(j1+1,j2,1)<=minx) then
                  plot(j1:j1)='x'
                  goto skip
               else if (gridz(j1,j2,1)<=minz || gridz(j1,j2+1,1)<=minz ||
     $                 gridz(j1+1,j2+1,1)<=minz || gridz(j1+1,j2,1)<=minz) then
                  plot(j1:j1)='z'
                  goto skip
               endif
/*
               write(stdout,'(5f10.4)') gridx(j1,j2,1),gridx(j1,j2+1,1),
     $              gridx(j1+1,j2+1,1),gridx(j1+1,j2,1),gridx(j1,j2,1)
               write(stdout,'(5f10.4)') gridz(j1,j2,1),gridz(j1,j2+1,1),
     $              gridz(j1+1,j2+1,1),gridz(j1+1,j2,1),gridz(j1,j2,1)
*/
               zone++
               n=0
               x[1,n]=gridx(j1,j2,1); x[2,n]=gridz(j1,j2,1); n++
               x[1,n]=gridx(j1+1,j2,1); x[2,n]=gridz(j1+1,j2,1); n++
               x[1,n]=gridx(j1+1,j2+1,1); x[2,n]=gridz(j1+1,j2+1,1); n++
               x[1,n]=gridx(j1,j2+1,1); x[2,n]=gridz(j1,j2+1,1); n++ 
               x[1,n]=x[1,0]; x[2,n]=x[2,0]
               call decompose_polygon(n,x,zone)
               zn_type_set(zone,zn_plasma)
               zn_volume(zone)=polygon_volume(n,x)
               zn_index(zone,1)=j1
               zn_index(zone,2)=j2
skip:          continue
              end do
              write(stderr,*) j2,' ',plot(grid_startv:grid_stopv)
           enddo
        elseif (keyword == 'edge') then
           assert(next_token(line,b,e,p))
           grid_startv=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_stopv=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_starth=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_stoph=read_integer(line(b:e))
           assert( grid_startv == grid_stopv || grid_starth == grid_stoph )
           if (grid_startv == grid_stopv) then
              stepv=0
           else if (grid_startv < grid_stopv) then
              stepv=1
              num=grid_stopv-grid_startv+1
           else 
              stepv=-1
              num=grid_startv-grid_stopv+1
           endif
           if (grid_starth == grid_stoph) then
              steph=0
           else if (grid_starth < grid_stoph) then
              steph=1
              num=grid_stoph-grid_starth+1
           else 
              steph=-1
              num=grid_starth-grid_stoph+1
           endif
           h=grid_starth
           v=grid_startv
           do i=0,num-1
              x[1,n]=gridx(v,h,1)
              x[2,n]=gridz(v,h,1)
              n++
              h=h+steph
              v=v+stepv
           enddo
        elseif (keyword == 'mindensity') then
           assert(next_token(line,b,e,p))
           mindensity=read_real(line(b:e))
        elseif (keyword == 'minz') then
           assert(next_token(line,b,e,p))
           minz=read_real(line(b:e))
        elseif (keyword == 'minx') then
           assert(next_token(line,b,e,p))
           minx=read_real(line(b:e))

      elseif (keyword == 'mesh') then
         assert(uedge)
         assert(next_token(line,b,e,p))
         xmin=read_real(line(b:e))
         assert(next_token(line,b,e,p))
         xmax=read_real(line(b:e))
         assert(next_token(line,b,e,p))
         zmin=read_real(line(b:e))
         assert(next_token(line,b,e,p))
         zmax=read_real(line(b:e))
         call universal_cell(xmin,xmax,zmin,zmax,vol)
         do j1=1,nx
            do j2=1,ny
               zone++
               n=0
               if (sonnet) then
                  xcorner1 = 3; zcorner1 =3
                  xcorner2 = 1; zcorner2 =1
                  xcorner3 = 2; zcorner3 =2
                  xcorner4 = 4; zcorner4 =4
               else
                  xcorner1 = 1; zcorner1 =1
                  xcorner2 = 3; zcorner2 =3
                  xcorner3 = 4; zcorner3 =4
                  xcorner4 = 2; zcorner4 =2
               endif
               x[1,n]=rm(j1,j2,xcorner1); x[2,n]=zm(j1,j2,zcorner1); n++
               x[1,n]=rm(j1,j2,xcorner2); x[2,n]=zm(j1,j2,zcorner2); n++
               x[1,n]=rm(j1,j2,xcorner3); x[2,n]=zm(j1,j2,zcorner3); n++
               x[1,n]=rm(j1,j2,xcorner4); x[2,n]=zm(j1,j2,zcorner4); n++
               x[1,n]=x[1,0]; x[2,n]=x[2,0]               
               
               call decompose_polygon(n,x,zone)
               zn_type_set(zone,zn_plasma)
               zn_volume(zone)=polygon_volume(n,x)
               zn_index(zone,1)=j1
               zn_index(zone,2)=j2
            enddo
         enddo
         zone++

/*
   start from left lower corner of box and go clockwise along box till 
   right lower corner. return along outer edge of SOL to starting pt. 
*/
         n=0
         x[1,n]=xmin; x[2,n]=zmin; n++
         x[1,n]=xmin; x[2,n]=zmax; n++
         x[1,n]=xmax; x[2,n]=zmax; n++
         x[1,n]=xmax; x[2,n]=zmin; n++
         j1=nx; j2=ny
         x[1,n]=rm(j1,j2,xcorner3); x[2,n]=zm(j1,j2,zcorner3); n++
         do j1=nx,1,-1
            x[1,n]=rm(j1,j2,xcorner2); x[2,n]=zm(j1,j2,zcorner2); n++
         end do
         x[1,n]=x[1,0]; x[2,n]=x[2,0]               
         call decompose_polygon(n,x,zone)
         zn_type_set(zone,zn_solid)
         zn_volume(zone)=polygon_volume(n,x)

/*start from left lower corner of box and to upper left bottom of SOL to lower left bottom of SOL to lower right bottom of SOL to upper right bottom of SOL tolower right bottom of box  and back*/
         n=0
         x[1,n]=xmin; x[2,n]=zmin; n++
         j1=1
         do j2=ny,1,-1
            x[1,n]=rm(j1,j2,xcorner2); x[2,n]=zm(j1,j2,zcorner2); n++
         end do
         j2=1
         do j1=1,ixpt1
            x[1,n]=rm(j1,j2,xcorner1); x[2,n]=zm(j1,j2,zcorner1); n++
         end do
         do j1=ixpt2+1,nx
            x[1,n]=rm(j1,j2,xcorner1); x[2,n]=zm(j1,j2,zcorner1); n++
         end do
         j1=nx
         do j2=1,ny
            x[1,n]=rm(j1,j2,xcorner4); x[2,n]=zm(j1,j2,zcorner4); n++
         end do
         j2=ny
         x[1,n]=rm(j1,j2,xcorner3); x[2,n]=zm(j1,j2,zcorner3); n++

         x[1,n]=xmax; x[2,n]=zmin; n++
         x[1,n]=x[1,0]; x[2,n]=x[2,0]               
         call decompose_polygon(n,x,zone)
         zn_volume(zone)=zn_volume(zone)+polygon_volume(n,x)
         
         zone++

/* core region */
         n=0
         j2=1
         do j1=ixpt1+1,ixpt2
            x[1,n]=rm(j1,j2,xcorner1); x[2,n]=zm(j1,j2,zcorner1); n++
         enddo
         x[1,n]=x[1,0]; x[2,n]=x[2,0]               
         call decompose_polygon(n,x,zone)
         zn_type_set(zone,zn_exit)
         zn_volume(zone)=polygon_volume(n,x)

/* insert additional keywords below this */            

      elseif (keyword == 'end') then
           
         goto eof
      else
         write(stderr,*) 'Unknown keyword ',trim(keyword)
         assert(.false.)
      end if
      goto loop2
eof:  continue
      close(unit=diskin)
      call end_geometry
      call check_geometry
      call write_geometry
      vola=zero
      do i=1,zn_num
         assert(zn_volume(i)>0)
         vola=vola+zn_volume(i)
      end do

      call erase_geometry
      stop
      end

@ Define universal cell

@<Functions...@>=
      subroutine universal_cell(xmin,xmax,zmin,zmax,vol)
      implicit_none
      real xmin,xmax,zmin,zmax
      real vol
      integer face,surf_type,zone,i
      real x[2,0:4],apex[3],x1[3],x2[3],coeff[NCOEFFS]
      gi_common
      gi_ext
      

      zone=0
      i=0
      x[1,i]=xmin; x[2,i]=zmin; i=i+1
      x[1,i]=xmin; x[2,i]=zmax; i=i+1
      x[1,i]=xmax; x[2,i]=zmax; i=i+1
      x[1,i]=xmax; x[2,i]=zmin; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
      
      do i=0,3
         vc_set(x1,x[1,i],zero,x[2,i])
         vc_set(x2,x[1,i+1],zero,x[2,i+1])
         call conea(x1,x2,coeff,surf_type,apex)
         face=define_surface(coeff,.true.)
         call add_surface(face,0,.true.)
      end do
      
      vol=PI*(x[1,2]^2-x[1,0]^2)*(x[2,2]-x[2,0])

      return
      end

@ subroutine to read inputs from sonnet file.
@<Functions ...@>=
      subroutine inpt_sonnet(datafilename,nu,xmin,xmax,
     $     zmin,zmax,crx,cry,nx,ny,mx,my,ixcut1,ixcut2,iycut)
      implicit none
      integer*4 ix, iy, ixh, iyh,nxd,nyd,i,ixcut1,ixcut2,iycut,nu,mx,my
     $     ,nx,ny,j, corner_no[4] 

      /* for ~/vesey/Sonnet/cmod.elm.779old */
      parameter (nxd=120,nyd=24) 
      
      real  crx(mx,my,0:4), cry(mx,my,0:4),pit(nxd,nyd),
