@n/

@* A program to read a geometry specification from an external file.
the file name has to be given in the command  line. The syntax for the file is:

keyword args

The keyword is shown in bold face below and the arguments in italics.
``keyword'' is one of {\bf degasfile},{\bf  new_zone},{\bf  new_polygon},
\bf define_polygon},
{\bf wall},{\bf outer}, {\bf minx}, {\bf minz},{\bf mindensity} {\bf grid} {\bf
edge} . {\bf degasfile}  {\it degasfile_name} defines a degas input file.
{\bf new_zone} {\it zone_type} starts a new zone. {\it zone_type} is a
string that indicates the type of  the zone. It can be ``plasma'',
``vacuum'' or ``solid''. {\bf new_polygon} starts
a new polygon. {\bf define_polygon} adds the current polygon to the current
zone. {\bf wall} {\it wallno start stop direction} where {\it start} \&{\it
stop} can be replaced by ``*'' (meaning the whole wall segment) and {\it
direction} is optional (default = +1).  {\bf outer}{\it i j k} adds i'th j'th
k'th points from outer boundary to polygon (bottom left corner = point 0,
numbering is clockwise). {\bf grid} {\it j1 j2 j3 j4}
will put the gridx and gridz values into an array containing corners of
polygons. The vertical boundary and horizontal boundary limits are {\it
j1},{\it j2} and  {\it j3},{\it j4}. {\bf minx} {\it x value}  \& {\bf minz}
{z value} are for excluding grid indices (and hence the gridx, gridz
values) that lie below these values. {\bf mindensity} {\it density value}
is also used to exclude grid indices that define the cells containing
plasma density less than the given value. {\bf edge} {\it j1 j2 j3 j4}
define edges of the plasma zone. The arguments indicate the same things as
in {\bf grid} except that here we must have either {\it j1} = {\it j2} or
{\it j3} = {\it j4} since all edges lie on the same horizontal or vertical
boundary. 

\ID{$Id$}

@m FILE 'readgeometry.web'

@I macros.hweb
@I degas.hweb
@I geomint.hweb

@f namelist integer
@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ The main program

@<Functions...@>=
      program readgeometry
      implicit_none
      character*FILELEN filename,degasfilename
      integer length,p,b,e // Local
      integer degasfile_diskin,zone,surf_type,face,n,wall_no,wall_start,
     $     wall_stop,wall_direction,i,grid_startv,grid_stopv,j1,j2,
     $     grid_starth,grid_stoph,steph,stepv,h,v,num
      character*LINELEN line,keyword
      logical complete
      real x[2,0:5000],xmin,xmax,zmin,zmax,vol,vola
      real x1[3],x2[3],coeff[NCOEFFS],apex[3],mindensity,minx,minz
      character*100 plot
      sy_common
      st_common
      gi_common
      gi_ext
      zn_common

      @<pardef.h@>
      @<combal.h@>
      @<comst.h@>
      @<comgeo.h@>
      @<compls.h@>
      @<comflg.h@>
      @<comrfl.h@>
      @<comrat.h@>
      @<comsv.h@>
      @<comstat.h@>
      @<compar.h@>

      call command_arg(1,filename)

      degasfile_diskin=diskin+1
      open(unit=diskin,file=filename,status='old',form='formatted')

      /* read the file containing keywords that describe the way plotting has to be done */
      assert( read_string(diskin,line,length) )
      assert(length<=len(line))
      
      length=parse_string(line(:length))
      p=0
      assert( next_token(line,b,e,p) )
      keyword = line(b:e)
      assert( next_token(line,b,e,p) )
      assert(keyword ==  'degasfile')
      degasfilename = line(b:e)
      open(unit=degasfile_diskin,file=degasfilename,status='old',
     $     form='formatted')
      call inpt(degasfile_diskin,xmin,xmax,zmin,zmax)
      close(unit=degasfile_diskin)

      call init_geometry

      zone=0
      i=0
      x[1,i]=xmin; x[2,i]=zmin; i=i+1
      x[1,i]=xmin; x[2,i]=zmax; i=i+1
      x[1,i]=xmax; x[2,i]=zmax; i=i+1
      x[1,i]=xmax; x[2,i]=zmin; i=i+1
      x[1,i]=x[1,0]; x[2,i]=x[2,0]
      
      do i=0,3
         vc_set(x1,x[1,i],zero,x[2,i])
         vc_set(x2,x[1,i+1],zero,x[2,i+1])
         call conea(x1,x2,coeff,surf_type,apex)
         face=define_surface(coeff,.true.)
         call add_surface(face,0,.true.)
      end do
      
      vol=PI*(x[1,2]^2-x[1,0]^2)*(x[2,2]-x[2,0])

loop2: continue
      if (! read_string(diskin,line,length) ) goto eof 
      assert(length <= len(line))
      length=parse_string(line(:length))
      p=0
      assert( next_token(line,b,e,p) )
      keyword = line(b:e)
      if (keyword == 'new_zone') then
         zone++
         zn_volume(zone)=zero
         assert(next_token(line,b,e,p))
         if (line(b:e) == 'solid') then
            zn_type_set(zone,zn_solid)
         else if (line(b:e) == 'exit') then
            zn_type_set(zone,zn_exit)
         else if (line(b:e) == 'vacuum') then
            zn_type_set(zone,zn_vacuum)
         else if (line(b:e) == 'plasma') then
            zn_type_set(zone,zn_plasma)
         else
            write(stderr,*) 'Unknown zone type: ',line(b:e)
            assert(.false.)
         end if
      elseif (keyword == 'new_polygon') then
         n=0
      elseif (keyword == 'define_polygon') then
         x[1,n]=x[1,0]; x[2,n]=x[2,0]
         call decompose_polygon(n,x,zone)
         zn_volume(zone)=zn_volume(zone)+polygon_volume(n,x)
      elseif (keyword == 'wall') then
         assert(next_token(line,b,e,p))
         wall_no=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         complete = line(b:e)=='*'
         if (! complete) then
            wall_start=read_integer(line(b:e))
            assert(next_token(line,b,e,p))
            wall_stop=read_integer(line(b:e))
         end if
         if (next_token(line,b,e,p)) then
            wall_direction=read_integer(line(b:e))
         else
            wall_direction=1
         end if
         if (complete) then
            if (wall_direction > 0) then
               wall_start=1
               wall_stop=nosegsxz[wall_no]+1
            else
               wall_start=nosegsxz[wall_no]+1
               wall_stop=1
            end if
         end if
         if (wall_direction > 0) then
            if (wall_stop<wall_start) wall_stop = wall_stop+nosegsxz[wall_no]+1
         else
            if (wall_stop>wall_start) wall_start = wall_start+nosegsxz[wall_no]+1
         end if
         do i=wall_start,wall_stop,wall_direction
            x[1,n]=xwall[mod(i-1,nosegsxz[wall_no]+1)+1,wall_no]
            x[2,n]=zwall[mod(i-1,nosegsxz[wall_no]+1)+1,wall_no]
            n++
            assert(n<=5000)
         end do
      elseif (keyword == 'outer') then
loop3:   continue
         if (next_token(line,b,e,p)) then
            i=read_integer(line(b:e))
            if (i==0 || i==4) then
               x[1,n]=xmin;x[2,n]=zmin
            else if (i==1) then
               x[1,n]=xmin;x[2,n]=zmax
            else if (i==2) then
               x[1,n]=xmax;x[2,n]=zmax
            else if (i==3) then
               x[1,n]=xmax;x[2,n]=zmin
            end if
            n++
            assert(n<=5000)
            goto loop3
         end if
      elseif (keyword=='grid') then
         assert(next_token(line,b,e,p))
         grid_startv=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_stopv=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_starth=read_integer(line(b:e))
         assert(next_token(line,b,e,p))
         grid_stoph=read_integer(line(b:e))
         do j2=grid_starth,grid_stoph 
            plot=' '
            do j1=grid_startv,grid_stopv   
               if (kzone1(j1,j2) <= 0 || kzone2(j1,j2) <= 0) then
                  plot(j1:j1)='k'
                  goto skip
               else if (denehvt(j1,j2,1) <= mindensity) then
                  plot(j1:j1)='d'
                  goto skip
               else if (gridx(j1,j2,1)<=minx || gridx(j1,j2+1,1)<=minx ||
     $                 gridx(j1+1,j2+1,1)<=minx || gridx(j1+1,j2,1)<=minx) then
                  plot(j1:j1)='x'
                  goto skip
               else if (gridz(j1,j2,1)<=minz || gridz(j1,j2+1,1)<=minz ||
     $                 gridz(j1+1,j2+1,1)<=minz || gridz(j1+1,j2,1)<=minz) then
                  plot(j1:j1)='z'
                  goto skip
               endif
/*
               write(stdout,'(5f10.4)') gridx(j1,j2,1),gridx(j1,j2+1,1),
     $              gridx(j1+1,j2+1,1),gridx(j1+1,j2,1),gridx(j1,j2,1)
               write(stdout,'(5f10.4)') gridz(j1,j2,1),gridz(j1,j2+1,1),
     $              gridz(j1+1,j2+1,1),gridz(j1+1,j2,1),gridz(j1,j2,1)
*/
               zone++
               n=0
               x[1,n]=gridx(j1,j2,1); x[2,n]=gridz(j1,j2,1); n++
               x[1,n]=gridx(j1+1,j2,1); x[2,n]=gridz(j1+1,j2,1); n++
               x[1,n]=gridx(j1+1,j2+1,1); x[2,n]=gridz(j1+1,j2+1,1); n++
               x[1,n]=gridx(j1,j2+1,1); x[2,n]=gridz(j1,j2+1,1); n++ 
               x[1,n]=x[1,0]; x[2,n]=x[2,0]
               call decompose_polygon(n,x,zone)
               zn_type_set(zone,zn_plasma)
               zn_volume(zone)=polygon_volume(n,x)
               zn_index(zone,1)=j1
               zn_index(zone,2)=j2
skip:          continue
              end do
              write(stderr,*) j2,' ',plot(grid_startv:grid_stopv)
           enddo
        elseif (keyword == 'edge') then
           assert(next_token(line,b,e,p))
           grid_startv=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_stopv=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_starth=read_integer(line(b:e))
           assert(next_token(line,b,e,p))
           grid_stoph=read_integer(line(b:e))
           assert( grid_startv == grid_stopv || grid_starth == grid_stoph )
           if (grid_startv == grid_stopv) then
              stepv=0
           else if (grid_startv < grid_stopv) then
              stepv=1
              num=grid_stopv-grid_startv+1
           else 
              stepv=-1
              num=grid_startv-grid_stopv+1
           endif
           if (grid_starth == grid_stoph) then
              steph=0
           else if (grid_starth < grid_stoph) then
              steph=1
              num=grid_stoph-grid_starth+1
           else 
              steph=-1
              num=grid_starth-grid_stoph+1
           endif
           h=grid_starth
           v=grid_startv
           do i=0,num-1
              x[1,n]=gridx(v,h,1)
              x[2,n]=gridz(v,h,1)
              n++
              h=h+steph
              v=v+stepv
           enddo
        elseif (keyword == 'mindensity') then
           assert(next_token(line,b,e,p))
           mindensity=read_real(line(b:e))
        elseif (keyword == 'minz') then
           assert(next_token(line,b,e,p))
           minz=read_real(line(b:e))
        elseif (keyword == 'minx') then
           assert(next_token(line,b,e,p))
           minx=read_real(line(b:e))
        elseif (keyword == 'end') then
           goto eof
        else
           write(stderr,*) 'Unknown keyword ',trim(keyword)
           assert(.false.)
        end if
        goto loop2
eof:  continue
      close(unit=diskin)
      call end_geometry
      call check_geometry
      call write_geometry
      call print_geometry(stdout)
      vola=zero
      do i=1,zn_num
         assert(zn_volume(i)>0)
         vola=vola+zn_volume(i)
      end do
      write(stderr,*) vol,vola
      call erase_geometry
      stop
      end

@* Index.
