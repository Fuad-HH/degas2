\ID{$Id$}

Information about background species is held in arrays in
common blocks.  An background is identified by an integer indexing into
these arrays.

@f bk_decl integer

@m bk_args(x) x

@m bk_dummy(x) x

@m bk_decl(x) integer x @;

@m bk_copy(x,y) y=x @;

@m bk_check(x) (x > 0 && x <= bk_num)

@m bk_sp(x) background_sp[x]
@m bk_n(x,i) background_n[x,zn_pointer(i)]
@m bk_temp(x,i) background_temp[x,zn_pointer(i)]
@m bk_v(x,i) background_v[x,zn_pointer(i)]

@ Variable definitions.

@a
      package_init(bk)
      define_dimen_pk(bk,background_ind,bk_num)
      define_dimen_pk(bk,plasma_ind,zn_plasma_num)
      define_var_pk(bk,bk_num,INT)
      define_varp_pk(bk,background_sp,INT,background_ind)
      define_varp_pk(bk,background_n,INT,background_ind,plasma_ind)
      define_varp_pk(bk,background_v,INT,vc_ind,background_ind,plasma_ind)
      define_varp_pk(bk,background_temp,INT,background_ind,plasma_ind)

@ Common blocks definitions.

@f bk_common integer
@m bk_common
      bk_common_a @;
