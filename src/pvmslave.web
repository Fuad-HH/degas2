@n/

@* A test program for the geometry routines.

\ID{$Id$}

@m FILE 'pvmslave.web'
@m SP _UNQUOTE(' ')
@I macros.hweb
@I pvm.hweb

@ The main program.

@a
      program pvm_slave
      implicit_none

      call slave_init
      call pvm_flights_slave

      stop
      end

      @<Functions and Subroutines@>

@ Initialize common blocks.

@<Functions...@>=
      subroutine slave_init
      implicit_none
      sy_common
      logical res
      
      res=set_cwd('degas/degas2/SUN')
      assert(res)
      call read_geometry
      call nc_read_elements
      call nc_read_species
      call nc_read_background
      call nc_read_test
      call nc_read_reactions
      
      return
      end
      
@ The master controller.

@<Functions...@>=
      subroutine pvm_flights_slave
      implicit_none
      integer nstart,num,seed[0:1]     // Local
      integer mytid,mastertid,ret,msgtype
      zn_common
      sy_common
      st_common
      real weight1
      ptr_decl(stat1)
      ptr_decl(stat2)
      real stat1(2,zn_num)
      real stat2(2,zn_num)
      
      real_alloc(stat1,2*zn_num)
      real_alloc(stat2,2*zn_num)

      call pvmfmytid(mytid)
      call pvmfparent(mastertid)

loop: continue
      msgtype=1
      call pvmfrecv(mastertid,msgtype,ret); assert(ret >= 0)
      call pvmfunpack(pvm_int,nstart,1,1,ret); assert(ret >= 0)
      call pvmfunpack(pvm_int,num,1,1,ret); assert(ret >= 0)
      call pvmfunpack(pvm_int,seed,2,1,ret); assert(ret >= 0)
      if (num <= 0) goto break
      
      call do_flights(nstart,num,seed,stat1,weight1,stat2)
      call pvmfinitsend(PVMDEFAULT,ret); assert(ret >= 0)
      call pvmfpack(pvm_real,stat1,2*zn_num,1,ret); assert(ret >= 0)
      call pvmfpack(pvm_real,weight1,1,1,ret); assert(ret >= 0)
      msgtype=2
      call pvmfsend(mastertid, msgtype,ret); assert(ret >= 0)
      
      goto loop
      
break: continue
      call pvmfexit(ret); assert(ret >= 0)

      real_free(stat1,2*zn_num)
      real_free(stat2,2*zn_num)

      return
      end


@* Index.
