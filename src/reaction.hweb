\ID{$Id$}

Information about reactions is held in arrays in common blocks.  An
reaction is identified by an integer indexing into these arrays.

@f rc_decl integer
@m rc_args(x) x
@m rc_dummy(x) x
@m rc_decl(x) integer x @;
@m rc_copy(x,y) y=x @;
@m rc_check(x) assert(x > 0 && x <= rc_num) @;
@m rc_name(x) reaction_name[x]
@m rc_sy(x)   reaction_sy[x]
@m rc_reagant_num(x) reaction_reagant_num[x]
@m rc_product_num(x) reaction_product_num[x]
@m rc_reagant(x,i)   reaction_reagant[i,x]
@m rc_product(x,i)   reaction_product[i,x]
@m rc_xsection_type(x) reaction_xsection_type[x]
@m rc_xsection_pointer(x) reaction_xsection_pointer[x]
@m rc_reaction_type(x) reaction_type[x]
@m rc_xsection1(x,i) reaction_xsection_table[reaction_xs_base[x]+i]
@m rc_xsection2(x,i,j) reaction_xsection_table[reaction_xs_base[x]+i+reaction_xs_tab_index[x][1]*j]
@m rc_xsection3(x,i,j,k) reaction_xsection_table[reaction_xs_base[x]+i+reaction_xs_tab_index[x][1]*(j+reaction_xs_tab_index[x][2]*k)]

@ Length specifications.

@m rc_type_tn 1
@m rc_type_te 2
@m rc_type_max 2
@m rc_sy_len 24
@m rc_name_len 32
@m rc_type_len 32
@m rc_reagant_max 2
@m rc_product_max 4
@m rc_energy_num 47
@m rc_density_num 10
@m rc_logenergy_min zero
@m rc_logdensity_min const(16.0)
@m rc_logenergy_delta const(0.1)
@m rc_logdensity_delta const(0.5)

@ Variable definitions.

@a
      package_init(rc)
      define_dimen_pk(rc,reaction_symbol_string,rc_sy_len)
      define_dimen_pk(rc,reaction_name_string,rc_name_len)
      define_dimen_pk(rc,reaction_type_string,rc_type_len)
      define_dimen_pk(rc,reaction_ind,rc_num)
      define_dimen_pk(rc,reaction_tn_ind,rc_tn_num)
      define_dimen_pk(rc,reaction_te_ind,rc_te_num)
      define_dimen_pk(rc,reagant_ind,rc_reagant_max)
      define_dimen_pk(rc,product_ind,rc_product_max)
      define_dimen_pk(rc,energy_ind,0,rc_energy_num)
      define_dimen_pk(rc,density_ind,0,rc_density_num)
      define_var_pk(rc,rc_num,INT)
      define_var_pk(rc,rc_tn_num,INT)
      define_var_pk(rc,rc_te_num,INT)
      define_varp_pk(rc,reaction_name,CHAR,reaction_name_string,reaction_ind)
      define_varp_pk(rc,reaction_type,CHAR,reaction_type_string,reaction_ind)
      define_varp_pk(rc,reaction_sy,CHAR,reaction_symbol_string,reaction_ind)
      define_varp_pk(rc,reaction_reagant_num,INT,reaction_ind)
      define_varp_pk(rc,reaction_product_num,INT,reaction_ind)
      define_varp_pk(rc,reaction_reagant,INT,reagant_ind,reaction_ind)
      define_varp_pk(rc,reaction_product,INT,product_ind,reaction_ind)
      define_varp_pk(rc,tn_cross_section_table,FLOAT,energy_ind,density_ind,reaction_tn_ind)
      define_varp_pk(rc,te_cross_section_table,FLOAT,energy_ind,energy_ind,reaction_te_ind)

      define_dimen_pk(rc,rc_rank_ind,xs_table_rank_max)
      define_dimen_pk(rc,rc_rank_ind0,0,xs_table_rank_max)
      define_dimen_pk(rc,rc_cross_section_ind,0,xs_base_max-1)
      define_var_pk(rc,xs_base_max,INT)
      define_varp_pk(rc,reaction_organization,INT,reaction_ind)
      define_varp_pk(rc,reaction_xs_min,FLOAT,rc_rank_ind,reaction_ind)
      define_varp_pk(rc,reaction_xs_delta,FLOAT,rc_rank_ind,reaction_ind)
      define_varp_pk(rc,reaction_xs_rank,INT,reaction_ind)
      define_varp_pk(rc,reaction_xs_spacing,INT,rc_rank_ind0,reaction_ind)
      define_varp_pk(rc,reaction_xs_tab_index,INT,rc_rank_ind,reaction_ind)
      define_varp_pk(rc,reaction_xs_base,INT,reaction_ind)
      define_varp_pk(rc,reaction_xs_var,INT,rc_rank_ind0,reaction_ind)
      define_varp_pk(rc,reaction_xsection_table,FLOAT,rc_cross_section_ind)
@ Common blocks definitions.

@f rc_common integer
@m rc_common
      rc_common_a;
      character*LINELEN reaction_version;
      common /com_reaction_c/ reaction_version;
      save /com_reaction_c/ @;

@m rc_ncread(fileid)
      rc_ncreada(fileid);
      rc_ncreadb(fileid);
      rc_ncreadc(fileid) @;
