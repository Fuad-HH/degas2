@* Introduction.

\ID{$Id$}

Routines for accumulating statistics.

@m FILE 'stat.web'

@I macros.hweb

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Add scores into a base.  A score is represented by a weight $w$, a mean
$m$ and a variance $s$.  This routine combines scores $[w_1, m_1, s_1] +
[w_0, m_0, s_0]$ and place result into $[w_n, m_n, s_n]$. This is done
for |nsp| variables.

@<Functions...@>=
      subroutine stat_add(n,nsp,w1,stat1,w0,stat0,wn,statn)
      implicit_none
      integer n,nsp                 // Input
      real w1,w0,stat1[2,n,nsp],stat0[2,n,nsp]
      real wn,statn[2,n,nsp]        // Output
      real wa,ma             // Local
      integer i,j

      wa=w0+w1

      assert(w0 >= zero && w1 >= zero && wa > zero)

      do j=1,nsp
         do i=1,n
            ma=stat0[1,i,j]+(stat1[1,i,j]-stat0[1,i,j])*w1/wa
/* Original
            statn[2,i,j]=(w0*stat0[2,i,j]+w1*stat1[2,i,j]
     $           +(stat1[1,i,j]-stat0[1,i,j])*(stat1[1,i,j]-ma)*w1)/wa
 */
            statn[2,i,j]=(w0-one)*stat0[2,i,j]+(w1-one)*stat1[2,i,j]
     $           +(stat1[1,i,j]-stat0[1,i,j])*(stat1[1,i,j]-ma)*w1
            if (wa > one) then
               statn[2,i,j]=statn[2,i,j]/(wa-one)
            else
               statn[2,i,j]=zero         // Strictly, is infinite
            end if
            statn[1,i,j]=ma
         end do
      end do

      wn=wa

      return
      end


