@* Introduction.

\ID{$Id$}

Routines for accumulating statistics.

@m FILE 'stat.web'

@I macros.hweb
@I output.hweb

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Add scores  A score is represented by a weight $w$, a mean
$m$ and a variance $s$.  This routine combines scores $[w_1, m_1, s_1] +
[w_0, m_0, s_0]$ and place result into $[w_n, m_n, s_n]$. This is done
for |n| variables.

@<Functions...@>=
      subroutine stat_add(n,w1,stat1,w0,stat0,wn,statn)
      implicit_none_f77
      implicit_none_f90
      integer n                 // Input
      real w1,w0,stat1[0:n-1][o_mean:o_var],stat0[0:n-1][o_mean:o_var]
      real wn,statn[0:n-1][o_mean:o_var]        // Output
      real wa,ma             // Local
      integer i

      wn=w0
      do i=0,n-1
         statn[i][o_mean]=stat0[i][o_mean]
         statn[i][o_var]=stat0[i][o_var]
      end do
      
      call stat_acc(n,w1,stat1,wn,statn)

@#if 0
      wa=w0+w1

      assert(w0 >= zero && w1 >= zero && wa > zero)

      do i=0,n-1
/* This is the same as $(w_0 m_0 + w_1 m_1)/w_a$ */
         ma=stat0[i][o_mean]+(stat1[i][o_mean]-stat0[i][o_mean])*w1/wa
/* Original
      statn[i][o_var]=(w0*stat0[i][o_var]+w1*stat1[i][o_var]
     $+(stat1[i][o_mean]-stat0[i][o_mean])*(stat1[i][o_mean]-ma)*w1)/wa
 */
         statn[i][o_var]=(w0-one)*stat0[i][o_var]+(w1-one)*stat1[i][o_var]
     $+(stat1[i][o_mean]-stat0[i][o_mean])*(stat1[i][o_mean]-ma)*w1
         if (wa > one) then
            statn[i][o_var]=statn[i][o_var]/(wa-one)
         else
            statn[i][o_var]=zero         // Strictly, is infinite
         end if
         statn[i][o_mean]=ma
      end do

      wn=wa
@#endif

      return
      end

@ Accumulate scores into a base.  A score is represented by a weight
$w$, a mean $m$ and a variance $s$.  This routine combines scores $[w_0,
m_0, s_0] += [w_1, m_1, s_1]$.  This is done for |n| variables.

@<Functions...@>=
      subroutine stat_acc(n,w1,stat1,w0,stat0)
      implicit_none_f77
      implicit_none_f90
      integer n                 // Input
      real w1,stat1[0:n-1][o_mean:o_var]
      real w0,stat0[0:n-1][o_mean:o_var]        // Input/Output
      real wa,ma             // Local
      integer i

      wa=w0+w1

      assert(w0 >= zero && w1 >= zero && wa > zero)

      do i=0,n-1
/* This is the same as $(w_0 m_0 + w_1 m_1)/w_a$ */
         ma=stat0[i][o_mean]+(stat1[i][o_mean]-stat0[i][o_mean])*w1/wa
/* Original
      statn[i][o_var]=(w0*stat0[i][o_var]+w1*stat1[i][o_var]
     $+(stat1[i][o_mean]-stat0[i][o_mean])*(stat1[i][o_mean]-ma)*w1)/wa
 */
         stat0[i][o_var]=(w0-one)*stat0[i][o_var]+(w1-one)*stat1[i][o_var]
     $+(stat1[i][o_mean]-stat0[i][o_mean])*(stat1[i][o_mean]-ma)*w1
         if (wa > one) then
            stat0[i][o_var]=stat0[i][o_var]/(wa-one)
         else
            stat0[i][o_var]=zero         // Strictly, is infinite
         end if
         stat0[i][o_mean]=ma
      end do

      w0=wa

      return
      end

