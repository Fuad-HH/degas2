@* Introduction.

\ID{$Id$}

Routines for accumulating statistics.

@m FILE 'stat.web'

@I macros.hweb

@ The unnamed module.

@a
      @<Functions and Subroutines@>

@ Add scores into a base.  A score is represented by a weight $w$, a mean
$m$ and a variance $s$.  This routine combines scores $[w_1, m_1, s_1] +
[w_0, m_0, s_0]$ and place result into $[w_n, m_n, s_n]$.

@<Functions...@>=
      subroutine stat_add(n,w1,stat1,w0,stat0,wn,statn)
      implicit_none
      integer n                 // Input
      real w1,w0,stat1[2,n],stat0[2,n]
      real wn,statn[2,n]        // Output
      real wa,ma             // Local
      integer i

      wa=w0+w1

      assert(w0 >= zero && w1 >= zero && wa > zero)

      do i=1,n
         ma=stat0[1,i]+(stat1[1,i]-stat0[1,i])*w1/wa
         statn[2,i]=(w0*stat0[2,i]+w1*stat1[2,i]+(stat1[1,i]-stat0[1,i])*(stat1[1,i]-ma)*w1)/wa
         statn[1,i]=ma
      end do

      wn=wa

      return
      end


