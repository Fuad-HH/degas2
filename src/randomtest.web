@* A test program for the random number routines.

\ID{$Id$}

This random number generator is portable as long as no bits are lost in the
additions and subtractions in |random_batch|.  As a check, with
|seed[0]=1234| and |seed[1]=5678|, the zeroth and thousandth random numbers
are $53744947432387/2^{48} \approx 0.1909404099094552$ and
$80023218797819/2^{48} \approx 0.2842995840446569$. Also, a speed check
of the random number generator is included for comparison with standard
numerical operations.

@m FILE 'randomtest.web'

@i macros.hweb

@I random.hweb

@ The main program.

@a
      program random_test
      implicit_none
      integer seed[0:5]                 // Local
      integer i,j,k
      real x,start,end,cpu_time
      real*8 rndd1
      real xx[0:110000],yy[0:110000]
      character*26 dec
      rn_decl(tag)                     // Local for random number routines
      rn_common

      do k=1,3
         if (k == 1) then
            write(stdout,'(a)') 'Test with seeds 1234 5678'
            seed[0]=1234
            seed[1]=5678
         else if (k == 2) then
            write(stdout,'(a)') 'Test with seed 99999999999999'
            call random_seed_test(seed)
         else
            write(stdout,'(a)') 'Advance seed 23'
            call next_seed(23,seed,seed)
         end if
         write(stdout,'(a,2i9)') 'Seeds: ',seed
         call random_init(seed,rn_args(tag))

/* Write out the zeroth random number */
         rn_next(x,tag)
         write(stdout,*) x

/* Here's how to use |fast_random| */
         do i=1,10*RAN_K,RAN_K
            call random_check(RAN_K,rn_args(tag)) // Check |RAN_K| numbers are available
            do j=i,i-1+RAN_K    // This loop can vectorize
               rn_fast_next(x,tag)
            end do
         end do

/* Here's how to use |random| */
         do i=10*RAN_K+1,999       // This loop won't vectorize
            rn_next(x,tag)
         end do

/* Write out the thousandth random number */
         rn_next(x,tag)
         write(stdout,*) x

/* Write out the zeroth and thousandth gaussian random numbers */
         rn_gauss_next(x,tag)
         write(stdout,*) x
         do i=1,999
            rn_gauss_next(x,tag)
         end do
         rn_gauss_next(x,tag)
         write(stdout,*) x

      end do

/*
   Speed checks. These arrays will be used below to prevent loops
   from being trivialized by the compiler.
*/
      do i=0,99999
         yy[i]=xx[i]
      end do

/*
   Get seed and initialize
*/
      call random_seed_test(seed)
      call random_init(seed,rn_args(tag))

/* 
   Time for $100044 = 1588 |RAN_K|$ executions of |rn_fast_next| 
*/
      start=cpu_time()
      do i=1,1588*RAN_K,RAN_K
         call random_check(RAN_K,rn_args(tag))
         do j=i,i-1+RAN_K  
            rn_fast_next(xx[j],tag)
         end do
      end do
      end=cpu_time()
      write(stdout,*) 'Fast random time:   ',end-start

/* 
   Time for 100000 executions of |rn_next| 
*/
      start=cpu_time()
      do i=0,99999     
         rn_next(xx[i],tag)
      end do
      end=cpu_time()
      write(stdout,*) 'Normal random time: ',end-start


/* 
   Time for 100000 executions of |rn_gauss_next| 
*/
      start=cpu_time()
      do i=0,99999
         rn_gauss_next(xx[i],tag)
      end do
      end=cpu_time()
      write(stdout,*) 'Gauss random time:  ',end-start

/*
   Times for standard numerical operations
*/
      start=cpu_time()
      do i=0,99999
         yy[i]=xx[i]
      end do
      end=cpu_time()
      write(stdout,*) 'Time for copy:     ',end-start

      start=cpu_time()
      do i=0,99999
         xx[i]=exp(yy[i])
      end do
      end=cpu_time()
      write(stdout,*) 'Time for exp():     ',end-start


      start=cpu_time()
      do i=0,99999
         yy[i]=xx[i]+1233456789.
      end do
      end=cpu_time()
      write(stdout,*) 'Time for addition: ',end-start

      write(stdout,*) 'Test of new initializer'
      call decimal_to_seed('31415926535897932',seed) // $\lfloor 10^{16} \pi \rfloor$
      call seed_to_decimal(seed,dec)
      write(stdout,*) 'Seed (31415926535897932) = ',dec
      call next_seed_1(23,seed,seed) // Should be 12169046133858735
      call seed_to_decimal(seed,dec)
      write(stdout,*) 'Seed (12169046133858735) = ',dec
      call random_init_1(seed,rn_args(tag))

/* Write out the zeroth random number */
      rn_next(x,tag)            // $215019793392575/2^{48} \approx 0.7639037611986588$
      write(stdout,*) 'Zeroth number (0.7639037611986588) = ',x

/* Here's how to use |fast_random| */
      do i=1,10*RAN_K,RAN_K
         call random_check(RAN_K,rn_args(tag)) // Check |RAN_K| numbers are available
         do j=i,i-1+RAN_K       // This loop can vectorize
            rn_fast_next(x,tag)
         end do
      end do

/* Here's how to use |random| */
      do i=10*RAN_K+1,999       // This loop won't vectorize
         rn_next(x,tag)
      end do

/* Write out the thousandth random number */
      rn_next(x,tag)            // $259243462334031/2^{48} \approx 0.9210177947737144$
      write(stdout,*) '1000th number (0.9210177947737144) = ',x
      
      call next_seed_1(-23,seed,seed) // Backtrack seed
      call seed_to_decimal(seed,dec)
      write(stdout,*) 'Seed (31415926535897932) = ',dec

      stop
      end

@* INDEX.
