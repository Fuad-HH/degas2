@* Segment definitions.

% $Id$

% $Log$

\ID{$Id$}

Information about segment is held in arrays in common blocks.  An segment
is identified by a positive integer indexing into these arrays.  Segments
are to surfaces as zones are to cells.  Segments a top-level picture of
directed surface segements.  (However, not every surface segment needs
to belong to a segment.)  Within the internal geometry routines (which
deal with surfaces and cells), segments are identified by a cell and a
surface number.  This is stored in 

@f sg_decl integer

@m sg_args(x) x

@m sg_dummy(x) x

@m sg_decl(x) integer x @;

@m sg_copy(x,y) y=x @;

@m sg_check(x) (x > 0 && x <= sg_num && 
      sg_type(x) > 0 && sg_type(x) <= sg_type_max)

@m sg_type(x) segment_type[x]
@m sg_pointer(x) segment_pointer[x]
@m sg_volume(x) segment_volume[x]

@ Length specifications.

@m sg_type_max 5
@m sg_undefined 0
@m sg_diagnostic 1
@m sg_wall 2
@m sg_target 3
@m sg_pump 4
@m sg_exit 5

@ Variable definitions.

@a
      package_init(sg)
      define_var_pk(sg,sg_num,INT)
      define_dimen_pk(sg,segment_type_ind,sg_type_max)
      define_dimen_pk(sg,segment_ind,sg_num)
      define_var_pk(sg,segment_type_num,INT,segment_type_ind)
      define_varp_pk(sg,segment_type,INT,segment_ind)
      define_varp_pk(sg,segment_pointer,INT,segment_ind)
      define_varp_pk(sg,segment_cell,INT,segment_ind)
      define_varp_pk(sg,segment_face,INT,segment_ind)

@ Common blocks definitions.

@f sg_common integer
@m sg_common
      sg_common_a;
      character*LINELEN segment_version;
      common /com_segment_c/ segment_version;
      save /com_segment_c/ @;

@ Setting up segment information.

@m sg_type_set(segment,type) sg_type(segment)=type;
      segment_type_num[type]=segment_type_num[type]+1;
      sg_pointer(segment)=segment_type_num[type] @;
