\ID{$Id$}

Data for reactions is held in arrays in common blocks.
|rd_data3(x,m,...)| accesses the data for the $m$th table as an array
with up to 3 dimensions.
Miscellaneous (i.e., not cross section or reaction rate) data is handled
in the analogous |rd_misc_data3| array.

@I xsection.hweb
@I problem.hweb

@m rd_data3(x,m,i,j,k) reaction_data_table[reaction_data_base[x][m]+i+reaction_data_tab_index[x][m][1]*(j+reaction_data_tab_index[x][m][2]*k)]

@m rd_misc_data3(x,m,i,j,k) reaction_misc_table[reaction_misc_base[x][m]+i+reaction_misc_tab_index[x][m][1]*(j+reaction_misc_tab_index[x][m][2]*k)]

@m rd_xs 1
@m rd_rate 2

@ Variable definitions.

@a
      package_init(rd)
      define_var_pk(rd,reaction_data_size,INT)
      define_var_pk(rd,reaction_misc_size,INT)
/*
      define_dummy_pk(rd,rd_ignore,INT)
*/
      define_dimen_pk(rd,rd_rank_ind,xs_table_rank_max)
      define_dimen_pk(rd,rd_dep_var_ind,xs_dep_var_max)
      define_dimen_pk(rd,rd_rank_ind0,0,xs_table_rank_max)
      define_dimen_pk(rd,rd_table_ind,0,reaction_data_size-1)
      define_varp_pk(rd,reaction_organization,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_min,FLOAT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_delta,FLOAT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_rank,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_spacing,INT,rd_rank_ind0,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_tab_index,INT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_base,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_var,INT,rd_rank_ind0,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_data_table,FLOAT,rd_table_ind)
      
      define_dimen_pk(rd,rd_tag_string,xs_tag_string_length)
      define_dimen_pk(rd,rd_misc_table_ind,0,reaction_misc_size-1)
      define_varp_pk(rd,reaction_misc_organization,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_min,FLOAT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_delta,FLOAT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_rank,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_spacing,INT,rd_rank_ind0,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_tab_index,INT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_base,INT,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_var_dep,CHAR,rd_tag_string,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_var_indep,INT,rd_rank_ind,rd_dep_var_ind,problem_reaction_ind)
      define_varp_pk(rd,reaction_misc_table,FLOAT,rd_misc_table_ind)
@ Common blocks definitions.

@f rd_common integer
@m rd_common
      rd_common_a;
      integer inc;

/* The |ragged_alloc| macros are a subset of the ones described in 
   |pmidata.hweb|. More detailed documentation is given there. */
@m rd_set_baseinc(x,y,subs)
      x##_base##subs##=x##_size;
      inc=1;
      $DO(I,range_min(ind_##y##_1),range_max(ind_##y##_1)) {
        inc=inc*y##subs##[I];
      }

@m rd_ragged_alloc(x) 
      x##_size=0;
      var_alloc(x##_base);

@m rd_ragged_realloc(x,y,subs)
      rd_set_baseinc(x,y,subs);
      var_realloc(x##_table,x##_size-1,x##_size-1+inc);
      x##_size=x##_size+inc @;
