@ Common blocks definitions.

@f rd_common integer
@m rd_common
      rd_common_a;
      integer inc;

/*
   |rd_set_inc| computes the number of elements in the J-dimensional
   object labeled by the indices |m| and |n|, where J is the range of 
   the first index of |y|. |y| is intended to be a |tab_index| array
   of the sort defined above.
*/
@m rd_set_inc(y,m,n)
      inc=1;
      $DO(I,range_min(ind_##y##_1),range_max(ind_##y##_1)) {
        inc=inc*y[I,m,n];
      }

/*
   |rd_ragged_alloc| and |rd_ragged_realloc| are designed to automatically
   allocate memory for ragged arrays needed by this class. This simply 
   involves calculating the size of each incremental ``chunk'' 
   (corresponding to particular values of the subscripts |m| and |n|), 
   using that to allocate space in the table |x_table|, setting the
   base |x_base| which stores the address of the initial location of the
   (m,n)th chunk, and totaling the size |x_size| of the array. The number
   of elements in the (m,n)th chunk is contained in the |y| array; see
   |set_inc| above. Since |x_table| has zero size at the beginning of the
   code, no initial allocation is required. However, |x_size| must be
   initialized and memory for |x_base| allocated. We do this in the
   disguise of |rd_ragged_alloc| for consistency with other macros
   which are expanded at the same time.
*/
@m rd_ragged_alloc(x) 
      x##_size=0;
      var_alloc(x##_base);

@m rd_ragged_realloc(x,y,m,n)
      rd_set_inc(y,m,n);
      x##_base(m,n)=x##_size;
      var_realloc(x##_table,x##_size-1,x##_size-1+inc);
      x##_size=x##_size+inc @;
