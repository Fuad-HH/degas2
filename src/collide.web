\ID{$Id$}

@m FILE 'collide.web'

@I macros.hweb
@I particle.hweb
@I problem.hweb
@I random.hweb
@I background.hweb
@I geomint.hweb
@I vector.hweb
@I zone.hweb
@I species.hweb
@I string.hweb
@I reaction.hweb
@I reactiondata.hweb
@I location.hweb
@I xsection.hweb
@I output.hweb
@I materials.hweb

@ The main program.

@a
      @<Functions and Subroutines@>

@ Pick a reaction to process.
@<Functions...@>=
      subroutine pick_reaction(pr_test_dummy(test),
     $     pr_reaction_dummy(ts_reac),rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),
     $     w_prod,num_scoring_data,scoring_data,
     $     scoring_data_label,coupling_scores,rn_dummy(x))

      implicit_none_f77
      rc_common                                         // Common
      pr_common
      implicit_none_f90

      pr_test_decl(test)                                // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                    // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                        // Input/output

      pr_reaction_decl(pr_reac)                         // Local  


      pr_reac=pr_ts_rc(test,ts_reac) 
/* 
   Split up into different reaction types. Note that for now types |dissoc|
   and |dissoc_rec| use the same processing routine; the distinction between
   the two currently exists because different logic is required during the
   ``set products'' phase of |problemsetup|.
*/
      if (rc_reaction_type(pr_reaction(pr_reac)) == 'chargex') then
         call chargex(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'elastic') then
         call elastic(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'dissoc') then
         call dissoc(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'dissoc_rec') then
         call dissoc(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'dissoc_cramd') then
         call dissoc_cramd(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'ionize') then
         call ionize(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))
      else
         assert('Unsupported reaction type' == ' ')
      end if

      return
      end

@ Process a charge exchange reaction.

@<Functions...@>=
      subroutine chargex(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      rd_common
      sp_common
      implicit_none_f90

      rd_decls
      rn_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                   // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      integer i,i_cx,count
      vc_decl(v_test)
      vc_decl(v_back)
      vc_decl(vb_flow)
      vc_decl(vt_plasma_frame)
      vc_decl(vb_therm)
      vc_decl(vrel)
      real v_thermal,ran,sgvmax,cxsec,cx_v,m_i  

      external eval_data                              // External
      real eval_data
      real tempmax
      save tempmax
      data tempmax/zero/
      

      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)
      count=0

      sgvmax=zero
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'sigv_max') then
            sgvmax=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'cross_section') then
            i_cx=i
         end if
      end do

/*
   Transform to frame moving with the local background flow velocity
*/
      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
         vb_flow[i]=independent_parameters[xs_var_v_flow_1+i-1]
      end do
      vc_difference(v_test,vb_flow,vt_plasma_frame)

loop: continue
      count++
 /* Pick a background particle */
      v_thermal=sqrt(independent_parameters[xs_var_sp_temperature])
      do i=1,3
         rn_gauss_next(ran,x)
         vb_therm[i]=v_thermal*ran
      end do

/*
  Now evaluate velocity {\em relative} to this particular particle
  (we need to transform to the frame moving at |vb_flow| ahead of
  time since the average of |vb_therm| is 0.).
*/
      vc_difference(vt_plasma_frame,vb_therm,vrel)

/*
  And re-evaluate the |independent_parameters| associated with the
  relative test energy.
*/
      independent_parameters[xs_var_energy]
     $     =half*independent_parameters[xs_var_m_test]*vc_abs2(vrel)
      independent_parameters[xs_var_sp_energy]=half*vc_abs2(vrel)

      cxsec=eval_data(rd_data_args(reaction_handling,[pr_reac][i_cx]),
     $    independent_parameters,rn_args(x))
      cx_v=cxsec*vc_abs(vrel)

 //     assert(cx_v<=sgvmax)    // Can disable rejection with |sgvmax| = 0.
      if (cx_v > tempmax) then
         tempmax=cx_v
      end if
      rn_next(ran,x)
      if (cx_v < ran*sgvmax) goto loop

/*
   Assume that the background particle becomes the test species and
   vice-versa. Hence, the appearance of the former background velocity
   in the first assignment below for the intended test particle.
*/
      assert(pr_num_arrangements(test,ts_reac) == 1)
      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,1,i)
         if (pr_test_lookup(prod[i]) != 0) then
            w_prod[i]=one
            vc_add(vb_therm,vb_flow,v_back)
            vc_copy(v_back,v_prod[i])
         else
            w_prod[i]=one                        // Was zero - check
            vc_copy(v_test,v_prod[i])
         end if
      end do

/*
   Collision scoring - only background sources expected here.
*/
      coupling_scores[back][ou_coupling_mass]+=
     $     -sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_momentum_1]+=
     $     -sp_m(pr_background(back))*v_back[1]*rate
      coupling_scores[back][ou_coupling_momentum_2]+=
     $     -sp_m(pr_background(back))*v_back[2]*rate
      coupling_scores[back][ou_coupling_momentum_3]+=
     $     -sp_m(pr_background(back))*v_back[3]*rate
      coupling_scores[back][ou_coupling_energy]+=
     $     -half*sp_m(pr_background(back))*vc_abs2(v_back)*rate
      do i=1,nprod
         back_i=pr_background_lookup(prod[i])
         if (back_i != 0) then
            m_i=sp_m(pr_background(back_i))
            coupling_scores[back_i][ou_coupling_mass]+=m_i*rate
            coupling_scores[back_i][ou_coupling_momentum_1]+=
     $           m_i*v_prod[i][1]*rate 
            coupling_scores[back_i][ou_coupling_momentum_2]+=
     $           m_i*v_prod[i][2]*rate
            coupling_scores[back_i][ou_coupling_momentum_3]+=
     $           m_i*v_prod[i][3]*rate
            coupling_scores[back_i][ou_coupling_energy]+=
     $           half*m_i*vc_abs2(v_prod[i])*rate
         end if
      end do

      return
      end

@ Process an elastic collision. Arguments are the same as for |chargex|.

@<Functions...@>=
      subroutine elastic(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      rd_common
      sp_common
      implicit_none_f90

      rd_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                   // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)

      vc_decl(v_test)
      vc_decl(v_back)
      vc_decl(vb_flow)
      vc_decl(vt_plasma_frame)
      vc_decl(vb_therm)
      vc_decl(vrel)
      vc_decl(vcm)
      vc_decl(vb_cm)
      vc_decl(vt_cm)

      integer rm_mu_prob
      integer i,i_cx,count

      real eval_data
      real v_thermal,ran,sigvmax,tempmax,cxsec,cx_v,m_i
      real mu_angle
      real vcm_sq,vb_cmsq,vt_cmsq
      real vcm_sqrt,vbcm_sqrt,vtcm_sqrt
      real lab_energy,vb_lab,vt_lab
      real lab_angle,vb_langle,vt_langle

      save tempmax

      data sigvmax / zero /
      data tempmax / zero /

      external eval_data                               // External
      external lab_angle,lab_energy


      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)
      count=0

      sigvmax=zero
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'sigv_max') then
            sigvmax=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'cross_section') then
            i_cx=i
         else if  (reaction_handling_var0[pr_reac][i] == 'cos_scattering_angle') then
            rm_mu_prob=i
         end if
      end do

/*     
      Transform to frame moving with the local background flow velocity
*/
      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
         vb_flow[i]=independent_parameters[xs_var_v_flow_1+i-1]
      end do
      vc_difference(v_test,vb_flow,vt_plasma_frame)

loop: continue
      count++
/*    
      Pick a background particle 
*/
      v_thermal=sqrt(independent_parameters[xs_var_sp_temperature])
      do i=1,3
         rn_gauss_next(ran,x)
         vb_therm[i]=v_thermal*ran
      end do

/*
  Now evaluate velocity {\em relative} to this particular particle
  (we need to transform to the frame moving at |vb_flow| ahead of
  time since the average of |vb_therm| is 0.).
*/
      vc_difference(vt_plasma_frame,vb_therm,vrel)

/*
  And re-evaluate the |independent_parameters| associated with the
  relative test energy.
*/
      independent_parameters[xs_var_energy]
     $     =half*independent_parameters[xs_var_m_test]*vc_abs2(vrel)
      independent_parameters[xs_var_sp_energy]=half*vc_abs2(vrel)

      cxsec=eval_data(rd_data_args(reaction_handling,[pr_reac][i_cx]),
     $    independent_parameters,rn_args(x))

      cx_v=cxsec*vc_abs(vrel)

      assert(cx_v<=sigvmax)
      if (cx_v > tempmax) then
         tempmax=cx_v
      end if
      rn_next(ran,x)
      if(cx_v < ran*sigvmax) goto loop

/*
  Interpolate the scattering angle:
*/
      mu_angle=eval_data(rd_data_args(reaction_handling,[pr_reac][rm_mu_prob]),
     $ independent_parameters,rn_args(x))

/*
   Do the scattering:
*/
      do i = 1 , 3
         vcm(i) = (independent_parameters[xs_var_m_test]*vt_plasma_frame(i)+
     $        independent_parameters[xs_var_m_back]*vb_therm(i))/
     $        (independent_parameters[xs_var_m_test]+independent_parameters[xs_var_m_back])
         vb_cm(i) = vb_therm(i) - vcm(i)
	 vt_cm(i) = vt_plasma_frame(i) - vcm(i)
      end do

/*    
      convert to laboratory frame from center-of-mass frame
*/
      vcm_sq = vc_abs2(vcm)
      vb_cmsq = vc_abs2(vb_cm)
      vt_cmsq = vc_abs2(vt_cm)
      vcm_sqrt = sqrt(vcm_sq)
      vbcm_sqrt = sqrt(vb_cmsq)
      vtcm_sqrt = sqrt(vt_cmsq)

      vb_lab = sqrt(lab_energy(mu_angle,vcm_sq,vcm_sqrt,vb_cmsq,vbcm_sqrt))
      vt_lab = sqrt(lab_energy(mu_angle,vcm_sq,vcm_sqrt,vt_cmsq,-vtcm_sqrt))
      vb_langle=lab_angle(mu_angle,vcm_sqrt,vbcm_sqrt,vb_lab)
      vt_langle=lab_angle(mu_angle,vcm_sqrt,-vtcm_sqrt,vt_lab)

/*
   This assume a certain order for the products; see |set_prod_elastic|.
*/
      call new_direct(vc_args(vcm),vb_lab,vb_langle,vc_args(v_prod[1]),
     $                1,rn_args(x))
      call new_direct(vc_args(vcm),vt_lab,vt_langle,
     $                vc_args(v_prod[1]),2,rn_args(x))

      assert(pr_num_arrangements(test,ts_reac) == 1) 

      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,1,i)
@#if 0
         if (sp_name(prod[i]) == 'molecular hydrogen') then   // ?????
            w_prod[i]=one
         else
            w_prod[i]=zero
         end if
@#endif
         w_prod[i]=one
         vc_add(v_prod[i],vb_flow,v_prod[i])
      end do
      
      vc_add(vb_therm,vb_flow,v_back)
/*
   Collision scoring - only background sources expected here.
*/
      coupling_scores[back][ou_coupling_mass]+=
     $     -sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_momentum_1]+=
     $     -sp_m(pr_background(back))*v_back[1]*rate
      coupling_scores[back][ou_coupling_momentum_2]+=
     $     -sp_m(pr_background(back))*v_back[2]*rate
      coupling_scores[back][ou_coupling_momentum_3]+=
     $     -sp_m(pr_background(back))*v_back[3]*rate
      coupling_scores[back][ou_coupling_energy]+=
     $     -half*sp_m(pr_background(back))*vc_abs2(v_back)*rate
      do i=1,nprod
         back_i=pr_background_lookup(prod[i])
         if (back_i != 0) then
            m_i=sp_m(pr_background(back_i))
            coupling_scores[back_i][ou_coupling_mass]+=m_i*rate
            coupling_scores[back_i][ou_coupling_momentum_1]+=
     $           m_i*v_prod[i][1]*rate 
            coupling_scores[back_i][ou_coupling_momentum_2]+=
     $           m_i*v_prod[i][2]*rate
            coupling_scores[back_i][ou_coupling_momentum_3]+=
     $           m_i*v_prod[i][3]
            coupling_scores[back_i][ou_coupling_energy]+=
     $           half*m_i*vc_abs2(v_prod[i])*rate
         end if
      end do

      return
      end

@ Process a dissociation. Arguments are the same as for |chargex|.

@<Functions...@>=
      subroutine dissoc(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      sp_common
      rd_common

      implicit_none_f90

      rd_decls
      rn_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                   // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      integer i,num_heavy_products,j_arr
      integer product_index[2]
      vc_decl(v_test)
      vc_decl(v_iso)
      real sum,ran,ediss,elediss,v_diss1,v_diss2,m_i
      real mass[2]

      external eval_data                               // External
      real eval_data
      
      pr_reac=pr_ts_rc(test,ts_reac)   // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)

/*
   Randomly select from the various product arrangements available for this
   test particle-reaction combination. The array |pr_prod_mult| provides the
   probability for each.
*/
      sum=zero
      rn_next(ran,x)
      do i=1,pr_num_arrangements(test,ts_reac)
         sum=sum+pr_prod_mult(test,ts_reac,i)
         if (sum >= ran) then
            j_arr=i
            goto break
         end if
      end do

break:continue

/*
   Get an isotropic unit vector to use in setting the product velocities.
*/
      rn_iso_next(v_iso,x)

      num_heavy_products=0
      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,j_arr,i)
         if (sp_sy(prod[i]) != 'e') then
            num_heavy_products++
            mass[num_heavy_products]=sp_m(prod[i])
            product_index[num_heavy_products]=i
         end if
      end do
      
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'dissociation_energy') then
            ediss=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'background_energy_loss_rate') then
            elediss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do

/*
   Set speeds of products so as to conserve momentum. This routine is 
   equipped to deal with only two heavy products.
*/
      assert(num_heavy_products == 2)
      v_diss1=sqrt(const(4.0)*ediss*(mass[2]/mass[1])/(mass[1]+mass[2]))
      v_diss2=-v_diss1*mass[1]/mass[2]

/*
   Set product velocities by transforming back into the lab frame (from the
   test particle frame). Set weight fractions.
*/
      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
      end do

      do i=1,nprod

         if (product_index[1] == i) then
            vc_xvt(v_test,v_iso,v_diss1,v_prod[i])
            w_prod[i]=one
         else if (product_index[2] == i) then
            vc_xvt(v_test,v_iso,v_diss2,v_prod[i])
            w_prod[i]=one
         else
            vc_set(v_prod[i],zero,zero,zero)
            w_prod[i]=zero
         end if
      end do

/*
   Collision scoring. Will be adding some H-alpha detection and scoring.
   Note: assume background is an electron so that no reagent background
   momentum is lost.
*/
      coupling_scores[back][ou_coupling_mass]+=
     $  -sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_energy]+=-elediss
      do i=1,nprod
         back_i=pr_background_lookup(prod[i])
         if (back_i != 0) then
            m_i=sp_m(pr_background(back_i))
            coupling_scores[back_i][ou_coupling_mass]+=m_i*rate
            coupling_scores[back_i][ou_coupling_momentum_1]+=
     $           m_i*v_prod[i][1]*rate
            coupling_scores[back_i][ou_coupling_momentum_2]+=
     $           m_i*v_prod[i][2]*rate
            coupling_scores[back_i][ou_coupling_momentum_3]+=
     $           m_i*v_prod[i][3]*rate
            coupling_scores[back_i][ou_coupling_energy]+=
     $           half*m_i*vc_abs2(v_prod[i])*rate
         end if
      end do

      return
      end

@ Process a dissociation for CRAMD. Arguments are the same as for |chargex|.

@<Functions...@>=
      subroutine dissoc_cramd(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      sp_common
      rd_common

      implicit_none_f90

      rd_decls
      rn_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                   // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      integer i,num_heavy_products,j_arr
      integer product_index[2]
      vc_decl(v_test)
      vc_decl(v_iso)
      real sum,ran,eloss,iloss,hfrac,ediss,v_diss1,v_diss2,m_i
      real mass[2]

      external eval_data                               // External
      real eval_data
      
      pr_reac=pr_ts_rc(test,ts_reac)   // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)

/*
   Randomly select from the various product arrangements available for this
   test particle-reaction combination. The array |pr_prod_mult| provides the
   probability for each.
*/
      sum=zero
      rn_next(ran,x)
      do i=1,pr_num_arrangements(test,ts_reac)
         sum=sum+pr_prod_mult(test,ts_reac,i)
         if (sum >= ran) then
            j_arr=i
            goto break
         end if
      end do

break:continue

/*
   Get an isotropic unit vector to use in setting the product velocities.
*/
      rn_iso_next(v_iso,x)

      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'background_energy_loss_rate') then
            eloss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'proton_energy_loss_rate') then

/*
   The multiplier here should really be the ion density. The existing
   CRAMD data assume equal electron and ion densities anyway, so do the
   convenient thing here. If that condition is relaxed, should factor the
   density ratio into the externally computed value of |iloss|; this would
   keep its usage consistent with the present definition of the dissociation
   reaction.
*/
            iloss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'H_fraction') then
            hfrac=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do

      num_heavy_products=0
      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,j_arr,i)
         if (sp_sy(prod[i]) != 'e') then
            num_heavy_products++
            mass[num_heavy_products]=sp_m(prod[i])
            product_index[num_heavy_products]=i
            if (sp_z(prod[i]) == 0) then
               w_prod[i]=two*hfrac
            else
               assert(sp_z(prod[i]) > 0)
               w_prod[i]=two*(one-hfrac)
            end if
         else
            w_prod[i]=zero
         end if
      end do
      
/* 
   For the time being, the actual dissocation energy is hardwired at 3 eV.
   Doing better will require significant improvements to CRAMD.
*/
      ediss=const(3.)*electron_charge    
/*
   Set speeds of products so as to conserve momentum. This routine is 
   equipped to deal with only two heavy products.
*/
      assert(num_heavy_products == 2)
      v_diss1=sqrt(const(4.0)*ediss*(mass[2]/mass[1])/(mass[1]+mass[2]))
      v_diss2=-v_diss1*mass[1]/mass[2]

/*
   Set product velocities by transforming back into the lab frame (from the
   test particle frame). Set weight fractions.
*/
      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
      end do
      do i=1,nprod
         if (product_index[1] == i) then
            vc_xvt(v_test,v_iso,v_diss1,v_prod[i])
         else if (product_index[2] == i) then
            vc_xvt(v_test,v_iso,v_diss2,v_prod[i])
         else
            vc_set(v_prod[i],zero,zero,zero)
         end if
      end do

/*
   Collision scoring. This isn't done yet. There remain the MAR and 
   H-alpha data to implement.
*/

      coupling_scores[back][ou_coupling_mass]+=
     $  -sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_energy]+=-eloss
      do i=1,nprod
         back_i=pr_background_lookup(prod[i])
         if (back_i != 0) then
            m_i=sp_m(pr_background(back_i))
            if (sp_sy(prod[i]) == 'e') then
               coupling_scores[back_i][ou_coupling_mass]+=
     $              m_i*(const(3.)-two*hfrac)*rate
            else
               coupling_scores[back_i][ou_coupling_mass]+=
     $              m_i*two*(one-hfrac)*rate
               coupling_scores[back_i][ou_coupling_momentum_1]+=
     $              m_i*v_prod[i][1]*two*(one-hfrac)*rate
               coupling_scores[back_i][ou_coupling_momentum_2]+=
     $              m_i*v_prod[i][2]*two*(one-hfrac)*rate
               coupling_scores[back_i][ou_coupling_momentum_3]+=
     $              m_i*v_prod[i][3]*two*(one-hfrac)*rate
               coupling_scores[back_i][ou_coupling_energy]+=
     $              half*m_i*vc_abs2(v_prod[i])*two*(one-hfrac)*rate-iloss
            end if
         end if
      end do

      return
      end

@ Process an ionization. Arguments are the same as for |chargex|. This
routine is required for ionizations which are not treated by the method
of suppressed absorption.

@<Functions...@>=
      subroutine ionize(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_dummy(prod),vc_dummy(v_prod),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common
      rc_common
      sp_common
      rd_common

      implicit_none_f90

      rd_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer nprod,num_scoring_data                   // Output
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])
      real w_prod[rc_product_max],scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      rc_decl(reac)
      integer i,e_rate_ind,line_ind
      real eioniz
      vc_decl(v_test)
      vc_decl(v_emitter)

      external eval_data,species_add_check             // External
      real eval_data
      logical species_add_check
      
      pr_reac=pr_ts_rc(test,ts_reac)   // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)
      assert(pr_num_arrangements(test,ts_reac) == 1)

/*
   Trying this approach here; may want to propagate into the other
   scoring routines: loop through the ``handling'' dependent variables.
   Grab everything which is explicitly needed for this routine to work.
   Dump everything else into |scoring_data| along with its name. This
   will allow: 
   \begin{enumerate}
     \item This code to not keep track of which emission lines (if
           any at all) are present in the data.
     \item Any data which are special to a particular reaction of this
           type to be scored simply by setting |tally_dep_var| to the
           same label. {\em This code would not require modification.}
   \end{enumerate}
*/

      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
      end do
      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,1,i)
         if (sp_sy(prod[i]) != 'e') then
            vc_copy(v_test,v_prod[i])
            w_prod[i]=one
         else
            vc_set(v_prod[i],zero,zero,zero)
            w_prod[i]=zero
         end if
      end do

      reac=pr_reaction(pr_reac)
      if (rc_emitter(reac) != 0) then
         if (rc_emitter(reac) > 0) then
            vc_copy(v_prod[rc_emitter(reac)],v_emitter)
            independent_parameters[xs_var_m_emitter]=sp_m(prod[rc_emitter(reac)])
/* Don't really recall which reagent is which. Should be able to tell
   test from a back just with |sp_generic|.
*/
         else if (sp_generic(rc_reagent(reac,-rc_emitter(reac))) 
     $           == sp_generic(pr_test(test))) then
            vc_copy(v_test,v_emitter)
            independent_parameters[xs_var_m_emitter]=sp_m(pr_test(test))
         else if (sp_generic(rc_reagent(reac,-rc_emitter(reac))) 
     $           == sp_generic(pr_background(back))) then
            assert('background velocity not set' == ' ')
         end if
         scoring_data_label[num_scoring_data+1]='emitter_v_1'
         scoring_data[num_scoring_data+1]=v_emitter[1]
         scoring_data_label[num_scoring_data+2]='emitter_v_2'
         scoring_data[num_scoring_data+2]=v_emitter[2]
         scoring_data_label[num_scoring_data+3]='emitter_v_3'
         scoring_data[num_scoring_data+3]=v_emitter[3]
         num_scoring_data+=3
      end if

/*
   ``In general'' the emission rate and wavelength variables should both
   have the name of the line appended to the variable names. For the case
   of greatest interest, this would entail carrying around 3 sets of 
   (usually) identical data - one for each hydrogen isotope. This
   is a compromise : since we assume only one emitter, we can give it a
   generic name without confusion. Below we look for the nonzero wavelength
   and upon finding it reset the emission rate variable to have the 
   corresponding line name.
*/
      e_rate_ind=0
      line_ind=0
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'background_energy_loss_rate') then
            eioniz=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] != 'unknown') then
            num_scoring_data++
            scoring_data_label[num_scoring_data]
     $           =reaction_handling_var0[pr_reac][i]
            scoring_data[num_scoring_data]
     $           =eval_data(rd_data_args(reaction_handling,
     $           [pr_reac][i]),independent_parameters,rn_args(x))
            if (scoring_data_label[num_scoring_data] == 'emission_rate') then
                e_rate_ind=num_scoring_data
                scoring_data[e_rate_ind]*=independent_parameters[xs_var_density]
             end if
            if (scoring_data_label[num_scoring_data]SP(1:10) == 'wavelength' 
     $           && scoring_data[num_scoring_data] > zero) 
     $           line_ind=num_scoring_data
         end if
      end do

      if (e_rate_ind != 0 && line_ind != 0) then 
         scoring_data_label[e_rate_ind]=
     $        'emission_rate'\/scoring_data_label[line_ind]SP(11:)
         assert(rc_emitter(reac) != 0)
      end if

/*
   Collision scoring of |coupling_scores|
*/
      coupling_scores[back][ou_coupling_mass]+=
     $  -sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_energy]+=-eioniz
      do i=1,nprod
         prod[i]=pr_ts_prod(test,ts_reac,1,i)
         back_i=pr_background_lookup(prod[i])
         if (back_i != 0) then
            coupling_scores[back_i][ou_coupling_mass]+=
     $           sp_m(prod[i])*rate
            if (i == 2) then         // See assertion below
               vc_copy(v_test,v_prod[i])
               coupling_scores[back_i][ou_coupling_momentum_1]+=
     $              sp_m(prod[i])*v_prod[i][1]*rate 
               coupling_scores[back_i][ou_coupling_momentum_2]+=
     $              sp_m(prod[i])*v_prod[i][2]*rate
               coupling_scores[back_i][ou_coupling_momentum_3]+=
     $              sp_m(prod[i])*v_prod[i][3]*rate
               coupling_scores[back_i][ou_coupling_energy]+=
     $              half*sp_m(prod[i])*vc_abs2(v_prod[i])*rate
            else if (i == 3) then
               vc_set(v_prod[i],zero,zero,zero)
            end if
         end if
      end do
            
/*
  Verify that second product (plus an electron, the third product) corresponds
  to the test species, as should have been checked in problemsetup and is 
  assumed above.

  This check turns out to be inordinately time consuming. Comment out for
  now. This is the same check which is used in |set_prod_ionize|
  during problemsetup.

      assert(species_add_check(2,sp_args(prod[2]),1,sp_args(pr_test(test))))
*/
      return
      end

@ Subroutine to determine the laboratory scattering angle

@<Functions...@>=
      subroutine new_direct(vc_dummy(v_dummy),v_lab,cos_psi,vc_dummy(v_prod),
     $                      i,rn_dummy(x))
      implicit_none_f77
      implicit_none_f90

      rn_decl(x)

      vc_decl(v_prod[rc_product_max])
      vc_decl(v_dummy)
      vc_decl(v_prime)
      vc_decl(unit_v)
      vc_decl(vector_temp)

      integer i,itest

      real sign,v_lab
      real cos_psi,sin_psi
      real cos_delta,sin_delta
      real rho_bar
      real eps,eps_sq,eta,eta_sq,eps_eta

      data itest / 0 /

      if ( itest .eq. 0 ) then

loop: continue
      rn_next(eps,x)
      rn_next(eta,x)
      eps_sq=eps*eps
      eta_sq=eta*eta
      eps_eta=eps_sq+eta_sq
      if ( eps_eta > one ) goto loop

      cos_delta=(eps_sq-eta_sq)/eps_eta
      sin_delta=2.*eps*eta/eps_eta
      rn_next(sign,x)
      if ( sign < 0.5 ) sin_delta = -sin_delta

      sin_psi=sqrt(1.-cos_psi*cos_psi)

      itest = 1

      elseif( itest == 1 ) then

         sin_psi=-sqrt(1.-cos_psi*cos_psi)
         itest = 0

      end if

      vc_unit(v_dummy,unit_v)

      rho_bar=sqrt(1.-unit_v(3)*unit_v(3))

      if (  unit_v(3) <= 0.95 ) then

         v_prime(1)=(sin_psi*cos_delta*unit_v(3)*unit_v(1)-
     $     sin_psi*sin_delta*unit_v(2))/rho_bar+cos_psi*unit_v(1)
         v_prime(2)=(sin_psi*cos_delta*unit_v(3)*unit_v(2)+
     $     sin_psi*sin_delta*unit_v(1))/rho_bar+cos_psi*unit_v(2)
         v_prime(3)=-sin_psi*cos_delta*rho_bar+cos_psi*unit_v(3)

      else

         v_prime(1)=sin_psi*cos_delta
         v_prime(2)=sin_psi*sin_delta
         v_prime(3)=cos_psi*unit_v(3)

      endif

      vc_scale(v_lab,v_prime,v_prod[i])

      return
      end

@ Calculation of Post Collision Laboratory velocity squared

@<Functions...@>=
      function lab_energy(mu_angle,vcm_sq,vcm_sqrt,vx_cmsq,vxcm_sqrt)
      implicit_none_f77
      implicit_none_f90

      real vcm_sq,vcm_sqrt,vx_cmsq,vxcm_sqrt
      real mu_angle,lab_energy
      
      lab_energy = vcm_sq+vx_cmsq+2.*vcm_sqrt*vxcm_sqrt*mu_angle

      return
      end

@ Subroutine to determine the laboratory scattering angle

@<Functions...@>=
      function lab_angle(mu_angle,vcm_sqrt,vxcm_sqrt,vx_lab)
      implicit_none_f77
      implicit_none_f90

      real vcm_sqrt,vxcm_sqrt,vx_lab
      real mu_angle,lab_angle

      lab_angle=(vcm_sqrt+vxcm_sqrt*mu_angle)/vx_lab

      return
      end

@ Pick a reaction to score by track length estimator.

@<Functions...@>=
      subroutine pick_track_reaction(pr_test_dummy(test),
     $     pr_reaction_dummy(ts_reac),rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      rc_common                                         // Common
      pr_common

      implicit_none_f90

      pr_test_decl(test)                                // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer num_scoring_data                          // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                        // Input/output

      pr_reaction_decl(pr_reac)                         // Local  

      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list

      if (rc_reaction_type(pr_reaction(pr_reac)) == 'chargex') then
         call track_chargex(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'elastic') then
         call track_elastic(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'dissoc') then
         call track_dissoc(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'dissoc_rec') then
         call track_dissoc(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac))=='dissoc_cramd') then
         call track_dissoc_cramd(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'ionize') then
         call track_ionize(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else if (rc_reaction_type(pr_reaction(pr_reac)) == 'ionize_suppress') then
         call track_ionize(pr_test_args(test),
     $        pr_reaction_args(ts_reac),rate,independent_parameters,
     $        num_scoring_data,scoring_data,scoring_data_label,
     $        coupling_scores,rn_args(x))
      else
         assert('Unsupported reaction type' == ' ')
      end if

      return
      end

@ Compute scoring data for charge exchange track-length estimator.

@<Functions...@>=
      subroutine track_chargex(pr_test_dummy(test),
     $     pr_reaction_dummy(ts_reac),rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      rc_common                                         // Common
      rd_common
      pr_common
      sp_common

      implicit_none_f90

      rd_decls
      pr_test_decl(test)                                // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer num_scoring_data                          // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                        // Input/output

      pr_reaction_decl(pr_reac)                         // Local  
      pr_background_decl(back)
      integer i,nprod,back_i
      real ni_1up,ni_2up2,up2,up,u_abs,uprime_abs,mom_src,m_i
      vc_decl(u)
      vc_decl(uprime)
      vc_decl(vb_flow)

      external eval_data                                // External
      real eval_data

      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)
      ni_1up=real_uninit
      ni_2up2=real_uninit
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'I_l_1*up') then
            ni_1up=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'I_l_2*up^2') then
            ni_2up2=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do
      assert(ni_1up != real_uninit && ni_2up2 != real_uninit)

      do i=1,3
         u[i]=independent_parameters[xs_var_v_test_1+i-1]
         vb_flow[i]=independent_parameters[xs_var_v_flow_1+i-1]
      end do

      up2=two*independent_parameters[xs_var_sp_temperature]
      up=sqrt(up2)
      u_abs=vc_abs(u)
      vc_difference(u,vb_flow,uprime)
      uprime_abs=vc_abs(uprime)

      coupling_scores[back][ou_coupling_mass]+=
     $     -sp_m(pr_background(back))*rate
      mom_src=sp_m(pr_background(back))*(-half*up2*rate/uprime_abs**2
     $     +ni_1up/uprime_abs)
      coupling_scores[back][ou_coupling_momentum_1]
     $     +=-sp_m(pr_background(back))*rate*u[1]
     $     + mom_src*uprime[1]
      coupling_scores[back][ou_coupling_momentum_2]
     $     +=-sp_m(pr_background(back))*rate*u[2]
     $     + mom_src*uprime[2]
      coupling_scores[back][ou_coupling_momentum_3]
     $     +=-sp_m(pr_background(back))*rate*u[3]
     $     + mom_src*uprime[3]
      coupling_scores[back][ou_coupling_energy] 
     $     +=sp_m(pr_background(back))*(
     $     -half*u_abs**2*rate
     $     +vc_product(u,uprime)*ni_1up/uprime_abs
     $     -half*(up2*vc_product(u,uprime)*rate/uprime_abs**2+ni_2up2))
      do i=1,nprod
         back_i=pr_background_lookup(pr_ts_prod(test,ts_reac,1,i))
         if (back_i != 0) then
            m_i=sp_m(pr_background(back_i))
            coupling_scores[back_i][ou_coupling_mass]+=m_i*rate
            coupling_scores[back_i][ou_coupling_momentum_1]+=m_i*rate*u[1]
            coupling_scores[back_i][ou_coupling_momentum_2]+=m_i*rate*u[2]
            coupling_scores[back_i][ou_coupling_momentum_3]+=m_i*rate*u[3]
            coupling_scores[back_i][ou_coupling_energy]+=
     $           half*m_i*rate*u_abs**2
         end if
      end do

      return
      end

@ Compute scoring data for elastic scattering track-length estimator.

@<Functions...@>=
      subroutine track_elastic(pr_test_dummy(test),
     $     pr_reaction_dummy(ts_reac),rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      rc_common                                         // Common
      rd_common
      pr_common

      implicit_none_f90

      rd_decls
      pr_test_decl(test)                                // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer num_scoring_data                          // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                        // Input/output

      pr_reaction_decl(pr_reac)                         // Local  
      pr_background_decl(back)
      integer i
      real ni_0,ni_1up,ni_2up2,up2,up,m_test,m_back,mom_src,uprime_abs
      vc_decl(u)
      vc_decl(uprime)
      vc_decl(vb_flow)

      external eval_data                                // External
      real eval_data

      pr_reac=pr_ts_rc(test,ts_reac)  // Index to problem-reaction list
      back=pr_ts_bk(test,ts_reac)
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'I_1_0') then
            ni_0=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'I_l_1*up') then
            ni_1up=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'I_l_2*up^2') then
            ni_2up2=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do

      do i=1,3
         u[i]=independent_parameters[xs_var_v_test_1+i-1]
         vb_flow[i]=independent_parameters[xs_var_v_flow_1+i-1]
      end do

      up2=two*independent_parameters[xs_var_sp_temperature]
      up=sqrt(up2)
      vc_difference(u,vb_flow,uprime)
      uprime_abs=vc_abs(uprime)
      m_test=independent_parameters[xs_var_m_test]
      m_back=independent_parameters[xs_var_m_back]

      coupling_scores[back][ou_coupling_mass]+=zero // NO CHANGE in species
      mom_src=(m_test*m_back/(m_test+m_back))*(-half*up2*ni_0/uprime_abs**2
     $     +ni_1up/uprime_abs)
      coupling_scores[back][ou_coupling_momentum_1]
     $     +=mom_src*uprime[1]
      coupling_scores[back][ou_coupling_momentum_2]
     $     +=mom_src*uprime[2]
      coupling_scores[back][ou_coupling_momentum_3]
     $     +=mom_src*uprime[3]
      coupling_scores[back][ou_coupling_energy] 
     $     +=(two*m_test*m_back/(m_test+m_back)**2)
     $     *(half*m_back*ni_2up2
     $     +half*(m_test+m_back)*vc_product(u,uprime)
     $     *(ni_1up/uprime_abs-half*up2*ni_0/uprime_abs**2))
      // No product terms!

      return
      end

@ Compute scoring data for dissociation track-length estimator.

@<Functions...@>=
      subroutine track_dissoc(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      sp_common
      rd_common

      implicit_none_f90

      rd_decls
      rn_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[*]

      integer num_scoring_data                         // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      sp_decl(prod[rc_product_max])
      integer i,nprod,num_heavy_products,j_arr,k
      integer product_index[2]
      vc_decl(v_test)
      real ediss,elediss,mass_total
      real mass[2]

      external eval_data                               // External
      real eval_data
      
      pr_reac=pr_ts_rc(test,ts_reac)   // Index to problem-reaction list
      back=pr_ts_bk(test,ts_reac)
      nprod=rc_product_num(pr_reaction(pr_reac))

/*
   Search through the list of miscellaneous dependent
   variables to find |ediss|, the dissociation energy, and |elediss|, the
   energy lost by the dissociating agent. 
*/
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'dissociation_energy') then
            ediss=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'background_energy_loss_rate') then
            elediss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do
/*
   TLE scoring:
   This may work for MASS ONLY. The product momentum and energy expressions 
   are provisional; they assume that the isotropic component of the 
   dissociated velocities has been averaged out. Note: this may not work at 
   all for a time-dependent case.
*/
      coupling_scores[back][ou_coupling_mass]+=-sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_energy]+=-elediss
      do i=1,3
         v_test[i]=independent_parameters[xs_var_v_test_1+i-1]
      end do
      do j_arr=1,pr_num_arrangements(test,ts_reac)
         num_heavy_products=0
         mass_total=zero
         do i=1,nprod
            prod[i]=pr_ts_prod(test,ts_reac,j_arr,i)
            back_i=pr_background_lookup(prod[i])
            if (back_i != 0) then
               coupling_scores[back_i][ou_coupling_mass]+=
     $              sp_m(prod[i])*rate*pr_prod_mult(test,ts_reac,j_arr)
            end if
            if (sp_sy(prod[i])  != 'e') then
               num_heavy_products++
               mass[num_heavy_products]=sp_m(prod[i])
               mass_total+=sp_m(prod[i])
               product_index[num_heavy_products]=i
            end if
         end do
         assert(num_heavy_products == 2)
         do k=1,num_heavy_products
            back_i=pr_background_lookup(pr_ts_prod(test,ts_reac,j_arr,product_index[k]))
            if (back_i != 0) then
               coupling_scores[back_i][ou_coupling_momentum_1]+=
     $              mass[k]*v_test[1]*rate*pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_momentum_2]+=
     $              mass[k]*v_test[2]*rate*pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_momentum_3]+=
     $              mass[k]*v_test[3]*rate*pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_energy]+=
     $              (half*mass[k]*vc_abs2(v_test)+two*ediss*(one-mass[k]/mass_total))
     $              *rate*pr_prod_mult(test,ts_reac,j_arr)
            end if
         end do
      end do

      return
      end

@ Comput scoring data for CRAMD dissociation track-length estimator.

@<Functions...@>=
      subroutine track_dissoc_cramd(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                                        // Common
      rc_common
      sp_common
      rd_common

      implicit_none_f90

      rd_decls
      rn_decls
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[*]

      integer num_scoring_data                         // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      pr_reaction_decl(pr_reac)                        // Local
      pr_background_decl(back)
      pr_background_decl(back_i)
      sp_decl(prod[rc_product_max])
      integer i,num_heavy_products,j_arr,k,nprod
      integer product_index[2]
      vc_decl(v_test)
      real eloss,iloss,hfrac,ediss,mass_total
      real mass[2]

      external eval_data                               // External
      real eval_data
      
      pr_reac=pr_ts_rc(test,ts_reac)   // Index to problem-reaction list
      nprod=rc_product_num(pr_reaction(pr_reac))
      back=pr_ts_bk(test,ts_reac)

/*
   Search through the list of miscellaneous dependent
   variables to find |ediss|, the dissociation energy, and |elediss|, the
   energy lost by the dissociating agent. 
*/
      do i=1,rd_dep_var_max
         if (reaction_handling_var0[pr_reac][i] == 'background_energy_loss_rate') then
            eloss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'proton_energy_loss_rate') then  // See comment in |dissoc_cramd|
            iloss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] == 'H_fraction') then
            hfrac=eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         end if
      end do

/* 
   For the time being, the actual dissocation energy is hardwired at 3 eV.
   Doing better will require significant improvements to CRAMD.
*/
      ediss=const(3.)*electron_charge    

/*
   TLE Scoring:
  We cannot pretend to be able to do mixed isotope dissociations anymore. 
  We would need a more complete species breakdown of the particle and 
  energy transfer rates. The same caveats apply to the momentum and
  energy exchanges as in |track_dissoc|.
*/
      assert(sp_ncomp(pr_test(test)) == 1)
      assert(sp_count(pr_test(test),1) == 2)

      assert(sp_sy(pr_background(back)) == 'e')
      coupling_scores[back][ou_coupling_mass]+=-sp_m(pr_background(back))*rate
      coupling_scores[back][ou_coupling_energy]+=-eloss
      do j_arr=1,pr_num_arrangements(test,ts_reac)
         num_heavy_products=0
         mass_total=zero
         do i=1,nprod
            back_i=pr_background_lookup(pr_ts_prod(test,ts_reac,j_arr,i))
            if (back_i != 0) then
               if (sp_sy(prod[i]) == 'e') then
                  coupling_scores[back_i][ou_coupling_mass]+=
     $                 sp_m(pr_background(back_i))
     $                 *rate*(const(3.)-two*hfrac)*pr_prod_mult(test,ts_reac,j_arr)
               else
                  coupling_scores[back_i][ou_coupling_mass]+=
     $                 sp_m(pr_background(back_i))
     $                 *rate*two*(one-hfrac)*pr_prod_mult(test,ts_reac,j_arr)
               end if
            end if
            prod[i]=pr_ts_prod(test,ts_reac,j_arr,i)
            if (sp_sy(prod[i])  != 'e') then
               num_heavy_products++
               mass[num_heavy_products]=sp_m(prod[i])
               mass_total+=sp_m(prod[i])
               product_index[num_heavy_products]=i
            end if
         end do
         assert(num_heavy_products == 2)
         do k=1,num_heavy_products
            back_i=pr_background_lookup(product_index[k])
            if (back_i != 0) then
               coupling_scores[back_i][ou_coupling_momentum_1]+=
     $              mass[k]*v_test[1]*rate*two*(one-hfrac)
     $              *pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_momentum_2]+=
     $              mass[k]*v_test[2]*rate*two*(one-hfrac)
     $              *pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_momentum_3]+=
     $              mass[k]*v_test[3]*rate*two*(one-hfrac)
     $              *pr_prod_mult(test,ts_reac,j_arr)
               coupling_scores[back_i][ou_coupling_energy]+=
     $              (half*mass[k]*vc_abs2(v_test)
     $              +two*ediss*(one-mass[k]/mass_total))
     $              *rate*two*(one-hfrac)*pr_prod_mult(test,ts_reac,j_arr)
     $              -iloss
            end if
         end do
      end do

      return
      end

@ Compute scoring data for ionization track-length estimator.

@<Functions...@>=
      subroutine track_ionize(pr_test_dummy(test),pr_reaction_dummy(ts_reac),
     $     rate,independent_parameters,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_dummy(x))

      implicit_none_f77
      implicit_none_f90
      pr_test_decl(test)                               // Input
      pr_reaction_decl(ts_reac)
      real rate
      real independent_parameters[xs_max_indep_params]

      integer num_scoring_data                         // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                                       // Input/output

      integer nprod                                    // Local (dummies)
      real w_prod[rc_product_max]
      sp_decl(prod[rc_product_max])
      vc_decl(v_prod[rc_product_max])

/*
   The code we need here looks so much like the corresponding reaction
   processing routine that we might as well just call it.
*/
      call ionize(pr_test_args(test),pr_reaction_args(ts_reac),
     $     rate,independent_parameters,
     $     nprod,sp_args(prod),vc_args(v_prod[1]),w_prod,
     $     num_scoring_data,scoring_data,scoring_data_label,
     $     coupling_scores,rn_args(x))

      return
      end

@ Set scoring data for recombinations. Recombination scoring is
actually done at the source point or as a post-processor.

@<Functions...@>=
      subroutine recombination_data(pr_test_dummy(test),
     $   pr_reaction_dummy(bk_rc_is),est,rate,independent_parameters,
     $   num_scoring_data,scoring_data,scoring_data_label,
     $   coupling_scores,rn_dummy(x))

      implicit_none_f77
      pr_common                             // Common
      bk_common
      gi_common
      rc_common
      sp_common
      rd_common
      zn_common

      implicit_none_f90

      rd_decls
      lc_decls
      pr_test_decl(test)                     // Input
      pr_reaction_decl(bk_rc_is)
      integer est
      real rate
      real independent_parameters[xs_max_indep_params]

      integer num_scoring_data              // Output
      real scoring_data[scoring_data_max],
     $     coupling_scores[*][ou_coupling_max]
      character*tl_tag_length scoring_data_label[scoring_data_max]
      rn_decl(x)                            // Input/output

      pr_background_decl(back_2)            // Local
      pr_background_decl(back_1)
      pr_reaction_decl(pr_reac)
      rc_decl(reac)
      lc_decl(zone_loc)
      vc_decl(vb_flow)
      vc_decl(v_src)
      integer i,e_rate_ind,line_ind
      real e_src,e_e_loss,e_e_src

      external eval_data                    // External
      real eval_data

/*
   By convention, the second reagent is the one which will give
   rise to the velocity of the product test particle. The first
   background reagent is taken to be a pure background particle and
   enters here through the data in |independent_parameters|.
*/
      back_1=pr_bkrc_rg(bk_rc_is,1)
      back_2=pr_bkrc_rg(bk_rc_is,2)
      pr_reac=pr_bk_rc(bk_rc_is)
      reac=pr_reaction(pr_reac)

/*
   Set data for line emission. For post-processing, compute spectrum
   based on locally Maxwellian distributed ions. If scoring is 
   instead done at the source, take the actual sourced test particle
   velocity. Set the background momentum and energy sinks in an
   analogous way.
*/
      if (rc_emitter(reac) != 0) then
         assert(rc_emitter(reac) == 1)
         independent_parameters[xs_var_m_emitter]=sp_m(pr_test(test))
         if (est == tl_est_post_process) then
            vc_copy(zone_center[int(independent_parameters[xs_var_zone])],
     $           lc_x(zone_loc))
            lc_set(zone_loc)
            v_ext_to_int(lc_x(zone_loc),bk_v(back_2,lc_zone(zone_loc)),vb_flow,geometry_symmetry,background_coords)
            scoring_data_label[num_scoring_data+1]='emitter_vf-Maxwell_1'
            scoring_data[num_scoring_data+1]=vb_flow[1]
            scoring_data_label[num_scoring_data+2]='emitter_vf-Maxwell_2'
            scoring_data[num_scoring_data+2]=vb_flow[2]
            scoring_data_label[num_scoring_data+3]='emitter_vf-Maxwell_3'
            scoring_data[num_scoring_data+3]=vb_flow[3]
            scoring_data_label[num_scoring_data+4]='emitter_vth-Maxwell'
            scoring_data[num_scoring_data+4]=
     $           sqrt(bk_temp(back_2,lc_zone(zone_loc))
     $           /sp_m(pr_background(back_2)))
            num_scoring_data+=4
            vc_copy(vb_flow,v_src)
            e_src=const(1.5)*bk_temp(back_2,lc_zone(zone_loc))
         else if (est == tl_est_collision) then
            do i=1,3
               v_src[i]=independent_parameters[xs_var_v_test_1+i-1]
            end do
            scoring_data_label[num_scoring_data+1]='emitter_v_1'
            scoring_data[num_scoring_data+1]=v_src[1]
            scoring_data_label[num_scoring_data+2]='emitter_v_2'
            scoring_data[num_scoring_data+2]=v_src[2]
            scoring_data_label[num_scoring_data+3]='emitter_v_3'
            scoring_data[num_scoring_data+3]=v_src[3]
            num_scoring_data+=3
            e_src=half*sp_m(pr_background(back_2))*vc_abs2(v_src)
         end if
      end if

      e_rate_ind=0
      line_ind=0
      e_e_loss=zero
      e_e_src=zero
      do i=1,rd_dep_var_max

/* 
   Grab background energy loss and source rates (radiation and ``ionization''
   energy).
*/
         if (reaction_handling_var0[pr_reac][i] 
     $        == 'background_energy_loss_rate') then
            e_e_loss=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))
         else if (reaction_handling_var0[pr_reac][i] 
     $           == 'background_energy_source_rate') then
            e_e_src=independent_parameters[xs_var_density]
     $           *eval_data(rd_data_args(reaction_handling,[pr_reac][i]),
     $           independent_parameters,rn_args(x))

/* 
   Evaluate everything else nontrivial
*/
         else if (reaction_handling_var0[pr_reac][i] != 'unknown') then
            num_scoring_data++
            scoring_data_label[num_scoring_data]
     $           =reaction_handling_var0[pr_reac][i]
            scoring_data[num_scoring_data]
     $           =eval_data(rd_data_args(reaction_handling,
     $           [pr_reac][i]),independent_parameters,rn_args(x))
            if (scoring_data_label[num_scoring_data] == 'emission_rate') then
               e_rate_ind=num_scoring_data
               scoring_data[e_rate_ind]*=independent_parameters[xs_var_density]
            end if
            if (scoring_data_label[num_scoring_data]SP(1:10)=='wavelength' 
     $           && scoring_data[num_scoring_data] > zero) 
     $           line_ind=num_scoring_data
         end if
      end do

      if (e_rate_ind != 0 && line_ind != 0) then 
         scoring_data_label[e_rate_ind]=
     $        'emission_rate'\/scoring_data_label[line_ind]SP(11:)
         assert(rc_emitter(reac) != 0)
      end if

/*
   Collision scoring of |coupling_scores|
*/
      coupling_scores[back_1][ou_coupling_mass]+=
     $  -sp_m(pr_background(back_1))*rate
      coupling_scores[back_2][ou_coupling_mass]+=
     $     -sp_m(pr_background(back_2))*rate
      coupling_scores[back_2][ou_coupling_momentum_1]+=
     $     sp_m(pr_background(back_2))*v_src[1]*rate 
      coupling_scores[back_2][ou_coupling_momentum_2]+=
     $     sp_m(pr_background(back_2))*v_src[2]*rate 
      coupling_scores[back_2][ou_coupling_momentum_3]+=
     $     sp_m(pr_background(back_2))*v_src[3]*rate 
      coupling_scores[back_1][ou_coupling_energy]+=
     $     e_e_src-e_e_loss
      coupling_scores[back_2][ou_coupling_energy]+=
     $     e_src*rate

      return
      end

