@n/

@* Sampling from the sources.

\ID{$Id$}

@m FILE 'sources.web'

@I macros.hweb

@ The main program.

@a
      @<Functions and Subroutines@>

@ The sampling function.  This is an idiot version for now.  It uses an
inefficient procure for finding the source.  It just returns the
position of for the next flight.  (Missing is the species information, a
proper location, etc.)  It gives a uniform distribution along a line
(which isn't strictly correct).

@<Functions...@>=
      subroutine sample_sources(rn_dummy(r),lc_dummy(x))
      implicit_none
      rn_decl(r)                // Input and output
      lc_decl(x)                // Output
      real u,sum,fr,xa[3],xb[3] // Local
      integer i,n
      so_common                 // Common
      vc_common
      lc_common
      zn_common
      
      rn_next(u,r)
      u=source_total*u
      sum=zero
      do i=1,so_num
         if (sum+source_current(i) >= u) then
            fr=(u-sum)/source_current(i)
            n=i
            goto break
         endif
         sum=sum+source_current(i)
      end do
break: continue
      vc_difference(source_pos[1,n],source_pos[0,n],xa)
      vc_xvt(source_pos[0,n],xa,fr,lc_x(x))
      vc_set(xb,zero,one,zero)
      vc_cross(xa,xb,xa)
      fr=const(1.0,-4)/vc_abs(xa)
      vc_xvt(lc_x(x),xa,fr,lc_x(x))
      
      lc_set(x)
      assert(zn_type(lc_zone(x))==zn_plasma)
      return
      end

@* Index.
