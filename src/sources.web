@* Sampling from the sources.

\ID{$Id$}

@m FILE 'sources.web'

@I macros.hweb
@I random.hweb
@I location.hweb
@I sources.hweb
@I zone.hweb
@I species.hweb
@I flight.hweb
@I vector.hweb
@I particle.hweb
@I geomint.hweb
@I sector.hweb
@I background.hweb
@I problem.hweb
@I element.hweb
@I string.hweb
@I tally.hweb
@I output.hweb
@I reaction.hweb
@I materials.hweb

@ The main program.

@a
      @<Functions and Subroutines@>

@ Sampling Routine. This is the non-idiot version. Although still
incomplete, it should be easy to add more functionality. Models are
at this point faithful to the original DEGAS versions. This routine
oversees the selection of the flight origin's position, velocity,
species and ``relative weight''.

@f sources_localcommon integer
@m sources_localcommon save /sources_common/;
      vc_decl(x_surface);
      common /sources_common/ x_surface @;

@<Functions...@>=
      subroutine sample_sources(fl_dummy(x),rel_wt)
      implicit_none_f77
      so_common           // Common
      sp_common
      pr_common
      implicit_none_f90
      
      fl_decl(x)          // Input and output
      real rel_wt         // Output

      real urd,vprob      // Local
      integer kseg,xseg
      sp_decl(spsrc)

      st_decls
      rn_decls

/*
   Sample one segment from this source group. This implementation follows
   the description of the sampling algorithm described in Sec. 3.4.1 (and
   Exercise 7) of Knuth. He refers to the originator, A. J. Walker,
   [{\em Electronics Letters} {\bf 10}, 8 (1974), 127-128; {\em ACM Trans.
   Math. Software} {\bf 3} (1976), 253-256]. 
*/
      if (so_sampling == so_random) then
         rn_next(urd,fl_rand(x))
      else if (so_sampling == so_direct) then
         urd=mod(so_direct_delta+so_direct_mult*areal(fl_number(x)),one)
      else
         assert('Illegal value of so_sampling' == ' ')
      end if
      kseg=int(so_nseg(fl_source(x))*urd)
      vprob=so_nseg(fl_source(x))*urd - kseg
      if (vprob < source_segment_prob_alias[so_base(fl_source(x))+kseg]) then
         xseg=source_segment_ptr[so_base(fl_source(x))+kseg]
      else
         xseg=source_segment_ptr_alias[so_base(fl_source(x))+kseg]
         kseg=int_lookup(xseg,source_segment_ptr[so_base(fl_source(x))],so_nseg(fl_source(x)))-1
      end if

      call set_source_x(so_args(fl_source(x)),xseg,rn_args(fl_rand(x)),
     $     lc_args(pt_loc(fl_origin(x))))

      call set_source_v(so_args(fl_source(x)),xseg,lc_args(pt_loc(fl_origin(x))),
     $     rn_args(fl_rand(x)),vc_args(pt_v(fl_origin(x))),sp_args(spsrc))

      fl_init(x,sp_sy(spsrc))
      assert(pr_test_check(pt_test(fl_current(x))))

      rel_wt=source_segment_rel_wt[so_base(fl_source(x))+kseg]
     $     *so_wt_norm(fl_source(x))


      return
      end

@ Source position. Given a source ``segment'', sample a single point
using routines specific for the geometry of that source. 

@<Functions...@>=
      subroutine set_source_x(so_dummy(isource),xseg,rn_dummy(r),lc_dummy(x))
      implicit_none_f77
      gi_common                  // Common
      so_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      rn_decl(r)                 // Input and output
      lc_decl(x)                 // Output
      rn_decls

      
/* Can only handle 2-D geometries here:
 */
      assert(geometry_symmetry == geometry_symmetry_plane ||
     $     geometry_symmetry == geometry_symmetry_oned ||
     $     geometry_symmetry == geometry_symmetry_cylindrical)
      if (so_geom(isource) == so_surface) then
         call set_surface_source_x(so_args(isource),xseg,rn_args(r),lc_args(x))
      else if (so_geom(isource) == so_volume) then
         call set_volume_source_x(so_args(isource),xseg,rn_args(r),lc_args(x))
      else
         assert("Untreated source geometry" == " ")
      end if

      return
      end

@ Source position on a surface. This is a 2-D version only. Namely, this
routine really just samples on a line.

@<Functions...@>=
      subroutine set_surface_source_x(so_dummy(isource),xseg,rn_dummy(r),lc_dummy(x))
      implicit_none_f77
      gi_common
      sc_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      rn_decl(r)                 // Input and output
      lc_decl(x)                 // Output

      real urd,r0,r1,fr
      vc_decl(deltax)
      vc_decl(xsrc)
      vc_decl(vzero)
      vc_decl(vone)
      vc_decl(vnorm)
      rn_decls

      sources_localcommon

      lc_decls

      rn_next(urd,r)

/* For cylindrical (toroidal) geometry, weight sampling along this
   surface by the major radius:
 */
      if (geometry_symmetry == geometry_symmetry_cylindrical) then
         r0=sqrt(sector_points[xseg][0][1]**2+sector_points[xseg][0][2]**2)
         r1=sqrt(sector_points[xseg][1][1]**2+sector_points[xseg][1][2]**2)
         if (r1 != r0) urd=(sqrt(r0**2 + urd*(r1**2-r0**2)) - r0) / (r1 - r0)
      else
         assert(geometry_symmetry == geometry_symmetry_plane ||
     $        geometry_symmetry == geometry_symmetry_oned)
      end if

/* Interpolate along the surface according to |urd|:
 */
      vc_difference(sector_points[xseg][1],sector_points[xseg][0],deltax)
      vc_xvt(sector_points[xseg][0],deltax,urd,xsrc)

/* Use |surface_reflect| to get an inward-pointing normal to this surface
   (should point into a plasma or vacuum cell).
 */
      vc_set(vzero,zero,zero,zero)
      vc_set(vone,zero,zero,one)
      call surface_reflect(sector_surface[xseg],vc_args(xsrc),vc_args(vzero),
     $     vc_args(vone),vc_args(vnorm))
      vc_copy(xsrc,x_surface)    // For use in |set_plate_source_v|
/* Then take a small step along the normal to be sure we're in the cell */
      fr=geom_epsilon/vc_abs(vnorm)
      vc_xvt(xsrc,vnorm,fr,lc_x(x))

      lc_set(x)

      return
      end

@ Source position in a volume. This is a 2-D version only. Namely, this
routine really just samples out of a rectangle and uses rejection to narrow
the selection to being inside the given zone.

@<Functions...@>=
      subroutine set_volume_source_x(so_dummy(isource),xseg,rn_dummy(r),lc_dummy(x))
      implicit_none_f77
      gi_common
      sc_common
      zn_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      rn_decl(r)                 // Input and output
      lc_decl(x)                 // Output

      integer i                  // Local
      real urd_x,urd_z,r0,r1,x,y,z


      lc_decls
      rn_decls

      i=0
loop: continue
      i++
//      assert(i < 200)     // Catch bugs; temporary
      rn_next(urd_x,r)
      rn_next(urd_z,r)

/* For cylindrical (toroidal) geometry, weight sampling along this
   surface by the major radius:
 */
      if (geometry_symmetry == geometry_symmetry_cylindrical) then
         r0=sqrt(zone_min[xseg][1]**2+zone_min[xseg][2]**2)
         r1=sqrt(zone_max[xseg][1]**2+zone_max[xseg][2]**2)
         if (r1 != r0) urd_x=(sqrt(r0**2 + urd_x*(r1**2-r0**2)) - r0) / (r1 - r0)
      else
         assert(geometry_symmetry == geometry_symmetry_plane ||
     $        geometry_symmetry == geometry_symmetry_oned)
      end if
      x=zone_min[xseg][1]+urd_x*(zone_max[xseg][1]-zone_min[xseg][1])
      y=zone_min[xseg][2]+urd_x*(zone_max[xseg][2]-zone_min[xseg][2])
      z=zone_min[xseg][3]+urd_z*(zone_max[xseg][3]-zone_min[xseg][3])

      vc_set(lc_x(x),x,y,z)

      lc_set(x)

      if (lc_cell(x) < 0 || lc_zone(x) != xseg) goto loop

      return
      end

@ Source velocity. Given a source ``segment'', sample a velocity
using routines specific for the type of that source. 

@<Functions...@>=
      subroutine set_source_v(so_dummy(isource),xseg,lc_dummy(x),
     $   rn_dummy(r),vc_dummy(vsrc),sp_dummy(spsrc))
      implicit_none_f77
      so_common                  // Common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      lc_decl(x)                
      rn_decl(r)                 // Input and output
      vc_decl(vsrc)              // Output
      sp_decl(spsrc)


      if (so_type(isource) == so_plate) then 
         call set_plate_source_v(so_args(isource),xseg,lc_args(x),
     $        rn_args(r),vc_args(vsrc),sp_args(spsrc))
      else if (so_type(isource) == so_puff) then
         call set_puff_source_v(so_args(isource),xseg,lc_args(x),
     $        rn_args(r),vc_args(vsrc),sp_args(spsrc))
      else if (so_type(isource) == so_recomb) then
         call set_recomb_source_v(so_args(isource),xseg,lc_args(x),
     $        rn_args(r),vc_args(vsrc),sp_args(spsrc))
      else
         assert("Unsupported source type" == " ")
      end if

      return
      end

@ Plate source velocity.
      
@<Functions...@>=
      subroutine set_plate_source_v(so_dummy(isource),xseg,lc_dummy(x),
     $   rn_dummy(r),vc_dummy(vsrc),sp_dummy(spsrc))
      implicit_none_f77
      so_common                  // Common
      pr_common
      bk_common
      sc_common
      sp_common
      zn_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      lc_decl(x)                
      rn_decl(r)                 // Input and output
      vc_decl(vsrc)              // Output
      sp_decl(spsrc)

      integer j                  // Local
      real vgauss,wa,sheath_pot,ion_energy,ion_velocity
      sp_decl(spion)  
      vc_decl(vzero)
      vc_decl(vone)
      sc_target_decl(target_sc_ptr)

      external neutralize_species  // External
      integer neutralize_species

      sources_localcommon

      assert(so_geom(isource) == so_surface)
      spion=so_species(isource)
      target_sc_ptr=sector_type_pointer[xseg][sc_target]
      assert(sc_target_check(target_sc_ptr))
      wa=zero
      if (target_e_ion_mult[target_sc_ptr] > zero) then
/* Sample a Gaussian energy at background temperature */
         do j=1,3
            rn_gauss_next(vgauss,r)
            wa+=vgauss**2
         end do
         wa=half*wa*bk_temp(pr_background_lookup(spion),lc_zone(x))
      else
         assert(target_e_ion_mult[target_sc_ptr] == zero)
      end if
@#if 0
      assert(sp_sy(pr_background(1))=='e')
/* Simple sheath model for now: $\Phi = 3 T_{e}$. */
      sheath_pot=const(3.)*bk_temp(1,lc_zone(x))
      assert(sp_z(spion) > 0)
      ion_energy=sp_z(spion)*sheath_pot + wa
@#endif
/*
   First attempt at a flexible sheath physics model. These parameters
   are now set in |readbackground.web|.
*/
      assert(sp_z(spion) == 1) // If $> 1$, should have term $\propto Z$
      ion_energy=target_e_ion_delta[target_sc_ptr]
     $     + target_e_ion_mult[target_sc_ptr]*wa
      
      ion_velocity=sqrt(two*ion_energy/sp_m(spion))

/* This should work if the analogous code for sampling surface x works 
   |lc_x(x)| should be slightly off of the plate. This generates a
   velocity which heads directly back to it, where |process_sector|
   is called to do the rest of the job.
 */
      vc_set(vzero,zero,zero,zero)
      vc_set(vone,zero,zero,-one)  
@#if 0
      call surface_reflect(sector_surface[xseg],lc_x(x),vc_args(vzero),
     $     vc_args(vone),vc_args(vsrc))
@#else
// Use normal at point {\em on surface}, obtained by common from |surface_source_x|
      call surface_reflect(sector_surface[xseg],vc_args(x_surface),
     $     vc_args(vzero),vc_args(vone),vc_args(vsrc))
@#endif
      vc_scale(ion_velocity,vsrc,vsrc)

      spsrc=neutralize_species(spion)

      return
      end

@ Gas puff source velocity. This is for a cosine distribution, appropriate
for a surface source. There might also be a need for a pure volume source
with an isotropic distribution; we would need another routine for that.
      
@<Functions...@>=
      subroutine set_puff_source_v(so_dummy(isource),xseg,lc_dummy(x),
     $   rn_dummy(r),vc_dummy(vsrc),sp_dummy(spsrc))
      implicit_none_f77
      so_common                  // Common
      sc_common
      sp_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      lc_decl(x)                
      rn_decl(r)                 // Input and output
      vc_decl(vsrc)              // Output
      sp_decl(spsrc)

      integer j,xseg2            // Local
      real vgauss,vpuff,temp
      vc_decl(vzero)
      vc_decl(vcos)

      sources_localcommon

      st_decls

      assert(so_geom(isource) == so_surface)
      spsrc=so_species(isource)

      rn_cos_next(vcos,r)
      vc_set(vzero,zero,zero,zero)
@#if 0
/* The usual procedure in sampling source location is to move it away from
   the surface a bit. To use |surface_reflect|, however, we need a point
   on the surface. ``Move'' along a normal between the sector endpoints
   to find the point |xp2| which corresponds to |lc(x)|.
 */
      vc_difference(sector_points[xseg][1],sector_points[xseg][0],deltax)
      vc_difference(lc_x(x),sector_points[xseg][0],xp)
      fr=vc_product(xp,deltax)/vc_abs2(deltax)
      assert(fr >= 0 && fr <= one)
      vc_xvt(sector_points[xseg][0],deltax,fr,xp2)
      call surface_reflect(sector_surface[xseg],vc_args(xp2),vc_args(vzero),
     $     vc_args(vcos),vc_args(vsrc))
@#else
/*  Use now common value of |x_surface|.
*/
      call surface_reflect(sector_surface[xseg],vc_args(x_surface),
     $     vc_args(vzero),vc_args(vcos),vc_args(vsrc))
@#endif

/* To get a thermal particle as in original DEGAS, need to sample
   each component from a Gaussian.
 */
      vpuff=zero
      do j=1,3
         rn_gauss_next(vgauss,r)
         vpuff+=vgauss**2
      end do
/* The energy of the puff is hardwired here at 0.03 eV. Again, this
   is another piece of miscellaneous info that needs a home in the
   source class.
 */
@#if 0
      vpuff=sqrt(vpuff*electron_charge*const(3.,-2)/sp_m(spsrc))
@#endif
@#if 0
      xseg2=int_lookup(-sector_surface[xseg],sector_surface[1],nsectors)
      assert(strata[xseg2]==strata[xseg])
@#endif
      if (sc_wall_check(sector_type_pointer[xseg][sc_wall])) then
         temp=wall_temperature[sector_type_pointer[xseg][sc_wall]]
      else if (sc_target_check(sector_type_pointer[xseg][sc_target])) then
         temp=target_temperature[sector_type_pointer[xseg][sc_target]]
      else
         assert('Puffing surface not found' == ' ')
      end if
      vpuff=sqrt((vpuff*temp)/sp_m(spsrc))   // 1 eV for box case
      vc_scale(vpuff,vsrc,vsrc)

      return
      end

@ Recombination source velocity.
      
@<Functions...@>=
      subroutine set_recomb_source_v(so_dummy(isource),xseg,lc_dummy(x),
     $   rn_dummy(r),vc_dummy(vsrc),sp_dummy(spsrc))
      implicit_none_f77
      so_common                  // Common
      pr_common
      bk_common
      gi_common
      sp_common
      zn_common
      implicit_none_f90

      so_decl(isource)           // Input
      integer xseg
      lc_decl(x)                
      rn_decl(r)                 // Input and output
      vc_decl(vsrc)              // Output
      sp_decl(spsrc)

      integer j                  // Local
      real vgauss,vion
      vc_decl(vb_flow)
      pr_background_decl(spback)


      assert(so_geom(isource) == so_volume)
      spsrc=so_species(isource)
/* Need also species of recombining ion. This should be stored in the
   source class, but this appears to be a sort of miscellaneous info.
   for which we don't have a convenient slot (e.g., along with neutralized
   plate source species and gas puff energy).
 */
      spback=0
      do j=1,pr_bkrc_num
         if (pr_bkrc_prod(j,1) == spsrc) then
            assert(spback == 0)
            spback=pr_bkrc_rg(j,2)
         end if
      end do
      assert(spback != 0)

      v_ext_to_int(lc_x(x),bk_v(spback,lc_zone(x)),vb_flow,geometry_symmetry,background_coords)
      vion=sqrt(bk_temp(spback,lc_zone(x))/sp_m(spsrc))
      do j=1,3
         rn_gauss_next(vgauss,r)
         vsrc[j]=vion*vgauss + vb_flow[j]
      end do

      return
      end

@ Test species corresponding to background. Uses the fact that all charge in
a species arises from electrons along with the |species_add_check| function
to find the first entry the test list which matches the background species
with no electrons in its elements list.

@<Functions...@>=
      function neutralize_species(sp_dummy(s))
      implicit_none_f77
      el_common                          // Common
      sp_common
      pr_common
      implicit_none_f90
      st_decls
      integer neutralize_species         // Function
      sp_decl(s)                         // Input

      integer i,num_elec,num1,num2       // Local
      sp_decl(e_sp)
      sp_decl(test_sp)
      sp_decl(list1[sp_ncomp_max])
      sp_decl(list2[sp_ncomp_max])

      
      external species_add_check         // External
      logical species_add_check

      num_elec=0
      do i=1,sp_ncomp(s)
         if (el_z(sp_el(s,i)) == -1) then
            num_elec+=sp_count(s,i)
         end if
      end do

      list1[1]=s
      num1=1
      num2=1
      e_sp=sp_lookup('e')
      do i=1,abs(num_elec)
         if (num_elec < 0) then
            list1[i+1]=e_sp
            num1++
         else
            list2[i+1]=e_sp
            num2++
         end if
      end do


      do i=1,pr_test_num
         test_sp=pr_test(i)
         list2[1]=test_sp
         if (species_add_check(num1,sp_args(list1),num2,sp_args(list2))) go to break
      end do
      assert("No matching neutral species" == " ")
break: continue

      neutralize_species=test_sp

      return
      end

@* INDEX.
