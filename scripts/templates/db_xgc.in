#This should be in the default (tabular) format!

plasma_file d2xgc_plasma_data

# This time interval is arbitrary and included just to get the
# code set up in time dependent mode.  The actual interval will be
# specified by XGC0.

#time_interval  0.0  1.0

new_source_group
  source_type plt_e_bins
#
# Setting this to the maximum (so_e_bins_num_max) 
# here so that XGC0 can override it with a 
# smaller value as needed.  The other parameters
# will also be set by XGC0 upon initialization.
# Do NOT need to set the binned data here.
#
  source_e_bin_num EBINNUM
  source_e_bin_min 1.0
  source_e_bin_max 1.0e4
  source_e_bin_spacing log
  source_geom surface
  source_species D
  source_root_sp D+
  source_nflights 9600
  specify_current
#  source_time_variation uniform
  source_file sourcedata_placeholder tabular
#  source_stratum 2
#  source_segment *
#  source_strength 1.e21
end_source_group

