symmetry cylindrical
bounds RMIN RMAX ZMIN XMAX 
wallfile ../CASENAME.aif
sonnet_mesh ../CASENAME.son NUMELE 1
end_prep

new_zone solid

# Polygon 1: inner block
#
# This assumes that the first point of the wall is at or
# near the inner midplane so that we can safely connect it
# to the two R_min corners.

  new_polygon
    stratum 1
    material C
    recyc_coef RECYC
    wall 1 1 0 
    outer 0 1
  print_polygon poly_1
  breakup_polygon
#  clear_polygon

# Polygon 2: everthing else

  new_polygon
    stratum 2
    wall 1 1 *
    outer 0 3 2 1 
# Wall doesn't close on itself.
    wall 1 1 1     
  print_polygon poly_2
  triangulate_polygon
#  clear_polygon

polygon_nc_file poly.nc

end
quit
