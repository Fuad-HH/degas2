#
# Template degas2 input file for use with XGC
# Script will replace WORKDIR with where the problem input files get stored and WORKDIR with the XGC working directory, specified by the user
#

# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# Reference input files

elements_infile DATADIR/elements.input 
elementsfile  DATADIR/elements.nc 
species_infile DATADIR/species.input
speciesfile DATADIR/species.nc 
reaction_infile DATADIR/reactions.input
reactionfile DATADIR/reactions.nc 
materials_infile DATADIR/materials.input
materialsfile DATADIR/materials.nc
pmi_infile DATADIR/pmi.input
pmifile DATADIR/pmi.nc

# Problem specific files - Have versions with just D
# and D / D2.

problem_infile WORKDIR/d2problem.input
problemfile WORKDIR/d2problem.nc

# The objective here is to keep the procedure as simple as possible
# with minimal human intervention so that it might be automated.
#
# Do not need a special usr2ddetector.web.

geometryfile WORKDIR/d2geometry.nc

# Get the plasma data from a file written by XGC with a name like 
# plasma_data_xxxxxx.  Because this is just a placeholder, the number
# of zones don't even need to match.  Do not need a special usr2dplasma.web.
#
# DO need an explicit source file to get all of the wall
# and target sectors.  Obtain this via the "source_segment *"
# trick for all non-trivial source_stratum.
#

backgroundfile WORKDIR/d2background.nc

# This is in fact still the default tally input from the example

tally_infile WORKDIR/d2tally.input
tallyfile WORKDIR/d2tally.nc

outputfile WORKDIR/d2output.nc

snapshotfile WORKDIR/d2snapshot.nc


