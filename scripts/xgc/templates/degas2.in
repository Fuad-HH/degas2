#
# Template degas2 input file for use with XGC
# Script will replace XGCD2DIR with where the problem input files get stored and XGCD2DIR with the XGC working directory, specified by the user
#

# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# Reference input files

elements_infile XGCD2DIR/elements.input 
elementsfile  XGCD2DIR/elements.nc 
species_infile XGCD2DIR/species.input
speciesfile XGCD2DIR/species.nc 
reaction_infile XGCD2DIR/reactions.input
reactionfile XGCD2DIR/reactions.nc 
materials_infile XGCD2DIR/materials.input
materialsfile XGCD2DIR/materials.nc
pmi_infile XGCD2DIR/pmi.input
pmifile XGCD2DIR/pmi.nc

# Problem specific files - Have versions with just D
# and D / D2.

problem_infile XGCD2DIR/pr_xgc.input
problemfile XGCD2DIR/pr_xgc_D2.nc

# The objective here is to keep the procedure as simple as possible
# with minimal human intervention so that it might be automated.
#
# Do not need a special usr2ddetector.web.

geometryfile XGCD2DIR/ge_rpi.nc

# Get the plasma data from a file written by XGC with a name like 
# plasma_data_xxxxxx.  Because this is just a placeholder, the number
# of zones don't even need to match.  Do not need a special usr2dplasma.web.
#
# DO need an explicit source file to get all of the wall
# and target sectors.  Obtain this via the "source_segment *"
# trick for all non-trivial source_stratum.
#

backgroundfile XGCD2DIR/bk_rpi.nc

# This is in fact still the default tally input from the example

tally_infile XGCD2DIR/tally_xgc.input
tallyfile XGCD2DIR/tally_rpi_D2.nc

outputfile XGCD2DIR/degas2_xgc.nc

snapshotfile XGCD2DIR/sn_xgc.nc


