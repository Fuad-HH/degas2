# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# symbolic_filename  actual_filename

# The filenames can be in any order; comments and spaces will be ignored.
# For more information, see the documentation in readfilenames.hweb
# and the User's Manual.

elements_infile ../data/elements.input 
elementsfile  ../data/elements.nc 

species_infile ../data/species.input
speciesfile ../data/species.nc 

reaction_infile ../data/reactions.input
reactionfile ../data/reactions.nc 

materials_infile ../data/materials.input
materialsfile ../data/materials.nc

pmi_infile ../data/pmi.input
pmifile ../data/pmi.nc

problem_infile  ../examples/He_metastables/pr_boxgen_mboth.input
problemfile pr_boxgen_mboth.nc 

geometryfile ge_boxgen.nc 
backgroundfile bk_boxgen_mboth.nc 

tally_infile ../examples/He_metastables/tally_boxgen.input
tallyfile tally_boxgen_mboth.nc

outputfile degas2_boxgen_mboth.nc


