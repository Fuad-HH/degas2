# This is a simple run associated with a 2016 NSTX-U shot
# for comparison with ENDD data.  This is also the first 
# ENDD run using efit2dg2d.web (and nstxendd3.web) to set
# up the geometry and plasma.  Here, we demonstrate the
# effects of the relatively new H2 CR model.

# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# symbolic_filename  actual_filename

# The filenames can be in any order; comments and spaces will be ignored.
# For more information, see the documentation in readfilenames.hweb
# and the User's Manual.

# These are the reference input files and generally do not need
# to be altered for GPI simulations.

elements_infile ../data/elements.input 
elementsfile  ../data/elements.nc 

species_infile ../data/species.input
speciesfile ../data/species.nc 

reaction_infile ../data/reactions.input
reactionfile ../data/reactions.nc 

materials_infile ../data/materials.input
materialsfile ../data/materials.nc

pmi_infile ../data/pmi.input
pmifile ../data/pmi.nc

problem_infile ../examples/NSTX_204500_682_ex/pr_nstx_jcr_c_fe.input
problemfile pr_nstx_jcr_c_fe.nc

# The input file is nstx_204500_682_dg2d.in, largely
# consists of the polygons_dg2d.in file generated
# by efit2dg2d.
# No usr2ddetector.web needed here.

geometryfile ge_endd_nstx.nc 

# The input file is nstx_204500_682_db.in with 
# nstxendd3.web as usr2dplasma.web.

backgroundfile bk_endd_nstx.nc 

# This is a pretty basic tally input file since there
# is no simulated camera in this run.

tally_infile ../examples/NSTX_204500_682_ex/tally_endd_nstx.input

# The resulting tally netCDF file is run specific since it 
# contains information about the DEGAS 2 geometry.

tallyfile tally_endd_nstx_jcr.nc

outputfile degas2_endd_nstx_jcr.nc









