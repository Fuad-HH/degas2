# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# symbolic_filename  actual_filename

# The filenames can be in any order; comments and spaces will be ignored.
# For more information, see the documentation in readfilenames.hweb
# and the User's Manual.

# This is a simple 2-D (axisymmetric) simulation of a single NCSX
# cross section.  The flux surface shapes are derived from a VMEC
# equilibrium (via a separate code).  The background plasma
# is taken from a separate transport code calculation.  The source
# is ad hoc.

elements_infile ../data/elements.input 
elementsfile  ../data/elements.nc 

species_infile ../data/species.input
speciesfile ../data/species.nc 

reaction_infile ../data/reactions.input
reactionfile ../data/reactions.nc

materials_infile ../data/materials.input
materialsfile ../data/materials.nc

# This uses a modified PMI file, removing H as
# a product in desorption from C.

pmi_infile ../examples/NCSX/pmi.input
pmifile pmi.nc

# The reactions and PMI are otherwise
# standard for D2 in a carbon device.

problem_infile  ../examples/NCSX/pr_ncsx.input
problemfile pr_ncsx.nc

# Input file for definegeometry2d is ../examples/NCSX/dg2dinz1li383

geometryfile ge_ncsx.nc 

# Input file for defineback is ../examples/NCSX/z1li383_db.in
# Need to use ncsxplasma.web for usr2dplasma.web

backgroundfile bk_ncsx.nc 

tally_infile ../examples/NCSX/tally_ncsx.input
tallyfile tally_ncsx.nc

outputfile degas2_ncsx_out.nc


