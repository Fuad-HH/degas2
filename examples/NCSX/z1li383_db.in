 
# This is the input file for defineback. It in turn reads other files
# to get the bulk of the required data.  Note that one of these is
# the polygon netCDF file (ncsxz1li383.nc) generated by definegeometry2d.

plasma_file ../examples/NCSX/radiiz1li383 ../examples/NCSX/nT_profiles ncsxz1li383.nc 0.022 0.022 

new_source_group
  source_type plate
  source_geom surface
  source_species D
  source_root_sp D+
  specify_current
  source_stratum   22   23
  source_segment    0    6
  source_strength 1.e21 1.e21
end_source_group



