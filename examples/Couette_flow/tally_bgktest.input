# This tally is specifically defined for the Couette flow example
# and may not represent anything physical in other problems.

xz stress tensor
  DEPENDENT VARIABLE
	xz_stress
  INDEPENDENT VARIABLES
	zone
	test
  CONVERSIONS
	scale_volume
  ESTIMATORS
# For test tallies, is T or C only
	T   
--------------------------------------------------------

REACTION TALLIES

# estimator restrictions:
#
#   ionize_suppress - no C (there are no collisions)
#   recombination   - no T (it is not a tracked reaction)
#   test_ion        - C only (test ions are not tracked currently)
#
#   For spectrum tallies, P works only with recombination (post processed
#   tallies use an average velocity)

ion source rate
  DEPENDENT VARIABLE
	mass_change
  INDEPENDENT VARIABLES
	zone
	problem_sp
  CONVERSIONS
	scale_problem_sp_mass
  ESTIMATORS
# ionize  ionize_sup. chargex elastic dissoc test_ion plate puff recomb. 
    P	      P          C       T      T       C       C    C     N         
----1---------2----------3-------4------5-------6-------7----8-----9---------

ion momentum source vector		     		                     
  DEPENDENT VARIABLE
	momentum_change_vector		     		                     
  INDEPENDENT VARIABLES			     		                     
	zone				     		                     
	problem_sp
  CONVERSIONS				     		                     
	track_v_to_external		     		                     
  ESTIMATORS				     		                     
    T	      T          C       T      C       C       C    C     N         
----1---------2----------3-------4------5-------6-------7----8-----9---------

ion energy source			     		                     
  DEPENDENT VARIABLE
	energy_change
  INDEPENDENT VARIABLES
	zone  
	problem_sp
  ESTIMATORS
    T	      T          C       T      C       C       C    C     N         
----1---------2----------3-------4------5-------6-------7----8-----9---------

energy source by reaction	     		                     
  DEPENDENT VARIABLE
	energy_change
  INDEPENDENT VARIABLES
	problem_sp
        reaction
  ESTIMATORS
    C	      T          C       C      C       C       C    C     N         
----1---------2----------3-------4------5-------6-------7----8-----9---------
total momentum source vector		     		                     
