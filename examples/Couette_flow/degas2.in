# file names for degas2
#the name of this file is passed as argument to readfilenames
# syntax is : symbolic filename  [actual filename]
#the filenames can be in any order, comments and spaces will be ignored 
# (like this line). 

elements_infile ../data/elements.input 
elementsfile  ../data/elements.nc 

species_infile ../data/species.input
speciesfile ../data/species.nc 

reaction_infile ../examples/Couette_flow/reactions_bgktest.input
reactionfile reactions_bgktest.nc 

materials_infile ../data/materials.input
materialsfile ../data/materials.nc

pmi_infile ../examples/Couette_flow/pmi_bgktest.input
pmifile pmi_bgktest.nc

problem_infile  ../examples/Couette_flow/pr_bgktest.input
problemfile pr_bgktest.nc 

backgroundfile bk_bgktest.nc 
geometryfile ge_bgktest.nc 

tally_infile ../examples/Couette_flow/tally_bgktest.input
tallyfile tally_bgktest.nc

outputfile degas2_bgktest.nc

