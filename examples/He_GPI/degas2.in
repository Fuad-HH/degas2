# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# symbolic_filename  actual_filename

# The filenames can be in any order; comments and spaces will be ignored.
# For more information, see the documentation in readfilenames.hweb
# and the User's Manual.

# This is a 3-D simulation of 112811 with an unsmoothed Thomson
# scattering electron temperature profile.  The DG file is based on an EFIT02 
# equilibrium at 250 ms.

elements_infile ../data/elements.input 
elementsfile  ../data/elements.nc 

species_infile ../data/species.input
speciesfile ../data/species.nc 

reaction_infile ../data/reactions.input
reactionfile ../data/reactions.nc 

materials_infile ../data/materials.input
materialsfile ../data/materials.nc

pmi_infile ../data/pmi.input
pmifile ../data/pmi.nc

# This is essentially for neutral helium puffed into a
# deuterium plasma.  PMI's are expected to be unimportant

problem_infile  ../examples/He_GPI/pr_nstx_m.input
problemfile pr_nstx_m.nc 

# Input file for definegeometry2d is nstx_25_dg2d.in or nstx_25_dg3d.in 
# Using gpicamera.web for usr2ddetector.web 

geometryfile ge_nstx_25_2d.nc 

# Input file for defineback is nstx_30_db.in
# Note that this file has lines for both the 2-D and 3-D
# source files; the one not needed should be commented out.  
# Requires using nstxgpi2.web for usr2dplasma.web

backgroundfile bk_nstx_30.nc 

tally_infile ../examples/He_GPI/tally_nstx_rev.input
tallyfile tally_nstx_30.nc

outputfile degas2_nstx_30_out.nc






