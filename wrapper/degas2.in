# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# Reference input files

elements_infile /u/gwilkie/src/degas2/data/elements.input 
elementsfile  /u/gwilkie/src/degas2/data/elements.nc 
species_infile /u/gwilkie/src/degas2/data/species.input
speciesfile /u/gwilkie/src/degas2/data/species.nc 
reaction_infile /u/gwilkie/src/degas2/data/reactions.input
reactionfile /u/gwilkie/src/degas2/data/reactions.nc 
materials_infile /u/gwilkie/src/degas2/data/materials.input
materialsfile /u/gwilkie/src/degas2/data/materials.nc
pmi_infile /u/gwilkie/src/degas2/data/pmi.input
pmifile /u/gwilkie/src/degas2/data/pmi.nc

# Problem specific files 

problem_infile ltx_problem.input
problemfile ltx_problem.nc

# The objective here is to keep the procedure as simple as possible
# with minimal human intervention so that it might be automated.
#
# Do not need a special usr2ddetector.web.

geometryfile ltxgeometry.nc

# Get the plasma data from a file written by XGC with a name like 
# plasma_data_xxxxxx.  Because this is just a placeholder, the number
# of zones don't even need to match.  Do not need a special usr2dplasma.web.
#
# DO need an explicit source file to get all of the wall
# and target sectors.  Obtain this via the "source_segment *"
# trick for all non-trivial source_stratum.
#

backgroundfile ltx_background.nc

# This is in fact still the default tally input from the example

tally_infile ltx_tally.input
tallyfile ltx_tally.nc

outputfile ltx_output.nc

