# File Names for DEGAS 2

# The name of this file is hardcoded in subroutine |readfilenames|
# The syntax here is:

# Reference input files

elements_infile D2ROOT/data/elements.input 
elementsfile  D2ROOT/data/elements.nc 
species_infile D2ROOT/data/species.input
speciesfile D2ROOT/data/species.nc 
reaction_infile D2ROOT/data/reactions.input
reactionfile D2ROOT/data/reactions.nc 
materials_infile D2ROOT/data/materials.input
materialsfile D2ROOT/data/materials.nc
pmi_infile D2ROOT/data/pmi.input
pmifile D2ROOT/data/pmi.nc

# .nc "output" files read by other executables. 
# Can name the following however you want
problemfile problem.nc
geometryfile geometry.nc
backgroundfile background.nc
tallyfile tally.nc
outputfile output.nc

# Problem specific files. Generate these yourself.
problem_infile problem.in
tally_infile tally.in


